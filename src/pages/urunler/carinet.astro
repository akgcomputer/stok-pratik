---
// src/pages/urunler/carinet.astro - CariNET B2B Tanıtım Sayfası
import BaseLayout from '../../layouts/BaseLayout.astro';

const features = [
  {
    icon: "📊",
    title: "Canlı Cari Ekstre & Fatura PDF İndirme",
    desc: "Müşteriniz telefonla muhasebenizi arayıp 'Bakiyem ne kadar, son faturamı WhatsApp'tan atar mısınız?' diye sormaz; tüm hareketlerini ve fatura kalemlerini 7/24 canlı görür ve indirir."
  },
  {
    icon: "💳",
    title: "3D Secure Kredi Kartı ile Anında Bakiye Kapama",
    desc: "Müşteriniz vadesi gelen borcunu veya istediği tutarı tek çekim ya da taksitli kredi kartıyla güvenle öder; yapılan tahsilat kuruşu kuruşuna cari hesabından otomatik düşer."
  },
  {
    icon: "🛒",
    title: "Cariye Özel İskontolu B2B Katalog & Sipariş Sepeti",
    desc: "Her bayinize özel tanımladığınız fiyat listesi, vadeli iskonto ve kampanya kurallarıyla bayiniz sepetini oluşturup siparişini doğrudan ERP sisteminize onaylı düşürür."
  },
  {
    icon: "🔄",
    title: "Self-Servis İade (RMA) & Mutabakat Onayı",
    desc: "Bayiniz arızalı veya iade ürün talebini koli ve ürün fotoğraflarıyla portal üzerinden açar; cari hesap mutabakatını da tek tıkla inceleyip onaylar."
  }
];

const faqs = [
  {
    q: "Bayilerim başkasının fiyatlarını veya diğer firmaların bilgilerini görebilir mi?",
    a: "Hayır. Her bayiye tanımlanan kullanıcı adı ve şifre tamamen izoledir. Bayi sadece kendisine özel fiyat listesini, iskonto oranlarını ve kendi fatura geçmişini görebilir."
  },
  {
    q: "Kredi kartı tahsilatları hangi banka veya sanal POS ile çalışır?",
    a: "İster kendi şirketinizin banka sanal POS'unu (Garanti, İş Bankası, Yapı Kredi, Akbank vb.) ister iyzico, PayTR gibi ödeme kuruluşlarını bağlayabilirsiniz. Komisyon kuralları otomatik uygulanır."
  },
  {
    q: "Bayi sipariş verdiğinde stoklarımızdan hemen düşer mi?",
    a: "Evet! Bayi CariNET üzerinden siparişi onayladığı an ürünler merkez depoda rezerve edilir ve stoktan düşer. Böylece aynı malın başka bir kanaldan mükerrer satılması engellenir."
  }
];
---

<BaseLayout
  title="CariNET B2B | Müşteri & Bayi Self-Servis Sipariş ve 3D Tahsilat Portalı — StokPratik"
  description="Müşterilerinize özel şifre tanımlayın; 7/24 canlı cari ekstrelerini görsünler, 3D Secure kredi kartıyla borç ödesinler ve kendilerine özel iskontolarla B2B sipariş versinler."
>
  <main class="min-h-screen bg-slate-950 text-slate-100 selection:bg-blue-500 selection:text-white pb-24">
    
    {/* HERO BÖLÜMÜ */}
    <section class="relative pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-slate-800 overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[380px] bg-gradient-to-b from-blue-600/15 via-cyan-600/10 to-transparent blur-3xl pointer-events-none"></div>

      <div class="container mx-auto px-4 max-w-6xl relative z-10">
        
        <div class="flex items-center gap-2 mb-6">
          <a href="/pratik-ekosistemi" class="text-xs font-bold text-blue-400 hover:text-blue-300 transition-colors">
            ← Pratik Ekosistemi Ana Sayfası
          </a>
          <span class="text-slate-600">•</span>
          <span class="text-xs text-slate-400">Departman Çözümü 02</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs sm:text-sm font-bold shadow-sm mb-5">
              <span>🌐</span>
              <span>B2B CARİ EKSTRE, SİPARİŞ & 3D TAHSİLAT</span>
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
              CariNET B2B: Müşteriniz Ekstre İstemek İçin Aramasın, Kendi Ekranından Sipariş Verip Ödesin!
            </h1>

            <p class="mt-5 text-slate-300 text-sm sm:text-base lg:text-lg leading-relaxed">
              Her cari kartınıza tek tıkla özel kullanıcı adı ve şifre üretip WhatsApp ile gönderin. Bayiniz kendi ekranından güncel bakiyesini incelesin, açık faturalarını kredi kartıyla kapatsın ve size özel fiyat listesiyle sipariş geçsin.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/carinet"
                target="_blank"
                rel="noopener noreferrer"
                class="px-7 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-sm sm:text-base shadow-lg shadow-blue-500/25 transition-all hover:scale-105 flex items-center gap-2"
              >
                <span>🌐 CariNET B2B Portala Gir</span>
                <span class="text-lg">↗</span>
              </a>

              <button 
                type="button"
                class="open-request-modal px-6 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm sm:text-base border border-slate-700 transition-all hover:border-blue-500/50 cursor-pointer"
                data-package="CariNET B2B Yıllık Lisans"
              >
                💎 Lisans & Paket Talebi Oluştur
              </button>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900">
              <img 
                src="/images/ekosistem/carinet_crm_servis_portallari_hero_1793942256908.jpg" 
                alt="CariNET B2B Portal Görseli"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* 4 TEMEL ÖZELLİK */}
    <section class="py-16 sm:py-20 bg-slate-900/60 border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-6xl">
        
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">Self-Servis B2B Gücü</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-1">
            Bayi ve Müşteri İlişkilerinizi Otomatiğe Bağlayan 4 Sütun
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {features.map((f, i) => (
            <div class="p-6 sm:p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-blue-500/40 transition-all">
              <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center text-2xl mb-4">
                {f.icon}
              </div>
              <h3 class="text-lg font-bold text-white mb-2">
                {i + 1}. {f.title}
              </h3>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
                {f.desc}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* SSS BÖLÜMÜ */}
    <section class="py-16 sm:py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-4xl">
        
        <div class="text-center mb-12">
          <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">Sıkça Sorulan Sorular</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
            CariNET B2B Hakkında Merak Edilenler
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
              <h3 class="text-base font-bold text-white mb-2">
                {faq.q}
              </h3>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* ALT CTA */}
    <section class="py-16 sm:py-20 bg-slate-900">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 font-bold text-xs mb-4">
          YILLIK ÖDEME AVANTAJI
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Bayileriniz İçin 7/24 Açık Dijital Şubenizi Başlatın
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-3 max-w-xl mx-auto">
          WhatsApp'tan şifre üretip gönderin, alacaklarınızı 3D kredi kartıyla tahsil edin ve siparişleri otomatik toplayın.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <button 
            type="button"
            class="open-request-modal px-8 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-sm sm:text-base shadow-xl shadow-blue-500/25 transition-all hover:scale-105 cursor-pointer"
            data-package="CariNET B2B Yıllık Ödeme"
          >
            💎 Lisans & Paket Talebi Oluştur
          </button>

          <a 
            href="/pratik-ekosistemi"
            class="px-6 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-colors"
          >
            ← Diğer Pratik Ürünlerini Keşfet
          </a>
        </div>

      </div>
    </section>

    {/* MODAL */}
    <div id="productModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative text-left">
        <button id="closeProdModalBtn" type="button" class="absolute top-5 right-5 text-slate-400 hover:text-white text-xl p-1">
          ✕
        </button>
        <h3 class="text-xl font-extrabold text-white mb-2">CariNET B2B Lisans Talebi</h3>
        <p class="text-xs text-slate-400 mb-6">Yetkili satış temsilcimiz 15 dakika içinde sizinle iletişime geçecektir.</p>
        <form id="prodReqForm" class="space-y-4">
          <input type="text" required id="pName" placeholder="Adınız Soyadınız *" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-blue-500" />
          <input type="tel" required id="pPhone" placeholder="Telefon Numaranız *" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-blue-500" />
          <input type="email" required id="pEmail" placeholder="Firma E-Posta Adresiniz *" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-blue-500" />
          <div id="pFeedback" class="hidden text-xs p-3 rounded-xl"></div>
          <button type="submit" id="pSubmitBtn" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-black text-sm cursor-pointer">Talebi Gönder</button>
        </form>
      </div>
    </div>

  </main>
</BaseLayout>

<script>
  function setupProductModal() {
    const modal = document.getElementById('productModal');
    const openBtns = document.querySelectorAll('.open-request-modal');
    const closeBtn = document.getElementById('closeProdModalBtn');
    const form = document.getElementById('prodReqForm') as HTMLFormElement;
    const feedback = document.getElementById('pFeedback');
    const submitBtn = document.getElementById('pSubmitBtn') as HTMLButtonElement;

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.textContent = 'İletiliyor...';

      const name = (document.getElementById('pName') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('pPhone') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('pEmail') as HTMLInputElement)?.value || '';

      try {
        await fetch('/api/campaign/extend-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, package: 'CariNET B2B', timestamp: new Date().toISOString() })
        }).catch(() => null);
      } catch (err) {}

      if (feedback) {
        feedback.className = 'text-xs p-3 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 block';
        feedback.textContent = '✅ Talebiniz alınmıştır! Lisans ve paket talebiniz Süperadmin ekranına başarıyla iletildi.';
      }

      submitBtn.disabled = false;
      submitBtn.textContent = 'Talebiniz Alındı ✓';

      setTimeout(() => {
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
        form.reset();
        submitBtn.textContent = 'Talebi Gönder';
      }, 2500);
    });
  }

  document.addEventListener('DOMContentLoaded', setupProductModal);
  document.addEventListener('astro:page-load', setupProductModal);
</script>
