            Açıklama metni...
          </div>
        </div>

        {/* Bottom Conversion Actions */}
        <div class="mt-6 pt-4 border-t border-slate-800 flex flex-col gap-3">
          
          <div class="bg-gradient-to-r from-red-600/20 to-amber-500/20 border border-amber-400/40 rounded-xl p-3 text-center">
            <p class="text-xs text-amber-300 font-bold mb-1">
              🎁 45 Gün Ücretsiz Kampanya Promosyon Kodu
            </p>
            <p class="font-mono text-white font-black text-sm tracking-wider">
              StokPratik45Gun
            </p>
