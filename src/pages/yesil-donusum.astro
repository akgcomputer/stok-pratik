---
// src/pages/yesil-donusum.astro - YeşilPratik 2026 AB SKDM (CBAM) & 7552 TR-ETS Kurumsal Karbon Muhasebesi
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "YeşilPratik — 2026 AB SKDM & 7552 İklim Kanunu Kurumsal Karbon Muhasebesi | StokPratik";
const pageDescription = "StokPratik ekosisteminin yeni nesil karbon muhasebesi: GİB e-fatura XML ve üretim reçetelerinizden (BOM) 15 saniyede ISO 14064-1 envanteri hazırlayın, tek tıkla resmi AB CBAM .xml çıktısı alın.";
const canonicalUrl = "https://stokpratik.com.tr/yesil-donusum";

// Links
const liveDemoUrl = "https://yesilpratik.pages.dev";
const skdmToolUrl = "https://yesilpratik.pages.dev/skdm";
const whatsappNumber = "905412465429";
const defaultWhatsappMessage = encodeURIComponent("Merhaba, YeşilPratik 2026 AB SKDM ve Kurumsal Karbon Muhasebesi hakkında bilgi almak ve demo incelemek istiyorum.");
const directWhatsappUrl = `https://wa.me/${whatsappNumber}?text=${defaultWhatsappMessage}`;

// 4 Core Powers
const corePowers = [
  {
    icon: "⚡",
    badge: "15 SANİYEDE ENVENTER",
    title: "Manuel Fatura Zahmetine Son: e-Fatura & BOM ile Otopilot",
    desc: "2026'da faturaları tek tek Excel'e işlemek yerine; GİB e-Fatura XML ve StokPratik ERP API bağlantısıyla Kapsam 1, Kapsam 2 ve Kapsam 3 emisyonlarınızı 15 saniyede ISO 14064-1 envanterine dönüştürün.",
    color: "from-emerald-500/20 to-teal-500/10",
    border: "border-emerald-500/40",
    textColor: "text-emerald-400"
  },
  {
    icon: "🇪🇺",
    badge: "RESMİ GÜMRÜK FORMATI",
    title: "AB SKDM (CBAM) İçin Tek Tıkla .xml Çıktısı",
    desc: "Avrupalı müşterinize göndereceğiniz resmi AB CBAM .xml dosyasını tek tıkla üretin. Müşteriniz dosyayı doğrudan AB Gümrük Portalına yüklesin; sınırda karbon vergisi cezalarından ve gümrük beklemelerinden kurtulun.",
    color: "from-blue-500/20 to-indigo-500/10",
    border: "border-blue-500/40",
    textColor: "text-blue-400"
  },
  {
    icon: "🏛️",
    badge: "%70 DEVLET DESTEĞİ",
    title: "T.C. Ticaret Bakanlığı Responsible® Hibe Kapsamında",
    desc: "YeşilPratik lisans ve entegrasyon bedelleri, Ticaret Bakanlığı Yeşil Mutabakat Uyum Projesi Desteği kapsamında %70 hibe ile geri ödenir. Yatırımınız sıfıra yakın maliyetle karşılanır.",
    color: "from-amber-500/20 to-yellow-500/10",
    border: "border-amber-500/40",
    textColor: "text-amber-400"
  },
  {
    icon: "📈",
    badge: "7552 TR-ETS ENTEGRASYONU",
    title: "EPİAŞ Karbon Piyasasında Emisyon Geliri Elde Edin",
    desc: "7552 sayılı İklim Kanunu ile yürürlüğe giren Türkiye Emisyon Ticaret Sistemi (TR-ETS) kapsamında yasal emisyon kotanızın altında kalan tasarrufunuzu EPİAŞ Karbon Borsası'nda nakde dönüştürün.",
    color: "from-teal-500/20 to-emerald-500/10",
    border: "border-teal-500/40",
    textColor: "text-teal-400"
  }
];

// Target Sectors
const sectors = [
  {
    name: "Demir-Çelik & Metal Sanayi",
    desc: "Ham çelik, haddelenmiş profil, döküm ve ferforje ihracatında ton başına gömülü karbon (embedded emissions) hesabı.",
    icon: "⚙️",
    badge: "SKDM Öncelikli"
  },
  {
    name: "Alüminyum & Ekstrüzyon",
    desc: "Külçe, profil, rulo levha ve alüminyum alaşımlarında ergitme ve proses elektriği emisyon ayrıştırması.",
    icon: "🔩",
    badge: "SKDM Öncelikli"
  },
  {
    name: "Çimento, Klinker & Yapı Kimyasalları",
    desc: "Kalsinasyon fırın emisyonları, klinker oranı ve alternatif yakıt kullanımının ISO 14064 katsayılarıyla doğrulanması.",
    icon: "🏗️",
    badge: "SKDM Öncelikli"
  },
  {
    name: "Gübre & Kimya İmalatı",
    desc: "Amonyak, nitrik asit, üre ve kompleks gübre üretiminde proses bazlı sera gazı emisyonlarının resmi beyanı.",
    icon: "🧪",
    badge: "SKDM Öncelikli"
  },
  {
    name: "Tekstil, Hazır Giyim & Deri",
    desc: "Avrupa markalarının tedarikçi denetimlerinde talep ettiği ürün karbon ayak izi (Product Carbon Footprint - PCF).",
    icon: "🧵",
    badge: "Tedarikçi Zinciri"
  },
  {
    name: "Otomotiv Yan Sanayi & Yedek Parça",
    desc: "OEM üreticilerinin tedarikçi derecelendirmesi ve yeşil sertifikasyon için parça başına karbon beyannamesi.",
    icon: "🚗",
    badge: "Tedarikçi Zinciri"
  }
];

// SSS (FAQ)
const faqs = [
  {
    q: "StokPratik kullanıcısıyım, YeşilPratik için tekrar üye olmam gerekir mi?",
    a: "Hayır. Mevcut StokPratik ERP kullanıcıları için tekrar kayıt veya hesap açma süreci yoktur. StokPratik yönetim panelinizden tek tıkla YeşilPratik'i aktif edebilirsiniz. Ayrıca StokPratik üyelerine özel %40 lisans avantajı tanımlanır."
  },
  {
    q: "Verilerimi elle tek tek girmek zorunda mıyım?",
    a: "Kesinlikle hayır. Tam Excel aktarım desteğinin yanı sıra; GİB e-Fatura XML'leriniz (elektrik, doğalgaz, akaryakıt, hammadde alış faturaları) ve StokPratik üretim reçeteleriniz (BOM) API köprüsüyle otopilotla aktarılır. 15 saniyede ISO 14064-1 envanteriniz hazır olur."
  },
  {
    q: "Ürettiğim .xml dosyası Avrupa gümrüğünde geçerli mi?",
    a: "Evet. YeşilPratik, Avrupa Komisyonu'nun yayımladığı en güncel Resmi AB CBAM İletişim Şablonu ve XML şeması ile %100 uyumludur. Oluşturulan .xml dosyasını Avrupalı alıcınıza ilettiğinizde doğrudan AB Gümrük Geçiş Portalına yükleyebilir."
  },
  {
    q: "Devlet hibe desteğinden (%70) nasıl yararlanabiliriz?",
    a: "YeşilPratik, T.C. Ticaret Bakanlığı Responsible® Yeşil Mutabakat Uyum Projesi Desteği kriterlerine tam uygundur. Danışmanlık ve yazılım harcamalarınızın %70'i hibe olarak geri ödenir. Uzman ekibimiz başvuru evraklarınızı hazırlamanızda destek vermektedir."
  },
  {
    q: "Canlı demoyu hemen görebilir miyim, form doldurmam gerekir mi?",
    a: "Form doldurmanıza veya satış temsilcisi beklemenize gerek yoktur. 'Kayıtsız Canlı Demo İncele' butonuna tıklayarak içi gerçek örnek fabrika verileriyle dolu YeşilPratik yönetim panelini hemen canlı olarak gezebilirsiniz."
  }
];

// Schema JSON-LD
const schemaJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "YeşilPratik Kurumsal Karbon Muhasebesi ve AB SKDM Çözümü",
  "operatingSystem": "Web, Cloud, SaaS",
  "applicationCategory": "BusinessApplication",
  "description": pageDescription,
  "url": canonicalUrl,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "TRY",
    "description": "Kayıtsız Canlı Demo ve StokPratik Kullanıcılarına %40 Avantaj"
  },
  "publisher": {
    "@type": "Organization",
    "name": "StokPratik",
    "url": "https://stokpratik.com.tr",
    "telephone": "+905412465429"
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 min-h-screen selection:bg-emerald-500 selection:text-slate-950">
    
    {/* JSON-LD Schema */}
    <script type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} />

    {/* ========================================================================= */}
    {/* 1. HERO SECTION */}
    {/* ========================================================================= */}
    <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden border-b border-slate-800">
      
      {/* Arka Plan Glow Efektleri - Zümrüt Yeşili & Lacivert */}
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-gradient-to-b from-emerald-500/25 via-teal-600/10 to-transparent blur-3xl pointer-events-none"></div>
      <div class="absolute top-1/4 -right-40 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-10 -left-40 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="container mx-auto px-4 max-w-6xl relative z-10 text-center">
        
        {/* Üst Rozet */}
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs sm:text-sm font-extrabold mb-6 shadow-lg shadow-emerald-500/10">
          <span class="text-base">🌱</span>
          <span>7552 İKLİM KANUNU (TR-ETS) & 2026 AB SKDM (CBAM) OTOMASYONU</span>
          <span class="bg-emerald-500 text-slate-950 text-[10px] font-black uppercase px-2 py-0.5 rounded-full ml-1">CANLI</span>
        </div>

        {/* Ana Başlık */}
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight sm:leading-tight max-w-4xl mx-auto mb-6">
          Avrupa'ya İhracatta Karbon Duvarına Takılmayın: <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
            YeşilPratik Karbon Muhasebesi
          </span>
        </h1>

        {/* Alt Açıklama */}
        <p class="text-slate-300 text-base sm:text-xl max-w-3xl mx-auto leading-relaxed mb-8">
          GİB e-Faturalarınızdan ve üretim reçetelerinizden (BOM) <strong class="text-white font-bold">15 saniyede ISO 14064-1 envanteri</strong> hazırlayın; Avrupalı müşterinize tek tıkla resmi <strong class="text-emerald-400 font-bold">AB CBAM .xml çıktısı</strong> sunun.
        </p>

        {/* StokPratik Entegrasyon Rozeti */}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-xl bg-slate-900/90 border border-emerald-500/30 text-xs text-slate-300 mb-8 shadow-sm">
          <span class="text-emerald-400 font-bold">⚡ StokPratik ERP Üyelerine:</span>
          <span>Tekrar Kayıt Yok • Tek Tıkla Aktif • <strong class="text-amber-300">%40 Özel İndirim</strong></span>
        </div>

        {/* Hızlı Dönüşüm Butonları */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-xl mx-auto mb-10">
          
          {/* Birincil Buton: Kayıtsız Canlı Demo İncele */}
          <a 
            href={liveDemoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base shadow-xl shadow-emerald-500/25 transition-all hover:scale-[1.02] active:scale-[0.98] group"
          >
            <span>🌱 Kayıtsız Canlı Demo İncele</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>

          {/* İkincil Buton: WhatsApp Sorularınızı Cevaplayalım */}
          <a 
            href={directWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-base border border-slate-700 hover:border-emerald-500/50 transition-all shadow-lg"
          >
            <span class="text-xl">💬</span>
            <span>Sorularınızı Cevaplayalım</span>
          </a>

        </div>

        {/* Güven Rozetleri */}
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm text-slate-400 pt-4 border-t border-slate-800/80 max-w-3xl mx-auto">
          <span class="flex items-center gap-1.5 text-emerald-400 font-semibold">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            Resmi AB CBAM .xml Çıktısı
          </span>
          <span class="flex items-center gap-1.5 text-emerald-400 font-semibold">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            %70 Ticaret Bakanlığı Hibe Desteği
          </span>
          <span class="flex items-center gap-1.5 text-emerald-400 font-semibold">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            7552 TR-ETS & EPİAŞ Uyumlu
          </span>
        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* 2. 4 TEMEL GÜÇ KARTI */}
    {/* ========================================================================= */}
    <section class="py-16 sm:py-24 border-b border-slate-800 relative">
      <div class="container mx-auto px-4 max-w-6xl">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-emerald-400 font-black text-xs uppercase tracking-wider bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            STRATEJİK AVANTAJLAR
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-3 mb-4">
            YeşilPratik ile Karbon Dönüşümünde 4 Büyük Güç
          </h2>
          <p class="text-slate-400 text-sm sm:text-base">
            Manuel danışmanlık raporları yerine uçtan uca otomatikleşmiş akıllı veri motoru.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {corePowers.map((pow) => (
            <div class={`bg-slate-900/90 rounded-3xl p-7 sm:p-8 border ${pow.border} hover:border-emerald-500/70 transition-all duration-300 flex flex-col justify-between group shadow-xl shadow-black/40`}>
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-4xl p-3.5 rounded-2xl bg-slate-950 border border-slate-800 group-hover:scale-110 transition-transform">
                    {pow.icon}
                  </span>
                  <span class={`text-[10px] font-black uppercase px-3 py-1 rounded-full bg-slate-950 border border-slate-800 ${pow.textColor}`}>
                    {pow.badge}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors mb-3">
                  {pow.title}
                </h3>
                <p class="text-sm text-slate-300 leading-relaxed">
                  {pow.desc}
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* 3. ÜCRETSİZ ARAÇLAR & GTİP SORGULAMA KÖPRÜSÜ (LEAD MAGNET) */}
    {/* ========================================================================= */}
    <section class="py-14 bg-gradient-to-r from-emerald-950/60 via-slate-900 to-teal-950/60 border-b border-emerald-500/30">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-8 p-8 sm:p-10 rounded-3xl bg-slate-950/90 border border-emerald-500/40 shadow-2xl relative overflow-hidden">
          
          <div class="flex-1 text-center lg:text-left">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/30 mb-3">
              <span>🔍</span>
              <span>Ücretsiz Sanayici & İhracatçı Araçları</span>
            </span>
            <h3 class="text-xl sm:text-3xl font-extrabold text-white mb-2">
              2026 AB SKDM GTİP Kodunuz Kapsamda mı?
            </h3>
            <p class="text-sm sm:text-base text-slate-300 max-w-xl">
              İhracat yaptığınız ürünün GTİP kodunu girin; vergiye tabi olup olmadığını ve tahmini karbon vergi yükünü <strong class="text-emerald-400">ücretsiz simülatörümüzle</strong> hemen hesaplayın.
            </p>
          </div>

          <div class="shrink-0 flex flex-col sm:flex-row items-center gap-3 w-full lg:w-auto">
            <a 
              href={skdmToolUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-sm sm:text-base shadow-xl shadow-amber-500/20 transition-all hover:scale-[1.02]"
            >
              <span>🔍 Ücretsiz GTİP Sorgula →</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    {/* ========================================================================= */}
    {/* 4. HEDEF SEKTÖRLER */}
    {/* ========================================================================= */}
    <section class="py-16 sm:py-24 border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-6xl">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-teal-400 font-black text-xs uppercase tracking-wider bg-teal-500/10 px-3 py-1 rounded-full border border-teal-500/20">
            ÖNCELİKLİ SANAYİ SEKTÖRLERİ
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-3 mb-4">
            SKDM ve İklim Kanunundan Kimler Etkileniyor?
          </h2>
          <p class="text-slate-400 text-sm sm:text-base">
            Avrupa Birliği Sınırda Karbon Düzenleme Mekanizması ve Türkiye ETS kapsamındaki temel ihracat kollarımız.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sectors.map((sec) => (
            <div class="bg-slate-900/80 rounded-2xl p-6 border border-slate-800 hover:border-emerald-500/40 transition-all flex items-start gap-4">
              <span class="text-3xl shrink-0 p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                {sec.icon}
              </span>
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <h3 class="text-base font-bold text-white">
                    {sec.name}
                  </h3>
                </div>
                <span class="inline-block text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 mb-2">
                  {sec.badge}
                </span>
                <p class="text-xs text-slate-400 leading-relaxed">
                  {sec.desc}
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* 5. SIKÇA SORULAN SORULAR */}
    {/* ========================================================================= */}
    <section class="py-16 sm:py-24 border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-4xl">
        
        <div class="text-center mb-14">
          <span class="text-emerald-400 font-black text-xs uppercase tracking-wider bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            MERAK EDİLENLER
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-3 mb-4">
            Yeşil Dönüşüm & SKDM Sıkça Sorulan Sorular
          </h2>
          <p class="text-slate-400 text-sm">
            2026 yasal takvimi, devlet destekleri ve yazılım geçişi hakkında bilmeniz gerekenler.
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden transition-all duration-200">
              <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer font-bold text-white text-base sm:text-lg hover:text-emerald-400 select-none">
                <span>{faq.q}</span>
                <span class="ml-4 shrink-0 text-slate-500 group-open:rotate-180 transition-transform duration-200 text-xl">
                  ▼
                </span>
              </summary>
              <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-slate-300 text-sm sm:text-base leading-relaxed border-t border-slate-800/80 pt-4">
                {faq.a}
              </div>
            </details>
          ))}
        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* 6. BOTTOM CTA */}
    {/* ========================================================================= */}
    <section class="py-20 text-center relative overflow-hidden">
      <div class="container mx-auto px-4 max-w-4xl relative z-10">
        <h2 class="text-3xl sm:text-5xl font-black text-white mb-6">
          Avrupa İhracatınızı <br class="hidden sm:inline" />
          <span class="text-emerald-400">Yeşil Güvenceye Alın</span>
        </h2>
        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
          Form doldurmadan içi dolu örnek fabrika verileriyle YeşilPratik panelini hemen test edin.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
