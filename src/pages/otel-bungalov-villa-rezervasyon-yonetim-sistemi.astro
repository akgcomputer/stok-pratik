---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Otel, Bungalov ve Villa Rezervasyon Yönetim Sistemi | Stok Pratik";
const pageDescription = "Ajandada karışan odalara ve kapora ödemeyen misafirlere son! Görsel Room Rack doluluk takvimi, linkle anında kapora tahsilatı, %2 konaklama vergili e-fatura ve folyo yönetimi.";

const roomCalendar = [
  { room: "Bungalov #1 (Jakuzili)", status: "Dolu", guest: "Ahmet Y. (3 Gece)", badge: "bg-rose-500/20 text-rose-400 border-rose-500/30", dates: "24-27 Eki" },
  { room: "Bungalov #2 (Şömineli)", status: "Kapora Bekliyor", guest: "Selin K. (Link Gönderildi)", badge: "bg-amber-500/20 text-amber-400 border-amber-500/30", dates: "25-28 Eki" },
  { room: "Deluxe Villa (Havuzlu)", status: "Temizlikte", guest: "Çıkış Yapıldı • Kat Hizmetleri", badge: "bg-blue-500/20 text-blue-400 border-blue-500/30", dates: "Bugün 14:00 Hazır" },
  { room: "Taş Ev #3 (Bahçeli)", status: "Boş / Satışa Açık", guest: "Hemen Rezervasyona Hazır", badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30", dates: "Müsait" }
];

const hospitalityPowers = [
  {
    icon: "📅",
    title: "Görsel Oda / Villa Doluluk Takvimi (Room Rack)",
    desc: "Hangi oda veya bungalovun hangi tarihlerde dolu olduğunu, bugün giriş yapacak (Check-in), çıkış yapacak (Check-out) ve temizlik bekleyen (Housekeeping) odaları renk kodlu matriste tek ekranda izleyin."
  },
  {
    icon: "🔗",
    title: "Linkle Anında Kapora Tahsilatı (No-Show Kalkanı)",
    desc: "Telefonda veya Instagram/WhatsApp'ta rezervasyon soran misafire saniyeler içinde 3D Secure Kapora Ödeme Linki gönderin; kaporası ödenmeyen talepler takviminizi boş yere kilitlemesin."
  },
  {
    icon: "🧾",
    title: "%2 Konaklama Vergisi & Turizm e-Fatura / e-Arşiv",
    desc: "Konaklama tesislerine zorunlu olan %2 Konaklama Vergisi ve %10 KDV hesaplamasını GİB mevzuatına %100 uygun şekilde tek faturada otomatik ayrıştırarak saniyeler içinde kesin."
  },
  {
    icon: "🍽️",
    title: "Oda Folyosu, Minibar & Restoran Ekstra Harcamaları",
    desc: "Misafirin konaklama süresince restoranda yediği yemekleri, minibar tüketimini veya ekstra ATV/tur aktivitelerini oda folyosuna ekleyin; çıkışta tek hesapta tahsil edin."
  },
  {
    icon: "🧹",
    title: "Kat Hizmetleri (Temizlik) & Buklet Sarf Malzeme Stoğu",
    desc: "Odalarda kullanılan şampuan, terlik, havlu, temizlik kimyasalları ve kahvaltı stoklarını Stok Pratik depo modülüyle entegre izleyin; eksilen malzemeleri anında tamamlayın."
  },
  {
    icon: "🪑",
    title: "Oda Demirbaşları & Cihaz Bakım Takibi (/demirbaslar)",
    desc: "Odalardaki klima, televizyon, jakuzi motoru, şömine ve mobilyaların garanti, arıza ve periyodik bakım geçmişini kayıt altına alarak müşteri mağduriyetlerini önleyin."
  }
];

const faqs = [
  {
    q: "Hangi konaklama ve kiralama işletmeleri için uygundur?",
    a: "Butik oteller, bungalov işletmeleri, günlük kiralık tatil villaları, apart oteller, pansiyonlar, glamping alanları ve tiny house tesisleri için eksiksiz tasarlanmıştır."
  },
  {
    q: "Misafire kapora ödeme linkini nasıl iletiyoruz?",
    a: "Rezervasyon kaydını açtığınız anda sistem tek tıkla güvenli bir 3D Secure ödeme linki üretir. Bu linki WhatsApp veya SMS ile misafire göndererek kredi kartıyla anında kapora tahsilatı yapabilirsiniz."
  },
  {
    q: "%2 Konaklama Vergisi faturada nasıl gösterilir?",
    a: "GİB e-Fatura ve e-Arşiv standartlarına uygun olarak matrah üzerinden %10 KDV ve %2 Konaklama Vergisi ayrı satırlarda otomatik hesaplanır; muhasebe programlarına aktarıma hazır hale gelir."
  },
  {
    q: "Aynı odaya çifte rezervasyon (Overbooking) yapılabilir mi?",
    a: "Hayır. Sistem seçilen tarihlerde odanın dolu olduğunu anında tespit eder ve çakışan rezervasyon girişini engelleyerek sizi ve misafirinizi zor durumda bırakmaz."
  },
  {
    q: "Oda temizlik durumunu kat görevlileri kendi telefonundan görebilir mi?",
    a: "Evet. Kat hizmetleri personeli mobil arayüz üzerinden çıkış yapılan odaları görür; temizliği bitirdiğinde tek tıkla 'Oda Temiz / Satışa Açık' durumuna getirebilir."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-sky-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-sky-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-sky-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
              🏨 Konaklama & Rezervasyon • Otel, Bungalov, Villa & Apart
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Karışan Odalara ve <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-teal-300 to-amber-200">
                Gelmeyen Müşterilere Son!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Otel, bungalov veya tatil villası mı işletiyorsunuz? Doluluk takvimini tek ekranda yönetin, WhatsApp'tan <strong>Kapora Ödeme Linki</strong> göndererek rezervasyonu garantiye alın, çıkışta <strong>%2 Konaklama Vergili e-Faturayı</strong> 1 saniyede kesin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-sky-600 via-sky-500 to-teal-600 hover:from-sky-500 hover:to-teal-500 text-white font-bold text-base shadow-lg shadow-sky-600/30 hover:scale-[1.02] transition-all text-center"
              >
                🏨 Rezervasyon Sistemini Ücretsiz Deneyin
              </a>
              <a 
                href="#room-rack" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>📅 Canlı Doluluk Takvimini Gör</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> 3D Secure Kapora Linki</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> %2 Konaklama Vergisi</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Minibar & Folyo Entegre</span>
            </div>
          </div>

          <!-- Sağ: Canlı Room Rack Doluluk Takvimi & Kapora Mockup'ı -->
          <div class="lg:col-span-7" id="room-rack">
            <div class="bg-slate-900/90 rounded-2xl border border-sky-500/30 p-5 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-sky-500 via-teal-500 to-amber-500"></div>

              <!-- Üst Takvim Başlığı -->
              <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-xs font-mono font-bold text-white uppercase tracking-wider">CANLI ODA & DOLULUK PANOSU (ROOM RACK)</span>
                </div>
                <span class="text-[10px] bg-sky-500/20 text-sky-300 px-2 py-0.5 rounded font-mono">Bugün: 24 Ekim 2026</span>
              </div>

              <!-- Oda Durum Kartları -->
              <div class="space-y-2.5 mb-4">
                {roomCalendar.map((item) => (
                  <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
                    <div>
                      <div class="font-bold text-white text-sm">{item.room}</div>
                      <div class="text-[11px] text-slate-400 mt-0.5">{item.guest}</div>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-[10px] text-slate-400 font-mono">{item.dates}</span>
                      <span class={`px-2 py-0.5 rounded font-semibold text-[10px] border ${item.badge}`}>
                        {item.status}
                      </span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Kapora ve Folyo Simülasyonu -->
              <div class="bg-slate-950/80 p-3.5 rounded-xl border border-sky-500/20 text-xs">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 pb-2 border-b border-slate-800/80 mb-2">
                  <span class="text-slate-300">
                    <strong>Folyo Özeti (Bungalov #1):</strong> 3 Gece (13.500 ₺) + Restoran (1.840 ₺) + Minibar (450 ₺)
                  </span>
                  <span class="text-emerald-400 font-mono font-bold text-sm">15.790 ₺</span>
                </div>
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[11px] text-slate-400">
                  <span>Ödenen Kapora: <strong class="text-slate-200">5.000 ₺</strong> (Linkle Ödendi)</span>
                  <span class="text-sky-300 font-semibold">Kalan Çıkış Tahsilatı: 10.790 ₺ (Konaklama Vergisi Dahil)</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. KONAKLAMA VE REZERVASYON 6 TEMEL KABİLİYET -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-sky-400 font-bold mb-3">Kusursuz Tesis Yönetimi</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Otel ve Tesisinizin Gelirini Artıran 6 Güçlü Özellik</h3>
          <p class="text-slate-400 mt-4 text-base">
            Misafir kabulünden temizlik takibine, kapora tahsilatından resmi vergi faturasına kadar her süreç kontrolünüz altında.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {hospitalityPowers.map((power, index) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-sky-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center text-2xl mb-4">
                  {power.icon}
                </div>
                <div class="text-xs font-mono text-sky-400 font-bold mb-1">KABİLİYET 0{index + 1}</div>
                <h4 class="text-lg font-bold text-white mb-2">{power.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{power.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-sky-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">Rezervasyon Sistemi Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-sky-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-sky-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-sky-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-sky-500/20 border border-sky-500/40 text-sky-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🏨
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Tesisinizin Doluluğunu ve Gelirini Profesyonelce Yönetin! <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-teal-300 to-amber-200">
              Stok Pratik ile Rezervasyon Kaosunu Bitirin.
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Hemen ücretsiz hesabınızı açın; oda takviminizi kurun, kapora linkleri gönderin ve konaklama faturalarınızı tek tıkla kesin.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-sky-600 via-sky-500 to-teal-600 hover:from-sky-500 hover:to-teal-500 text-white font-bold text-lg shadow-xl shadow-sky-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 Hemen Ücretsiz Kullanmaya Başla
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • 1 dakikada şirket hesabı açın • %2 konaklama vergisi uyumlu</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik Otel ve Tesis Rezervasyon Yönetim Sistemi",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
