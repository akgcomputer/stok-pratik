<BaseLayout
  title="İşletmeniz Hangi Alanda? 1 Tıkla Sektörünüze Özel Hazırlansın — Stok Pratik"
  description="Karmaşık menülerle vakit kaybetmeyin. Sektörünüzü seçin; hazır ürün şablonları, e-fatura ve stok altyapınız anında kurulsun. 30 gün ücretsiz deneyin, kredi kartı gerekmez."
>
  <main class="min-h-screen bg-slate-50/50 text-slate-800 selection:bg-emerald-500 selection:text-white pb-20">
    
    {/* ========================================================================= */}
    {/* 1. HERO BÖLÜMÜ */}
    {/* ========================================================================= */}
    <section class="relative pt-12 pb-10 sm:pt-16 sm:pb-14 bg-white border-b border-slate-200/80 overflow-hidden">
      
      {/* Hafif estetik arka plan ışıkları */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-indigo-50/80 via-emerald-50/40 to-transparent blur-3xl pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
        
        {/* Üst Küçük Rozet */}
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-200/80 text-indigo-900 text-xs sm:text-sm font-bold shadow-sm mb-5">
          <span class="text-base leading-none">🚀</span>
          <span>Sektörel Akıllı Kurulum Sihirbazı</span>
        </div>

        {/* Ana Başlık */}
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-extrabold text-slate-900 tracking-tight leading-snug sm:leading-tight max-w-4xl mx-auto">
          İşletmeniz Hangi Alanda? <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-indigo-900 via-indigo-700 to-teal-700 bg-clip-text text-transparent">
            1 Tıkla Sektörünüze Özel Hazırlansın.
          </span>
        </h1>

        {/* Alt Başlık */}
        <p class="mt-4 text-slate-600 text-sm sm:text-base lg:text-lg max-w-2xl mx-auto leading-relaxed">
          Karmaşık menülerle vakit kaybetmeyin. Sektörünüzü seçin; hazır ürün şablonları, e-fatura ve stok altyapınız anında kurulsun.
        </p>

        {/* Güven Rozetleri */}
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5 sm:gap-4 text-xs sm:text-sm font-semibold">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-red-600 border border-red-700 text-white font-bold shadow-sm">
            <span>💳</span> Kredi Kartı Gerekmez
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-600 border border-emerald-700 text-white font-bold shadow-sm">
            <span>⏱️</span> 30 Gün Ücretsiz
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-slate-100 border border-slate-300 text-slate-800 font-semibold shadow-sm">
            <span class="text-indigo-600 font-bold">📊</span> Excel'den 1 Tıkla Veri Aktarımı
          </span>
        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* 2. İNTERAKTİF SEKTÖR SEÇİM IZGARASI (GRID) */}
    {/* ========================================================================= */}
    <section class="py-10 sm:py-14" id="sektorler-alani">
      <div class="container mx-auto px-4 max-w-6xl">
        
        {/* Bölüm Başlığı & Açıklaması */}
        <div class="text-center mb-8">
          <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Hızlı Başlangıç</span>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 mt-1">
            Aşağıdan Sektörünüzü Seçin
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">
            Sektörünüze tıkladığınızda özel modülleriniz ve kurulum paketiniz anında aşağıda hazırlanır.
          </p>
        </div>

        {/* 26 Sektör Kartı (Grid) */}
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 sm:gap-4" id="sectorGrid">
          {sectors.map((sector, index) => (
            <button
              type="button"
              class={`sector-card group relative p-3.5 sm:p-4 rounded-xl border bg-white text-left transition-all duration-200 hover:-translate-y-1 hover:shadow-lg cursor-pointer flex flex-col justify-between min-h-[135px] sm:min-h-[140px] ${index === 0 ? 'active border-indigo-600 ring-2 ring-indigo-500/20 bg-indigo-50/50 shadow-md' : 'border-slate-200/90 hover:border-indigo-400'}`}
              data-id={sector.id}
              data-name={sector.name}
              data-category={sector.category}
              data-features={JSON.stringify(sector.features)}
              data-timesaving={sector.timeSaving}
              data-readysetup={sector.readySetup}
              data-badge={sector.badge}
              data-icon={sector.icon}
            >
              {/* Üst Kısım: İkon ve Seçim Tiki */}
              <div class="flex items-center justify-between w-full mb-2">
                <span class="text-2xl sm:text-3xl p-1.5 rounded-xl bg-slate-50 group-hover:bg-indigo-50 group-hover:scale-110 transition-all">
                  {sector.icon}
                </span>
                
                {/* Seçim İndikatörü */}
                <span class={`check-badge w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold transition-all ${index === 0 ? 'bg-indigo-600 text-white' : 'border border-slate-300 text-transparent group-hover:border-indigo-400'}`}>
                  ✓
                </span>
              </div>

              {/* Alt Kısım: Sektör İsmi ve Mikro Rozet */}
              <div>
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-indigo-900 transition-colors leading-tight line-clamp-2">
                  {sector.name}
                </h3>
                <span class="inline-block text-[10px] text-slate-500 group-hover:text-indigo-600 font-medium mt-1">
                  {sector.badge}
                </span>
              </div>

              {/* Tıkla & İncele Yönlendirme İpucu */}
              <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-indigo-600 group-hover:text-indigo-800 transition-colors">
                <span>Paketi Aç</span>
                <span class="text-xs font-black transition-transform group-hover:translate-y-0.5">↓</span>
              </div>
            </button>
          ))}
        </div>

        {/* ========================================================================= */}
        {/* 3. DİNAMİK CANLI ÖNİZLEME ALANI (MAGIC REVEAL) */}
        {/* ========================================================================= */}
        <div id="magicRevealBox" class="mt-10 scroll-mt-20 transition-all duration-300">
          
          <div class="relative bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 text-white rounded-3xl p-6 sm:p-10 shadow-2xl border border-indigo-700/50 overflow-hidden">
            
            {/* Arka plan süslemeleri */}
            <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10">
              
              {/* Başlık ve Sektör Rozeti */}
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                <div class="flex items-center gap-3.5">
                  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-3xl shadow-inner shrink-0" id="revealIcon">
                    🛒
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Sektörünüze Özel Paket Hazır</span>
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                    </div>
                    <h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-white tracking-tight mt-0.5" id="revealTitle">
                      E-ticaret İçin Özel Altyapı
                    </h2>
                  </div>
                </div>

                <div class="flex items-center gap-2 self-start sm:self-auto">
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30" id="revealBadge">
                    Pazaryeri Entegre
                  </span>
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    Tam Uyumlu
                  </span>
                </div>
              </div>

              {/* Orta Kısım: 3 Renkli Kritik Özellik Kartı (Hardal Sarı, Kırmızı, Turuncu) */}
              <div class="py-6">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">
                  Sektörünüze Özel Açılacak 3 Temel Güç:
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="revealFeaturesList">
                  {/* 1. Özellik: Hardal Sarı Zeminli */}
                  <div class="p-5 rounded-2xl bg-amber-400 text-slate-950 border border-amber-500 shadow-md">
                    <span class="text-slate-950 text-base font-black block mb-2">⚡ 1. Senkronizasyon</span>
                    <p class="text-slate-900 text-xs sm:text-sm leading-relaxed font-semibold">
                      Trendyol, Hepsiburada, Amazon ve web sitenizle 20 dakikada bir otomatik stok ve sipariş senkronizasyonu.
                    </p>
                  </div>
                  {/* 2. Özellik: Kırmızı Zeminli */}
                  <div class="p-5 rounded-2xl bg-red-600 text-white border border-red-700 shadow-md">
                    <span class="text-white text-base font-black block mb-2">🧾 2. e-Fatura & Kargo</span>
                    <p class="text-red-50 text-xs sm:text-sm leading-relaxed font-medium">
                      Gelen tüm siparişler için tek tıkla e-Fatura, e-Arşiv ve kargo fişi oluşturma.
                    </p>
