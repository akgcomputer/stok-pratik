    <!-- CLIENT SCRIPT: 7 SENARYOLU LIVE OS SWITCHER INTERACTION -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const tabBtns = document.querySelectorAll('.os-tab-btn');
        const panels = document.querySelectorAll('.os-content-panel');

        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-target');
            
            // Tab stillerini güncelle (Tactile Buton Stilleri)
            tabBtns.forEach(b => {
              b.classList.remove('active', 'bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-lg', 'shadow-indigo-600/25');
              b.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200', 'shadow-sm');
            });
            btn.classList.add('active', 'bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-lg', 'shadow-indigo-600/25');
            btn.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200', 'shadow-sm');

            // Panelleri aç/kapa
            panels.forEach(p => {
              if (p.id === targetId) {
                p.classList.remove('hidden');
                p.classList.add('block');
              } else {
                p.classList.remove('block');
                p.classList.add('hidden');
              }
            });
          });
        });
      });
    </script>

