---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Akıllı Kademeli Toptan Fiyat, Koli/Palet Matrisi ve Maliyet Kilidi | Stok Pratik";
const pageDescription = "1 adet alana farklı, 1 koliye farklı, 1 palete farklı fiyat! Stok Pratik Kademeli Fiyat Motoru ile alış maliyetinizin altına asla düşmeyen toptan iskonto merdivenleri kurun.";

const pricingRules = [
  {
    icon: "📊",
    ruleNo: "Kural 1",
    title: "Miktar Bazlı Otomatik Fiyat Merdiveni (Tiered Pricing)",
    subtitle: "Sipariş Adedi Arttıkça Birim Fiyat Otomatik Düşsün, Sürümden Kazancınız Katlansın!",
    desc: "Her ürün kartına sınırsız sayıda miktar kademesi (10+ Adet, 50+ Adet, 250+ Adet vb.) tanımlayın. Fatura keserken, sahada sıcak satış yaparken veya bayiniz CariNET üzerinden sipariş geçerken sepete eklenen adede göre doğru birim fiyat otomatik uygulanır; personelinizin yanlış fiyat verme ihtimali sıfırlanır!",
    colSpan: "lg:col-span-2"
  },
  {
    icon: "📦",
    ruleNo: "Kural 2",
    title: "Koli, Palet, Konteyner ve Minimum Sipariş (MOQ) Kuralları",
    subtitle: "Toptancının Dili Adet Değil; Koli, Palet ve Konteynerdir!",
    desc: "Ürün kartında Koli İçi Adet (Örn: 24), Palet İçi Adet (Örn: 480), Konteyner İçi Adet ve Minimum Toptan Sipariş Adedi (MOQ) tanımlayın. Toptan kanallarda müşterilerinizin belirlediğiniz minimum adedin altında tek tek sipariş geçmesini otomatik engelleyin.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "🛡️",
    ruleNo: "Kural 3",
    title: "Çift Kademeli Fiyat Doğrulama ve Sıfır Zarar Kilidi",
    subtitle: "Yanlışlıkla Alış Maliyetinin Altında İskonto Yapılmasına İmkân Yok!",
    desc: "Sistemimiz her zaman şu matematiksel kuralı zorunlu tutar: Alış Maliyeti ≤ En Alt Toptan Kademe Fiyatı ≤ Perakende Satış Fiyatı ≤ Piyasa Liste Fiyatı. Personeliniz toptan kademe fiyatını alış maliyetinin altına indirmeye çalışırsa sistem işlemi anında durdurur ve kârınızı kilitler.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "💱",
    ruleNo: "Kural 4",
    title: "Dövizli Maliyet & Otomatik Kâr Marjı (%) Hesaplama",
    subtitle: "Alış Fiyatınız Değiştiğinde Tüm Toptan Fiyatlarınız Tek Tıkla Güncellensin!",
    desc: "İster dövizli alış maliyetinin üzerine hedef kâr marjı (+%35) girerek satış fiyatını otomatik hesaplatın, ister Excel ile binlerce ürünün kademeli toptan ve perakende fiyatlarını saniyeler içinde toplu güncelleyin.",
    colSpan: "lg:col-span-2"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-amber-500 selection:text-slate-950">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-amber-950/30 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-amber-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
              🏷️ B2B Toptan Ticaret • Kademeli Fiyat, Koli/Palet Matrisi & Maliyet Kilidi
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              "1 Adet Alana Farklı, 1 Koliye Farklı, 1 Palete Farklı": <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-yellow-200">
                Toptan Fiyatlarınızı Akıllı Kâr Motoruyla Belirleyin!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Müşteriniz "100 adet alırsam kaça olur?", "1 palet çekersek iskonto ne yaparsınız?" diye sorduğunda hesap makinesi aramayın! Stok Pratik'in <strong>Kademeli Toptan Fiyat Motoru</strong> ile alış maliyetinizin altına asla düşmeyen adet, koli, palet ve konteyner fiyat merdivenlerini saniyeler içinde kurgulayın.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold text-base shadow-lg shadow-amber-500/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🚀 Toptan Fiyatlarınızı Ücretsiz Kurgulayın</span>
              </a>
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/giris" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🔐 Giriş Yap</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-bold">✓</span> Alış Maliyeti Kilit Koruması
              </div>
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-bold">✓</span> Otomatik Koli & Palet Matrisi
              </div>
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-bold">✓</span> Excel ile Toplu Fiyat Güncelleme
              </div>
            </div>
          </div>

          <!-- Sağ: Canlı İnteraktif Kademeli Toptan Fiyat Merdiveni Kartı -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-amber-500/30 rounded-3xl p-6 sm:p-7 shadow-2xl backdrop-blur-xl">
              
              <!-- Başlık Barı -->
              <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-5">
                <div>
                  <div class="text-[11px] text-amber-400 font-mono uppercase tracking-wider font-semibold">Akıllı Fiyat Merdiveni</div>
                  <div class="text-base font-bold text-white">Endüstriyel Akrilik Mastik 310ml</div>
                </div>
                <div class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold border border-amber-500/30">
                  Dinamik Tier
                </div>
              </div>

              <!-- Fiyat Merdiveni Basamakları -->
              <div class="space-y-2.5">
                
                <!-- 1. Taban Kilit (Alış Maliyeti) -->
                <div class="flex items-center justify-between p-3 rounded-xl bg-rose-950/40 border border-rose-500/30 text-xs sm:text-sm">
                  <div class="flex items-center gap-2">
                    <span class="text-rose-400 text-base">🔒</span>
                    <div>
                      <div class="font-bold text-rose-200">Alış Maliyeti (Taban Kilit)</div>
                      <div class="text-[10px] text-rose-400/80">Bu tutarın altına satış engellenir</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-mono font-bold text-rose-300">100,00 ₺</div>
                    <div class="text-[10px] text-rose-400/80">KDV Hariç Maliyet</div>
                  </div>
                </div>

                <!-- 2. Perakende -->
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-xs sm:text-sm">
                  <div class="flex items-center gap-2">
                    <span class="text-slate-400 text-base">🛍️</span>
                    <div>
                      <div class="font-semibold text-slate-200">Perakende Kademe (1 - 11 Adet)</div>
                      <div class="text-[10px] text-slate-400">Tekil ve tezgah satışı</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-mono font-bold text-white">180,00 ₺</div>
                    <div class="text-[10px] text-emerald-400 font-semibold">%80 Net Kâr</div>
                  </div>
                </div>

                <!-- 3. Koli Bazlı -->
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-xs sm:text-sm">
                  <div class="flex items-center gap-2">
                    <span class="text-amber-400 text-base">📦</span>
                    <div>
                      <div class="font-semibold text-slate-200">Koli Bazlı (12 - 119 Adet / 1 Koli)</div>
                      <div class="text-[10px] text-amber-400/90">Koli İçi: 12 Adet</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-mono font-bold text-amber-300">150,00 ₺</div>
                    <div class="text-[10px] text-emerald-400 font-semibold">%50 Net Kâr</div>
                  </div>
                </div>

                <!-- 4. Palet Bazlı -->
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-xs sm:text-sm">
                  <div class="flex items-center gap-2">
                    <span class="text-orange-400 text-base">🏗️</span>
                    <div>
                      <div class="font-semibold text-slate-200">Palet Bazlı (120 - 999 Adet / 1 Palet)</div>
                      <div class="text-[10px] text-orange-400/90">Palet İçi: 120 Adet (10 Koli)</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-mono font-bold text-orange-300">132,00 ₺</div>
                    <div class="text-[10px] text-emerald-400 font-semibold">%32 Net Kâr</div>
                  </div>
                </div>

                <!-- 5. Konteyner / İhracat -->
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-xs sm:text-sm">
                  <div class="flex items-center gap-2">
                    <span class="text-cyan-400 text-base">🚢</span>
                    <div>
                      <div class="font-semibold text-slate-200">Konteyner / İhracat (1.000+ Adet)</div>
                      <div class="text-[10px] text-cyan-400/90">Maksimum Sürüm İskontosu</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-mono font-bold text-cyan-300">118,00 ₺</div>
                    <div class="text-[10px] text-emerald-400 font-semibold">%18 Net Kâr</div>
                  </div>
                </div>

              </div>

              <!-- Canlı Uyarı ve Güvenlik Kilidi Bandı -->
              <div class="mt-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center gap-3">
                <span class="text-lg">🛡️</span>
                <div class="text-xs text-amber-200 leading-snug">
                  <strong>Maliyet Koruma Kilidi Aktif:</strong> Hiçbir kademe veya iskonto 100,00 ₺ alış maliyetinin altına indirilemez. Kâr marjınız matematiksel olarak güvendedir.
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. TOPTAN FİYAT BELİRLEMENİN 4 ALTIN KURALI -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative bg-slate-900/40">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-amber-400 text-sm font-semibold tracking-wider uppercase mb-3">Toptan Fiyat Yönetimi</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Toptan Fiyat Belirlemenin 4 Altın Kuralı
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            Zararına satış riskini ortadan kaldıran, sipariş adedine göre anında çalışan kurgulanmış toptan ticaret omurgası.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {pricingRules.map((rule) => (
            <div class={`${rule.colSpan} bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 hover:border-amber-500/40 transition-all duration-300 flex flex-col justify-between group`}>
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 text-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    {rule.icon}
                  </div>
                  <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-slate-800 text-amber-400 border border-slate-700">
                    {rule.ruleNo}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">{rule.title}</h3>
                <div class="text-xs font-semibold text-amber-300/90 mb-3">{rule.subtitle}</div>
                <p class="text-slate-400 text-sm sm:text-base leading-relaxed">{rule.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-amber-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs sm:text-sm font-semibold mb-6">
          🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          Toptan Fiyat Stratejinizi Profesyonelce Yönetin!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Hemen ücretsiz Stok Pratik hesabınızı açın, ürünlerinize koli ve palet bazlı fiyat kademelerini dakikalar içinde tanımlayarak sürümden kazancınızı garantiye alın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold text-base shadow-lg shadow-amber-500/30 transition-all duration-200"
          >
            🚀 Hemen Ücretsiz Kullanmaya Başla
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
