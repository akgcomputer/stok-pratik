              </div>
            </div>
          ))}
        </div>

        {/* Alt Güvence Notu */}
        <div class="mt-10 p-6 rounded-2xl bg-indigo-50/70 border border-indigo-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
          <div class="flex items-center gap-3">
            <span class="text-3xl">🛡️</span>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Sıfır Risk, Kesintisiz Başlangıç</h3>
              <p class="text-xs text-slate-600">Beğenmezseniz hiçbir taahhüdünüz veya ödemeniz bulunmaz.</p>
            </div>
          </div>
          
          <a 
            href="#sektorler-alani"
            class="px-5 py-2.5 rounded-xl bg-indigo-900 hover:bg-indigo-800 text-white font-bold text-xs sm:text-sm transition-colors shrink-0"
          >
            Sektörünü Seç ↑
          </a>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>

<script>
  function setupSectorSelector() {
    const cards = document.querySelectorAll('.sector-card');
    
    // Reveal Box Elements
    const revealIcon = document.getElementById('revealIcon');
    const revealTitle = document.getElementById('revealTitle');
    const revealBadge = document.getElementById('revealBadge');
    const revealFeaturesList = document.getElementById('revealFeaturesList');
    const revealTimeSaving = document.getElementById('revealTimeSaving');
    const revealReadySetup = document.getElementById('revealReadySetup');
    const sectorCtaBtn = document.getElementById('sectorCtaBtn') as HTMLAnchorElement;
    const sectorWhatsappBtn = document.getElementById('sectorWhatsappBtn') as HTMLAnchorElement;
    const magicRevealBox = document.getElementById('magicRevealBox');

    // 3 Renkli Kart Şablonu: 1. Hardal Sarı, 2. Kırmızı, 3. Turuncu
    const colorStyles = [
      {
        box: 'bg-amber-400 text-slate-950 border border-amber-500 shadow-md',
        title: 'text-slate-950 font-black',
        text: 'text-slate-900 font-semibold'
      },
      {
        box: 'bg-red-600 text-white border border-red-700 shadow-md',
        title: 'text-white font-black',
        text: 'text-red-50 font-medium'
      },
      {
        box: 'bg-orange-500 text-white border border-orange-600 shadow-md',
        title: 'text-white font-black',
        text: 'text-orange-50 font-medium'
      }
    ];

    function selectSector(card: Element, triggerScroll = false) {
      // Remove active from all cards
      cards.forEach(c => {
        c.classList.remove('active', 'border-indigo-600', 'ring-2', 'ring-indigo-500/20', 'bg-indigo-50/50', 'shadow-md');
        c.classList.add('border-slate-200/90');
        const badge = c.querySelector('.check-badge');
        if (badge) {
          badge.classList.remove('bg-indigo-600', 'text-white');
          badge.classList.add('border', 'border-slate-300', 'text-transparent');
        }
      });

      // Add active to selected
      card.classList.add('active', 'border-indigo-600', 'ring-2', 'ring-indigo-500/20', 'bg-indigo-50/50', 'shadow-md');
      card.classList.remove('border-slate-200/90');
      const badge = card.querySelector('.check-badge');
      if (badge) {
        badge.classList.add('bg-indigo-600', 'text-white');
        badge.classList.remove('border', 'border-slate-300', 'text-transparent');
      }

      // Read data attributes
      const id = card.getAttribute('data-id') || 'genel';
      const name = card.getAttribute('data-name') || '';
      const icon = card.getAttribute('data-icon') || '✨';
      const cardBadge = card.getAttribute('data-badge') || 'Tam Uyumlu';
      const timeSaving = card.getAttribute('data-timesaving') || '';
      const readySetup = card.getAttribute('data-readysetup') || '';
      let features: string[] = [];
      try {
        features = JSON.parse(card.getAttribute('data-features') || '[]');
      } catch (e) {
        features = [];
      }

      // Update Reveal Box
      if (revealIcon) revealIcon.textContent = icon;
      if (revealTitle) revealTitle.textContent = `${name} İçin Özel Altyapı`;
      if (revealBadge) revealBadge.textContent = cardBadge;
      if (revealTimeSaving) revealTimeSaving.textContent = timeSaving;
      if (revealReadySetup) revealReadySetup.textContent = readySetup;

      if (revealFeaturesList) {
        revealFeaturesList.innerHTML = features.map((feat, i) => {
          const style = colorStyles[i % colorStyles.length];
          return `
            <div class="p-5 rounded-2xl ${style.box} transition-all hover:scale-[1.01]">
              <span class="${style.title} text-base block mb-2">⚡ ${i + 1}. Özellik</span>
              <p class="${style.text} text-xs sm:text-sm leading-relaxed">${feat}</p>
            </div>
          `;
        }).join('');
      }

      // Update CTA Link
      const targetUrl = `https://erp-eticaret.stokpratik.com.tr/?sektor=${encodeURIComponent(id)}`;
      if (sectorCtaBtn) {
        sectorCtaBtn.href = targetUrl;
        const span = sectorCtaBtn.querySelector('span:first-child');
        if (span) span.textContent = `${name} İle Ücretsiz Başla`;
      }

      if (sectorWhatsappBtn) {
        const message = `Merhaba, ${name} sektörü için Stok Pratik kurulumu ve 30 gün ücretsiz deneme hakkında bilgi almak istiyorum.`;
        sectorWhatsappBtn.href = `https://wa.me/+905325000999?text=${encodeURIComponent(message)}`;
      }

      // Tıklanınca otomatik olarak aşağıya (Özel Paket Hazır kutusuna) yumuşak geçiş yap
      if (triggerScroll && magicRevealBox) {
        magicRevealBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Attach Click Events to Cards
    cards.forEach(card => {
      card.addEventListener('click', () => {
        selectSector(card, true);
      });
    });

    // Check URL parameters for initial selection (e.g. ?sektor=butik)
    const urlParams = new URLSearchParams(window.location.search);
    const initialSector = urlParams.get('sektor');
    if (initialSector) {
      const matchCard = Array.from(cards).find(c => c.getAttribute('data-id') === initialSector);
      if (matchCard) {
        selectSector(matchCard, false);
      }
    }

    // FAQ Accordion Toggle
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');

      trigger?.addEventListener('click', () => {
        const isOpen = content?.classList.contains('block');

        // Close all
        faqItems.forEach(other => {
          const otherContent = other.querySelector('.faq-content');
          const otherIcon = other.querySelector('.faq-icon');
          const otherTrigger = other.querySelector('.faq-trigger');
          otherContent?.classList.remove('block');
          otherContent?.classList.add('hidden');
          if (otherIcon) otherIcon.textContent = '+';
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
        });

        // Toggle clicked
        if (!isOpen) {
          content?.classList.remove('hidden');
          content?.classList.add('block');
          if (icon) icon.textContent = '−';
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  // Execute on load & Astro transitions
  document.addEventListener('DOMContentLoaded', setupSectorSelector);
  document.addEventListener('astro:page-load', setupSectorSelector);
</script>
