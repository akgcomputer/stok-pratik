---
// src/pages/sitemap.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const destekPosts = await getCollection('destek');

// Sort alphabetically
const sortedBlog = blogPosts.sort((a, b) => a.data.title.localeCompare(b.data.title));
const sortedDestek = destekPosts.sort((a, b) => a.data.title.localeCompare(b.data.title));

const totalDynamicArticles = blogPosts.length + destekPosts.length;
---

<BaseLayout 
  title="Site Haritası (Sitemap) — Stok Pratik Bulut ERP, E-Ticaret, POS & Sektörel Çözümler"
  description="Stok Pratik platformundaki tüm sayfalar, e-Dönüşüm, Üretim ERP, QR-PDKS, CRM, 40+ Raporlar, Plaka Sicil, Pazaryeri entegrasyonları, sektörel çözümler ve blog rehberlerinin tam site haritası."
>
  <!-- Hero Section -->
  <section class="py-16 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white relative overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(99,102,241,0.15),transparent_50%)]"></div>
    <div class="container mx-auto px-4 relative z-10 text-center max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-4 border border-indigo-500/30">
        <span>🗺️ Tam Kapsamlı Site İndeksi</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>SEO & AI Uyumlu</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight">
        <span class="text-red-500">Stok Pratik</span> <span class="bg-gradient-to-r from-indigo-400 via-sky-300 to-emerald-400 bg-clip-text text-transparent">Site Haritası</span>
      </h1>
      <p class="text-base md:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
        Bulut ERP, E-Ticaret, Dokunmatik POS, e-Dönüşüm, QR-PDKS, CRM, 20+ Sektörel Çözüm ve yüzlerce rehber içeriğin tamamına tek bir noktadan kolayca ulaşın.
      </p>

      <!-- Instant Search Filter -->
      <div class="max-w-xl mx-auto relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg">🔍</span>
        <input 
          type="text" 
          id="sitemap-search" 
          placeholder="Sayfa adı veya modül ara (örn: PDKS, BOM, e-Fatura, Otomotiv, B2B)..." 
          class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-slate-800/90 text-white border border-slate-700 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/40 text-sm shadow-xl transition-all"
        />
        <span id="search-counter" class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-medium text-slate-400 hidden"></span>
      </div>
    </div>
  </section>

  <!-- Quick Links Strip -->
  <div class="bg-slate-800 text-slate-300 border-b border-slate-700 py-3 text-xs md:text-sm">
    <div class="container mx-auto px-4 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4 flex-wrap">
        <span class="font-semibold text-white flex items-center gap-1.5">
          <span>⚡ Hızlı Bölümler:</span>
        </span>
        <a href="#amiral-moduller" class="hover:text-indigo-300 transition">🚀 Yeni Amiral Modüller</a>
        <a href="#e-donusum" class="hover:text-indigo-300 transition">🏛️ e-Dönüşüm</a>
        <a href="#uretim-erp" class="hover:text-indigo-300 transition">🏭 Üretim ERP</a>
        <a href="#qr-pdks" class="hover:text-indigo-300 transition">⏱️ QR-PDKS</a>
        <a href="#oto-servis" class="hover:text-indigo-300 transition">🚗 Plaka Sicil</a>
        <a href="#sektorler" class="hover:text-indigo-300 transition">📦 20+ Sektör</a>
        <a href="#blog-destek" class="hover:text-indigo-300 transition">📰 Blog ({totalDynamicArticles})</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="/sitemap-index.xml" target="_blank" class="text-sky-400 hover:text-sky-300 font-mono text-xs flex items-center gap-1 underline">
          <span>XML Sitemap</span> ↗
        </a>
        <span class="text-slate-600">•</span>
        <a href="/llms.txt" target="_blank" class="text-emerald-400 hover:text-emerald-300 font-mono text-xs flex items-center gap-1 underline">
          <span>llms.txt (AI)</span> ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Sitemap Body -->
  <main class="py-12 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-6xl space-y-12">

      <!-- 1. AMİRAL GEMİSİ MODÜLLER (Yeni Nesil Landing Page'ler) -->
      <section id="amiral-moduller" class="sitemap-category-group bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-200">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100 flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <span class="text-2xl p-2 rounded-xl bg-indigo-50 text-indigo-600">🚀</span>
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900">Amiral Gemisi Çözümler & Yeni Nesil Modüller</h2>
              <p class="text-xs md:text-sm text-slate-500">Stok Pratik'in yeni nesil interaktif landing page sayfaları ve dikey iş modülleri</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold">11 Temel Modül</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/e-donusum" class="sitemap-card group border-indigo-200 hover:border-indigo-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🏛️</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition flex items-center gap-1.5">
                  e-Dönüşüm Merkezi
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700">Yeni</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">e-Fatura, e-Arşiv, e-İrsaliye, GİB UBL-TR & SMMM Köprüsü</div>
                <div class="text-[11px] font-mono text-indigo-500 mt-2">/e-donusum</div>
              </div>
            </div>
          </a>

          <a href="/uretim" class="sitemap-card group border-orange-200 hover:border-orange-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⚙️</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-orange-600 transition flex items-center gap-1.5">
                  Üretim ERP & BOM Reçetesi
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-orange-100 text-orange-700">Yeni</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">Ürün Ağacı, İstasyon Takibi & Gerçek Maliyet Motoru</div>
                <div class="text-[11px] font-mono text-orange-500 mt-2">/uretim</div>
              </div>
            </div>
          </a>

          <a href="/pdks" class="sitemap-card group border-cyan-200 hover:border-cyan-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⏱️</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-cyan-600 transition flex items-center gap-1.5">
                  15 Sn QR-PDKS Personel Takip
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-cyan-100 text-cyan-700">Yeni</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">Kriptografik Kiosk, GPS & Cihaz Kilitli Sıfır Donanım PDKS</div>
                <div class="text-[11px] font-mono text-cyan-600 mt-2">/pdks</div>
              </div>
            </div>
          </a>

          <a href="/crm" class="sitemap-card group border-rose-200 hover:border-rose-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🤝</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-rose-600 transition flex items-center gap-1.5">
                  CRM Satış Hunisi (Pipeline)
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-rose-100 text-rose-700">Yeni</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">Kanban Fırsat Yönetimi, Teklif & Otomatik Fatura Köprüsü</div>
                <div class="text-[11px] font-mono text-rose-500 mt-2">/crm</div>
              </div>
            </div>
          </a>

          <a href="/raporlar" class="sitemap-card group border-indigo-200 hover:border-indigo-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">📊</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition flex items-center gap-1.5">
                  40+ Kurumsal Raporlama Merkezi
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-700">Yeni</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">5 Departmanda Finans, Perakende, Tedarik, CRM & e-Dönüşüm</div>
                <div class="text-[11px] font-mono text-indigo-500 mt-2">/raporlar</div>
              </div>
            </div>
          </a>

          <a href="/plakasicil" class="sitemap-card group border-amber-200 hover:border-amber-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🚗</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-amber-600 transition flex items-center gap-1.5">
                  Plaka Sicil Oto Servis & Geçmiş
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">Yeni</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">Canlı Plaka Sorgulama, İş Emri & Yedek Parça Ekosistemi</div>
                <div class="text-[11px] font-mono text-amber-600 mt-2">/plakasicil</div>
              </div>
            </div>
          </a>

          <a href="/pazaryeri" class="sitemap-card group border-purple-200 hover:border-purple-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🛍️</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-purple-600 transition flex items-center gap-1.5">
                  37+ Pazaryeri Entegratörü
                </div>
                <div class="text-xs text-slate-500 mt-1">Trendyol, Hepsiburada, Amazon, N11 Çift Yönlü Stok Eşitleme</div>
                <div class="text-[11px] font-mono text-purple-500 mt-2">/pazaryeri</div>
              </div>
            </div>
          </a>

          <a href="/b2b" class="sitemap-card group border-blue-200 hover:border-blue-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🏢</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-blue-600 transition flex items-center gap-1.5">
                  B2B Toptan DepodanDirekt
                </div>
                <div class="text-xs text-slate-500 mt-1">Kapalı Bayi Portalı, Kademeli İskonto & Cari Limit Siparişi</div>
                <div class="text-[11px] font-mono text-blue-500 mt-2">/b2b</div>
              </div>
            </div>
          </a>

          <a href="/hizli-satis" class="sitemap-card group border-emerald-200 hover:border-emerald-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⚡</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-emerald-600 transition flex items-center gap-1.5">
                  Dokunmatik POS & Hızlı Satış
                </div>
                <div class="text-xs text-slate-500 mt-1">Barkodlu Perakende Kasa, Parçalı Tahsilat & Fiş/Fatura</div>
                <div class="text-[11px] font-mono text-emerald-600 mt-2">/hizli-satis</div>
              </div>
            </div>
          </a>

          <a href="/smmm" class="sitemap-card group border-teal-200 hover:border-teal-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⚖️</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-teal-600 transition flex items-center gap-1.5">
                  SMMM Mali Müşavir Portalı
                </div>
                <div class="text-xs text-slate-500 mt-1">Zirve, Luca, Logo Uyumlu Tek Tıkla Mizan ve e-Aktarım</div>
                <div class="text-[11px] font-mono text-teal-600 mt-2">/smmm</div>
              </div>
            </div>
          </a>

          <a href="/yapay-zeka-fis-okuma-masraf-yonetimi" class="sitemap-card group border-violet-200 hover:border-violet-400 hover:shadow-md">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🤖</span>
              <div>
                <div class="font-bold text-slate-900 group-hover:text-violet-600 transition flex items-center gap-1.5">
                  Yapay Zeka AI Fiş Okuma
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-violet-100 text-violet-700">AI OCR</span>
                </div>
                <div class="text-xs text-slate-500 mt-1">Fotoğraftan KDV, Tutar, Firma Okuma & Masraf Otomasyonu</div>
                <div class="text-[11px] font-mono text-violet-500 mt-2">/yapay-zeka-fis-okuma-masraf-yonetimi</div>
              </div>
            </div>
          </a>
        </div>
      </section>

      <!-- 2. e-DÖNÜŞÜM & MALİ YAZILIMLAR -->
      <section id="e-donusum" class="sitemap-category-group bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-200">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
          <span class="text-2xl p-2 rounded-xl bg-purple-50 text-purple-600">🏛️</span>
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900">e-Dönüşüm, e-Belgeler ve Ön Muhasebe</h2>
            <p class="text-xs md:text-sm text-slate-500">GİB mevzuatına tam uyumlu elektronik belge ve muhasebe çözümleri</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href="/e-fatura" class="sitemap-item"><span>📄</span> e-Fatura Çözümü</a>
          <a href="/e-arsiv-fatura" class="sitemap-item"><span>🧾</span> e-Arşiv Fatura Sistemi</a>
          <a href="/e-irsaliye" class="sitemap-item"><span>🚚</span> e-İrsaliye ve Lojistik</a>
          <a href="/ozel-sektorel-e-belgeler-e-smm-e-mustahsil-e-gider-pusulasi" class="sitemap-item"><span>📜</span> Özel Sektörel e-Belgeler (e-SMM, Müstahsil)</a>
          <a href="/mali-musavir-smmm-koprusu-ve-e-aktarim" class="sitemap-item"><span>🔗</span> Mali Müşavir SMMM Köprüsü</a>
          <a href="/bulut-on-muhasebe-e-fatura" class="sitemap-item"><span>☁️</span> Bulut Ön Muhasebe ve e-Fatura</a>
          <a href="/online-muhasebe-programi" class="sitemap-item"><span>💻</span> Online Muhasebe Programı</a>
          <a href="/otomatik-muhasebe-yazilimi" class="sitemap-item"><span>⚡</span> Otomatik Muhasebe Yazılımı</a>
          <a href="/kobi-muhasebe-programi" class="sitemap-item"><span>🏪</span> KOBİ Muhasebe Programı</a>
          <a href="/on-muhasebe-ve-cari-hesap-yonetimi" class="sitemap-item"><span>💳</span> Ön Muhasebe & Cari Hesap</a>
          <a href="/on-muhasebe-ve-pos-paketi" class="sitemap-item"><span>📦</span> Ön Muhasebe ve POS Paketi</a>
          <a href="/ucretsiz-muhasebe-programi" class="sitemap-item"><span>🎁</span> Ücretsiz Muhasebe Deneyimi</a>
        </div>
      </section>

      <!-- 3. ÜRETİM ERP & BOM -->
      <section id="uretim-erp" class="sitemap-category-group bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-200">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
          <span class="text-2xl p-2 rounded-xl bg-orange-50 text-orange-600">🏭</span>
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900">Üretim ERP, BOM ve İmalat Yönetimi</h2>
            <p class="text-xs md:text-sm text-slate-500">Hammadde, reçete, fire, makine amortismanı ve istasyon maliyetleri</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href="/uretim-erp-urun-agaci-bom-ve-gercek-maliyet-motoru" class="sitemap-item"><span>⚙️</span> BOM Ürün Ağacı & Maliyet Motoru</a>
          <a href="/uretim-takip-mrp-programi" class="sitemap-item"><span>🏭</span> Üretim Takip ve MRP Programı</a>
          <a href="/sektorel-imalat-receteleri-ve-hazir-fabrika-sablonlari" class="sitemap-item"><span>📐</span> Sektörel İmalat Reçeteleri</a>
          <a href="/uretim-erp" class="sitemap-item"><span>🏗️</span> Bulut Üretim ERP</a>
          <a href="/uretim-yonetimi" class="sitemap-item"><span>📋</span> Üretim Planlama & İş Emirleri</a>
          <a href="/proje-yonetimi" class="sitemap-item"><span>📌</span> Proje ve Aşama Yönetimi</a>
        </div>
      </section>

      <!-- 4. QR-PDKS & İNSAN KAYNAKLARI -->
      <section id="qr-pdks" class="sitemap-category-group bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-200">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
          <span class="text-2xl p-2 rounded-xl bg-cyan-50 text-cyan-600">⏱️</span>
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900">QR-PDKS, Puantaj ve Personel Yönetimi</h2>
            <p class="text-xs md:text-sm text-slate-500">15 saniye dinamik kiosk QR, GPS metre kilitli ve donanımsız personel takibi</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href="/qr-pdks-kriptografik-personel-takip-sistemi" class="sitemap-item"><span>🔒</span> Kriptografik QR-PDKS Giriş/Çıkış</a>
          <a href="/personel-canli-ihlal-takibi-ve-mesai-radari" class="sitemap-item"><span>📡</span> Canlı İhlal Takibi & Mesai Radarı</a>
          <a href="/personel-izin-ve-maas-avansi-onay-merkezi" class="sitemap-item"><span>📝</span> Personel İzin & Avans Onay Merkezi</a>
          <a href="/sgk-personel-puantaj-cetveli-ve-mesai-hesaplama" class="sitemap-item"><span>📑</span> SGK Puantaj Cetveli & Bordro</a>
          <a href="/pdks-puantaj" class="sitemap-item"><span>📅</span> Canlı Puantaj Takvimi</a>
          <a href="/pdks-takip" class="sitemap-item"><span>⏱️</span> Günlük Giriş / Çıkış Takibi</a>
          <a href="/pdks-onaylar" class="sitemap-item"><span>✅</span> Yönetici İzin Onayları</a>
