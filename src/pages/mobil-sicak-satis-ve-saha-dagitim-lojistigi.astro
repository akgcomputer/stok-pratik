---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Mobil Sıcak Satış, Plasiyer ve Saha Dağıtım Lojistiği | Stok Pratik";
const pageDescription = "Araçlarınızı yürüyen şubelere dönüştürün. Sabah araç yükleme fişi, sahada cep telefonundan barkodlu sıcak satış, e-fatura kesimi ve akşam araç mutabakatı.";

const timeline = [
  {
    time: "08:00",
    badge: "1. Adım: Sabah Yükleme",
    icon: "📦",
    title: "Merkez Depodan Araca Mal Yükleme (Araç Fişi)",
    desc: "Her dağıtım aracınız sistemde bağımsız bir 'Mobil Depo' olarak tanımlanır. Sabah yüklenen mallar tek tıkla Araç Yükleme İrsaliyesi ile aracın stoğuna aktarılır; şoför ve plaka bilgileri resmi evraka otomatik basılır."
  },
  {
    time: "10:30",
    badge: "2. Adım: Nokta Ziyareti",
    icon: "📱",
    title: "Müşteri Noktasında Sıcak Satış (Mobil / Tablet)",
    desc: "Plasiyer bakkal veya markete girdiğinde müşteriyi seçer; eski borcunu ve açık hesap risk limitini anında görür. Telefon kamerasıyla barkodu okutup adet/koli bazında satışı onaylar, araç stoğundan anında düşer."
  },
  {
    time: "13:30",
    badge: "3. Adım: Sahada Evrak",
    icon: "🧾",
    title: "Sahada Anında Fatura, İrsaliye ve Tahsilat",
    desc: "Müşteriye sahada anında resmi e-Fatura / e-Arşiv veya Sevk İrsaliyesi kesilir; PDF WhatsApp'tan iletilir veya araç içi Bluetooth yazıcıdan basılır. Nakit, kredi kartı veya linkle ödeme alınır."
  },
  {
    time: "18:00",
    badge: "4. Adım: Akşam Kapanış",
    icon: "🏁",
    title: "Gün Sonu Araç Sayımı ve Kasa Mutabakatı",
    desc: "Akşam merkeze dönüldüğünde: 'Sabah Yüklenen - Sahada Satılan = Araçta Kalması Gereken Stok' denklemi tek ekranda çıkar. Toplanan nakit ve POS fişleri merkez kasaya devredilir; stok açığı sıfıra iner."
  }
];

const sectors = [
  {
    icon: "🧀",
    title: "Gıda, Süt, İçecek & Su Dağıtımı",
    desc: "Günlük rut ziyareti, koli/adet/palet dönüşümleri, iade/fire mal alımı ve anlık nakit-pos tahsilatı.",
    colSpan: "lg:col-span-2"
  },
  {
    icon: "🧴",
    title: "Temizlik, Kozmetik & Ambalaj",
    desc: "Kuaförlere, restoranlara ve perakendecilere araçtan sıcak satış, vadeli açık hesap takibi.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "🔧",
    title: "Oto Yedek Parça & Hırdavat",
    desc: "Sanayi sitelerindeki tamirhanelere yerinde teslimat, plasiyer prim hesabı ve tahsilat makbuzu.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "📦",
    title: "Soğuk Satış (Ön Sipariş) & Dağıtım",
    desc: "Plasiyer tabletten siparişi toplasın; merkez depo akşam hazırlayıp ertesi gün araçla sevk etsin.",
    colSpan: "lg:col-span-2"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-orange-600 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-orange-950/30 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 left-1/3 w-[500px] h-[300px] bg-orange-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-7 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-orange-400 animate-ping"></span>
              🚚 Temel Ticaret • Mobil Sıcak Satış, Plasiyer & Saha Lojistiği
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Dağıtım Araçlarınızı Yürüyen Şubelere Dönüştürün: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-white">
                Sabah Yükleyin, Sahada Satın, Akşam Kuruşu Kuruşuna Mutabakat Yapın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-400 max-w-2xl mb-8 leading-relaxed">
              <code>34 ABC 123</code> plakalı aracınızda şu an kaç koli ürün kaldı, plasiyeriniz hangi rota üzerindeki marketlere uğradı, ne kadar tahsilat yaptı? Stok Pratik Mobil Sıcak Satış ile saha operasyonunuzu merkez deponuzla canlı bağlayın.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-orange-500 hover:bg-orange-400 text-slate-950 font-black rounded-xl shadow-lg shadow-orange-500/30 transition-all transform hover:-translate-y-0.5 text-center text-base">
                🚚 Mobil Sıcak Satışı Ücretsiz Başlat
              </a>
              <a href="#akisi-gor" class="w-full sm:w-auto px-7 py-4 bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-bold rounded-xl transition-all text-center text-base">
                🗺️ Sabah-Akşam Operasyon Akışını Gör
              </a>
            </div>

            <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <span class="flex items-center gap-1.5"><span class="text-orange-400">✓</span> Cep Telefonundan Barkod Okutma</span>
              <span class="flex items-center gap-1.5"><span class="text-orange-400">✓</span> Sahada e-Fatura & WhatsApp</span>
              <span class="flex items-center gap-1.5"><span class="text-orange-400">✓</span> Gün Sonu Araç Sayım Kalkanı</span>
            </div>
          </div>

          <!-- Sağ: Plaka Bazlı Mobil Araç Deposu Mockup'ı -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl bg-slate-900 p-6 border border-slate-800 shadow-2xl shadow-orange-950/40 backdrop-blur-xl">
              <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">🚛</span>
                  <div>
                    <h3 class="font-extrabold text-sm text-white">34 SP 001 — Mobil Satış Aracı</h3>
                    <p class="text-xs text-slate-400">Şoför: Mehmet K. • Rut: Kadıköy-Üsküdar</p>
                  </div>
                </div>
                <span class="px-2.5 py-1 rounded bg-orange-500/20 text-orange-300 text-xs font-bold">Sahada Aktif</span>
              </div>

              <!-- İstatistikler -->
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                  <span class="text-[11px] text-slate-400 uppercase font-bold block mb-1">Araçtaki Stok</span>
                  <span class="text-xl font-black text-white">340 Koli</span>
                  <span class="text-[10px] text-slate-500 block mt-0.5">(Sabah: 500 Koli)</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                  <span class="text-[11px] text-slate-400 uppercase font-bold block mb-1">Günlük Tahsilat</span>
                  <span class="text-xl font-black text-emerald-400">48.500 ₺</span>
                  <span class="text-[10px] text-slate-500 block mt-0.5">14 Satış Noktası</span>
                </div>
              </div>

              <!-- Son Nokta Satışı Bildirimi -->
              <div class="p-3.5 rounded-xl bg-orange-500/10 border border-orange-500/30 text-xs mb-4">
                <div class="flex items-center justify-between font-bold text-orange-300 mb-1">
                  <span>📍 Son Ziyaret: Yıldız Market</span>
                  <span>14:22</span>
                </div>
                <p class="text-slate-400 text-[11px]">
                  30 Koli Su + 10 Koli Meşrubat satışı yapıldı • 4.250 ₺ Kredi Kartı tahsil edildi • e-Fatura iletildi.
                </p>
              </div>

              <!-- CTA -->
              <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="block w-full py-3.5 bg-orange-500 hover:bg-orange-400 text-slate-950 text-center font-black rounded-xl text-sm transition">
                Aracınızı Sisteme Ekleyin & Başlayın ➔
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. ZAMAN ÇİZELGESİ: 4 ADIMLI SAHA OPERASYON AKIŞI -->
    <section id="akisi-gor" class="py-24 bg-slate-900/50 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-orange-400 font-bold uppercase tracking-wider text-xs">Uçtan Uca Rut Akışı</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
            08:00'den 18:00'e Kusursuz Saha Hakimiyeti
          </h2>
          <p class="text-slate-400 mt-3 text-base">
            Araç yüklemesinden akşam kasa devrine kadar kayıp, kaçak ve mutabakat sorunlarına son.
          </p>
        </div>

        <div class="space-y-6">
          {timeline.map((item) => (
            <div class="p-7 rounded-2xl bg-slate-900 border border-slate-800 hover:border-orange-500/40 transition-all flex flex-col md:flex-row items-start md:items-center gap-6">
              <div class="flex-shrink-0 flex items-center justify-center w-16 h-16 rounded-2xl bg-orange-500/10 border border-orange-500/20 text-orange-400 text-3xl font-mono">
                {item.icon}
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                  <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-orange-500/20 text-orange-300">{item.time}</span>
                  <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">{item.badge}</span>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. HANGİ SEKTÖRLER İÇİN? (BENTO GRID) -->
    <section class="py-24 bg-slate-950">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-orange-400 font-bold uppercase tracking-wider text-xs">Sektörel Güç</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
            Saha Dağıtımında En Çok Tercih Edilen Sektörler
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {sectors.map((sec) => (
            <div class={`${sec.colSpan} p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between`}>
              <div>
                <span class="text-3xl mb-4 block">{sec.icon}</span>
                <h3 class="text-xl font-bold text-white mb-2">{sec.title}</h3>
                <p class="text-sm text-slate-400 leading-relaxed">{sec.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. ALT KAPANIŞ ÇAĞRISI (BOTTOM CTA) -->
    <section class="py-24 bg-gradient-to-b from-slate-900 via-orange-950 to-slate-950 text-white text-center relative overflow-hidden border-t border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
        <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/20 border border-orange-400/30 text-orange-300 text-xs font-bold uppercase tracking-wider mb-4">
          Ek Donanım Gerektirmez
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 text-white">
          Saha Ekibinizi ve Dağıtım Araçlarınızı Bugün Dijitalleştirin!
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Pahalı el terminallerine servet ödemeden, personellerinizin mevcut cep telefonlarıyla hemen ücretsiz kullanmaya başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-orange-500 hover:bg-orange-400 text-slate-950 font-black rounded-xl shadow-xl shadow-orange-500/30 transition-all text-center">
            🚀 Hemen Giriş Yapın & Başlayın
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center">
            🎁 14 Gün Ücretsiz Deneyin
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
