    <!-- Faydalı İçerikler (Rastgele 21) -->
    <div class="footer-useful-links">
      <h4>Faydalı İçerikler</h4>
      <ul class="footer-links random-links">
        {shuffledPosts.map(post => (
          <li><a href={post.url} title={post.title}>{post.title}</a></li>
        ))}
      </ul>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Stok Pratik. Tüm hakları saklıdır.<br>Tasarım ve Yazılım : <a href="https://isdeyeter.com/">isdeyeter.com</a> | Stok Pratik <a href="https://meetwork.com.tr/alt-sektor/stok-pratik/">MeetWork</a> İştirakidir.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--secondary-dark);
    color: white;
    padding: var(--spacing-xl) 0 var(--spacing-md);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1fr 1fr 1fr 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
  }
  .footer-useful-links {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: var(--spacing-xl);
  }
  .footer-useful-links h4 {
    color: white;
    margin-bottom: var(--spacing-md);
    text-align: center;
  }
  .random-links {
    column-count: 3;
    column-gap: 40px;
  }
  .random-links li {
    break-inside: avoid;
    margin-bottom: var(--spacing-sm);
  }

  .footer-section h3,
  .footer-section h4 {
    color: white;
    margin-bottom: var(--spacing-md);
  }

  .footer-description {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
  }

  .footer-description strong {
    color: white;
    font-size: 1.1rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-links {
    list-style: none;
  }

  .footer-links li {
    margin-bottom: var(--spacing-xs);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--primary-red);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--spacing-md);
    text-align: center;
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
  }

  .footer-social {
    margin-top: var(--spacing-md);
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .footer-content {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
    }
    .random-links {
      column-count: 2;
    }
  }

  @media (max-width: 480px) {
    .footer-content {
      grid-template-columns: 1fr;
    }
    .random-links {
      column-count: 1;
    }
    
    .footer-section h4:empty {
      display: none;
    }
  }
</style>