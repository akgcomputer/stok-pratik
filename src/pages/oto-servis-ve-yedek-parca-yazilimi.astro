      badge.innerText = "Hazır / Teslime Uygun";
      btn.innerText = "✓ Araç Teslime Hazırlandı & SMS İletildi";
      btn.className = "w-full py-2.5 px-4 rounded-xl bg-emerald-700 text-white font-bold text-xs cursor-default";
      box.classList.remove('hidden');
    }

    // Modal controls
    function openModal() {
      document.getElementById('demo-modal').classList.remove('hidden');
    }
    function closeModal() {
      document.getElementById('demo-modal').classList.add('hidden');
      document.getElementById('modal-form').classList.remove('hidden');
      document.getElementById('modal-success').classList.add('hidden');
    }
    function handleModalSubmit(e) {
      e.preventDefault();
      document.getElementById('modal-form').classList.add('hidden');
      document.getElementById('modal-success').classList.remove('hidden');
    }
    function handleCtaSubmit(e) {
      e.preventDefault();
      document.getElementById('cta-form-container').classList.add('hidden');
      document.getElementById('cta-success-msg').classList.remove('hidden');
    }

    // FAQ Accordion
    function toggleFaq(id) {
      const answer = document.getElementById(`faq-answer-${id}`);
      const icon = document.getElementById(`faq-icon-${id}`);
      if (answer.classList.contains('hidden')) {
        answer.classList.remove('hidden');
        icon.innerText = "▲";
      } else {
        answer.classList.add('hidden');
        icon.innerText = "▼";
      }
    }

    // Interactive Simulator State
    let orderParts = [
      { name: 'Yağ Filtresi OEM', price: 480, location: 'Raf A-03 / Kutu 12', qty: 1 },
      { name: '5W-30 Motor Yağı (4L)', price: 1650, location: 'Yağ Deposu / Palet 02', qty: 1 },
      { name: 'Ön Fren Balata Takımı', price: 1250, location: 'Raf B-01 / Kutu 04', qty: 1 }
    ];
    let currentLabor = 1100;

    function renderOrder() {
      const container = document.getElementById('order-parts-container');
      if (orderParts.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-400 py-2 text-center bg-white rounded-xl">İş emrine parça eklenmedi.</p>';
      } else {
        container.innerHTML = orderParts.map((item, idx) => `
          <div class="p-2 bg-white rounded-xl border border-slate-200 flex justify-between items-center text-xs">
            <div>
              <p class="font-bold text-slate-800">${item.name}</p>
              <p class="text-[10px] text-slate-500">${item.location} • ${item.price} ₺ x ${item.qty}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900">${item.price * item.qty} ₺</span>
              <button onclick="removePart(${idx})" class="w-5 h-5 bg-rose-100 text-rose-700 rounded text-xs font-bold flex items-center justify-center cursor-pointer">✕</button>
            </div>
          </div>
        `).join('');
      }

      const partsTotal = orderParts.reduce((a, b) => a + (b.price * b.qty), 0);
      document.getElementById('sim-parts-total').innerText = partsTotal.toLocaleString('tr-TR') + ' ₺';
      document.getElementById('sim-labor-total').innerText = currentLabor.toLocaleString('tr-TR') + ' ₺';
      document.getElementById('sim-grand-total').innerText = (partsTotal + currentLabor).toLocaleString('tr-TR') + ' ₺';
    }

    function addPart(name, price, location) {
      const existing = orderParts.find(p => p.name === name);
      if (existing) {
        existing.qty += 1;
      } else {
        orderParts.push({ name, price, location, qty: 1 });
      }
      renderOrder();
    }

    function removePart(idx) {
      if (orderParts[idx].qty > 1) {
        orderParts[idx].qty -= 1;
      } else {
        orderParts.splice(idx, 1);
      }
      renderOrder();
    }

    function updateLaborCost(val) {
      currentLabor = Number(val);
      document.getElementById('labor-cost-text').innerText = currentLabor.toLocaleString('tr-TR') + ' ₺';
      renderOrder();
    }

    function completeSimService() {
      const badge = document.getElementById('sim-status-badge');
      badge.className = "px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-900 shrink-0";
      badge.innerText = "Teslime Hazır / SMS Gönderildi";

      const fb = document.getElementById('sim-feedback-box');
      fb.classList.remove('hidden');
      fb.innerHTML = '🎉 <strong>Servis işlemi tamamlandı!</strong> Müşteriye teslim SMS’i gönderildi ve e-Fatura hazırlandı.';
      setTimeout(() => fb.classList.add('hidden'), 5000);
    }

    function switchVehicle(plate, car, owner, km) {
      document.getElementById('sim-car-name').innerText = car;
      document.getElementById('sim-car-meta').innerText = `${owner} • ${km}`;
      const btns = document.querySelectorAll('.plate-btn');
      btns.forEach(b => {
        if (b.innerText.includes(plate)) {
          b.className = "plate-btn px-3.5 py-2 rounded-xl font-mono text-xs font-extrabold bg-slate-900 text-white shadow-md ring-2 ring-orange-500 cursor-pointer";
        } else {
          b.className = "plate-btn px-3.5 py-2 rounded-xl font-mono text-xs font-extrabold bg-white text-slate-800 border border-slate-200 hover:border-orange-400 cursor-pointer";
        }
      });
      const badge = document.getElementById('sim-status-badge');
      badge.className = "px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 shrink-0";
      badge.innerText = "Liftte / Bakımda";
    }

    // Initial render
    renderOrder();
  </script>
  </div>
</BaseLayout>
