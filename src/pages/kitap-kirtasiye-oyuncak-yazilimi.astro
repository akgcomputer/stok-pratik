---
// src/pages/kitap-kirtasiye-oyuncak-yazilimi.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Kitap, Kırtasiye ve Oyuncak Mağazası Stok Programı | Stok Pratik";
const pageDescription = "Kırtasiye ve kitapçılar için ISBN/Barkod arama motorlu, sezonluk okul kampanyası destekli hızlı satış yazılımı.";

// Özellikler (6 adet)
const features = [
  {
    icon: "📖",
    title: "ISBN & Yayın Barkodu Arama",
    description: "Kitapların arkasındaki ISBN veya standart barkodları okutarak ürünleri kasaya saniyeler içinde ekleyin.",
    items: ["ISBN arama", "Barkod okuma", "Otomatik ürün getirme", "Hızlı ekleme"]
  },
  {
    icon: "📦",
    title: "Okul Listesi Paket Satışı",
    description: "Okul dönemlerinde sınıf listesindeki malzemeleri tek bir '1. Sınıf Kırtasiye Seti' olarak birleştirip tek tıkla satın.",
    items: ["Paket/Set oluşturma", "Tek barkodla satış", "Alt ürün stok düşümü", "Esnek liste yönetimi"]
  },
  {
    icon: "🎯",
    title: "Sezon Kampanya Yönetimi",
    description: "Okula dönüş sezonuna özel (3 al 2 öde, %15 İndirim vb.) kampanyaları sisteme tanımlayın, kasada otomatik hesaplansın.",
    items: ["Kampanya tanımlama", "Otomatik hesaplama", "Sezonluk ayarlar", "Promosyon yönetimi"]
  },
  {
    icon: "🔍",
    title: "Yaş Grubu & Kategori Filtresi",
    description: "Oyuncak ve kitapları yaş grupları, sınıflar veya konularına göre kategorilendirerek depoda hızla bulun.",
    items: ["Yaş grubu etiketi", "Kategori filtreleme", "Kolay arama", "Raf düzeni"]
  },
  {
    icon: "📋",
    title: "Veresiye & Okul Aile Birliği Takibi",
    description: "Öğretmenlere veya okullara yaptığınız vadeli / açık hesap satışları dijital olarak kaydedin.",
    items: ["Açık hesap takibi", "Ödeme hatırlatma", "Bakiye görüntüleme", "Okul bazlı rapor"]
  },
  {
    icon: "🌐",
    title: "Pazaryeri Entegrasyonu",
    description: "Fiziki mağazanızdaki kalem, defter satışları ile internet satışlarınızı tek stok havuzundan yönetin.",
    items: ["N11 entegrasyonu", "Hepsiburada entegrasyonu", "Tek stok havuzu", "Senkron satış"]
  }
];

// SSS
const faqs = [
  {
    q: "Mevcut kitap listemi Excel ile aktarabilir miyim?",
    a: "Evet, dağıtımcılardan (Toptancılardan) aldığınız tüm kitap veya kırtasiye Excel listelerini saniyeler içinde fiyat ve barkodlarıyla beraber içeri aktarabilirsiniz."
  },
  {
    q: "Barkodsuz kırtasiye ürünlerini (örn. tek kalem, silgi) nasıl satacağım?",
    a: "Dokunmatik veya fare ile kullanılabilen Hızlı Satış ekranımıza resimli kısayol tuşları (örn: Kırmızı Silgi, 2B Kalem) ekleyerek barkod okutmadan tıklayarak satabilirsiniz."
  },
  {
    q: "İnternet bağlantım koptuğunda sezon yoğunluğunda satış yapabilir miyim?",
    a: "Stok Pratik Offline Kasa (Çevrimdışı Kasa) özelliği sayesinde, internet kopsa bile ürünleri okutmaya, satış yapmaya ve fiş kesmeye kesintisiz devam edebilirsiniz."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- HERO SECTION -->
  <section class="hero-section py-16 bg-gradient-to-br from-primary-red-light to-bg-white">
    <div class="container">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-primary-red to-primary-red-dark bg-clip-text text-transparent">
          Kırtasiye ve Kitapçılarda Sezon Yoğunluğunu Hızlı Kasa İle Aşın!
        </h1>
        <p class="text-xl text-text-gray mb-8">
          {pageDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://wa.me/+905325000999?text=Merhaba,%20Kırtasiye%20programı%20demo%20talep%20ediyorum"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="mr-2">📚</span>
            Demo Talep Et
          </a>
          <a
            href="#ozellikler"
            class="btn btn-secondary"
          >
            Özellikleri Keşfet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ÖZELLİKLER -->
  <section id="ozellikler" class="features-section py-16 bg-bg-light">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Kırtasiye ve Kitap Mağazalarının İhtiyacı Olan Tüm Özellikler</h2>
        <p class="text-text-gray max-w-2xl mx-auto">
          Sezon yoğunluğunu yönetin, satışları hızlandırın
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="feature-card bg-white p-6 rounded-lg shadow-md">
            <div class="feature-icon mb-4 text-primary-red text-3xl">
              {feature.icon}
            </div>
            <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
            <p class="text-text-gray mb-4">{feature.description}</p>
            <ul class="space-y-2 text-text-gray">
              {feature.items.map((item) => (
                <li class="flex items-start">
                  <span class="text-green-500 mr-2 mt-1 flex-shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AVANTAJLAR (2 sütun) -->
  <section class="benefits-section py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Kırtasiye İşletmenize Sağladığı Avantajlar</h2>
        <p class="text-text-gray max-w-2xl mx-auto">
          Sezon yoğunluğunda size zaman ve maliyet kazandırır
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-bg-light p-8 rounded-lg">
          <h3 class="text-2xl font-semibold mb-4 text-primary-red">İşletmeniz İçin</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">⏱️</div>
              <div>
                <h4 class="font-semibold mb-1">Kuyruklara Son</h4>
                <p class="text-text-gray">Kasada bekleme süresini %70 azaltır</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">📊</div>
              <div>
                <h4 class="font-semibold mb-1">Stok Kontrolü</h4>
                <p class="text-text-gray">Hangi kalemin, hangi kitabın azaldığını anlık görün</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">💰</div>
              <div>
                <h4 class="font-semibold mb-1">Kayıpsız Veresiye</h4>
                <p class="text-text-gray">Öğretmen ve okul alacaklarını dijital takip edin</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-bg-light p-8 rounded-lg">
          <h3 class="text-2xl font-semibold mb-4 text-primary-red">Personeliniz İçin</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">📱</div>
              <div>
                <h4 class="font-semibold mb-1">Kolay Eğitim</h4>
                <p class="text-text-gray">Yeni personel dakikalar içinde öğrenir</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">🔌</div>
              <div>
                <h4 class="font-semibold mb-1">Offline Çalışma</h4>
                <p class="text-text-gray">İnternet yoksa satış devam eder</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">🔄</div>
              <div>
                <h4 class="font-semibold mb-1">Hızlı Kampanya</h4>
                <p class="text-text-gray">Sezon kampanyalarını tek tıkla uygulayın</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTEGRASYONLAR -->
  <section class="platforms-section py-16 bg-gradient-to-r from-primary-red-light to-bg-light">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-8">Entegre Çalıştığı Sistemler</h2>
      <div class="flex flex-wrap justify-center gap-8 mb-12">
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">📚</div>
          <h3 class="text-xl font-semibold">Kitap Veritabanı</h3>
          <p class="text-text-gray">ISBN ile otomatik kitap bilgisi</p>
        </div>
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">🛒</div>
          <h3 class="text-xl font-semibold">Pazaryerleri</h3>
          <p class="text-text-gray">N11, Hepsiburada entegrasyonu</p>
        </div>
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">🧾</div>
          <h3 class="text-xl font-semibold">e-Fatura</h3>
          <p class="text-text-gray">Okullara fatura kesimi</p>
        </div>
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-semibold">Muhasebe</h3>
          <p class="text-text-gray">Cari ve gelir takibi</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="faq-section py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Sıkça Sorulan Sorular</h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq) => (
          <details class="bg-bg-light p-4 rounded-lg border border-gray-200">
            <summary class="font-semibold text-primary-red cursor-pointer list-none flex justify-between items-center">
              {faq.q}
              <span class="text-gray-500">▼</span>
            </summary>
            <div class="mt-2 text-text-gray border-t border-gray-200 pt-2">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section py-16 bg-primary-red text-white">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-6">Kırtasiyenizi Dijitale Taşımaya Hazır mısınız?</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Hemen demo talep edin, sezon yoğunluğunda rahat nefes alın.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://wa.me/+905325000999?text=Merhaba,%20Kırtasiye%20programı%20demo%20talep%20ediyorum"
          class="btn bg-white text-primary-red hover:bg-gray-100 flex items-center justify-center"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="mr-2">💬</span>
          WhatsApp'tan Demo Talep Et
        </a>
        <a
          href="tel:+905325000999"
          class="btn bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary-red"
        >
          <span class="mr-2">📞</span>
          Hemen Ara: 0532 500 09 99
        </a>
      </div>
    </div>
  </section>

  <style>
    :global(body) {
      scroll-behavior: smooth;
    }

    /* Hero Section */
    .hero-section {
      background: linear-gradient(135deg, var(--primary-red-light) 0%, var(--bg-white) 100%);
    }

    /* Container */
    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Butonlar */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 2px solid transparent;
      cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
      color: white;
      border-color: var(--primary-red);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, var(--primary-red-dark), var(--primary-red-darker));
    }

    .btn-secondary {
      background: white;
      color: var(--primary-red);
      border: 2px solid var(--primary-red);
    }

    .btn-secondary:hover {
      background: var(--primary-red-light);
    }

    /* Feature Cards */
    .feature-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 1px solid #e5e7eb;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
      color: var(--primary-red);
    }

    /* Platform Cards */
    .platform-card {
      transition: transform 0.3s ease;
      min-width: 150px;
    }

    .platform-card:hover {
      transform: translateY(-5px);
    }

    /* CTA Section */
    .cta-section {
      background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
    }

    /* Utility Classes */
    .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
    .mb-4 { margin-bottom: 1rem; }
    .mb-6 { margin-bottom: 1.5rem; }
    .mb-8 { margin-bottom: 2rem; }
    .mb-12 { margin-bottom: 3rem; }
    .mt-1 { margin-top: 0.25rem; }
    .mr-2 { margin-right: 0.5rem; }
    .mr-4 { margin-right: 1rem; }
    .text-center { text-align: center; }
    .text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
    .text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
    .text-5xl { font-size: 3rem; line-height: 1; }
    .text-xl { font-size: 1.25rem; line-height: 1.75rem; }
    .text-2xl { font-size: 1.5rem; line-height: 2rem; }
    .font-bold { font-weight: 700; }
    .font-semibold { font-weight: 600; }
    .rounded-lg { border-radius: 0.5rem; }
    .rounded-full { border-radius: 9999px; }
    .shadow-md { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
    .bg-white { background-color: white; }
    .bg-bg-light { background-color: #f9fafb; }
    .bg-primary-red { background-color: #dc2626; }
    .bg-primary-red-light { background-color: #fef2f2; }
    .text-primary-red { color: #dc2626; }
    .text-white { color: white; }
    .text-text-gray { color: #6b7280; }
    .text-green-500 { color: #10b981; }
    .text-gray-500 { color: #6b7280; }
    .p-2 { padding: 0.5rem; }
    .p-4 { padding: 1rem; }
    .p-6 { padding: 1.5rem; }
    .p-8 { padding: 2rem; }
    .flex { display: flex; }
    .flex-col { flex-direction: column; }
    .flex-wrap { flex-wrap: wrap; }
    .items-start { align-items: flex-start; }
    .items-center { align-items: center; }
    .justify-center { justify-content: center; }
    .flex-shrink-0 { flex-shrink: 0; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    .max-w-4xl { max-width: 56rem; }
    .max-w-3xl { max-width: 48rem; }
    .max-w-2xl { max-width: 42rem; }
    .gap-4 { gap: 1rem; }
    .gap-8 { gap: 2rem; }
    .space-y-2 > * + * { margin-top: 0.5rem; }
    .space-y-4 > * + * { margin-top: 1rem; }
    .border { border-width: 1px; }
    .border-gray-200 { border-color: #e5e7eb; }
    .border-t { border-top-width: 1px; }
    .border-t-gray-200 { border-color: #e5e7eb; }
    .pt-2 { padding-top: 0.5rem; }
    .mt-2 { margin-top: 0.5rem; }
    .cursor-pointer { cursor: pointer; }
    .list-none { list-style: none; }

    /* Grid */
    .grid { display: grid; }
    .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
    .gap-8 { gap: 2rem; }

    /* Responsive */
    @media (min-width: 768px) {
      .md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sm\:flex-row { flex-direction: row; }
      .md\:text-5xl { font-size: 3rem; line-height: 1; }
    }

    @media (min-width: 1024px) {
      .lg\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 768px) {
      .hero-section h1 {
        font-size: 2.5rem;
      }
      
      .platforms-section .flex {
        flex-direction: column;
        align-items: center;
      }
      
      .platform-card {
        width: 100%;
        max-width: 250px;
      }
    }

    @media (max-width: 480px) {
      .hero-section h1 {
        font-size: 2rem;
      }
      
      .cta-section .flex {
        flex-direction: column;
      }
    }

    :root {
      --primary-red: #dc2626;
      --primary-red-dark: #b91c1c;
      --primary-red-darker: #991b1b;
      --primary-red-light: #fef2f2;
      --bg-white: #ffffff;
      --bg-light: #f9fafb;
      --text-gray: #6b7280;
      --border-color: #e5e7eb;
    }
  </style>
</BaseLayout>