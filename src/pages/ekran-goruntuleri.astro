  },
  {
    id: 9,
    category: "uretim-depo",
    categoryLabel: "Depo & Lojistik",
    badgeColor: "bg-teal-50 text-teal-700 border-teal-200",
    src: "/images/screenshots/StokPratik_Depo_Lojistik_Yonetimi.png",
    alt: "Stok Pratik Depo ve Lojistik Yönetimi Raf Sayım Ekranı",
    title: "Depo, Raf & Lojistik Yönetimi",
    description: "Çoklu depo, koridor/raf adresi tanımlama, el terminaliyle kör sayım ve şubeler arası kontrollü transferler.",
    features: [
      "Dinamik raf ve koridor lokasyon mimarisi",
      "Barkodlu / QR el terminali ile hatasız depo sayımı",
      "Eksik, hasarlı ve sevkiyat kabul kontrolleri"
    ]
  },
  {
    id: 10,
    category: "eticaret",
    categoryLabel: "E-Ticaret & Pazaryeri",
    badgeColor: "bg-rose-50 text-rose-700 border-rose-200",
    src: "/images/screenshots/StokPratik_e_Ticaret.png",
    alt: "Stok Pratik E-Ticaret ve Pazaryeri Entegrasyonları",
    title: "E-Ticaret & Pazaryeri Entegrasyonları",
    description: "Trendyol, Hepsiburada, Amazon, Shopify, WooCommerce ve ikas ile sipariş, stok ve fiyatları 7/24 eşzamanlayın.",
    features: [
      "Tüm pazaryerlerinden gelen siparişlerin tek ekranda toplanması",
      "Satış yapıldığında diğer kanallardaki stoğun saniyeler içinde güncellenmesi",
      "Toplu kargo barkodu ve resmi fatura basımı"
    ]
  },
  {
    id: 11,
    category: "analiz-yonetim",
    categoryLabel: "CRM",
    badgeColor: "bg-pink-50 text-pink-700 border-pink-200",
    src: "/images/screenshots/StokPratik_crm.png",
    alt: "Stok Pratik CRM Müşteri Takip Sistemi Ekran Görüntüsü",
    title: "CRM & Müşteri İlişkileri Takip Sistemi",
    description: "Müşteri görüşmeleri, teklifler, satış fırsatları, hatırlatıcılar ve 360° müşteri yaşam döngüsü.",
    features: [
      "Müşteri görüşme notları, toplantı ve görev takvimi",
      "Teklif hazırlama, revizyon takibi ve tek tıkla siparişe çevirme",
      "WhatsApp entegrasyonu ile hızlı bilgilendirme mesajları"
    ]
  },
  {
    id: 12,
    category: "ik-servis",
    categoryLabel: "İK & PDKS",
    badgeColor: "bg-amber-50 text-amber-700 border-amber-200",
    src: "/images/screenshots/StokPratik_QR-PDKS_ik.png",
    alt: "Stok Pratik QR-PDKS Personel ve İnsan Kaynakları Yönetimi",
    title: "QR-PDKS & İnsan Kaynakları Yönetimi",
    description: "Pahalı kart okuyuculara son! Dinamik QR kod ile cep telefonundan anlık personel devam kontrolü ve bordro ön hazırlığı.",
    features: [
      "Personel giriş-çıkış saatleri, geç kalma ve mola süreleri",
      "Yıllık izin, mazeret ve rapor süreçlerinin dijital onayı",
      "Avans, prim ve maaş hesaplama bordro desteği"
    ]
  },
  {
    id: 13,
    category: "ik-servis",
    categoryLabel: "İK & Mobil",
    badgeColor: "bg-yellow-50 text-yellow-800 border-yellow-200",
    src: "/images/screenshots/StokPratik_QR-PDKS_ik-qr-okuma.png",
    alt: "Stok Pratik QR Personel Okuma ve Anlık Devam Kontrolü",
    title: "QR Kod ile Personel Giriş-Çıkış Terminali",
    description: "Tablet veya akıllı telefon kamerasından saniyede okunan dinamik QR kodlar ile sahtecilikten arındırılmış PDKS.",
    features: [
      "Dinamik yenilenen QR kod güvenliği (fotoğraf çekip okutmayı önler)",
      "Konum doğrulamalı mobil check-in (saha personeli için)",
      "Gece vardiyası ve fazla mesai saatlerinin otomatik hesaplanması"
    ]
  },
  {
    id: 14,
    category: "ik-servis",
    categoryLabel: "Teknik Servis",
    badgeColor: "bg-emerald-50 text-emerald-700 border-emerald-200",
    src: "/images/screenshots/StokPratik_hizmet_servis.png",
    alt: "Stok Pratik Hizmet ve Teknik Servis Yönetimi Ekranı",
    title: "Hizmet & Teknik Servis Yönetimi",
    description: "Arıza kabul formu, parça değişimi, servis iş emirleri ve müşteriye SMS ile canlı cihaz takip linki gönderme.",
    features: [
      "Cihaz seri no, aksesuar ve arıza açıklamasıyla kabul fişi",
      "Müşteriye SMS ile canlı servis takip linki (İnceleniyor, Onarıldı, Hazır)",
      "Kullanılan yedek parçaların servis anında stoktan otomatik düşmesi"
    ]
  },
  {
    id: 15,
    category: "analiz-yonetim",
    categoryLabel: "Raporlama & Analiz",
    badgeColor: "bg-violet-50 text-violet-700 border-violet-200",
    src: "/images/screenshots/StokPratik_Raporlama.png",
