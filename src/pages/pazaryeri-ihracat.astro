  <!-- Slider JavaScript (client-side) -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const track = document.getElementById('sliderTrack');
      const slides = track.querySelectorAll('.slide-item');
      const totalSlides = slides.length;
      let currentIndex = 0;
      let autoPlayInterval = null;
      const dotsContainer = document.getElementById('sliderDots');

      // Klonlama ile sonsuz döngü için ilk slidi sona ekle
      const firstClone = slides[0].cloneNode(true);
      track.appendChild(firstClone);
      const allItems = track.querySelectorAll('.slide-item');
      const totalItems = allItems.length;

      // Nokta oluştur
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('span');
        if (i === 0) dot.classList.add('active');
        dot.dataset.index = i;
        dot.addEventListener('click', () => goTo(i));
        dotsContainer.appendChild(dot);
      }
      const dots = dotsContainer.querySelectorAll('span');

      function updateSlider(index) {
        const offset = -index * 100;
        track.style.transform = `translateX(${offset}%)`;
        // Noktaları güncelle
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index % totalSlides);
        });
      }

      function goTo(index) {
        currentIndex = index;
        updateSlider(currentIndex);
        resetAutoPlay();
      }

      function nextSlide() {
        currentIndex++;
        if (currentIndex >= totalItems) {
          // Son klona geldiyse anında ilk slide geç (sıfır transition)
          track.style.transition = 'none';
          currentIndex = 0;
          updateSlider(currentIndex);
          // Transition'ı tekrar aç
          requestAnimationFrame(() => {
            track.style.transition = 'transform 0.5s ease-in-out';
          });
        } else {
          updateSlider(currentIndex);
        }
        resetAutoPlay();
      }

      function prevSlide() {
        if (currentIndex === 0) {
          // Başa gelindiyse son klona git
          currentIndex = totalItems - 1;
          track.style.transition = 'none';
          updateSlider(currentIndex);
          requestAnimationFrame(() => {
            track.style.transition = 'transform 0.5s ease-in-out';
          });
        } else {
          currentIndex--;
          updateSlider(currentIndex);
        }
        resetAutoPlay();
      }

      function resetAutoPlay() {
        if (autoPlayInterval) {
          clearInterval(autoPlayInterval);
        }
        autoPlayInterval = setInterval(nextSlide, 4000);
      }

      // Butonlar
      document.getElementById('prevBtn').addEventListener('click', prevSlide);
      document.getElementById('nextBtn').addEventListener('click', nextSlide);

      // Başlat
      track.style.transition = 'transform 0.5s ease-in-out';
      resetAutoPlay();

      // Pause on hover
      const sliderContainer = document.querySelector('.slider-container');
      sliderContainer.addEventListener('mouseenter', () => {
        clearInterval(autoPlayInterval);
      });
      sliderContainer.addEventListener('mouseleave', resetAutoPlay);
    });
  </script>
