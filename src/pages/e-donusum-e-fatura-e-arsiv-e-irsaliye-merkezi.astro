---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "e-Dönüşüm Merkezi: e-Fatura, e-Arşiv ve e-İrsaliye | Stok Pratik";
const pageDescription = "Müşteriniz e-Fatura mı e-Arşiv mi siz düşünmeyin! Stok Pratik otomatik GİB PK sorgulasın, tek tıkla resmi e-Fatura, e-Arşiv ve e-İrsaliye kesin.";

const sections = [
  {
    badge: "Bölüm A • e-Fatura",
    icon: "📄",
    title: "Tüm GİB Senaryolarına ve Özel Vergi Kodlarına %100 Uyumlu e-Fatura",
    desc: "Ayrı entegratör portallarına fatura kopyalamaya son. Cari kartında VKN yazıldığı anda sistem mükellefiyet durumunu ve aktif posta kutusu etiketini (PK) otomatik çeker.",
    features: [
      "Otomatik GİB PK Sorgulama: Mükellefiyet durumuna göre e-Fatura veya e-Arşiv ayrımı anında yapılır.",
      "Tüm Resmi Senaryolar: Temel, Ticari (Kabul/Red yanıtlı), İhracat, Kamu ve Hal Kayıt Sistemi senaryoları.",
      "Tevkifat, İstisna ve Özel Matrah: 2/10'dan 9/10'a kadar KDV tevkifatları ve GİB muafiyet kodları (301, 350 vb.) hazır.",
      "Gelen e-Fatura Kutusu: Tedarikçinizden gelen faturayı tek tıkla kabul edin, ürünler depoya doğrudan Alış Faturası olarak işlensin."
    ]
  },
  {
    badge: "Bölüm B • e-Arşiv Fatura",
    icon: "🧾",
    title: "GİB Portalından SMS Şifresi Beklemeye Son: Saniyede e-Arşiv Fatura!",
    desc: "5.000 TL ve 30.000 TL sınırlarıyla uğraşmadan, doğrudan Stok Pratik içinden tek tıkla imzalı resmi e-Arşiv faturanızı düzenleyin; WhatsApp ve E-Posta ile müşterinize iletin.",
    features: [
      "E-Ticaret İnternet Satış Bilgisi: Web sitesi, ödeme şekli, ödeme tarihi ve kargo takip bilgileri faturaya otomatik basılır.",
      "Pazaryerlerine Otomatik PDF Entegrasyonu: Kesilen e-Arşiv faturası aynı saniyede Trendyol ve Hepsiburada siparişine yüklenir.",
      "Tek Tıkla WhatsApp & E-Posta Gönderimi: Müşterinize SMS veya WhatsApp üzerinden doğrudan imzalı PDF linki ulaştırın.",
      "Hızlı İptal ve İtiraz Süreçleri: Hatalı düzenlenen e-Arşiv faturaları için mevzuata uygun iptal ve iade süreci."
    ]
  },
  {
    badge: "Bölüm C • e-İrsaliye",
    icon: "🚚",
    title: "Depodan Kamyona Yüklenen Her Paletin Resmi e-İrsaliyesi Saniyeler İçinde!",
    desc: "Yolda maliye ve kolluk denetimlerinde ceza yemeyin. Araç plakası ve şoför TCKN doğrulamalı, resmi GİB karekodlu e-İrsaliyeler anında cebinizde.",
    features: [
      "Zorunlu GİB Alanları Denetimi: Taşıyıcı lojistik VKN, Çekici Plakası, Dorse Plakası ve Şoför TCKN eksiksiz kontrol edilir.",
      "Karekodlu (QR) Yol Denetim Çıktısı: Denetim memurunun barkod okuyucuyla veya telefonla okutabileceği resmi GİB QR kodu.",
      "Tek Tıkla e-Faturaya Dönüştürme: Hafta boyu kesilen sevk irsaliyelerini ay sonunda tek tıkla e-Faturaya dönüştürün.",
      "Şubeler Arası ve Konsinye Sevk: Kendi şubeleriniz ve fason atölyeleriniz arasındaki sevkleri güvenle kayıt altına alın."
    ]
  },
  {
    badge: "Bölüm D • E-Belge Kontör",
    icon: "🎫",
    title: "Yanmayan, Süresi Dolmayan, Şeffaf E-Belge Kontör Yönetimi",
    desc: "Nilvera ve Türkiye'nin önde gelen GİB lisanslı özel entegratörleriyle doğrudan entegrasyon; kalan kontörlerinizi şeffafça izleyin.",
    features: [
      "Yıl Sonunda Sıfırlanmayan Kontörler: Satın aldığınız kontörler sene sonunda yanmaz, süresi dolmaz.",
      "10 Yıl Güvenli Bulut Arşivi: GİB mevzuatına uygun olarak tüm gelen ve giden e-belgeleriniz 10 yıl boyunca şifreli saklanır.",
      "Çift Entegratör Yedekleme Güvencesi: Entegratör bakımdayken bile faturanız kuyruğa alınır, kesinti yaşanmaz.",
      "Gelen Faturalarda Ücretsiz Görüntüleme: Size gelen faturaları kontrol ederken gereksiz kontör israfı yaşanmaz."
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-purple-600 selection:text-white">
    
    <!-- 1. HERO SECTION (VKN Yaz -> GİB Algıla -> Tek Tıkla Gönder) -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-purple-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
              🏛️ GİB Standartlarında UBL-TR 1.2 • e-Fatura, e-Arşiv & e-İrsaliye
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Müşteriniz e-Fatura mı e-Arşiv mi? <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-violet-300 to-emerald-300">
                Siz Düşünmeyin, Stok Pratik Otomatik Algılasın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Ayrı bir entegratör portalına girip tekrar fatura yazma devri bitti! Stok Pratik'te satışınızı veya sevkiyatınızı kaydedin; sistem VKN/TCKN üzerinden GİB posta kutusunu (PK) otomatik sorgulasın, mükellefse <strong>e-Fatura</strong>, değilse <strong>e-Arşiv Fatura</strong>, sevkiyatsa <strong>e-İrsaliye</strong> olarak tek tıkla resmileştirsin.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-purple-600/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>⚡ e-Dönüşümü Ücretsiz Başlatın</span>
              </a>
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/giris" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🔐 Giriş Yap</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Otomatik GİB PK Sorgulama
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> 2/10 - 9/10 Tevkifat Motoru
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> 10 Yıl Güvenli Arşiv
              </div>
            </div>
          </div>

          <!-- Sağ: Canlı GİB Resmi Elektronik Belge Sahnesi -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-purple-500/30 rounded-3xl p-5 sm:p-6 shadow-2xl backdrop-blur-xl">
              
              <!-- Üst Sekmeler -->
              <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <div class="flex gap-1.5">
                  <span class="px-2.5 py-1 rounded-lg bg-purple-500/20 text-purple-300 font-bold text-xs border border-purple-500/30">
                    📄 e-Fatura
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-slate-950 text-slate-400 text-xs">
                    🧾 e-Arşiv
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-slate-950 text-slate-400 text-xs">
                    🚚 e-İrsaliye
                  </span>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] font-bold text-emerald-400">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  GİB Onaylandı ✓
                </div>
              </div>

              <!-- Resmi Belge Kağıdı Görünümü (Beyaz / Açık Gri Kart) -->
              <div class="bg-white text-slate-900 rounded-2xl p-4 sm:p-5 shadow-inner text-xs font-sans space-y-3">
                
                <!-- Belge Üst Başlık & Logo -->
                <div class="flex justify-between items-start border-b border-slate-200 pb-3">
                  <div>
                    <div class="text-red-700 font-black text-sm tracking-tight">T.C. GELİR İDARESİ BAŞKANLIĞI</div>
                    <div class="text-[10px] font-bold text-slate-700 uppercase">e-Fatura Resmi Önizleme</div>
                    <div class="text-[9px] text-slate-500 font-mono mt-0.5">ETTN: a7d89c31-92b1-4f12-8e43-cb201948ba12</div>
                  </div>
                  <!-- Karekod / QR Mockup -->
                  <div class="w-12 h-12 bg-slate-900 rounded p-1 flex flex-col justify-between items-center text-white text-[7px] font-mono">
                    <span class="tracking-widest">■ ■ ■</span>
                    <span class="text-[6px]">GİB QR</span>
                    <span class="tracking-widest">■ ■ ■</span>
                  </div>
                </div>

                <!-- Müşteri ve Senaryo Bilgileri -->
                <div class="grid grid-cols-2 gap-2 text-[10px] bg-slate-50 p-2.5 rounded-lg border border-slate-200">
                  <div>
                    <span class="text-slate-500 font-medium">Alıcı VKN:</span>
                    <span class="font-mono font-bold text-slate-800 ml-1">3240891244</span>
                    <div class="text-[9px] text-emerald-600 font-semibold mt-0.5">✓ GİB Mükellefi (Posta Kutusu Aktif)</div>
                  </div>
                  <div class="text-right">
                    <span class="text-slate-500 font-medium">Senaryo:</span>
                    <span class="font-bold text-purple-700 ml-1">TİCARİ FATURA</span>
                    <div class="text-[9px] text-slate-500 mt-0.5">Fatura No: SP202600000841</div>
                  </div>
                </div>

                <!-- Kalem Tablosu -->
                <table class="w-full text-[10px]">
                  <thead>
                    <tr class="border-b border-slate-300 text-slate-600">
                      <th class="text-left py-1">Ürün Açıklaması</th>
                      <th class="text-center py-1">Miktar</th>
                      <th class="text-right py-1">Birim Fiyat</th>
                      <th class="text-right py-1">KDV</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 font-mono">
                    <tr>
                      <td class="py-1.5 font-sans font-medium text-slate-800">Endüstriyel Akrilik Mastik</td>
                      <td class="text-center py-1.5">24 Adet</td>
                      <td class="text-right py-1.5">150,00 ₺</td>
                      <td class="text-right py-1.5">%20</td>
                    </tr>
                  </tbody>
                </table>

                <!-- Alt Toplamlar & Tevkifat Dökümü -->
                <div class="border-t border-slate-200 pt-2 text-[10px] font-mono space-y-1">
                  <div class="flex justify-between text-slate-600">
                    <span>Mal Hizmet Toplamı:</span>
                    <span>3.600,00 ₺</span>
                  </div>
                  <div class="flex justify-between text-slate-600">
                    <span>Hesaplanan KDV (%20):</span>
                    <span>720,00 ₺</span>
                  </div>
                  <div class="flex justify-between text-purple-700 font-semibold bg-purple-50 p-1 rounded">
                    <span>KDV Tevkifatı (5/10):</span>
                    <span>-360,00 ₺</span>
                  </div>
                  <div class="flex justify-between text-slate-900 font-black text-xs pt-1 border-t border-slate-300">
                    <span>Ödenecek Tutar:</span>
                    <span class="text-purple-800">3.960,00 ₺</span>
                  </div>
                </div>

              </div>

              <!-- Alt Kontör Durum Bildirimi -->
              <div class="mt-4 p-2.5 rounded-xl bg-purple-950/40 border border-purple-500/20 text-[11px] text-purple-300 flex items-center justify-between">
                <span>🎫 Kalan Kontör: <strong>2.450 Adet</strong></span>
                <span class="text-emerald-400 font-bold">10 Yıl Bulut Arşiv Aktif</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. STICKY SPLIT-SCROLL 4 DERİN BÖLÜM -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative bg-slate-900/30">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-purple-400 text-sm font-semibold tracking-wider uppercase mb-3">Tam Entegre Ekosistem</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Resmi Elektronik Belgelerinizin Tüm Yönetimi Tek Ekranda
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            e-Faturadan e-İrsaliyeye, e-Arşivden özel entegratör kontörüne kadar GİB ile doğrudan bağlantılı çalışan mimari.
          </p>
        </div>

        <div class="space-y-12">
          {sections.map((sec, idx) => (
            <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-10 hover:border-purple-500/40 transition-all duration-300">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <div class="lg:col-span-5">
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs font-bold mb-4">
                    {sec.badge}
                  </div>
                  <h3 class="text-2xl font-bold text-white mb-3 leading-snug">{sec.title}</h3>
                  <p class="text-slate-400 text-sm leading-relaxed mb-6">{sec.desc}</p>
                  <div class="w-14 h-14 rounded-2xl bg-purple-500/10 border border-purple-500/20 text-3xl flex items-center justify-center">
                    {sec.icon}
                  </div>
                </div>

                <div class="lg:col-span-7 bg-slate-950/70 rounded-2xl p-6 border border-slate-800/80">
                  <div class="text-xs uppercase font-mono text-purple-400 font-bold mb-4">Öne Çıkan Standartlar & Kabiliyetler</div>
                  <div class="space-y-3">
                    {sec.features.map((feat) => (
                      <div class="flex items-start gap-3 text-sm text-slate-300">
                        <span class="text-emerald-400 font-bold shrink-0 mt-0.5">✓</span>
                        <span>{feat}</span>
                      </div>
                    ))}
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 3. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-purple-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs sm:text-sm font-semibold mb-6">
          🏛️ 14 Gün Ücretsiz Deneme • Dakikalar İçinde e-Faturaya Geçin
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          Kağıt, Kargo ve GİB Portalı Çilesini Bugün Bitirin!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Hemen ücretsiz Stok Pratik hesabınızı açın; e-Fatura, e-Arşiv ve e-İrsaliye kesmenin benzersiz kolaylığını hemen yaşamaya başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-purple-600/30 transition-all duration-200"
          >
            🚀 Ücretsiz Hesabınızı Açın ve e-Dönüşüme Geçin
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
