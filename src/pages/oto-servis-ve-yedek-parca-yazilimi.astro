---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #FFFBF5;
    color: #1e293b;
  }
  .font-display {
    font-family: 'Outfit', sans-serif;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out forwards;
  }
</style>

<BaseLayout title="Oto Servis & Yedek Parça İçin Stok Pratik" description="Oto servislerine ve yedek parça satıcılarına özel plaka takibi, iş emri, bakım periyotları, OEM/muadil parça stoku ve e-Fatura tek platformda.">
  <div class="antialiased selection:bg-orange-500 selection:text-white">


  <!-- ========================================== -->
  <!-- 1. HERO SECTION & BRAND BAR (NO TOP HEADER) -->
  <!-- ========================================== -->
  <section class="relative overflow-hidden pt-8 pb-16 lg:pt-12 lg:pb-20 bg-gradient-to-b from-[#FFF5EA] via-[#FFFBF5] to-white border-b border-orange-200/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Brand & Quick Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-orange-200/60">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-orange-600 to-amber-500 flex items-center justify-center text-white shadow-md shadow-orange-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
              <circle cx="7" cy="17" r="2"></circle>
              <circle cx="17" cy="17" r="2"></circle>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-extrabold text-slate-900 tracking-tight font-display">
                Stok<span class="text-orange-600">Pratik</span>
              </span>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-orange-800 bg-orange-100/90 px-2 py-0.5 rounded-full border border-orange-300/80">
                Oto Servis & Yedek Parça
              </span>
            </div>
            <p class="text-xs text-slate-500">Servis İş Emri, Plaka Takibi & Parça Stok Platformu</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="tel:05325000999" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 bg-white px-3.5 py-2 rounded-xl border border-slate-200 shadow-xs hover:border-orange-500 transition-colors">
            <svg class="w-3.5 h-3.5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span>0532 500 09 99</span>
          </a>
          <button onclick="openModal()" class="bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-700 hover:to-amber-700 text-white text-xs sm:text-sm font-bold px-4 py-2 rounded-xl shadow-md shadow-orange-600/20 hover:shadow-lg transition-all cursor-pointer">
            14 Gün Ücretsiz Dene
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition -->
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-100/90 border border-orange-300/80 text-orange-900 text-xs sm:text-sm font-bold mb-5 shadow-xs">
            <span class="flex h-2 w-2 rounded-full bg-orange-600 animate-pulse"></span>
            <span>Servis Yönetimi & Yedek Parça Stoku Tek Ekranda</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15] font-display mb-6">
            Plaka, İş Emri ve Yedek Parçanın <br class="hidden sm:inline">
            <span class="bg-gradient-to-r from-orange-600 via-amber-600 to-blue-700 bg-clip-text text-transparent">
              Tek ve En Hızlı Adresi
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
            Oto servis ve yedek parça işletmelerinde iş emri, plaka geçmişi, usta işçilikleri ve OEM parça stoklarını aynı anda takip etmek hayati önem taşır. Stok Pratik ile araç kabulünden faturalandırmaya kadar tüm süreci dijitalleştirin; hangi parçanın hangi rafta ne kadar kaldığını anlık görün, müşterinize tek tıkla durum bilgilendirme SMS’i gönderin.
          </p>

          <!-- 3 Core Feature Badges -->
          <div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3.5 mb-8">
            <div class="p-3.5 rounded-2xl bg-white border border-orange-200/90 shadow-xs">
              <div class="flex items-center gap-2 text-orange-800 font-bold text-sm mb-1">
                <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span>Plaka & İş Emri</span>
              </div>
              <p class="text-xs text-slate-500">Plakayı yazın; tüm geçmiş bakım ve şase bilgisi gelsin.</p>
            </div>

            <div class="p-3.5 rounded-2xl bg-white border border-orange-200/90 shadow-xs">
              <div class="flex items-center gap-2 text-blue-800 font-bold text-sm mb-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span>OEM & Raf Stoku</span>
              </div>
              <p class="text-xs text-slate-500">Muadil parça eşleme ve raf/kutu konumu takibi.</p>
            </div>

            <div class="p-3.5 rounded-2xl bg-white border border-orange-200/90 shadow-xs">
              <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm mb-1">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                <span>Usta & İşçilik</span>
              </div>
              <p class="text-xs text-slate-500">Usta hakedişi, standart işçilik ve prim hesabı.</p>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto">
            <button onclick="openModal()" class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-orange-600 via-orange-700 to-amber-700 text-white font-bold text-base shadow-lg shadow-orange-600/25 hover:shadow-xl hover:shadow-orange-600/35 hover:-translate-y-0.5 transition-all cursor-pointer">
              <span>Hemen Dene - 14 Gün Ücretsiz Demo</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>

            <a href="https://stokpratik.com.tr/paketlerimiz" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border-2 border-slate-300 hover:border-orange-500 text-slate-800 hover:text-orange-700 font-bold text-base shadow-xs hover:bg-orange-50/50 transition-all text-center">
              <span>Paketleri İncele</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="mt-6 flex flex-wrap items-center gap-y-2 gap-x-5 text-xs text-slate-500 font-medium">
            <span class="inline-flex items-center gap-1.5 text-emerald-700 font-semibold">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              Kredi Kartı Gerekmez
            </span>
            <span class="inline-flex items-center gap-1.5 text-slate-600">
              <svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              %100 Web Tabanlı (Tablet & Cep)
            </span>
            <span class="inline-flex items-center gap-1.5 text-slate-600">
              <svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              240+ Oto Servis Tercihi
            </span>
          </div>

        </div>

        <!-- Right: Live Mockup Card -->
        <div class="lg:col-span-5">
          <div class="bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
            
            <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white p-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="bg-white text-slate-950 font-mono font-extrabold px-3 py-1 rounded-lg border-2 border-slate-300 flex items-center gap-1.5 shadow-xs">
                  <span class="bg-blue-700 text-white text-[9px] font-bold px-1 rounded-xs">TR</span>
                  <span class="text-sm tracking-wider">34 STP 2026</span>
                </div>
                <div>
                  <h3 class="font-bold text-xs text-white font-display">Volkswagen Passat 1.5 TSI</h3>
                  <p class="text-[10px] text-orange-300">64.200 KM • Şase: WVWZZZ3CZ...</p>
                </div>
              </div>
              <span id="hero-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-md uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30">
                Liftte / İşlemde
              </span>
            </div>

            <div class="p-5 space-y-4 text-xs">
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">Müşteri & İletişim</p>
                  <p class="font-bold text-slate-800 text-xs">Ahmet Karadağ (0532 450 88 90)</p>
                  <p class="text-[11px] text-slate-500 mt-0.5">60.000 KM Periyodik Yağ & Filtre Bakımı</p>
                </div>
                <span class="text-[10px] bg-orange-100 text-orange-900 font-bold px-2 py-0.5 rounded">
                  Mustafa Usta
                </span>
              </div>

              <div>
                <p class="font-bold text-slate-700 mb-1.5">Kullanılan Yedek Parçalar & Raf Konumları:</p>
                <div class="space-y-1.5">
                  <div class="p-2.5 rounded-xl bg-white border border-slate-200 flex justify-between items-center">
                    <div>
                      <p class="font-bold text-slate-800">Yağ Filtresi (Orijinal OEM)</p>
                      <p class="text-[10px] text-blue-700 font-mono">Raf A-03 / Kutu 12 • OEM: 04E115561H</p>
                    </div>
                    <span class="font-bold text-slate-900">480 ₺</span>
                  </div>
                  <div class="p-2.5 rounded-xl bg-white border border-slate-200 flex justify-between items-center">
                    <div>
                      <p class="font-bold text-slate-800">5W-30 Tam Sentetik Motor Yağı (4L)</p>
                      <p class="text-[10px] text-blue-700 font-mono">Yağ Deposu / Palet 02</p>
                    </div>
                    <span class="font-bold text-slate-900">1.650 ₺</span>
                  </div>
                  <div class="p-2.5 rounded-xl bg-white border border-slate-200 flex justify-between items-center">
                    <div>
                      <p class="font-bold text-slate-800">Ön Fren Balata Takımı</p>
                      <p class="text-[10px] text-blue-700 font-mono">Raf B-01 / Kutu 04</p>
                    </div>
                    <span class="font-bold text-slate-900">1.250 ₺</span>
                  </div>
                </div>
              </div>

              <div class="p-3 bg-orange-50/70 rounded-xl border border-orange-200/80 space-y-1">
                <div class="flex justify-between text-slate-600">
                  <span>Parça Toplamı:</span>
                  <span class="font-semibold text-slate-900">3.380,00 ₺</span>
                </div>
                <div class="flex justify-between text-slate-600">
                  <span>Mekanik İşçilik:</span>
                  <span class="font-semibold text-slate-900">1.100,00 ₺</span>
                </div>
                <div class="pt-1.5 border-t border-orange-200 flex justify-between text-sm font-extrabold text-slate-900">
                  <span>Toplam Tutar:</span>
                  <span class="text-orange-700 font-extrabold text-base">4.480,00 ₺ <span class="text-[10px] text-slate-500 font-normal">+KDV</span></span>
                </div>
              </div>

              <button onclick="triggerHeroSMS()" id="hero-sms-btn" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-xs shadow-md shadow-emerald-600/20 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <span>İşlemi Tamamla & Müşteriye Teslim SMS’i Gönder</span>
              </button>

              <div id="hero-sms-box" class="hidden p-2.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-900 text-[11px] font-medium animate-fadeIn">
                📲 0532 450 88 90 numarasına <strong>"34 STP 2026 plakalı aracınızın periyodik bakımı tamamlanmış olup teslime hazırdır"</strong> SMS'i gönderildi!
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ========================================== -->
  <!-- 2. ZORLUKLAR & SEKTÖREL PROBLEMLER         -->
  <!-- ========================================== -->
  <section class="py-16 lg:py-24 bg-white border-b border-orange-200/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="inline-block px-3.5 py-1 rounded-full bg-orange-100 border border-orange-300 text-orange-900 text-xs font-bold uppercase tracking-wider mb-3">
          Otomotiv Sektöründeki Kritik Zorluklar
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
          Oto Servis & Yedek Parçada Yaşanan Aksaklıklar
        </h2>
        <p class="mt-3 text-base text-slate-600">
          Defterle, Excel ile veya yetersiz muhasebe programlarıyla araç kabul etmek ve parça aramak zaman, nakit ve müşteri kaybettirir.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- Card 1 -->
        <div class="bg-[#FFFBF5] rounded-3xl p-6 sm:p-7 border border-orange-200/80 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-800 flex items-center justify-center font-bold">
              🚗
            </div>
            <span class="text-xs font-bold text-orange-800 bg-orange-100/90 px-3 py-1 rounded-full border border-orange-300/70">
              %100 Geçmişe Hakimiyet
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-display">
            Plaka ve Araç Geçmişi Kaybı
          </h3>
          <div class="mb-3.5 p-3.5 rounded-2xl bg-rose-50/80 border border-rose-200/70 text-xs sm:text-sm text-slate-700">
            <strong class="text-rose-900 font-semibold">Geleneksel Sorun: </strong>
            Gelen aracın önceki servis ziyaretinde hangi yağın konulduğu, hangi parçanın değiştiği veya triger bakımının ne zaman yapıldığı bilinmez.
          </div>
          <div class="p-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 text-xs sm:text-sm text-slate-800 font-medium">
            <strong class="text-emerald-900 font-bold">Stok Pratik Çözümü: </strong>
            Plakayı yazdığınız anda aracın tüm servis geçmişi, takılan parçalar, şase no, usta notları ve önceki kilometre kayıtları saniyeler içinde ekrana gelir.
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-[#FFFBF5] rounded-3xl p-6 sm:p-7 border border-orange-200/80 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-800 flex items-center justify-center font-bold">
              ⚙️
            </div>
            <span class="text-xs font-bold text-orange-800 bg-orange-100/90 px-3 py-1 rounded-full border border-orange-300/70">
              Sıfır Parça Kaybı
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-display">
            Yedek Parça & Raf/OEM Karmaşası
          </h3>
          <div class="mb-3.5 p-3.5 rounded-2xl bg-rose-50/80 border border-rose-200/70 text-xs sm:text-sm text-slate-700">
            <strong class="text-rose-900 font-semibold">Geleneksel Sorun: </strong>
            Binlerce kalem yedek parça içinde orijinal/muadil kodları karışır, rafta parça kaybolur ve atölyede iş durur.
          </div>
          <div class="p-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 text-xs sm:text-sm text-slate-800 font-medium">
            <strong class="text-emerald-900 font-bold">Stok Pratik Çözümü: </strong>
            OEM kodu, muadil kodu, marka ve raf/kutu konumu (Örn: Raf C-3, Göz 14) ile parçayı anında bulun. İş emrine eklendiğinde stok otomatik düşer.
          </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-[#FFFBF5] rounded-3xl p-6 sm:p-7 border border-orange-200/80 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-800 flex items-center justify-center font-bold">
              🔧
            </div>
            <span class="text-xs font-bold text-orange-800 bg-orange-100/90 px-3 py-1 rounded-full border border-orange-300/70">
              %40 İşçilik Geliri Artışı
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-display">
            Usta & İşçilik Takipsizliği
          </h3>
          <div class="mb-3.5 p-3.5 rounded-2xl bg-rose-50/80 border border-rose-200/70 text-xs sm:text-sm text-slate-700">
            <strong class="text-rose-900 font-semibold">Geleneksel Sorun: </strong>
            Hangi ustanın hangi araçta ne kadar çalıştığı, eklenen işçilik kalemleri ve usta primleri elle hesaplanırken kaçaklar ve anlaşmazlıklar doğar.
          </div>
          <div class="p-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 text-xs sm:text-sm text-slate-800 font-medium">
            <strong class="text-emerald-900 font-bold">Stok Pratik Çözümü: </strong>
            Her iş emrine sorumlu usta atanır, standart işçilik saatleri veya özel bedeller tanımlanır; ustanın aylık prim ve hakediş raporu otomatik çıkar.
          </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-[#FFFBF5] rounded-3xl p-6 sm:p-7 border border-orange-200/80 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-800 flex items-center justify-center font-bold">
              📱
            </div>
