---
// src/components/Header.astro
import SocialMedia from './SocialMedia.astro';
---

<!-- Rotating Announcement Bar -->
<div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white text-xs sm:text-sm py-2.5 px-4 text-center border-b border-red-500/20 font-medium relative overflow-hidden h-11 flex items-center justify-center">
  <div class="container mx-auto relative h-6 flex items-center justify-center">
    <div class="announcement-item flex items-center justify-center gap-1.5 sm:gap-2 transition-all duration-500 absolute inset-0 opacity-100 translate-y-0">
      <span class="truncate">🚀 <strong>YENİ:</strong> Yapay Zeka (AI OCR) ile Fiş & Fatura Okuma Stok Pratik'te!</span>
      <a href="/yapay-zeka-fis-okuma-masraf-yonetimi" class="text-red-400 hover:text-red-300 font-bold underline inline-flex items-center gap-0.5 ml-1 shrink-0">Hemen İncele →</a>
    </div>
    <div class="announcement-item flex items-center justify-center gap-1.5 sm:gap-2 transition-all duration-500 absolute inset-0 opacity-0 translate-y-4 pointer-events-none">
      <span class="truncate">🌐 <strong>37+ Pazaryeri & E-İhracat:</strong> Canlı Stok ve Sipariş Senkronizasyonu!</span>
      <a href="/e-ticaret-pazaryeri-entegrasyonu" class="text-red-400 hover:text-red-300 font-bold underline inline-flex items-center gap-0.5 ml-1 shrink-0">Hemen İncele →</a>
    </div>
    <div class="announcement-item flex items-center justify-center gap-1.5 sm:gap-2 transition-all duration-500 absolute inset-0 opacity-0 translate-y-4 pointer-events-none">
      <span class="truncate">🎁 <strong>KAMPANYA:</strong> 1 Ay Tam Sürüm Ücretsiz Deneyin — Kredi Kartı Gerekmez!</span>
      <a href="/firma-kaydi" class="text-red-400 hover:text-red-300 font-bold underline inline-flex items-center gap-0.5 ml-1 shrink-0">Ücretsiz Başla →</a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
  <nav class="container mx-auto px-4 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Left: Logo -->
    <a href="/" class="flex-shrink-0 flex items-center gap-3 text-red-600 font-extrabold text-2xl lg:text-3xl tracking-tight hover:opacity-90 transition-opacity mr-6 xl:mr-12">
      <span>Stok Pratik</span>
    </a>

    <!-- Center/Right: Desktop Navigation -->
    <div class="hidden lg:flex flex-1 items-center justify-end gap-4 xl:gap-7">
      <ul class="flex items-center gap-3 xl:gap-6 list-none m-0 p-0">
        
        <li class="list-none shrink-0">
          <a href="/arkadasini-getir-kampanyasi" class="inline-flex items-center gap-2 text-red-600 font-bold uppercase tracking-wider text-[13px] hover:text-red-700 transition-colors bg-red-50 hover:bg-red-100 px-3.5 xl:px-4 py-2 rounded-lg whitespace-nowrap shadow-sm">
            <span class="text-base leading-none">🎁</span><span class="whitespace-nowrap">Ücretsiz Kullan</span>
          </a>
        </li>
        
        <li class="relative group list-none h-20 flex items-center shrink-0">
          <button class="flex items-center gap-2 text-red-500 font-bold uppercase tracking-wider text-[13px] hover:text-red-400 transition-colors bg-slate-900 px-3.5 xl:px-4 py-2 rounded-lg whitespace-nowrap">
            Fiyatlar ve Özellikler
