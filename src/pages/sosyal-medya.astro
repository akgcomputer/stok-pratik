---
// src/pages/sosyal-medya.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const feedId = "aqk1LlwnSuTE6SDhTCCY";
const instagramUrl = "https://www.instagram.com/stokpratik/";
const registerUrl = "https://erp-eticaret.stokpratik.com.tr/giris?promo=StokPratik45Gun";
---

<BaseLayout 
  title="Sosyal Medya & Canlı Instagram Reels Akışı — Stok Pratik"
  description="Stok Pratik resmi Instagram akışı ve Reels videoları. Ön muhasebe, e-ticaret, hızlı barkod POS ve ERP ipuçlarını canlı izleyin, 45 gün ücretsiz deneyin."
>
  <main class="min-h-screen bg-slate-950 text-white selection:bg-amber-400 selection:text-slate-950 relative overflow-hidden py-12 sm:py-16">
    
    {/* Ambient Glows */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-purple-600/20 via-pink-600/10 to-transparent blur-3xl pointer-events-none"></div>
    <div class="absolute top-80 -right-40 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-4 max-w-6xl relative z-10">
      
      {/* 1. PROFILE HEADER CARD */}
      <div class="bg-gradient-to-r from-slate-900 via-slate-900 to-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-10 mb-12 shadow-2xl relative overflow-hidden">
        
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          
          {/* Avatar & Info */}
          <div class="flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
            <div class="relative shrink-0">
              <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full p-1 bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 shadow-xl">
                <div class="w-full h-full rounded-full bg-slate-900 p-1 flex items-center justify-center overflow-hidden">
                  <span class="text-4xl sm:text-5xl">📱</span>
                </div>
              </div>
              <span class="absolute bottom-1 right-1 w-6 h-6 rounded-full bg-emerald-500 border-2 border-slate-900 flex items-center justify-center text-[10px] text-white font-bold" title="Canlı Akış">
                ✓
              </span>
            </div>

            <div>
              <div class="flex items-center justify-center sm:justify-start gap-2 mb-1">
                <h1 class="text-2xl sm:text-3xl font-black text-white">Stok Pratik</h1>
                <span class="text-sky-400 text-lg" title="Doğrulanmış Hesap">☑</span>
              </div>
              <p class="text-pink-400 font-mono font-bold text-sm mb-2">@stokpratik</p>
              <p class="text-slate-300 text-xs sm:text-sm max-w-xl leading-relaxed">
                Ön Muhasebe • e-Fatura • Pazaryeri • Hızlı Barkod POS • Mağazacılık • Lojistik • ERP • CRM
              </p>
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mt-3 text-xs text-slate-400">
                <span class="flex items-center gap-1 font-semibold text-slate-300">
                  <strong class="text-white">7/24</strong> Canlı Çözüm
                </span>
                <span>•</span>
                <span class="flex items-center gap-1 font-semibold text-slate-300">
                  <strong class="text-white">Otomatik</strong> Canlı Senkron
                </span>
                <span>•</span>
                <span class="text-amber-400 font-bold">
                  🎁 StokPratik45Gun Kampanyası Aktif
                </span>
              </div>
            </div>
          </div>

          {/* Action CTAs */}
          <div class="flex flex-col sm:flex-row md:flex-col gap-3 w-full md:w-auto shrink-0">
            <a 
              href={instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-purple-600 via-pink-600 to-amber-600 hover:from-purple-500 hover:to-amber-500 text-white font-black text-sm text-center shadow-lg shadow-pink-600/20 transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram'da Takip Et</span>
            </a>

            <a 
              href={registerUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-sm text-center shadow-lg shadow-amber-400/20 transition-all hover:scale-105 active:scale-95"
            >
              🚀 45 Gün Ücretsiz Başla →
            </a>
          </div>

        </div>

      </div>

      {/* 2. SECTION TITLE */}
      <div class="text-center max-w-2xl mx-auto mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-400 text-xs font-black uppercase tracking-wider mb-2">
          <span>🎬</span> Canlı Reels & Gönderi Vitrini
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-white">
          İşletmenizi Kolaylaştıran İpuçları
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-2">
          Instagram'a yüklediğimiz en yeni Reels videolarımız ve eğitim içeriklerimiz anlık olarak burada listelenmektedir. Videolara tıklayarak hemen izleyebilirsiniz.
        </p>
      </div>

      {/* 3. BEHOLD INSTAGRAM WIDGET */}
      <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-4 sm:p-8 shadow-2xl relative min-h-[400px]">
        <figure data-behold-id={feedId} class="w-full"></figure>
      </div>

      {/* 4. BOTTOM VALUE CTA */}
      <div class="mt-16 text-center bg-gradient-to-r from-red-600/20 via-amber-500/15 to-red-600/20 border-2 border-amber-400/40 rounded-3xl p-8 sm:p-12">
        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
          Videolarda Gördüğünüz Sistemi Firmanızda Deneyin
        </h3>
        <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto mb-6">
          Kredi kartı gerekmez, taahhüt yok! <strong class="text-amber-300">StokPratik45Gun</strong> koduyla 30 gün yerine tam 45 gün boyunca tüm modülleri sınırsız test edin.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href={registerUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 bg-amber-400 hover:bg-amber-300 text-slate-950 font-black rounded-xl text-base shadow-xl shadow-amber-400/20 transition-all hover:scale-105 active:scale-95"
          >
            🚀 Hemen 45 Gün Ücretsiz Başla
          </a>
          <a 
            href="/kampanya" 
            class="w-full sm:w-auto px-8 py-4 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl text-base transition-all"
          >
            Kampanya Detaylarını Gör →
          </a>
        </div>
      </div>

    </div>

  </main>

  {/* Behold Widget Script */}
  <script is:inline>
    (() => {
      if (window.__bhldScript) return;
      window.__bhldScript = true;
      const d = document, s = d.createElement("script");
      s.type = "module";
      s.src = "https://w.behold.so/widget.js";
      setTimeout(() => { d.head.append(s); }, 0);
    })();
  </script>
</BaseLayout>
