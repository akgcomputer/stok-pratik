---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Teknik Servis Yönetimi ve Online Cihaz Takip Portalı | Stok Pratik";
const pageDescription = "'Cihazım tamir oldu mu?' telefonlarına son! Barkodlu servis kabulü, yedek parça stok düşümü, müşteriye özel canlı SMS/WhatsApp servis takip linki ve online tahsilat.";

const repairSteps = [
  { step: "1", title: "Servis Kaydı Açıldı", status: "Tamamlandı", date: "24 Ekim 10:30", color: "text-emerald-400 bg-emerald-500/20 border-emerald-500/40" },
  { step: "2", title: "Arıza Tespiti Yapıldı", status: "Tamamlandı", date: "24 Ekim 11:45", color: "text-emerald-400 bg-emerald-500/20 border-emerald-500/40" },
  { step: "3", title: "Müşteri Fiyat Onayı", status: "Onaylandı (3.250 ₺)", date: "24 Ekim 13:10", color: "text-amber-400 bg-amber-500/20 border-amber-500/40" },
  { step: "4", title: "Onarım & Test Sürecinde", status: "Aktif İşlem", date: "Şu An", color: "text-cyan-400 bg-cyan-500/20 border-cyan-500/40 animate-pulse" },
  { step: "5", title: "Teslime Hazır & Online Öde", status: "Sıradaki", date: "Beklemede", color: "text-slate-500 bg-slate-800 border-slate-700" }
];

const serviceWorkflow = [
  {
    step: "01",
    title: "Saniyeler İçinde Cihaz Kabul Fişi & Barkod Etiketi",
    desc: "Cihazın marka, model, Seri No/IMEI, kozmetik durumu (çizik/hasar notları), aksesuarları ve müşteri şikayetini kaydedin. Tek tıkla resmi 2 nüsha A4 Kabul Formu ve cihaza yapıştırılacak termal barkod etiketini yazdırın.",
    icon: "🎫"
  },
  {
    step: "02",
    title: "Müşteriye Özel Şifresiz Canlı Takip Linki",
    desc: "Kayıt açıldığı anda müşteriye özel SMS ve WhatsApp linki (/servis-takip/SRV-8492) iletilir. Müşteri sizi telefonla rahatsız etmeden telefonundan kargo takip eder gibi tamir aşamasını canlı izler.",
    icon: "📱"
  },
  {
    step: "03",
    title: "Yedek Parça Stok Düşümü + Gerçek Servis Kârı",
    desc: "Kullanılan ekran, batarya, filtre veya rulman depodaki stoktan tek tıkla otomatik düşer. Parça alış maliyeti ile işçilik bedeli birleşerek servis fişinin gerçek brüt kârını kuruşu kuruşuna hesaplar.",
    icon: "⚙️"
  },
  {
    step: "04",
    title: "Pahalı Parçalarda WhatsApp Üzerinden Fiyat Onayı",
    desc: "Arıza tespiti sonrası müşteriye SMS/WhatsApp ile tahmini maliyeti onaylatın. Müşteri link üzerinden 'Fiyatı Onaylıyorum' butonuna basmadan tamire başlamayın, servis çıkışı anlaşmazlıkları sıfırlayın.",
    icon: "💬"
  },
  {
    step: "05",
    title: "Tek Tıkla Fatura & Kredi Kartıyla Linkle Tahsilat",
    desc: "Onarım bittiğinde servis kaydını tek tıkla e-Fatura veya e-Arşiv faturaya dönüştürün. Müşteriye gönderilen takip linkine entegre online kredi kartı ödeme butonuyla parayı kasaya anında aktarın.",
    icon: "💳"
  }
];

const faqs = [
  {
    q: "Müşterinin cihaz durumunu görmesi için sisteme üye olması gerekir mi?",
    a: "Hayır! Her servis kaydına özel, kriptografik ve güvenli bir canlı takip bağlantısı (/servis-takip/:token) üretilir. Müşteri SMS veya WhatsApp'tan gelen linke tıkladığı anda doğrudan kendi cihazının durumunu, fotoğraflarını ve tutarını görür."
  },
  {
    q: "Kullanılan yedek parçalar stoktan otomatik düşer mi?",
    a: "Evet. Teknisyen servis fişine 'iPhone 13 Orijinal Ekran' veya 'Kombi Sirkülasyon Pompası' eklediğinde, ilgili parça depodaki stoktan anında düşer ve alış maliyeti servis maliyetine yansıtılır."
  },
  {
    q: "Cihaz teslim alınırken müşteriye fiziksel form imzalatabilir miyiz?",
    a: "Kesinlikle. 'Cihaz Kabul ve Teslim Formu' A4 veya termal yazıcı formatında 2 nüsha olarak basılabilir; cihazın kozmetik kusurları ve müşteri imzası fiziksel olarak arşivlenebilir."
  },
  {
    q: "Hangi sektörlerdeki teknik servisler için uygundur?",
    a: "Bilgisayar/bilişim, cep telefonu/tablet, beyaz eşya, kombi/klima, elektronik kart tamiri, medikal cihazlar, endüstriyel makine, saat/optik ve elektrikli scooter servisleri için eksiksiz tasarlanmıştır."
  },
  {
    q: "Garanti kapsamında yapılan ücretsiz tamirleri ayrıca takip edebilir miyiz?",
    a: "Evet! Servis kaydı açılırken 'Garanti İçi (Ücretsiz)' veya 'Garanti Dışı (Ücretli)' seçilebilir. Garanti içi işlemlerde müşteriye 0 TL fatura/makbuz kesilirken parça maliyetleri şirket giderine yazılır."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-cyan-500 selection:text-slate-950">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-cyan-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-cyan-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              🛠️ Hizmet & Servis • Barkodlu Kabul & Canlı Müşteri Takip Portalı
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              "Cihazım Ne Oldu, Bitti mi?" Telefonlarına Son: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-300">
                Müşteriniz Canlı İzlesin, Online Ödesin!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Telefon, bilgisayar, beyaz eşya veya makine servisi misiniz? Cihazı barkodlu servis fişiyle teslim alın, yedek parçayı stoktan otomatik düşün, müşterinize özel <strong>Canlı Takip Linki</strong> gönderin. Tamir bittiğinde müşteri kredi kartıyla ödeyip cihazını teslim alsın!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-cyan-600 via-cyan-500 to-teal-600 hover:from-cyan-500 hover:to-teal-500 text-white font-bold text-base shadow-lg shadow-cyan-600/30 hover:shadow-cyan-600/50 hover:scale-[1.02] transition-all text-center"
              >
                🛠️ Teknik Servis Sistemini Ücretsiz Başlatın
              </a>
              <a 
                href="#live-tracker" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>📱 Canlı Takip Ekranını Gör</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> SMS & WhatsApp Bildirimi</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Yedek Parça Stok Entegre</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Kredi Kartıyla Linkle Öde</span>
            </div>
          </div>

          <!-- Sağ: Çift Arayüz Mockup'ı (Teknisyen Masası + Müşteri Canlı Takip Telefonu) -->
          <div class="lg:col-span-6" id="live-tracker">
            <div class="relative grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- 1. Ekran: Teknisyenin Servis Masası -->
              <div class="bg-slate-900/90 rounded-2xl border border-cyan-500/30 p-4 shadow-2xl relative overflow-hidden text-xs">
                <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-cyan-500 to-teal-500"></div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
                  <span class="bg-cyan-500/20 text-cyan-400 px-2 py-0.5 rounded font-mono font-bold">🔧 Teknisyen Masası</span>
                  <span class="text-slate-400 font-mono text-[10px]">#SRV-8492</span>
                </div>

                <div class="space-y-2 mb-3">
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-slate-400">Cihaz & Müşteri</div>
                    <div class="font-bold text-white">Apple MacBook Pro 14" (M2)</div>
                    <div class="text-[10px] text-slate-400">Müşteri: Sinan Kaya • 0532 *** **12</div>
                  </div>

                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-slate-400">Kullanılan Yedek Parça</div>
                    <div class="flex justify-between items-center text-slate-200">
                      <span>• Orijinal Sıvı Temas Bataryası</span>
                      <span class="text-emerald-400 font-mono font-bold">-1 Adet</span>
                    </div>
                    <div class="text-[10px] text-slate-500 mt-0.5">Depodan otomatik düşüldü</div>
                  </div>

                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="flex justify-between items-center text-[11px]">
                      <span class="text-slate-400">Yedek Parça:</span>
                      <span class="text-slate-200 font-mono">2.250 ₺</span>
                    </div>
                    <div class="flex justify-between items-center text-[11px]">
                      <span class="text-slate-400">İşçilik Bedeli:</span>
                      <span class="text-slate-200 font-mono">1.000 ₺</span>
                    </div>
                    <div class="flex justify-between items-center font-bold text-cyan-400 pt-1 border-t border-slate-800 mt-1">
                      <span>Toplam Ücret:</span>
                      <span>3.250 ₺</span>
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-slate-800">
                  <div class="w-full py-1.5 bg-cyan-600/30 border border-cyan-500/40 text-cyan-300 text-center rounded font-semibold text-[11px]">
                    ✓ Müşteri WhatsApp Fiyat Onayı Alındı
                  </div>
                </div>
              </div>

              <!-- 2. Ekran: Müşteri Mobil Takip Ekranı (/servis-takip/:token) -->
              <div class="bg-slate-900/90 rounded-2xl border border-teal-500/30 p-4 shadow-2xl relative overflow-hidden text-xs flex flex-col justify-between">
                <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-teal-500 to-emerald-500"></div>

                <div>
                  <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
                    <span class="bg-teal-500/20 text-teal-400 px-2 py-0.5 rounded font-mono font-bold">📱 Müşteri Takip Ekranı</span>
                    <span class="text-emerald-400 text-[10px] font-bold">Canlı Yayında</span>
                  </div>

                  <div class="text-center mb-3">
                    <div class="text-[10px] text-slate-400">Onarım Takip Kodu</div>
                    <div class="text-base font-black text-white font-mono">SRV-8492</div>
                  </div>

                  <!-- 5 Adımlı Canlı Durum Akışı -->
                  <div class="space-y-2 mb-3">
                    {repairSteps.map((step) => (
                      <div class="flex items-center justify-between p-1.5 rounded bg-slate-950 border border-slate-800/80">
                        <div class="flex items-center gap-2">
                          <span class={`w-5 h-5 rounded-full border text-[10px] flex items-center justify-center font-bold ${step.color}`}>
                            {step.step}
                          </span>
                          <span class="text-slate-300 text-[11px] font-medium">{step.title}</span>
                        </div>
                        <span class="text-[9px] text-slate-400 font-mono">{step.date}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Online Ödeme Butonu -->
                <div class="pt-2 border-t border-slate-800">
                  <div class="w-full py-2 bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-center rounded-lg font-bold text-xs shadow cursor-pointer flex items-center justify-center gap-1.5">
                    <span>💳</span> 3.250 ₺ Kredi Kartıyla Online Öde
                  </div>
                  <div class="text-[9px] text-slate-400 text-center mt-1">256-Bit SSL • Peşin Fiyatına Taksit İmkanı</div>
                </div>

              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. TEKNİK SERVİSİN 5 ADIMLI DİJİTAL AKIŞI -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-bold mb-3">Kusursuz Servis Döngüsü</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Cihaz Kabulünden Tahsilata 5 Adımlı Dijital Otomasyon</h3>
          <p class="text-slate-400 mt-4 text-base">
            Müşteri memnuniyetini en üst seviyeye çıkarırken servis personeli ve atölye maliyetlerini tek panelden denetleyin.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {serviceWorkflow.map((item) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-cyan-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center text-2xl mb-4">
                  {item.icon}
                </div>
                <div class="text-xs font-mono text-cyan-400 font-bold mb-1">ADIM {item.step}</div>
                <h4 class="text-lg font-bold text-white mb-2">{item.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">Teknik Servis Modülü Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-cyan-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-cyan-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-cyan-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-cyan-500/20 border border-cyan-500/40 text-cyan-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🛠️
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Teknik Servisinize Kurumsal Prestij ve Hız Kazandırın! <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-300">
              Müşterilerinize Profesyonel Takip Deneyimi Yaşatın.
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Hemen ücretsiz Stok Pratik hesabınızı açın, cihaz kabulünden online ödemeye kadar tüm atölyenizi dakikalar içinde dijitalleştirin.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-cyan-600 via-cyan-500 to-teal-600 hover:from-cyan-500 hover:to-teal-500 text-white font-bold text-lg shadow-xl shadow-cyan-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 Hemen Ücretsiz Kullanmaya Başla
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • Termal fiş & barkod yazıcılarla %100 uyumlu</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik Teknik Servis ve Canlı Müşteri Takip Sistemi",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
