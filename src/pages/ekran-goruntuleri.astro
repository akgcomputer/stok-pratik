---
// src/pages/ekran-goruntuleri.astro
import BaseLayout from '../layouts/BaseLayout.astro';

// 17 Yeni ve Gerçek Ekran Görüntüsü (Kullanıcı İsteğine Göre Sıralı)
const screenshots = [
  {
    id: 1,
    category: "analiz-yonetim",
    categoryLabel: "Güvenlik & Giriş",
    badgeColor: "bg-slate-100 text-slate-800 border-slate-300",
    src: "/images/screenshots/StokPratik_giris.png",
    alt: "Stok Pratik Güvenli Giriş ve Kullanıcı Kimlik Doğrulama Paneli",
    title: "Güvenli Giriş & Kullanıcı Rol Yetkilendirme",
    description: "256-bit SSL koruması, şube bazlı oturum açma, kasiyer/müdür yetki kısıtlamaları ve log kayıtları.",
    features: [
      "Personele özel kısıtlı ekranlar (fiyat görme, iskonto yapma yetkileri)",
      "Bulut altyapısıyla her cihazdan (PC, Mac, Tablet, Telefon) güvenli erişim",
      "Otomatik yedekleme ile sıfır veri kaybı güvencesi"
    ]
  },
  {
    id: 2,
    category: "ticaret",
    categoryLabel: "Ticaret & Satış",
    badgeColor: "bg-red-50 text-red-600 border-red-200",
    src: "/images/screenshots/StokPratik_baslangic_ekrani.png",
    alt: "Stok Pratik Başlangıç ve Yönetim Paneli Ekran Görüntüsü",
    title: "Başlangıç Ekranı & Yönetici Özeti",
    description: "İşletmenizin ciro, kasa durumu, kritik stoklar ve günlük satış özetlerini tek bakışta sunan akıllı kokpit.",
    features: [
      "Tek bakışta günlük ciro, kasa ve banka toplamları",
      "Kritik stok seviyesine düşen ürün alarmları",
      "Hızlı işlem kısayolları ve bekleyen siparişler"
    ]
  },
  {
    id: 3,
    category: "analiz-yonetim",
    categoryLabel: "Piyasa & Finans",
    badgeColor: "bg-amber-50 text-amber-700 border-amber-200",
    src: "/images/screenshots/StokPratik_piyasa_ekrani.png",
    alt: "Stok Pratik Piyasa Radarı Canlı Finans Ekranı",
    title: "Piyasa Radarı & Canlı Finans",
    description: "Ekran değiştirmeden anlık döviz kurları, TCMB verileri, altın, emtia ve brent petrol fiyatlarını canlı takip edin.",
    features: [
      "USD, EUR, GBP serbest piyasa ve TCMB kurları",
      "Gram, Çeyrek, Ons altın ve Brent Petrol fiyatları",
      "Maliyet ve dövizli faturalandırmada anlık kur güvencesi"
    ]
  },
  {
    id: 4,
    category: "ticaret",
    categoryLabel: "Ticaret & Satış",
    badgeColor: "bg-blue-50 text-blue-700 border-blue-200",
    src: "/images/screenshots/StokPratik_Temel_Ticaret.png",
    alt: "Stok Pratik Temel Ticaret Satış Alış ve Fatura Modülü",
    title: "Temel Ticaret (Alış, Satış, Stok, Kasa)",
    description: "Satış faturaları, tedarikçi alışları, irsaliye yönetimi, şube transferleri ve barkodlu kasa satışının merkezi kalbi.",
    features: [
      "Hızlı barkodlu perakende ve toptan satış kasası",
      "Tek tıkla GİB onaylı e-Fatura / e-Arşiv faturaya dönüştürme",
      "Merkezi kasa, şube kasaları ve tahsilat mutabakatları"
    ]
  },
  {
    id: 5,
    category: "ticaret",
    categoryLabel: "Ödeme & Tahsilat",
    badgeColor: "bg-emerald-50 text-emerald-700 border-emerald-200",
    src: "/images/screenshots/StokPratik_odeme_Kuruluslari.png",
    alt: "Stok Pratik Ödeme Kuruluşları ve Sanal POS Entegrasyonları",
    title: "Ödeme Kuruluşları & Sanal POS",
    description: "iyzico, PayTR, Param, N Kolay ve banka sanal POS'ları ile tek çekim veya taksitli tahsilat entegrasyonu.",
    features: [
      "Müşteriye SMS ve WhatsApp ile güvenli ödeme linki iletme",
      "3D Secure altyapısıyla güvenli ve hızlı tahsilat",
      "Tahsilat tamamlandığı anda cari bakiyenin otomatik düşmesi"
    ]
  },
  {
    id: 6,
    category: "finans",
    categoryLabel: "Finans & Muhasebe",
    badgeColor: "bg-purple-50 text-purple-700 border-purple-200",
    src: "/images/screenshots/StokPratik_Finans_Yonetimi.png",
    alt: "Stok Pratik Finans Yönetimi ve Masraf Takip Ekranı",
    title: "Finans Yönetimi & Gider Takibi (AI Destekli OCR)",
    description: "Kasa, banka, çek/senet portföyü, amortisman ve cep telefonu kamerasıyla fiş okuyan yapay zekalı gider işleme.",
    features: [
      "Kamera ile çekilen fişlerin yapay zeka ile otomatik matrah/KDV kaydı",
      "Çek ve senet portföyü vade takvimi ve alarm sistemi",
      "Brüt kâr, net kâr ve şube bazında gerçek kârlılık analizi"
    ]
  },
  {
    id: 7,
    category: "finans",
    categoryLabel: "e-Dönüşüm",
