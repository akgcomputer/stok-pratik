    <!-- Sektörel Çözümler -->
    <div class="footer-useful-links" style="margin-top: 0; padding-top: 0; border-top: none;">
      <h4>Sektörel Çözümler</h4>
      <ul class="footer-links random-links">
        <li><a href="/e-ticaret-pazaryeri-entegrasyonu" title="Pazaryeri Entegrasyonu">Pazaryeri Entegrasyonu</a></li>
        <li><a href="/b2b-toptan-satis-sistemi" title="B2B Toptan Satış Portalı">B2B Toptan Satış Portalı</a></li>
