<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.6);
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(251, 191, 36, 0.4);
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(251, 191, 36, 0.7);
  }
</style>

<script>
  function setupSocialGallery() {
    const gallery = document.querySelector('.social-feed-gallery');
    if (!gallery) return;

    // Filters
    const filterTabs = gallery.querySelectorAll('.filter-tab');
    const cards = gallery.querySelectorAll('.post-card');
    const loadMoreBtn = document.getElementById('btnLoadMore');
    const loadMoreContainer = document.getElementById('loadMoreContainer');
    const initialLimit = parseInt(gallery.getAttribute('data-initial-limit') || '6', 10);

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        
        filterTabs.forEach(t => {
          t.classList.remove('active', 'bg-amber-400', 'text-slate-950', 'shadow-md', 'shadow-amber-400/20');
          t.classList.add('bg-slate-900', 'border', 'border-slate-800', 'text-slate-300');
        });

        tab.classList.add('active', 'bg-amber-400', 'text-slate-950', 'shadow-md', 'shadow-amber-400/20');
        tab.classList.remove('bg-slate-900', 'border', 'border-slate-800', 'text-slate-300');

        let visibleCount = 0;
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide load more when filtered
        if (loadMoreContainer) {
          if (filter === 'all') {
            loadMoreContainer.style.display = 'block';
          } else {
            loadMoreContainer.style.display = 'none';
          }
        }
      });
    });

    // Load More
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const hiddenCards = gallery.querySelectorAll('.post-card.overflow-item');
        hiddenCards.forEach(card => {
          card.classList.remove('hidden', 'overflow-item');
        });
        if (loadMoreContainer) {
          loadMoreContainer.style.display = 'none';
        }
      });
    }

    // Lightbox Modal
    const modal = document.getElementById('socialModal');
    const modalContainer = document.getElementById('modalContainer');
    const btnClose = document.getElementById('btnModalClose');
    const btnCloseAlt = document.getElementById('btnModalCloseAlt');
    const modalIframe = document.getElementById('modalIframe') as HTMLIFrameElement;
    const modalImageBox = document.getElementById('modalImageBox');
    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalLoading = document.getElementById('modalLoading');
    const modalTitle = document.getElementById('modalTitle');
    const modalBadge = document.getElementById('modalBadge');
    const modalCaption = document.getElementById('modalCaption');
    const modalInstagramLink = document.getElementById('modalInstagramLink') as HTMLAnchorElement;

    function openModal(card: Element) {
      if (!modal || !modalContainer) return;

      const shortcode = card.getAttribute('data-shortcode') || '';
      const permalink = card.getAttribute('data-permalink') || 'https://www.instagram.com/stokpratik/';
      const title = card.getAttribute('data-title') || '';
      const badge = card.getAttribute('data-badge') || 'Reels';
      const caption = decodeURIComponent(card.getAttribute('data-caption') || '');
      const thumbnail = card.getAttribute('data-thumbnail') || '';
      const category = card.getAttribute('data-category');

      if (modalTitle) modalTitle.textContent = title;
      if (modalBadge) modalBadge.textContent = badge;
      if (modalCaption) modalCaption.textContent = caption;
      if (modalInstagramLink) modalInstagramLink.href = permalink;

      if (modalLoading) modalLoading.style.display = 'flex';

      if (category === 'video' && shortcode) {
        if (modalImageBox) modalImageBox.classList.add('hidden');
        if (modalIframe) {
          modalIframe.classList.remove('hidden');
          // Instagram reel embed URL
          modalIframe.src = `https://www.instagram.com/reel/${shortcode}/embed/`;
          modalIframe.onload = () => {
            if (modalLoading) modalLoading.style.display = 'none';
          };
        }
      } else {
        // Fallback or Image post
        if (modalIframe) {
          modalIframe.src = '';
          modalIframe.classList.add('hidden');
        }
        if (modalImageBox && modalImg) {
          modalImageBox.classList.remove('hidden');
          modalImg.src = thumbnail;
          if (modalLoading) modalLoading.style.display = 'none';
        }
      }

      // Show modal
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalContainer.classList.remove('scale-95');
      modalContainer.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !modalContainer) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalContainer.classList.remove('scale-100');
      modalContainer.classList.add('scale-95');
      if (modalIframe) {
        modalIframe.src = ''; // Stops audio / video immediately
      }
      document.body.style.overflow = '';
    }

    // Attach click to cards
    cards.forEach(card => {
      card.addEventListener('click', () => openModal(card));
    });

    // Close listeners
    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (btnCloseAlt) btnCloseAlt.addEventListener('click', closeModal);
    
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  // Init on DOM ready and Astro page swaps
  document.addEventListener('DOMContentLoaded', setupSocialGallery);
  document.addEventListener('astro:page-load', setupSocialGallery);
</script>
