---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Plaka Sicil Oto Servis, Yedek Parça ve Araç Geçmişi Yazılımı | Stok Pratik";
const pageDescription = "Plakayı yazın, aracın tüm servis ve parça geçmişi 1 saniyede açılsın! Lifteki araç iş emri, yedek parça stok düşümü, usta primi ve 10.000 km bakım hatırlatıcı tek ekranda.";

const servicePowers = [
  {
    icon: "🪪",
    title: "Plaka & Şasi No (VIN) Bazlı Ömür Boyu Araç Hafızası",
    desc: "Araç el değiştirse bile plakası veya şasi numarası üzerinden yapılan tüm mekanik, elektrik, periyodik bakım kayıtları, değişen parçalar ve kilometre geçmişi tarih sırasıyla elinizin altındadır."
  },
  {
    icon: "🔧",
    title: "Dijital İş Emri & Lift / Usta Performans Takibi",
    desc: "Araç kabulden lifte, parça onayından test sürüşüne kadar 5 adımlı servis sürecini canlı yönetin. Hangi ustanın hangi araçta çalıştığını ve işçilik primini kuruşu kuruşuna hesaplayın."
  },
  {
    icon: "⚙️",
    title: "Yedek Parça Deposu + İşçilik Otomatik Entegrasyonu",
    desc: "İş emrine eklenen motor yağı, filtre, balata veya akü yedek parça deponuzdan anında düşer. Maliyet Koruma Kilidi sayesinde parçanın alış maliyetinin altına inilmesini sistem otomatik engeller."
  },
  {
    icon: "📱",
    title: "WhatsApp'tan Onay & Kredi Kartıyla Linkle Tahsilat",
    desc: "Değişecek parçaların fiyat listesini araç sahibine tek tıkla WhatsApp'tan gönderip onay alın. Tamir bittiğinde 'Linkle Öde' üzerinden kredi kartına taksitle servis ücretini tahsil edin."
  },
  {
    icon: "🔔",
    title: "10.000 KM Periyodik Bakım & TÜVTÜRK Muayene Radarı",
    desc: "Aracın bir sonraki yağ değişimi (10.000 km / 1 yıl), fren kontrolü veya TÜVTÜRK muayene tarihi yaklaştığında müşteriyi servisinize geri getiren otomatik hatırlatma listeleri üretir."
  },
  {
    icon: "🌐",
    title: "Ulusal Plaka Sicil Ekosistem Güveni",
    desc: "Kayıt altına alınan şeffaf bakım geçmişi ile hem servisinizin kurumsal değerini ve müşteri sadakatini artırın hem de aracın ikinci el değerini tescilleyin."
  }
];

const faqs = [
  {
    q: "Müşteri ilk kez geldiğinde araç bilgilerini nasıl kaydediyoruz?",
    a: "Sadece araç plakasını yazarak marka, model, model yılı, şasi (VIN) no, motor no ve güncel kilometreyi saniyeler içinde kaydedebilirsiniz. Sonraki tüm gelişlerde sadece plakayı yazmanız yeterlidir."
  },
  {
    q: "Kullanılan motor yağı ve yedek parçalar stoktan otomatik düşer mi?",
    a: "Evet. Örneğin '5W-30 Motor Yağı (4 Litre)' ve 'Yağ Filtresi' iş emrine eklendiği an depodaki stok adediniz ve litre miktarınız anında güncellenir; parça maliyeti iş emrine işlenir."
  },
  {
    q: "Müşteriye resmi A4 Servis İş Emri ve Fatura çıktısı verebilir miyiz?",
    a: "Kesinlikle! Girişte araç kabul tutanağı, çıkışta ise yapılan işçilikler ve takılan parçaları detaylı gösteren kurumsal logolu Servis Fişi, e-Fatura veya e-Arşiv faturası tek tıkla basılabilir."
  },
  {
    q: "Farklı ustaların işçilik primlerini ayrı ayrı takip edebilir miyiz?",
    a: "Evet. İş emrindeki mekanik işçiliği Mehmet Usta'ya, elektrik işçiliğini Ali Usta'ya atayabilirsiniz. Sistem ay sonunda her ustanın yaptığı toplam işçilik cirosunu ve hak ettiği prim tutarını otomatik hesaplar."
  },
  {
    q: "Oto ekspertiz ve kaporta/boya atölyeleri için uygun mudur?",
    a: "Evet. Kaporta-boya atölyeleri, rot-balans ve lastikçiler, oto elektrik/klima servisleri ve oto ekspertiz merkezleri için parça, boya, işçilik ve görsel ekspertiz notlarıyla %100 uyumludur."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-orange-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-orange-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-orange-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-orange-400 animate-pulse"></span>
              🚗 Plaka Sicil Oto Servis Ekosistemi • İş Emri, Parça & Bakım Geçmişi
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Plakayı Yazın, <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-200">
                Tüm Araç Bakım Geçmişi 1 Saniyede Açılsın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              "Bu araca geçen gelişinde hangi yağı koymuştuk, triger ne zaman değişti?" Kağıt iş emirlerini unutun. Plakayı girin; aracın tüm kilometre, parça ve işçilik geçmişini görün, parçaları stoktan otomatik düşüp faturasını saniyeler içinde kesin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-orange-600 via-orange-500 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white font-bold text-base shadow-lg shadow-orange-600/30 hover:scale-[1.02] transition-all text-center"
              >
                🚗 Oto Servisinizi Ücretsiz Başlatın
              </a>
              <a 
                href="#plaka-sorgu" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>🔍 Canlı Plaka Sorgulama Ekranı</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Şasi (VIN) Hafızası</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Parça Depo Entegre</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> WhatsApp Onay & Linkle Öde</span>
            </div>
          </div>

          <!-- Sağ: Canlı TR Plaka Çerçevesi & Lifteki Araç İş Emri Mockup'ı -->
          <div class="lg:col-span-7" id="plaka-sorgu">
            <div class="bg-slate-900/90 rounded-2xl border border-orange-500/30 p-5 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-orange-500 via-amber-500 to-blue-600"></div>

              <!-- Gerçekçi TR Plaka Çubuğu -->
              <div class="mb-4">
                <div class="inline-flex items-center bg-white rounded-lg border-2 border-slate-900 px-3 py-1.5 shadow-md">
                  <div class="bg-[#003399] text-white px-2 py-0.5 rounded text-[10px] font-bold flex flex-col items-center justify-center mr-3">
                    <span class="text-[8px] leading-tight">🇹🇷</span>
                    <span>TR</span>
                  </div>
                  <span class="font-mono text-xl sm:text-2xl font-black text-slate-950 tracking-wider">34 SP 2026</span>
                </div>
                <span class="text-xs text-slate-400 ml-3 font-mono">Volkswagen Passat 1.5 TSI B8.5 (2022)</span>
              </div>

              <!-- İş Emri Kartı & Lift Durumu -->
              <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
                
                <!-- Sol Kolon: Araç Kimlik & Kilometre -->
                <div class="md:col-span-5 bg-slate-950 p-3.5 rounded-xl border border-slate-800 text-xs space-y-2">
                  <div class="text-[11px] font-bold text-orange-400 uppercase tracking-wider flex items-center justify-between">
                    <span>📋 ARAÇ SİCİL BİLGİSİ</span>
                    <span class="text-emerald-400 font-mono">Kayıtlı</span>
                  </div>
                  <div>
                    <div class="text-[10px] text-slate-500">Şasi No (VIN):</div>
                    <div class="font-mono text-slate-200 font-bold">WVWZZZ3CZNE098***</div>
                  </div>
                  <div>
                    <div class="text-[10px] text-slate-500">Mevcut Kilometre:</div>
                    <div class="font-mono text-white font-black text-sm">84.520 KM</div>
                  </div>
                  <div>
                    <div class="text-[10px] text-slate-500">Bir Sonraki Bakım:</div>
                    <div class="font-mono text-amber-300 font-bold">95.000 KM / 1 Yıl</div>
                  </div>
                  <div class="pt-1.5 border-t border-slate-800 text-[10px] text-slate-400">
                    Müşteri: Mehmet Demir • 0532 *** 45 10
                  </div>
                </div>

                <!-- Sağ Kolon: Lifteki İş Emri & Takılan Parçalar -->
                <div class="md:col-span-7 bg-slate-950 p-3.5 rounded-xl border border-slate-800 text-xs flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between pb-1.5 border-b border-slate-800 mb-2">
                      <span class="font-bold text-white flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
                        Lift #2 • İş Emri #IE-4192
                      </span>
                      <span class="text-[10px] bg-orange-500/20 text-orange-300 px-2 py-0.5 rounded font-mono">Usta: Murat U.</span>
                    </div>

                    <!-- Parça & İşçilik Kalemleri -->
                    <div class="space-y-1.5 text-[11px]">
                      <div class="flex justify-between items-center text-slate-300">
                        <span>• Castrol Edge 5W-30 (4 Litre)</span>
                        <span class="text-slate-400 font-mono">Depodan -4L</span>
                      </div>
                      <div class="flex justify-between items-center text-slate-300">
                        <span>• Mann Yağ & Hava Filtre Seti</span>
                        <span class="text-slate-400 font-mono">Depodan -1 Set</span>
                      </div>
                      <div class="flex justify-between items-center text-slate-300">
                        <span>• Ferodo Ön Fren Balatası</span>
                        <span class="text-slate-400 font-mono">Depodan -1 Tk</span>
                      </div>
                      <div class="flex justify-between items-center text-slate-300">
                        <span>• Periyodik Bakım & Balata İşçiliği</span>
                        <span class="text-emerald-400 font-mono">+1.250 ₺ Prim</span>
                      </div>
                    </div>
                  </div>

                  <!-- Tutar & Aksiyon -->
                  <div class="pt-2 border-t border-slate-800 mt-2 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] text-slate-400">Toplam İş Emri:</div>
                      <div class="text-sm font-black text-emerald-400 font-mono">4.850 ₺</div>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="px-2 py-1 rounded bg-slate-800 text-slate-200 text-[10px] cursor-pointer">WhatsApp Onay</span>
                      <span class="px-2 py-1 rounded bg-orange-600 text-white font-bold text-[10px] cursor-pointer">Tek Tık Fatura</span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Alt Hatırlatıcı Bildirim Çubuğu -->
              <div class="p-2.5 bg-orange-950/20 rounded-lg border border-orange-500/20 text-xs text-orange-200/90 flex items-center justify-between">
                <span class="flex items-center gap-2">
                  <span>🔔</span>
                  <strong>Otomatik Bakım Radarı:</strong> Son 1 yılda bakım yaptırmayan 34 kayıtlı araca periyodik bakım hatırlatması SMS'i hazırlandı.
                </span>
                <span class="text-[10px] bg-orange-500/20 text-orange-300 px-2 py-0.5 rounded font-mono shrink-0">Aktif</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. PLAKA SİCİL 6 SÜPER GÜÇ -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-orange-400 font-bold mb-3">Tam Donanımlı Oto Servis ERP</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Plaka Sicil'in Servisinize Kazandırdığı 6 Büyük Avantaj</h3>
          <p class="text-slate-400 mt-4 text-base">
            Oto tamirhaneleri, özel servisler, lastik ve ekspertiz merkezleri için tasarlanan uçtan uca dijital dönüşüm.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicePowers.map((power, index) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-orange-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center text-2xl mb-4">
                  {power.icon}
                </div>
                <div class="text-xs font-mono text-orange-400 font-bold mb-1">YETENEK 0{index + 1}</div>
                <h4 class="text-lg font-bold text-white mb-2">{power.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{power.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-orange-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">Plaka Sicil Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-orange-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-orange-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-orange-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-orange-500/20 border border-orange-500/40 text-orange-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🚗
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Sanayinin En Modern ve Güvenilir Oto Servisi Siz Olun! <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-200">
              Plaka Sicil ile İşinizi Büyütün.
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Hemen ücretsiz Stok Pratik Plaka Sicil hesabınızı açın; lifteki araçlarınızı, yedek parçalarınızı ve usta primlerinizi dakikalar içinde dijitalleştirin.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-orange-600 via-orange-500 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white font-bold text-lg shadow-xl shadow-orange-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 Hemen Ücretsiz Kullanmaya Başla
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • 1 dakikada şirket hesabı açın • Sanayi yazıcılarıyla %100 uyumlu</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik Plaka Sicil Oto Servis ve Yedek Parça Yazılımı",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
