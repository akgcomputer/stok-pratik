---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Masraf-Gir | Fişten Yevmiyeye Sıfır Hata | Stok Pratik";
const pageDescription = "Personelin sahada fişi çektiği saniyeden, mali müşavirin yevmiye defterine kaydettiği ana kadar tüm süreci Yapay Zeka ile dijitalleştirin.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- BÖLÜM 1: Çarpıcı Hero Alanı -->
  <section class="relative bg-white pt-24 pb-20 overflow-hidden border-b border-slate-200">
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-red-50 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-slate-50 rounded-full blur-3xl opacity-70 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 text-slate-800 font-semibold text-sm mb-8 border border-slate-200 shadow-sm transition-transform hover:scale-105">
        <span class="text-amber-500 text-lg">⚡</span> 
        Ay Sonu Masraf Çilesine ve Kayıp Fişlere Son!
      </div>
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6 max-w-5xl mx-auto">
        Buruşmuş Fişler, Silinmiş Yazılar ve Kayıp Faturalar Tarihe Karışıyor: <span class="text-red-600 block mt-2">Masraf-Gir ile Fişten Yevmiyeye Sıfır Hata.</span>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-600 max-w-3xl mx-auto mb-10 leading-relaxed">
        Personelin sahada fişi çektiği saniyeden, mali müşavirin yevmiye defterine kaydettiği ana kadar tüm süreci Yapay Zeka ile dijitalleştirin. 
        <strong class="block mt-3 font-semibold text-slate-800 text-xl">"Fişi cebine at, ay sonu getir" devri bitti.</strong>
      </p>
      
      <div class="mb-14">
        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-6">Desteklenen Muhasebe ve ERP Yazılımları</h3>
        <div class="flex flex-wrap justify-center items-center gap-2.5 max-w-6xl mx-auto">
          <span class="bg-red-600 text-white border border-red-700 px-4 py-2 rounded-full text-sm font-extrabold shadow-md transform transition-transform hover:scale-105 z-10">Stok Pratik ERP</span>
          
          {['Logo Yazılım', 'Mikro Yazılım', 'Zirve Bilgisayar', 'Luca', 'Paraşüt', 'Akınsoft', 'DİA Yazılım', 'ETA Bilgisayar', 'Nebim', 'Uyumsoft', 'Bizim Hesap', 'KolayBi\'', 'Logo İşbaşı', 'Vega Yazılım', 'Orka Bilgisayar', 'Datasoft', 'Canias ERP', 'Workcube ERP', 'SAP Business One', 'Microsoft Dynamics 365', 'Oracle NetSuite', 'Odoo ERP', 'GMS.NET', 'MikroX', 'BizMu', 'CPM Master ERP', 'İnpos', 'Bayt Yazılım', 'Demsoft', 'Sentez', 'Vento', 'Noyax', 'Minerva', 'IFS', 'Fenesoft', 'BilSoft', 'Karel', 'Aymet', 'Prosoft', 'CetaSoft', 'Pikademi', 'Axasoft', 'Yaylasoft', 'Netadam', 'Atia', 'Timecom', 'Vera ERP', 'Basecom', 'Asyasoft', 'Senkron ERP'].map((software, index) => {
            const colors = [
              'bg-blue-50 text-blue-700 border-blue-200',
              'bg-emerald-50 text-emerald-700 border-emerald-200',
              'bg-amber-50 text-amber-700 border-amber-200',
              'bg-purple-50 text-purple-700 border-purple-200',
              'bg-pink-50 text-pink-700 border-pink-200',
              'bg-indigo-50 text-indigo-700 border-indigo-200',
              'bg-teal-50 text-teal-700 border-teal-200',
              'bg-cyan-50 text-cyan-700 border-cyan-200',
              'bg-orange-50 text-orange-700 border-orange-200',
              'bg-fuchsia-50 text-fuchsia-700 border-fuchsia-200'
            ];
            
            let colorClass = '';
            if (software.includes('Logo')) colorClass = 'bg-rose-50 text-rose-800 border-rose-200';
            else if (software.includes('Mikro')) colorClass = 'bg-slate-100 text-slate-800 border-slate-300';
            else if (software.includes('Uyum')) colorClass = 'bg-indigo-50 text-indigo-800 border-indigo-200'; // Soft lacivert
            else colorClass = colors[index % colors.length];

            return (
              <span class={`border px-3.5 py-1.5 rounded-full text-xs font-semibold shadow-sm transition-all hover:scale-105 ${colorClass}`}>
                {software}
              </span>
            );
          })}
          
          <span class="bg-slate-900 text-white border border-slate-800 px-3.5 py-1.5 rounded-full text-xs font-bold shadow-md transform transition-transform hover:scale-105">
            + ve Dahası
          </span>
        </div>
        
        <p class="text-sm text-slate-500 max-w-2xl mx-auto mt-6 italic text-center">
          <span class="font-semibold text-slate-600">Bilgi Notu:</span> İşletmenizde kullandığınız program listede yer almasa dahi, Excel/CSV aktarımını destekleyen tüm yazılımlar Masraf Gir ile doğrudan uyumludur.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-16">
        <a href="https://masrafgir.stokpratik.com.tr/login" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl shadow-lg shadow-red-600/30 transition-all text-lg flex items-center justify-center gap-2">
          15 Gün Ücretsiz Dene / Demo
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
        <a href="/iletisim" class="w-full sm:w-auto px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl shadow-lg transition-all text-lg flex items-center justify-center gap-2">
          Mali Müşavirlere Özel Paketler
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>

      <div class="relative w-full max-w-5xl mx-auto h-auto md:h-96 rounded-2xl bg-gradient-to-tr from-slate-900 to-slate-800 shadow-2xl p-4 md:p-8 flex flex-col md:flex-row gap-6 overflow-hidden transform perspective-1000">
        <!-- Mobil Fiş Ekranı -->
        <div class="md:w-1/3 bg-slate-50 rounded-xl p-4 border border-slate-700/50 shadow-inner flex flex-col transform md:-rotate-2 transition-transform hover:rotate-0">
          <div class="w-full bg-white rounded-lg p-3 shadow-sm mb-3">
            <div class="w-full h-24 bg-slate-200 animate-pulse rounded flex items-center justify-center text-slate-400 text-xs">📸 Fiş Fotoğrafı Taranıyor...</div>
          </div>
          <div class="space-y-2">
            <div class="h-3 w-3/4 bg-red-100 rounded"></div>
            <div class="h-3 w-1/2 bg-slate-200 rounded"></div>
            <div class="h-3 w-full bg-slate-200 rounded"></div>
          </div>
          <div class="mt-auto pt-4 border-t border-slate-200 flex justify-between items-center">
            <span class="text-xs font-bold text-slate-500">KDV: %1, %20</span>
            <span class="bg-emerald-100 text-emerald-700 px-2 py-1 rounded text-xs font-bold">Onay Bekliyor</span>
          </div>
        </div>
        
        <!-- Muhasebe Zebra Yevmiye Ekranı -->
        <div class="md:w-2/3 bg-white rounded-xl border border-slate-200 shadow-xl overflow-hidden flex flex-col transform md:rotate-1 transition-transform hover:rotate-0">
          <div class="bg-slate-100 border-b border-slate-200 p-2 flex gap-2 items-center">
            <div class="w-3 h-3 rounded-full bg-red-400"></div><div class="w-3 h-3 rounded-full bg-amber-400"></div><div class="w-3 h-3 rounded-full bg-emerald-400"></div>
            <span class="text-xs text-slate-500 font-semibold ml-2">Yevmiye Onay & Dışa Aktarım Exceli</span>
          </div>
          <div class="p-4 flex-1 text-xs font-mono">
            <div class="grid grid-cols-4 gap-2 bg-slate-50 p-2 border-b border-slate-100 text-slate-500 font-bold">
              <span>Hesap Kodu</span><span>Açıklama</span><span class="text-right">Borç</span><span class="text-right">Alacak</span>
            </div>
            <div class="grid grid-cols-4 gap-2 bg-white p-2 border-b border-slate-50">
              <span class="text-red-600">770.01.003</span><span>Market Gideri</span><span class="text-right">500,00</span><span class="text-right"></span>
            </div>
            <div class="grid grid-cols-4 gap-2 bg-white p-2 border-b border-slate-100">
              <span class="text-red-600">191.01</span><span>İnd. KDV %1</span><span class="text-right">5,00</span><span class="text-right"></span>
            </div>
            <div class="grid grid-cols-4 gap-2 bg-slate-50 p-2 border-b border-slate-50">
              <span class="text-red-600">770.07.001</span><span>Temizlik Malz.</span><span class="text-right">625,00</span><span class="text-right"></span>
            </div>
            <div class="grid grid-cols-4 gap-2 bg-slate-50 p-2 border-b border-slate-100">
              <span class="text-red-600">191.20</span><span>İnd. KDV %20</span><span class="text-right">125,00</span><span class="text-right"></span>
            </div>
            <div class="grid grid-cols-4 gap-2 bg-emerald-50 p-2 font-bold">
              <span class="text-slate-800">300.01</span><span>Kredi Kartları</span><span class="text-right"></span><span class="text-right text-emerald-700">1.250,00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BÖLÜM 2: Ay Sonu Kaosuna Karşı "2 Temel Güç" -->
  <section class="py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Ay Sonu Kaosuna Karşı <span class="text-red-600">"2 Temel Güç"</span></h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">Sahadaki personelin işini saniyelere, ofisteki muhasebecinin işini tek tıka indiriyoruz.</p>
      </div>
      
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="bg-white p-8 md:p-10 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 relative overflow-hidden group hover:border-red-200 transition-colors">
          <div class="absolute top-0 right-0 w-32 h-32 bg-red-50 rounded-bl-full -mr-16 -mt-16 transition-transform group-hover:scale-110"></div>
          <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mb-6 relative z-10 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-2 relative z-10">1. Personel İçin Akıllı Masraf Girişi</h3>
          <p class="text-red-600 font-bold mb-8 uppercase text-xs tracking-wider relative z-10 bg-red-50 inline-block px-3 py-1 rounded-full">Saniyeler Süren İşlem</p>
          <ul class="space-y-6 relative z-10">
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5"><span class="text-emerald-600 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Yapay Zeka (AI) Asistanı:</strong> Personel sadece fotoğrafı çeker. Tarih, Satıcı Ünvanı, Toplam Tutar ve KDV oranları otomatik taranır.</p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5"><span class="text-emerald-600 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Bulut Dijital Arşiv:</strong> Termal fişlerin silinme derdi bitti. Güvenli bulutta yıllarca saklanan orijinal fiş görüntüsü tek tıkla ekranda.</p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5"><span class="text-emerald-600 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Devrim Yaratan "Çoklu KDV" Ayrıştırıcısı:</strong> Bir market fişindeki hem %1 (Gıda) hem %20 (Temizlik) KDV'yi tek ekranda satır satır böler.</p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5"><span class="text-emerald-600 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Hızlı Kategori & Ödeme Tipi:</strong> Harcama nedeni ve ödeme yöntemi anında seçilir, saniyesinde onaya düşer.</p>
            </li>
          </ul>
        </div>
        <div class="bg-white p-8 md:p-10 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 relative overflow-hidden group hover:border-slate-300 transition-colors">
          <div class="absolute top-0 right-0 w-32 h-32 bg-slate-100 rounded-bl-full -mr-16 -mt-16 transition-transform group-hover:scale-110"></div>
          <div class="w-14 h-14 bg-slate-900 text-white rounded-2xl flex items-center justify-center mb-6 relative z-10 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-2 relative z-10">2. Muhasebe Onay ve Otomasyon Paneli</h3>
          <p class="text-slate-700 font-bold mb-8 uppercase text-xs tracking-wider relative z-10 bg-slate-100 inline-block px-3 py-1 rounded-full">Tek Tıkla Yevmiye</p>
          <ul class="space-y-6 relative z-10">
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center mt-0.5"><span class="text-slate-700 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Tek Ekrandan Denetim:</strong> Orijinal fiş görüntüsü ile girilen veriler yan yana kıyaslanır; tek tıkla Onayla / Reddet.</p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center mt-0.5"><span class="text-slate-700 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">"Yevmiyeye Hazır" Akıllı Çıktı:</strong> Logo, Zirve, Mikro vb. programlara doğrudan yüklenebilir format.</p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center mt-0.5"><span class="text-slate-700 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Dinamik Hesap Kodları:</strong> Seçilen kategoriye göre 770/760 kodları otomatik atanır.</p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center mt-0.5"><span class="text-slate-700 text-sm font-bold">✓</span></div>
              <p class="text-slate-700 leading-relaxed"><strong class="text-slate-900">Kusursuz KDV & Zebra Tasarım:</strong> Matrahlar ayrı, vergiler ayrı satırlara yazılır. Fişler zebra renklerle gruplanarak göz yorgunluğunu sıfırlar.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BÖLÜM 3: Mali Müşavir Detayları -->
  <section class="py-24 bg-white border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Mali Müşavirlerin Hayatını Kurtaran 2 Detay</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">Karmaşık KDV hesaplamaları ve hesap kodu eşleştirmeleri artık tamamen otomatik.</p>
      </div>

      <div class="space-y-12">
        <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6 md:p-10 shadow-sm">
          <div class="flex items-center gap-4 mb-8 border-b border-slate-200 pb-6">
            <span class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xl">1</span>
            <h3 class="text-2xl md:text-3xl font-bold text-slate-900">Tekdüzen Hesap Planına Tam Uyumlu 770 & 760 Gider Motoru</h3>
          </div>
          <p class="text-slate-700 mb-8 text-lg">Sistem içindeki tüm kategoriler arka planda resmi hesap kodlarıyla çalışır.</p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6 text-sm">
            <div class="space-y-3">
              <h4 class="font-bold text-slate-900 border-b border-slate-200 pb-2">Taşıt & Ulaşım</h4>
              <ul class="space-y-1.5 text-slate-600">
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.05.001</span> Akaryakıt</li>
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.05.002</span> Şehir İçi Ulaşım/Taksi</li>
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.05.003</span> Otopark</li>
              </ul>
            </div>
            <div class="space-y-3">
              <h4 class="font-bold text-slate-900 border-b border-slate-200 pb-2">Mutfak & Temsil</h4>
              <ul class="space-y-1.5 text-slate-600">
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.01.001</span> Ofis Mutfak/Gıda</li>
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.01.003</span> Market</li>
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.03.001</span> Müşteri Yemek/Ağırlama</li>
              </ul>
            </div>
            <div class="space-y-3">
              <h4 class="font-bold text-slate-900 border-b border-slate-200 pb-2">Kırtasiye, Kargo & Bilişim</h4>
              <ul class="space-y-1.5 text-slate-600">
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.02.001</span> Kırtasiye Sarf</li>
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">770.08.004</span> SaaS Yazılım/Lisans</li>
                <li><span class="font-mono text-red-600 font-semibold bg-red-50 px-1 rounded">760.01.001</span> Google/Meta Reklamları</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="bg-white border-2 border-red-100 rounded-3xl p-6 md:p-10 shadow-lg shadow-red-50">
          <div class="flex items-center gap-4 mb-8 border-b border-red-100 pb-6">
            <span class="w-12 h-12 rounded-full bg-red-600 text-white flex items-center justify-center font-bold text-xl">2</span>
            <h3 class="text-2xl md:text-3xl font-bold text-slate-900">Kuruşu Kuruşuna Kapanış Sağlayan 8 Ödeme Türü & Alacak Bacağı</h3>
          </div>
          <p class="text-slate-700 mb-8 text-lg">Masrafın ödendiği yönteme göre yevmiye fişinin <strong class="text-slate-900">Alacak hesabı</strong> otomatik bağlanır.</p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200"><h4 class="font-bold text-slate-800 mb-1">Nakit Kasa</h4><span class="inline-block px-2 py-1 bg-white border border-slate-200 font-mono text-xs font-bold rounded">100.01</span></div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200"><h4 class="font-bold text-slate-800 mb-1">Şirket Kredi Kartı</h4><span class="inline-block px-2 py-1 bg-white border border-slate-200 font-mono text-xs font-bold rounded">300.01</span></div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200"><h4 class="font-bold text-slate-800 mb-1">Banka Hesabı</h4><span class="inline-block px-2 py-1 bg-white border border-slate-200 font-mono text-xs font-bold rounded">102.01 / 102.02</span></div>
            <div class="bg-red-50 p-4 rounded-xl border border-red-200 shadow-inner"><h4 class="font-bold text-red-800 mb-1">Personel Ödedi</h4><span class="inline-block px-2 py-1 bg-white border border-red-200 font-mono text-xs font-bold text-red-700 rounded">335.01.{`{ID}`}</span></div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200"><h4 class="font-bold text-slate-800 mb-1">İş Avansı</h4><span class="inline-block px-2 py-1 bg-white border border-slate-200 font-mono text-xs font-bold rounded">195.01.{`{ID}`}</span></div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200"><h4 class="font-bold text-slate-800 mb-1">Yemek Kartı</h4><span class="inline-block px-2 py-1 bg-white border border-slate-200 font-mono text-xs font-bold rounded">108.01</span></div>
