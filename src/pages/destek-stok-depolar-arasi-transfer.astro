            <span class="text-slate-400 font-medium hidden">Görsel Yeri: /images/destek/transfer-4.jpg</span>
          </div>
          <!-- Açıklama Alanı -->
          <div class="text-slate-600 text-lg leading-relaxed">
            <p>
              Yeni Transfer Oluştur Seçiyoruz
            </p>
          </div>
        </div>


        <!-- ADIM 5 -->
