---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "CRM: Satış Hunisi (Pipeline), Teklif ve Müşteri İlişkileri | Stok Pratik";
const pageDescription = "Verilen tekliflerin unutulmasına ve müşteri adaylarının kaçmasına son! Stok, fiyat, cari ve fatura entegre canlı Kanban satış hunisi ile her görüşmeyi ciroya dönüştürün.";

const pipelineStages = [
  {
    step: "1",
    title: "🎯 Yeni Aday (Lead)",
    count: "3 Aday",
    total: "145.000 ₺",
    color: "border-slate-700 bg-slate-900/80 text-slate-300",
    badge: "bg-slate-800 text-slate-300",
    leads: [
      { name: "Atlas Mimarlık", amount: "45.000 ₺", rep: "Zeynep K.", tag: "Web Formu", date: "Bugün 10:15" },
      { name: "Ege Ahşap Sanayi", amount: "100.000 ₺", rep: "Murat B.", tag: "Fuar İletişimi", date: "Dün" }
    ]
  },
  {
    step: "2",
    title: "📞 İlk Görüşme",
    count: "2 Fırsat",
    total: "180.000 ₺",
    color: "border-blue-500/40 bg-blue-950/20 text-blue-300",
    badge: "bg-blue-500/20 text-blue-400",
    leads: [
      { name: "Kuzey Lojistik A.Ş.", amount: "110.000 ₺", rep: "Zeynep K.", tag: "Online Demo Yapıldı", date: "Yarın 14:00 Aranacak" }
    ]
  },
  {
    step: "3",
    title: "📄 Teklif Verildi",
    count: "4 Fırsat",
    total: "420.000 ₺",
    color: "border-amber-500/40 bg-amber-950/20 text-amber-300",
    badge: "bg-amber-500/20 text-amber-400",
    leads: [
      { name: "Nova Tekstil Ltd.", amount: "185.000 ₺", rep: "Barış T.", tag: "Stok Rezerve Edildi", date: "Revizyon Gönderildi" }
    ]
  },
  {
    step: "4",
    title: "🤝 Pazarlık & Karar",
    count: "2 Fırsat",
    total: "290.000 ₺",
    color: "border-purple-500/40 bg-purple-950/20 text-purple-300",
    badge: "bg-purple-500/20 text-purple-400",
    leads: [
      { name: "Borusan Tedarik", amount: "210.000 ₺", rep: "Murat B.", tag: "Vade & İskonto", date: "Son Karar Aşaması" }
    ]
  },
  {
    step: "5",
    title: "🏆 Kazanıldı & Fatura",
    count: "Başarılı",
    total: "540.000 ₺",
    color: "border-emerald-500/40 bg-emerald-950/30 text-emerald-300",
    badge: "bg-emerald-500/20 text-emerald-400",
    leads: [
      { name: "Zirve Endüstri A.Ş.", amount: "320.000 ₺", rep: "Zeynep K.", tag: "⚡ Tek Tık Fatura Kesildi", date: "e-Arşiv Fatura No: 2841" }
    ]
  }
];

const crmDifferentiators = [
  {
    icon: "📋",
    title: "Gerçek Stok & Maliyet Kilitli Hızlı Teklif Hazırlama",
    desc: "Sıradan CRM'lerde satış temsilcisi kafasına göre ürün ve fiyat yazar. Stok Pratik CRM'de teklif hazırlarken deponuzdaki canlı stoğu görür ve Maliyet Koruma Kilidi sayesinde alış maliyetinin altına asla inemez."
  },
  {
    icon: "🔄",
    title: "'Kazanıldı' Olduğu Saniye Tek Tıkla Cari + İrsaliye + Fatura!",
    desc: "Müşteri teklifi onayladığında aynı bilgileri muhasebeye tekrar girmeye son! Tek tuşla aday 'Gerçek Müşteri Carisine' dönüşür, stok rezerve düşer ve e-Fatura / e-Arşiv saniyeler içinde resmileşir."
  },
  {
    icon: "📞",
    title: "Görüşme Geçmişi, Sesli/Yazılı Notlar ve Takip Hatırlatıcıları",
    desc: "Müşteriyle yapılan her görüşmeyi, WhatsApp notunu ve 'Cuma 14:30'da son karar için ara' hatırlatıcısını takvime işleyin. Temsilciniz işten ayrılsa bile tüm şirket hafızası sistemde kalır."
  },
  {
    icon: "👥",
    title: "Temsilci Performansı & Kayıp/Kazanç Analizi",
    desc: "Hangi temsilci kaç görüşme yaptı, tekliflerin yüzde kaçı ciroya döndü (Conversion Rate) ve kaybedilen fırsatlar neden kaçtı (Pahalı bulundu, stok yoktu, rakibe gitti vb.) şeffafça izleyin."
  },
  {
    icon: "📈",
    title: "RFM Müşteri Segmentasyonu & Geri Kazanım Radarı",
    desc: "Yalnızca yeni adayları değil; uzun süredir sipariş vermeyen 'Uyuyan / Kayıp Riskli' eski müşterileri otomatik tespit edin, satış ekibinize otomatik geri kazanım görevi atayın."
  }
];

const faqs = [
  {
    q: "Stok Pratik CRM'in diğer CRM yazılımlarından en temel farkı nedir?",
    a: "Geleneksel CRM yazılımları muhasebe ve depo programlarından tamamen kopuktur. Stok Pratik CRM'de ise ürün stoğu, alış maliyeti, cari hesap bakiyesi, teklif, irsaliye ve fatura aynı veri tabanında birleşir; teklif onaylandığı an tek tıkla faturalaşır."
  },
  {
    q: "Satış temsilcilerinin maliyetleri veya kâr marjlarını görmesi engellenebilir mi?",
    a: "Evet. Gelişmiş rol ve yetki yönetimiyle temsilcilerinizin sadece liste satış fiyatını görmesini, taban iskonto limitini aşamamasını ve şirket kâr marjını görmemesini sağlayabilirsiniz."
  },
  {
    q: "Verdiğimiz tekliflerin süresi dolduğunda veya müşteri vazgeçtiğinde ne olur?",
    a: "Teklif süresi bittiğinde sistem sizi uyarır. Fırsat kaybedildiğinde neden kaybedildiği (Fiyat yüksek, Rakibe gitti, İhtiyaç ertelendi vb.) seçilir ve bu veriler ilerleyen dönem stratejiniz için kayıp analiz raporlarına işlenir."
  },
  {
    q: "Müşteriye teklifi PDF olarak WhatsApp veya e-posta ile gönderebilir miyiz?",
    a: "Kesinlikle! Teklif onaylandığı anda kurumsal logonuz, banka IBAN bilgileriniz ve genel şartlarınızı içeren profesyonel PDF teklif mektubu üretilir; tek tıkla WhatsApp veya e-posta ile paylaşılabilir."
  },
  {
    q: "Birden fazla satış temsilcisi aynı müşteriye teklif verebilir mi?",
    a: "Her müşteri adayına bir 'Hesap Yöneticisi' atanır. Böylece temsilcilerin birbiriyle çakışması engellenir; yönetici dilerse fırsatı başka bir temsilciye devredebilir."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-rose-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-rose-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-rose-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
              🤝 Stok Pratik CRM • Satış Hunisi, Teklif & Müşteri Görüşmeleri
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Tekliflerin Unutulmasına Son: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-emerald-300">
                Her Görüşmeyi Satışa Dönüştürün!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              "Fiyat verdiğimiz müşteri ne dedi?", "Hangi temsilcinin elinde kaç liralık bekleyen teklif var?" Ajanda köşelerinde kaybolan notları unutun. Stok Pratik CRM ile adayları ilk temastan imzaya kadar Kanban panosunda izleyin; fırsat <strong>"Kazanıldı"</strong> olduğu saniyede tek tıkla <strong>Cari Kartı ve Satış Faturasını</strong> kesin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-rose-600 via-rose-500 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-base shadow-lg shadow-rose-600/30 hover:shadow-rose-600/50 hover:scale-[1.02] transition-all text-center"
              >
                🎯 Satış Hunisini Ücretsiz Deneyin
              </a>
              <a 
                href="#kanban-pipeline" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>📊 Canlı Kanban Simülatörü</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Canlı Stok & Maliyet Kilidi</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Tek Tık Faturaya Dönüşüm</span>
            </div>
          </div>

          <!-- Sağ: Canlı 5 Sütunlu Kanban Satış Hunisi Mockup'ı -->
          <div class="lg:col-span-7" id="kanban-pipeline">
            <div class="bg-slate-900/90 rounded-2xl border border-rose-500/30 p-5 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-rose-500 via-amber-500 to-emerald-500"></div>

              <!-- Üst Panel Barı -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-4 border-b border-slate-800 mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-rose-500 animate-ping"></div>
                  <h3 class="text-sm font-bold text-white font-mono">CANLI SATIŞ HUNİSİ (PIPELINE)</h3>
                </div>
                <div class="flex items-center gap-3 text-xs">
                  <span class="text-slate-400">Aktif Pipeline: <strong class="text-white font-mono">1.575.000 ₺</strong></span>
                  <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-bold border border-emerald-500/30">Kapanma: %72</span>
                </div>
              </div>

              <!-- 5 Sütunlu Kanban Akışı (Responsive kaydırma) -->
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-3">
                {pipelineStages.map((stage) => (
                  <div class={`rounded-xl border p-2.5 flex flex-col justify-between ${stage.color}`}>
                    <div>
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold truncate">{stage.title}</span>
                        <span class={`text-[9px] px-1.5 py-0.5 rounded font-mono ${stage.badge}`}>{stage.count}</span>
                      </div>
                      <div class="text-[10px] text-slate-400 mb-2 font-mono">{stage.total}</div>

                      <!-- Fırsat Kartları -->
                      <div class="space-y-2">
                        {stage.leads.map((lead) => (
                          <div class="bg-slate-950/90 rounded-lg p-2 border border-slate-800 shadow text-[11px] hover:border-slate-700 transition">
                            <div class="font-bold text-white truncate">{lead.name}</div>
                            <div class="text-rose-300 font-mono font-semibold text-[10px] my-0.5">{lead.amount}</div>
                            <div class="text-[9px] text-slate-400 flex items-center justify-between mt-1">
                              <span>👤 {lead.rep}</span>
                              <span class="text-slate-500">{lead.date}</span>
                            </div>
                            <div class="mt-1.5 pt-1 border-t border-slate-800 text-[9px] text-amber-400/90 font-medium truncate">
                              🏷️ {lead.tag}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <!-- Alt Hızlı Ekleme Butonu -->
                    <div class="mt-3 pt-2 border-t border-slate-800/80 text-center">
                      <span class="text-[10px] text-slate-400 hover:text-white cursor-pointer">+ Fırsat Ekle</span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Entegrasyon Çubuğu -->
              <div class="mt-4 p-3 bg-emerald-950/30 rounded-xl border border-emerald-500/30 text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-emerald-200">
                <span class="flex items-center gap-2">
                  <span class="text-emerald-400 text-sm">⚡</span>
                  <strong>Otomatik Entegrasyon:</strong> "Zirve Endüstri" fırsatı kazanıldı ➔ Cari Kart açıldı, e-Arşiv faturası kesildi ve stok rezerve çıkışı yapıldı!
                </span>
                <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded font-mono shrink-0">Tamamlandı ✓</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. STOK PRATİK CRM'İ AYIRAN 5 BÜYÜK FARK -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-rose-400 font-bold mb-3">Entegre ERP + CRM Üstünlüğü</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Stok Pratik CRM'i Kopuk CRM Yazılımlarından Ayıran 5 Büyük Fark</h3>
          <p class="text-slate-400 mt-4 text-base">
            Müşteri ilişkilerini muhasebeden ve depodan ayrı tutamazsınız. Stok Pratik, tekliften tahsilata kadar tüm satış ekosisteminizi tek ekranda birleştirir.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {crmDifferentiators.map((diff, index) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-rose-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center text-2xl mb-4">
                  {diff.icon}
                </div>
                <div class="text-xs font-mono text-rose-400 font-bold mb-1">0{index + 1}. AVANTAJ</div>
                <h4 class="text-lg font-bold text-white mb-2">{diff.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{diff.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-rose-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">CRM & Satış Hunisi Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-rose-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-rose-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-rose-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-rose-500/20 border border-rose-500/40 text-rose-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🎯
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Hiçbir Satış Fırsatının Masada Kalmasına İzin Vermeyin! <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-emerald-300">
              Stok Pratik CRM ile Ekibinizin Cirosunu Katlayın.
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Verilen teklifleri, müşteri toplantılarını ve satış kapama oranlarını tek merkezden izleyin; satış ekibinizin performansını zirveye taşıyın.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-rose-600 via-rose-500 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-lg shadow-xl shadow-rose-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 14 Gün Ücretsiz Başlayın
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • 1 dakikada kurun • Satış ekibiniz hemen kullanmaya başlasın</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik CRM ve Satış Hunisi Yönetimi",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
