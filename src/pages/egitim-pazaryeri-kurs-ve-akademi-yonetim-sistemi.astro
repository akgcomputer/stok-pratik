---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Eğitim Pazaryeri, Kurs ve Akademi Yönetim Sistemi | Stok Pratik";
const pageDescription = "Öğrenci kayıtlarını, taksit senetlerini, kitap stoklarını ve eğitmen ders saatlerini tek platformdan yönetin! Eğitim pazaryeri, QR-PDKS puantaj ve linkle online kayıt.";

const installmentPlan = [
  { no: "1. Taksit", amount: "3.500 ₺", date: "15 Eyl 2026", status: "Ödendi", badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30" },
  { no: "2. Taksit", amount: "3.500 ₺", date: "15 Eki 2026", status: "Ödendi", badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30" },
  { no: "3. Taksit", amount: "3.500 ₺", date: "15 Kas 2026", status: "Vadesi Geldi", badge: "bg-amber-500/20 text-amber-300 border-amber-500/30 font-bold animate-pulse" },
  { no: "4. Taksit", amount: "3.500 ₺", date: "15 Ara 2026", status: "Beklemede", badge: "bg-slate-800 text-slate-400 border-slate-700" }
];

const academyPowers = [
  {
    icon: "📜",
    title: "Öğrenci Sözleşmesi, Taksit & Senet Bordrosu",
    desc: "Kayıt olan öğrenci veya veli için 6, 9 veya 12 aylık taksit planı ve resmi senet bordrosu oluşturun. Vadesi gelen taksitler için veliye tek tıkla WhatsApp'tan 3D Secure kredi kartı ödeme linki gönderin."
  },
  {
    icon: "📚",
    title: "Eğitim Seti, Kitap & Üniforma Paket Stok Yönetimi",
    desc: "Kursa kaydolan öğrenciye verilen İngilizce kitap seti, soru bankası veya akademi üniformasını paket (bundle) ürün olarak tanımlayın; öğrenci kaydolduğu an kitap deponuzdan otomatik düşsün."
  },
  {
    icon: "👨‍🏫",
    title: "Eğitmen / Öğretmen Ders Saati & QR-PDKS Puantajı",
    desc: "Kadrolu ve saat ücretli (part-time) eğitmenlerin ders giriş-çıkışlarını 15 saniyede bir yenilenen kripto QR-PDKS ile tutun; ay sonunda kaç saat derse girdiğini ve hakediş bordrosunu tek tıkla hesaplayın."
  },
  {
    icon: "🌐",
    title: "Eğitim Pazaryeri Vitrini & Online Ön Kayıt",
    desc: "Kurumunuzun açtığı yeni dönem dil sınıflarını, yaz okullarını, sınav hazırlık kamplarını veya yüzme/sanat kurslarını doğrudan eğitim vitrininde sergileyip online kapora toplayın."
  },
  {
    icon: "🎯",
    title: "Aday Öğrenci & Veli Adayı CRM Takibi (/crm)",
    desc: "Kursa fiyat sormaya gelen veya sosyal medyadan form dolduran veli adaylarını satış hunisinde (pipeline) takip edin; arama notları ve kayıt randevularıyla aday kaçırmayın."
  },
  {
    icon: "🧾",
    title: "Eğitim KDV Oranlarına Uygun e-Fatura / e-Arşiv",
    desc: "Eğitim hizmetleri (%10 KDV) ile kitap/materyal satışlarını mevzuata %100 uygun olarak tek faturada kesin; mali müşavirinize tek tıkla hazır muhasebe mizanı aktarın."
  }
];

const faqs = [
  {
    q: "Hangi eğitim kurumları ve akademiler için uygundur?",
    a: "Yabancı dil kursları, sürücü kursları, spor akademileri (yüzme, futbol, tenis vb.), müzik ve bale okulları, etüt ve LGS/YKS hazırlık merkezleri, anaokulları/kreşler ve mesleki sertifika merkezleri için uygundur."
  },
  {
    q: "Veliye taksit hatırlatması ve online ödeme linki nasıl gönderilir?",
    a: "Vadesi yaklaşan veya geciken taksitler için sistem tek tıkla velinin WhatsApp numarasına özel 3D Secure ödeme bağlantısı üretir; veli evinden kredi kartıyla taksiti ödediğinde cari borç otomatik kapanır."
  },
  {
    q: "Matbu senet çıktısı alıp veliye imzalatabilir miyiz?",
    a: "Evet. Yasal standartlara uygun 'Borç Senedi ve Taahhütname' şablonu öğrenci ve veli kimlik bilgileriyle birlikte tek tıkla A4 olarak yazdırılmaya hazırdır."
  },
  {
    q: "Eğitmenlerin girdikleri ders saatleri puantaja nasıl yansır?",
    a: "Eğitmenler sınıfa girerken tablet veya telefondaki QR kodu okutur. Sistem ay sonunda haftalık toplam ders saatlerini toplar ve part-time öğretmenlerin maaş hakedişini hatasız üretir."
  },
  {
    q: "Yeni dönem kayıtlarında erken kayıt indirimi veya kardeş indirimi tanımlanabilir mi?",
    a: "Kesinlikle! Öğrenci kayıt kartında %10 Kardeş İndirimi, %15 Erken Kayıt veya Peşin Ödeme İskontosu gibi esnek indirim kuralları kurgulayabilirsiniz."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-blue-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-blue-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-blue-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
              🎓 Eğitim Pazaryeri & Akademi ERP • Taksit, Kitap & Eğitmen Puantajı
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Öğrenci Taksitlerini ve <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-300">
                Kurs Yönetimini Sıfırlayın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Dil kursları, spor akademileri, sürücü kursları ve etüt merkezleri için hepsi bir arada! Öğrenci senetlerini sıfır gecikmeyle takip edin, kitap stoklarını yönetin, eğitmenlerinizin ders saatlerini <strong>QR-PDKS</strong> ile tutun ve kurslarınızı <strong>Eğitim Pazaryerinde</strong> sergileyin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-blue-600/30 hover:scale-[1.02] transition-all text-center"
              >
                🎓 Eğitim Kurumunuzu Ücretsiz Başlatın
              </a>
              <a 
                href="#taksit-vitrin" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>📜 Canlı Taksit & Senet Matrisi</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Senet & Vade Hatırlatıcı</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Kitap & Paket Stok</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Eğitmen QR-PDKS</span>
            </div>
          </div>

          <!-- Sağ: Canlı Öğrenci Kayıt & Taksit/Senet Matrisi Mockup'ı -->
          <div class="lg:col-span-7" id="taksit-vitrin">
            <div class="bg-slate-900/90 rounded-2xl border border-blue-500/30 p-5 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500"></div>

              <!-- Üst Öğrenci Bilgisi -->
              <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 mb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                <div>
                  <div class="font-bold text-white text-sm">Öğrenci: Zeynep Arslan</div>
                  <div class="text-[11px] text-slate-400 mt-0.5">İngilizce B2 Yetişkin Kursu + Orijinal Kitap Seti</div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] text-slate-400">Toplam Kurs Bedeli (10 Taksit):</div>
                  <div class="text-emerald-400 font-mono font-black text-sm">35.000 ₺</div>
                </div>
              </div>

              <!-- Taksit / Senet Matrisi -->
              <div class="space-y-2 mb-4">
                {installmentPlan.map((item) => (
                  <div class="bg-slate-950 p-2.5 rounded-lg border border-slate-800 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-slate-300 font-bold">{item.no}</span>
                      <span class="text-slate-400 text-[11px]">{item.date}</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-white font-bold">{item.amount}</span>
                      <span class={`px-2 py-0.5 rounded text-[10px] border ${item.badge}`}>
                        {item.status}
                      </span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Alt Aksiyon: Vadesi Gelen Taksite Link Gönderme -->
              <div class="bg-slate-950/80 p-3 rounded-xl border border-blue-500/20 text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
                <span class="text-slate-300 text-[11px]">
                  <strong>3. Taksit (3.500 ₺):</strong> Veliye tek tıkla WhatsApp 3D Secure kredi kartı ödeme linki gönderildi.
                </span>
                <span class="px-2.5 py-1 rounded bg-blue-600 text-white font-bold text-[10px] cursor-pointer whitespace-nowrap">
                  Linkle Tahsil Et ➔
                </span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. EĞİTİM KURUMLARI 6 KRİTİK ÖZELLİK -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-blue-400 font-bold mb-3">Akademik ERP Gücü</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Eğitim Kurumunuzun İdari ve Finansal Yükünü Sıfırlayın</h3>
          <p class="text-slate-400 mt-4 text-base">
            Kayıttan tahsilata, kitap stoklarından eğitmen puantajına kadar kursunuzun her adımını güvenle yönetin.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {academyPowers.map((power, index) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-blue-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center text-2xl mb-4">
                  {power.icon}
                </div>
                <div class="text-xs font-mono text-blue-400 font-bold mb-1">KABİLİYET 0{index + 1}</div>
                <h4 class="text-lg font-bold text-white mb-2">{power.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{power.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-blue-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">Eğitim ve Kurs Yönetimi Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-blue-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-blue-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-blue-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-blue-500/20 border border-blue-500/40 text-blue-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🎓
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Eğitim Kurumunuzun Finans ve İdari Yükünü Sıfırlayın! <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-300">
              Stok Pratik Akademi ile Büyümeye Odaklanın.
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Hemen ücretsiz kurum hesabınızı açın; öğrenci senetlerinizi, taksitlerinizi ve eğitmen puantajınızı dakikalar içinde dijitalleştirin.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-lg shadow-xl shadow-blue-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 Hemen Ücretsiz Kullanmaya Başla
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • 1 dakikada şirket hesabı açın • Matbu senet çıktısı hazır</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik Eğitim Pazaryeri ve Kurs Yönetim Sistemi",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
