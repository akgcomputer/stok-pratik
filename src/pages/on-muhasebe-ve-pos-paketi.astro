---
import BaseLayout from '../layouts/BaseLayout.astro';
import pricingData from '../data/pricing.json';

const pageTitle = "Ön Muhasebe ve Hızlı Satış (POS) Programı | Stok Pratik";
const pageDescription = "Bulut tabanlı ön muhasebe, barkodlu hızlı satış (POS), e-Fatura, stok ve cari takip sistemi. Stok Pratik çekirdek paketi ile işletmenizi hemen dijitalleştirin.";

const { core_package, currency_symbol, vat_text } = pricingData;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased">
    
    <!-- HERO -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-900 to-slate-900 py-20 text-white">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-blue-300 bg-blue-950/60 border border-blue-500/30 rounded-full">
          📦 Stok Pratik Çekirdek Altyapı
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
          Ön Muhasebe & Barkodlu POS Satışını<br class="hidden sm:inline" />
          <span class="text-blue-400">Tek Ekranda ve Güvenle</span> Yönetin
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-6 leading-relaxed">
          Karmaşık muhasebe terimlerini unutun. Stok girişinden e-Fatura kesimine, kasa/banka takibinden barkodlu kasa satışına kadar işletmenizin tüm temel operasyonu tek çatı altında.
        </p>

        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/10 backdrop-blur border border-white/20 text-white text-sm font-semibold mb-8">
          <span>Aylık Sadece</span>
          <span class="text-xl font-black text-emerald-400">{core_package.yearly_monthly_price} {currency_symbol}</span>
          <span>'den başlayan avantajlı fiyatlarla ({vat_text})</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold text-lg rounded-xl shadow-lg transition duration-200 text-center">
            1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
          </a>
          <a href="/fiyatlar" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold text-lg rounded-xl border border-white/20 transition duration-200 text-center">
            Paketi ve Modülleri İncele
          </a>
        </div>
      </div>
    </section>

    <!-- CORE FEATURES -->
    <section class="py-16 bg-white border-b border-slate-200">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">Çekirdek Pakette Neler Var?</h2>
          <p class="text-slate-600 max-w-2xl mx-auto">İşletmenizin omurgasını oluşturan tüm temel özellikler hazır olarak gelir.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
            <div class="text-3xl mb-4">🧾</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">E-Fatura & E-İrsaliye</h3>
            <p class="text-slate-600 text-sm leading-relaxed">GİB entegrasyonu ile tek tıkla satış faturası kesin, gelen faturaları sisteme aktarın ve e-irsaliyelerinizi yönetin.</p>
          </div>

          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
            <div class="text-3xl mb-4">⚡</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Hızlı POS Satış Ekranı</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Dokunmatik ekran ve barkod okuyucu uyumlu arayüzle kasada saniyeler içinde perakende satış yapın, fiş yazdırın.</p>
          </div>

          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
            <div class="text-3xl mb-4">📊</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Stok, Kasa & Cari</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Müşteri/tedarikçi borç-alacak dengesi, kasa-banka hareketleri, çek-senet takibi ve patron özet raporları tek ekranda.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPANSION MODULES INFO -->
    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">İhtiyacınıza Göre Büyüyen Modüler Yapı</h2>
        <p class="text-slate-600 max-w-2xl mx-auto mb-10">Ön muhasebe çekirdeğinizi dilediğiniz an ek modüllerle büyütebilirsiniz:</p>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm mb-1">🏢 Çoklu Şube & Depo</span>
            <span class="text-xs text-slate-500">2 ve üzeri mağaza takibi</span>
          </div>
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm mb-1">🛒 Pazaryeri / E-Ticaret</span>
            <span class="text-xs text-slate-500">Trendyol, Hepsiburada vb.</span>
          </div>
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm mb-1">🤝 B2B Bayi Portalı</span>
            <span class="text-xs text-slate-500">Toptan sipariş toplama</span>
          </div>
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm mb-1">⚙️ ERP & CRM Modülü</span>
            <span class="text-xs text-slate-500">Üretim & Müşteri yönetimi</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-slate-900 text-white text-center">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold mb-4">İşletmenizi Hemen Stok Pratik ile Tanıştırın</h2>
        <p class="text-slate-400 mb-8">İhtiyacınız olan modülleri seçin, sadece kullandığınız kadar ödeyin.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/fiyatlar" class="px-8 py-3.5 bg-blue-500 hover:bg-blue-600 text-white font-bold rounded-xl transition">Paketi Yapılandır</a>
          <a href="/paketlerimiz" class="px-8 py-3.5 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl border border-slate-700 transition">Tüm Modül Özellikleri</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
