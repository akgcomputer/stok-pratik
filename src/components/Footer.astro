        </ul>
      </div>
      
      <!-- Özellikler 2. Bölüm -->
      <div class="footer-section">
        <h4>&nbsp;</h4>
        <ul class="footer-links">
          <li>Mağaza Satış Ekranı (POS)</li>
          <li>Sanal Pos ile Ödeme Alma</li>
