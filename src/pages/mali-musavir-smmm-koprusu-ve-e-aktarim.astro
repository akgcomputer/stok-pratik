---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Mali Müşavir (SMMM) Köprüsü ve Tek Tıkla e-Aktarım | Stok Pratik";
const pageDescription = "Ay sonunda poşetle evrak taşımaya son! Stok Pratik e-Aktarım ile tüm faturalar, banka ve masraf fişleri Luca, Logo, Mikro, Zirve ve Eta'ya tek tıkla muhasebe fişi olarak aktarılsın.";

const clientBenefits = [
  {
    icon: "📦",
    title: "Evrak Kaybı ve Kurye Zahmeti Biter",
    desc: "Fiş ve faturaları poşetleyip müşavir ofisine taşıma derdine son. Tüm e-Belgeler ve telefonla çekilen masraf fişleri bulutta anlık olarak müşavirinize hazırdır."
  },
  {
    icon: "💰",
    title: "Eksik Fiş Yüzünden Fazla Vergi Ödemezsiniz",
    desc: "Cebinizde kaybolan benzin, yemek veya kırtasiye fişlerini anında yapay zekayla okutun; indirilecek KDV ve masraf olarak doğrudan müşavirinizin onayına insin."
  },
  {
    icon: "🛒",
    title: "E-Ticarette Binlerce Fatura Kâbusu Çözülür",
    desc: "Trendyol ve Hepsiburada'da ayda binlerce sipariş mi kesiyorsunuz? Müşaviriniz binlerce faturayı tek tek elle girmez; tek tıkla saniyeler içinde programına çeker."
  },
  {
    icon: "📊",
    title: "Canlı KDV ve Geçici Vergi Öngörüsü",
    desc: "Ayın 25'ini beklemeden o ay ne kadar KDV ve kurumlar/gelir vergisi çıkacağını mali müşavirinizle aynı ekranda canlı izleyin, sürpriz vergilerle karşılaşmayın."
  }
];

const smmmBenefits = [
  {
    icon: "💻",
    title: "Luca, Logo, Mikro, Zirve ve Eta ile %100 Uyum",
    desc: "Luca (Özel Fiş / Excel / XML), Logo Tiger/Go, Mikro, Zirve Müşavir, Eta, Datasoft ve GMS.NET formatlarında hatasız muhasebe fiş çıktısı alın."
  },
  {
    icon: "📑",
    title: "Otomatik Tekdüzen Hesap Planı (TDHP)",
    desc: "KDV oranlarına göre (%1, %10, %20) 153/191/600/391 hesap kırılımları, cari 120/320 kodları ve tevkifat/istisna kodları otomatik ayrıştırılır."
  },
  {
    icon: "👥",
    title: "SGK Puantaj ve Bordro Verisi Hazır",
    desc: "Mükellefinizin QR-PDKS modülünden gelen aylık personel puantaj cetveli, izin ve mesai saatleri bordroya hazır halde tek tıkla indirilir."
  },
  {
    icon: "🔑",
    title: "SMMM Ücretsiz Özel Yetki Girişi",
    desc: "Mükellefleriniz size yalnızca 'Mali Müşavir / Denetim' yetkisi tanımlar; ofisinizden çıkmadan tüm mükelleflerinizin kayıtlarını tek ekrandan denetleyin."
  }
];

const supportedSoftwares = [
  { name: "Luca", desc: "Doğrudan Muhasebe Fişi & XML Aktarımı" },
  { name: "Logo (Go / Tiger)", desc: "Resmi Logo XML Formatında Fiş Çıktısı" },
  { name: "Mikro Yazılım", desc: "Mikro Muhasebe Fiş Şablonu" },
  { name: "Zirve Müşavir", desc: "Zirve Fiş & Excel Entegrasyonu" },
  { name: "Eta", desc: "Eta Muhasebe Fiş Aktarımı" },
  { name: "Datasoft & Orka", desc: "Standart Hesap Planı Çıktısı" }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-purple-600 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-purple-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
              🔄 SMMM & Mali Müşavir Dostu ERP • Tek Tıkla e-Aktarım
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Ay Sonunda Poşetle Evrak Taşımaya ve Fatura Tekrar Girmeye Son: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-300 to-amber-200">
                Mali Müşavirinizle Tek Tıkla Tam Entegre Çalışın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              İşletmenizde kestiğiniz tüm faturalar, pazaryeri satışları, yapay zekayla okuttuğunuz masraf fişleri ve banka hareketleri ay sonunda tek tıkla mali müşavirinizin kullandığı programa (<strong>Luca, Logo, Mikro, Zirve, Eta</strong> vb.) muhasebe fişi olarak hatasız aktarılsın. Günler süren iş yükünden kurtulun!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-purple-600/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🚀 İşletmem İçin Ücretsiz Başla</span>
              </a>
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>💼 Mali Müşavirim (SMMM Portalı)</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-purple-400 font-bold">✓</span> Luca, Logo, Zirve Entegrasyonu
              </div>
              <div class="flex items-center gap-2">
                <span class="text-purple-400 font-bold">✓</span> Otomatik TDHP Kodlama
              </div>
              <div class="flex items-center gap-2">
                <span class="text-purple-400 font-bold">✓</span> SGK Puantaj Cetveli
              </div>
            </div>
          </div>

          <!-- Sağ: Canlı Veri Köprüsü (Hub & Spoke) Mockup'ı -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-purple-500/30 rounded-3xl p-6 sm:p-7 shadow-2xl backdrop-blur-xl">
              
              <div class="text-center mb-5">
                <div class="text-xs font-mono font-bold text-purple-400">Canlı Muhasebe Aktarım Köprüsü</div>
                <div class="text-sm font-bold text-white">İşletme ➔ Stok Pratik ➔ Mali Müşavir Programı</div>
              </div>

              <!-- Sol (Giriş Verileri) + Sağ (Müşavir Çıktıları) 2 Kolon -->
              <div class="grid grid-cols-2 gap-3 mb-4 text-xs font-mono">
                
                <div class="bg-slate-950/80 p-3 rounded-2xl border border-slate-800 space-y-1.5">
                  <div class="text-purple-300 font-bold text-[11px] font-sans">📥 İşletme Verileri</div>
                  <div class="text-slate-400 text-[10px]">✓ Alış & Satış Faturaları</div>
                  <div class="text-slate-400 text-[10px]">✓ Pazaryeri e-Faturaları</div>
                  <div class="text-slate-400 text-[10px]">✓ OCR Masraf Fişleri</div>
                  <div class="text-slate-400 text-[10px]">✓ Banka Ekstreleri (102)</div>
                  <div class="text-slate-400 text-[10px]">✓ SGK Puantaj Verisi</div>
                </div>

                <div class="bg-purple-950/20 p-3 rounded-2xl border border-purple-500/30 space-y-1.5">
                  <div class="text-emerald-400 font-bold text-[11px] font-sans">📤 Müşavir Formatları</div>
                  <div class="text-slate-300 text-[10px] font-bold">⚡ Luca Fiş Formatı</div>
                  <div class="text-slate-300 text-[10px] font-bold">⚡ Logo Tiger/Go XML</div>
                  <div class="text-slate-300 text-[10px] font-bold">⚡ Zirve Müşavir Fişi</div>
                  <div class="text-slate-300 text-[10px] font-bold">⚡ Mikro & Eta Aktarımı</div>
                  <div class="text-slate-300 text-[10px] font-bold">⚡ Standart TDHP Excel</div>
                </div>

              </div>

              <!-- Otomatik Eşleştirme Motoru Bandı -->
              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-300 space-y-1">
                <div class="flex justify-between font-mono">
                  <span>Hesap Kodu Eşleşmesi:</span>
                  <span class="text-emerald-400 font-bold">%100 Otomatik</span>
                </div>
                <div class="text-[10px] text-slate-400 leading-tight">
                  KDV oranlarına göre 153/191/600/391 ve cari 120/320 alt hesapları saniyeler içinde ayrıştırıldı.
                </div>
              </div>

              <!-- Tek Tıkla İndirme Butonu -->
              <div class="mt-4 p-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold text-xs text-center shadow-md">
                ⚡ Seçili Dönem Fişlerini Tek Tıkla Dışa Aktar
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. DESTEKLENEN MUHASEBE YAZILIMLARI -->
    <section class="py-12 border-b border-slate-800 bg-slate-900/50">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center mb-8">
          <span class="text-xs uppercase font-mono text-purple-400 font-bold tracking-wider">
            Desteklenen Başlıca Resmi Muhasebe Yazılımları
          </span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {supportedSoftwares.map((sw) => (
            <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-4 text-center hover:border-purple-500/40 transition-all">
              <div class="font-bold text-white text-base mb-1">{sw.name}</div>
              <div class="text-[10px] text-slate-400">{sw.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ÇİFT TARAFLI AVANTAJ VİTRİNİ -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-purple-400 text-sm font-semibold tracking-wider uppercase mb-3">Kazan - Kazan</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Hem İşletme Hem Mali Müşavir İçin Benzersiz Kolaylık
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            Mükellef ile müşavir arasındaki evrak trafiğini sıfıra indirerek her iki tarafın da zamandan tasarruf etmesini sağlar.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          <!-- İşletme Sahipleri İçin -->
          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 text-2xl flex items-center justify-center">
                🏢
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">İşletme Sahipleri (Mükellefler)</h3>
                <div class="text-xs text-purple-300">Evrak takibi ve kurye derdine son</div>
              </div>
            </div>

            <div class="space-y-4">
              {clientBenefits.map((b) => (
                <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/80">
                  <div class="flex items-center gap-2 font-bold text-white text-sm mb-1">
                    <span>{b.icon}</span>
                    <span>{b.title}</span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-400 leading-relaxed pl-6">{b.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Mali Müşavirler İçin -->
          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-2xl flex items-center justify-center">
                💼
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Mali Müşavirler (SMMM & YMM)</h3>
                <div class="text-xs text-indigo-300">Tek tıkla programınıza aktarın</div>
              </div>
            </div>

            <div class="space-y-4">
              {smmmBenefits.map((b) => (
                <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/80">
                  <div class="flex items-center gap-2 font-bold text-white text-sm mb-1">
                    <span>{b.icon}</span>
                    <span>{b.title}</span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-400 leading-relaxed pl-6">{b.desc}</p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-purple-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs sm:text-sm font-semibold mb-6">
          🤝 Müşavir Dostu Bulut ERP • Sıfır Evrak Kaybı
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          Mali Müşavirinizin En Sevdiği İşletme Olun!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Hemen ücretsiz Stok Pratik hesabınızı açın, mali müşavirinize tek tıkla resmi muhasebe aktarımı konforunu ve şeffaf denetim yetkisini yaşatın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-purple-600/30 transition-all duration-200"
          >
            🎁 Hemen Ücretsiz Kullanmaya Başla
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
