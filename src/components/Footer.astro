          <li>Online Satış</li>
          <li>Sıcak Satış</li>
          <li>Saha Satış</li>
          <li>Sipariş Yönetimi</li>
          <li>Çek ve Senet</li>
        </ul>
      </div>
      
      <!-- Özellikler 4. Bölüm -->
      <div class="footer-section">
        <h4>&nbsp;</h4>
        <ul class="footer-links">
          <li>Şube ve Depo Yönetimi</li>
          <li>Raporlar</li>
          <li>Pazaryeri Entegrasyonu</li>
          <li>Online Tahsilat</li>
