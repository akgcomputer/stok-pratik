---
// src/pages/uretim-takip-mrp-programi.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "İmalatçı ve Üretim Yapan İşletmeler İçin MRP Programı | Stok Pratik";
const pageDescription = "Küçük ve orta ölçekli imalatçılar için ürün reçetesi (BOM) ve hammadde stok takip yazılımı. Üretim maliyetini hatasız hesaplayın!";

// Özellikler verisi (örnekteki gibi 6 özellik)
const features = [
  {
    icon: "📋",
    title: "Aşamalı Ürün Reçetesi (BOM)",
    description: "Bir ürünün üretilmesi için gereken hammadde, yarı mamul ve ambalaj malzemelerini standart reçeteler olarak tanımlayın.",
    items: ["Hammadde listesi", "Yarı mamul tanımı", "Ambalaj malzemeleri", "Standart reçete oluşturma"]
  },
  {
    icon: "📉",
    title: "Otomatik Hammadde Düşüşü",
    description: "Üretim fişini oluşturduğunuz an sistem, reçetede yazan hammaddeleri ana depodan otomatik olarak düşer, mamul stoğunu artırır.",
    items: ["Otomatik stok düşüşü", "Mamul stok artışı", "Fire oranı hesaplama", "Anlık güncelleme"]
  },
  {
    icon: "💰",
    title: "Gerçek Birim Maliyet Hesabı",
    description: "Hammaddelerin güncel alış fiyatları (FIFO), işçilik ve genel gider payları eklenerek en doğru üretim maliyetinizi hesaplar.",
    items: ["FIFO maliyetleme", "İşçilik gideri", "Genel gider dağıtımı", "Detaylı maliyet raporu"]
  },
  {
    icon: "🔁",
    title: "Fason Üretim Takibi",
    description: "Üretimin bir aşamasını dışarıya fasona veriyorsanız, gönderilen hammaddeleri ve dışarıda oluşan maliyetleri sisteme işleyin.",
    items: ["Fason sipariş oluşturma", "Malzeme gönderimi", "Dış maliyet girişi", "Fason stok takibi"]
  },
  {
    icon: "⚠️",
    title: "Eksik Hammadde İkazı",
    description: "Sipariş aldığınızda üretim için gerekli olan ancak depoda bulunmayan eksik hammaddelerin listesini tek tıkla alın.",
    items: ["Eksik malzeme analizi", "Otomatik uyarı", "Sipariş önerisi", "Tedarikçi yönlendirme"]
  },
  {
    icon: "🧾",
    title: "Entegre Ön Muhasebe & e-Fatura",
    description: "Üretilen malları toptan veya perakende sattığınızda anında e-faturasını kesin ve tahsilatlarını muhasebeden takip edin.",
    items: ["e-Fatura kesimi", "Tahsilat takibi", "Muhasebe entegrasyonu", "Cari mutabakat"]
  }
];

// SSS (isteğe bağlı, örnekte yok ama ekleyebiliriz)
const faqs = [
  {
    q: "Üretim sırasında harcanan işçilik veya elektriği maliyete ekleyebilir miyim?",
    a: "Evet, reçetelerinize 'Genel Gider' veya 'İşçilik' isimli hizmet kalemleri ekleyerek toplam maliyetinizin daha tutarlı hesaplanmasını sağlayabilirsiniz."
  },
  {
    q: "Gıda imalathaneleri için uygun mu?",
    a: "Kesinlikle. Gram, litre, adet gibi farklı birimlerle reçete oluşturabilirsiniz. Unlu mamuller, kuruyemiş, tekstil ve makine parça imalatı yapan tüm KOBİ'ler kullanabilir."
  },
  {
    q: "Yarı mamul üretimi destekleniyor mu?",
    a: "Sistemde alt reçeteler (yarı mamuller) oluşturabilir, bir ana ürünü üretirken içinde kullanılan yarı mamullerin de hammaddelerden düşmesini sağlayabilirsiniz."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- HERO SECTION (örnekteki gibi) -->
  <section class="hero-section py-16 bg-gradient-to-br from-primary-red-light to-bg-white">
    <div class="container">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-primary-red to-primary-red-dark bg-clip-text text-transparent">
          İmalathanelerde Hammadde Kaybına ve Hatalı Maliyet Hesabına Son!
        </h1>
        <p class="text-xl text-text-gray mb-8">
          {pageDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://wa.me/+905325000999?text=Merhaba,%20MRP%20Üretim%20Takip%20programı%20demo%20talep%20ediyorum"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="mr-2">📋</span>
            Demo Talep Et
          </a>
          <a
            href="#ozellikler"
            class="btn btn-secondary"
          >
            Özellikleri Keşfet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ÖZELLİKLER (6 kart) -->
  <section id="ozellikler" class="features-section py-16 bg-bg-light">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Üretim Süreçlerinizi Dijitalleştiren Özellikler</h2>
        <p class="text-text-gray max-w-2xl mx-auto">
          Küçük ve orta ölçekli imalatçılar için özel olarak geliştirilmiş araçlar
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="feature-card bg-white p-6 rounded-lg shadow-md">
            <div class="feature-icon mb-4 text-primary-red text-3xl">
              {feature.icon}
            </div>
            <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
            <p class="text-text-gray mb-4">{feature.description}</p>
            <ul class="space-y-2 text-text-gray">
              {feature.items.map((item) => (
                <li class="flex items-start">
                  <span class="text-green-500 mr-2 mt-1 flex-shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AVANTAJLAR (2 sütun) -->
  <section class="benefits-section py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">MRP Sisteminin İşletmenize Sağladığı Avantajlar</h2>
        <p class="text-text-gray max-w-2xl mx-auto">
          Üretim süreçlerinizde verimlilik ve kontrol
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- İşletmeniz İçin -->
        <div class="bg-bg-light p-8 rounded-lg">
          <h3 class="text-2xl font-semibold mb-4 text-primary-red">İşletmeniz İçin</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">💰</div>
              <div>
                <h4 class="font-semibold mb-1">Doğru Maliyet Hesabı</h4>
                <p class="text-text-gray">Hammadde, işçilik ve genel giderlerle gerçek maliyet</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">📊</div>
              <div>
                <h4 class="font-semibold mb-1">Stok Kontrolü</h4>
                <p class="text-text-gray">Hammadde ve mamul stoklarınız anlık izlenebilir</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">⏱️</div>
              <div>
                <h4 class="font-semibold mb-1">Zaman Tasarrufu</h4>
                <p class="text-text-gray">Manuel hesaplama ve takip süreleri %60 azalır</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Üretim Ekibiniz İçin -->
        <div class="bg-bg-light p-8 rounded-lg">
          <h3 class="text-2xl font-semibold mb-4 text-primary-red">Üretim Ekibiniz İçin</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">📱</div>
              <div>
                <h4 class="font-semibold mb-1">Mobil Erişim</h4>
                <p class="text-text-gray">Tezgahtan veya depodan anlık veri girişi</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">🔧</div>
              <div>
                <h4 class="font-semibold mb-1">Kolay Reçete Yönetimi</h4>
                <p class="text-text-gray">Standart reçetelerle hızlı üretim başlatma</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="bg-primary-red text-white p-2 rounded-full mr-4">🔄</div>
              <div>
                <h4 class="font-semibold mb-1">Şeffaf Takip</h4>
                <p class="text-text-gray">Her işlem kayıtlı, hata payı minimum</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTEGRASYONLAR / PLATFORMLAR -->
  <section class="platforms-section py-16 bg-gradient-to-r from-primary-red-light to-bg-light">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-8">Entegre Çalıştığı Sistemler</h2>
      <div class="flex flex-wrap justify-center gap-8 mb-12">
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">📦</div>
          <h3 class="text-xl font-semibold">Stok Yönetimi</h3>
          <p class="text-text-gray">Hammadde ve mamul senkronu</p>
        </div>
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">🧾</div>
          <h3 class="text-xl font-semibold">e-Fatura</h3>
          <p class="text-text-gray">Otomatik fatura kesimi</p>
        </div>
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-semibold">Muhasebe</h3>
          <p class="text-text-gray">Maliyet ve kar takibi</p>
        </div>
        <div class="platform-card bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl mb-4">🛒</div>
          <h3 class="text-xl font-semibold">B2B Portal</h3>
          <p class="text-text-gray">Toptan sipariş yönetimi</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS (isteğe bağlı, örnekte yok ama ekledim) -->
  <section class="faq-section py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Sıkça Sorulan Sorular</h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq) => (
          <details class="bg-bg-light p-4 rounded-lg border border-gray-200">
            <summary class="font-semibold text-primary-red cursor-pointer list-none flex justify-between items-center">
              {faq.q}
              <span class="text-gray-500">▼</span>
            </summary>
            <div class="mt-2 text-text-gray border-t border-gray-200 pt-2">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section py-16 bg-primary-red text-white">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-6">Üretim Yönetimini Dijitale Taşımaya Hazır mısınız?</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Hemen demo talep edin, üretim süreçlerinizde kontrol sizde olsun.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://wa.me/+905325000999?text=Merhaba,%20MRP%20Üretim%20Takip%20programı%20demo%20talep%20ediyorum"
          class="btn bg-white text-primary-red hover:bg-gray-100 flex items-center justify-center"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="mr-2">💬</span>
          WhatsApp'tan Demo Talep Et
        </a>
        <a
          href="tel:+905325000999"
          class="btn bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary-red"
        >
          <span class="mr-2">📞</span>
          Hemen Ara: 0532 500 09 99
        </a>
      </div>
    </div>
  </section>

  <style>
    :global(body) {
      scroll-behavior: smooth;
    }

    /* Hero Section */
    .hero-section {
      background: linear-gradient(135deg, var(--primary-red-light) 0%, var(--bg-white) 100%);
    }

    /* Container */
    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Butonlar */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 2px solid transparent;
      cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
      color: white;
      border-color: var(--primary-red);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, var(--primary-red-dark), var(--primary-red-darker));
    }

    .btn-secondary {
      background: white;
      color: var(--primary-red);
      border: 2px solid var(--primary-red);
    }

    .btn-secondary:hover {
      background: var(--primary-red-light);
    }

    /* Feature Cards */
    .feature-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 1px solid #e5e7eb;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
      color: var(--primary-red);
    }

    /* Platform Cards */
    .platform-card {
      transition: transform 0.3s ease;
      min-width: 150px;
    }

    .platform-card:hover {
      transform: translateY(-5px);
    }

    /* CTA Section */
    .cta-section {
      background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
    }

    /* Utility Classes */
    .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
    .mb-4 { margin-bottom: 1rem; }
    .mb-6 { margin-bottom: 1.5rem; }
    .mb-8 { margin-bottom: 2rem; }
    .mb-12 { margin-bottom: 3rem; }
    .mt-1 { margin-top: 0.25rem; }
    .mr-2 { margin-right: 0.5rem; }
    .mr-4 { margin-right: 1rem; }
    .text-center { text-align: center; }
    .text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
    .text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
    .text-5xl { font-size: 3rem; line-height: 1; }
    .text-xl { font-size: 1.25rem; line-height: 1.75rem; }
    .text-2xl { font-size: 1.5rem; line-height: 2rem; }
    .font-bold { font-weight: 700; }
    .font-semibold { font-weight: 600; }
    .rounded-lg { border-radius: 0.5rem; }
    .rounded-full { border-radius: 9999px; }
    .shadow-md { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
    .bg-white { background-color: white; }
    .bg-bg-light { background-color: #f9fafb; }
    .bg-primary-red { background-color: #dc2626; }
    .bg-primary-red-light { background-color: #fef2f2; }
    .text-primary-red { color: #dc2626; }
    .text-white { color: white; }
    .text-text-gray { color: #6b7280; }
    .text-green-500 { color: #10b981; }
    .text-gray-500 { color: #6b7280; }
    .p-2 { padding: 0.5rem; }
    .p-4 { padding: 1rem; }
    .p-6 { padding: 1.5rem; }
    .p-8 { padding: 2rem; }
    .flex { display: flex; }
    .flex-col { flex-direction: column; }
    .flex-wrap { flex-wrap: wrap; }
    .items-start { align-items: flex-start; }
    .items-center { align-items: center; }
    .justify-center { justify-content: center; }
    .flex-shrink-0 { flex-shrink: 0; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    .max-w-4xl { max-width: 56rem; }
    .max-w-3xl { max-width: 48rem; }
    .max-w-2xl { max-width: 42rem; }
    .gap-4 { gap: 1rem; }
    .gap-8 { gap: 2rem; }
    .space-y-2 > * + * { margin-top: 0.5rem; }
    .space-y-4 > * + * { margin-top: 1rem; }
    .border { border-width: 1px; }
    .border-gray-200 { border-color: #e5e7eb; }
    .border-t { border-top-width: 1px; }
    .border-t-gray-200 { border-color: #e5e7eb; }
    .pt-2 { padding-top: 0.5rem; }
    .mt-2 { margin-top: 0.5rem; }
    .cursor-pointer { cursor: pointer; }
    .list-none { list-style: none; }

    /* Grid */
    .grid { display: grid; }
    .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
    .gap-8 { gap: 2rem; }

    /* Responsive */
    @media (min-width: 768px) {
      .md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sm\:flex-row { flex-direction: row; }
      .md\:text-5xl { font-size: 3rem; line-height: 1; }
    }

    @media (min-width: 1024px) {
      .lg\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 768px) {
      .hero-section h1 {
        font-size: 2.5rem;
      }
      
      .platforms-section .flex {
        flex-direction: column;
        align-items: center;
      }
      
      .platform-card {
        width: 100%;
        max-width: 250px;
      }
    }

    @media (max-width: 480px) {
      .hero-section h1 {
        font-size: 2rem;
      }
      
      .cta-section .flex {
        flex-direction: column;
      }
    }

    :root {
      --primary-red: #dc2626;
      --primary-red-dark: #b91c1c;
      --primary-red-darker: #991b1b;
      --primary-red-light: #fef2f2;
      --bg-white: #ffffff;
      --bg-light: #f9fafb;
      --text-gray: #6b7280;
      --border-color: #e5e7eb;
    }
  </style>
</BaseLayout>