---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Akıllı Stok Takibi ve Varyantlı Ürün Yönetimi | Stok Pratik";
const pageDescription = "Bulut tabanlı barkodlu stok takibi, varyant matrisi, bundle set ürünler, toptan kademeli fiyatlama ve maliyet koruma kilidi ile zararına satışı engelleyin.";

const shields = [
  {
    icon: "🛡️",
    title: "Zararına Satış Engelleme",
    subtitle: "Maliyet Koruma Kilidi",
    desc: "Satış fiyatı son alış maliyetinizin altına düştüğü anda sistem satışı ve etiket kaydını otomatik durdurur; kasa ve pazaryerlerinde zarar etmenizi önler."
  },
  {
    icon: "⚡",
    title: "Otomatik EAN-13 Barkod Üretici",
    subtitle: "Tek Tıkla Benzersiz Barkod",
    desc: "Barkodu bulunmayan yerli üretim veya açık ürünleriniz için tek tıkla GS1 standartlarında çakışmayan EAN-13 barkodları üretir ve etiket basar."
  },
  {
    icon: "🔔",
    title: "Kritik Stok & Emniyet Stoğu Alarmı",
    subtitle: "Tedarik Cezası Kalkanı",
    desc: "Depo adediniz belirlediğiniz güvenlik sınırının altına indiğinde anında bildirim gönderir; pazaryerlerine '0' basarak mağaza puanınızı korur."
  }
];

const features = [
  {
    icon: "📦",
    title: "Gelişmiş Ürün & Katalog Kartları",
    desc: "Her ürün için zengin meta veriler ve 5'li yüksek çözünürlüklü ürün görseli desteği.",
    items: [
      "Barkod, Stok Kodu, Muhasebe Kodu, Marka, Kategori ve Desi takibi",
      "Ürün bazında özel KDV oranları ve tahmini teslim süresi tanımlama",
      "Cloudflare R2 CDN altyapısıyla yıldırım hızında yüklenen 5 HD ürün görseli"
    ]
  },
  {
    icon: "🎨",
    title: "Renk / Beden / Ölçü Varyant Matrisi",
    desc: "Tekstil, ayakkabı ve endüstriyel ürünler için tek ana ürün kartı altında sonsuz varyant esnekliği.",
    items: [
      "Tek tıkla onlarca renk/beden kombinasyonu ve otomatik alt kart açma",
      "Her varyanta özel bağımsız barkod, raf adresi ve stok miktarı",
      "Kritik seviyeye inen renk veya bedeni tek ekranda anında tespit etme"
    ]
  },
  {
    icon: "🎁",
    title: "Set / Paket (Bundle) Ürün Oluşturma",
    desc: "Birden fazla ürünü tek bir kampanya seti veya hediye paketi olarak birleştirin.",
    items: [
      "Paket satıldığında alt bileşenlerin stoklarından anında otomatik düşüm",
      "Bileşenlerden biri tükendiğinde paketin pazaryerlerinde satışını durdurma",
      "Set ürünlere özel indirimli kampanya fiyatları tanımlama"
    ]
  },
  {
    icon: "🏢",
    title: "Kademeli Toptan & B2B Fiyatlandırma",
    desc: "Perakende fiyatının yanı sıra adet, koli ve palet bazlı otomatik fiyat kademeleri belirleyin.",
    items: [
      "10+ Adet, Koli İçi ve Palet İçi otomatik iskonto seviyeleri",
      "Bayi gruplarına (A Grubu, B Grubu, Toptancı) özel sabit fiyat listeleri",
      "Sipariş anında seçilen miktara göre otomatik kademeli fiyat uygulama"
    ]
  },
  {
    icon: "🛒",
    title: "Pazaryeri Eşleşme & Fiyat Masası ('P' Kısayolu)",
    desc: "Ürün listesinden hiç çıkmadan tek tıkla pazaryeri kârlılık hesabınızı yapın.",
    items: [
      "Klavyeden 'P' tuşuna basarak Trendyol ve Hepsiburada komisyon/kargo simülatörü",
      "Kargo desi ücreti ve platform komisyonu düşüldükten sonra net kârı görme",
      "Belirlediğiniz hedef kâra göre anında pazaryeri liste fiyatı kaydetme"
    ]
  },
  {
    icon: "📊",
    title: "Excel ile Toplu Ürün Yükleme & Güncelleme",
    desc: "Binlerce ürünü, fiyatını ve stok sayısını saniyeler içinde içeri ve dışarı aktarın.",
    items: [
      "Kullanımı kolay hazır Excel şablonu ile tek tıkla toplu ürün yükleme",
      "Maliyet veya satış fiyatı güncellemelerini Excel üzerinden anında yansıtma",
      "Depo sayım sonuçlarını Excel'den yükleyerek stokları tek seferde eşitleme"
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    
    <!-- 1. HERO SECTION (Amber / Orange Theme) -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-amber-950/40 to-slate-900 py-20 sm:py-24 text-white border-b border-amber-900/40">
      <div class="absolute inset-0 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-5xl text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Temel Ticaret • Akıllı Stok & Ürün Katalog Yönetimi
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          Deponuzdaki Her Ürünü, Varyantı ve Kârınızı <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-white">
            Kuruşu Kuruşuna Kontrol Edin!
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
          Stok Pratik ile binlerce ürününüzü barkodlu takip edin, kritik stok uyarılarıyla "yok satma" derdine son verin ve <strong>Maliyet Koruma Kilidi</strong> ile zararına satışı tamamen engelleyin.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold rounded-xl shadow-lg shadow-amber-500/30 transition-all transform hover:-translate-y-0.5 text-center text-base">
            🚀 Hemen Giriş Yap & Ücretsiz Başla
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center text-base backdrop-blur-sm">
            🎁 14 Gün Ücretsiz Deneyin
          </a>
        </div>

        <div class="mt-8 flex items-center justify-center gap-6 text-xs text-slate-400">
          <span class="flex items-center gap-1.5">✓ Otomatik EAN-13 Barkod</span>
          <span class="flex items-center gap-1.5">✓ Renk/Beden Varyant Matrisi</span>
          <span class="flex items-center gap-1.5">✓ Sıfır Zarar Kalkanı</span>
        </div>
      </div>
    </section>

    <!-- 2. 3 AKILLI KALKAN BÖLÜMÜ -->
    <section class="py-16 bg-white border-b border-slate-200">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center mb-12">
          <span class="text-amber-600 font-bold uppercase tracking-wider text-xs">Benzersiz Güvenlik</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">
            Stok Pratik'i Benzersiz Kılan 3 Akıllı Koruma Kalkanı
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {shields.map((s) => (
            <div class="p-7 rounded-2xl bg-gradient-to-b from-amber-50/60 to-white border border-amber-200/80 shadow-sm hover:shadow-lg transition-all">
              <div class="w-12 h-12 rounded-xl bg-amber-100/80 flex items-center justify-center text-2xl mb-4 text-amber-700">
                {s.icon}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-1">{s.title}</h3>
              <p class="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-3">{s.subtitle}</p>
              <p class="text-slate-600 text-sm leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ÖNE ÇIKAN KABİLİYETLER (6 KART) -->
    <section class="py-20 bg-slate-50">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-amber-600 font-bold uppercase tracking-wider text-xs">Profesyonel Yönetim</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2">
            Stok & Ürün Yönetiminde Eksiksiz Özellikler
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg">
            Tekstil varyantlarından toptan fiyat kademelerine, set ürünlerden pazaryeri fiyat masasına kadar her detayı sizin için düşündük.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((item) => (
            <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-amber-300 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center text-2xl mb-5">
                  {item.icon}
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">{item.title}</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">{item.desc}</p>
              </div>
              <ul class="space-y-2.5 pt-4 border-t border-slate-100 text-xs text-slate-700 font-medium">
                {item.items.map((sub) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-600 font-bold">✓</span>
                    <span>{sub}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. ALT KAPANIŞ ÇAĞRISI (BOTTOM CTA) -->
    <section class="py-20 bg-gradient-to-br from-slate-950 via-amber-950/60 to-slate-900 text-white text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:20px_20px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
        <span class="inline-block px-4 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
          Hızlı Kurulum • Canlı Stok Takibi
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">
          Stoklarınızı Bugün Kontrol Altına Alın!
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Hemen ücretsiz hesabınızı açın, ilk ürünlerinizi ekleyin veya Excel'den tek tıkla yükleyerek hatasız takibe başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold rounded-xl shadow-xl shadow-amber-500/30 transition-all text-center">
            🚀 Hemen Giriş Yapın & Başlayın
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center">
            🎁 14 Gün Ücretsiz Deneyin
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
