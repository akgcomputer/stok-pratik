---
// src/pages/piyasa-radari.astro - Stok Pratik Canlı Piyasa Radarı & Akıllı Yatırımcı Hesaplayıcısı
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Canlı Piyasa Radarı & Akıllı Yatırımcı Hesaplayıcısı | Stok Pratik Bulut ERP"
  description="Serbest piyasa ve Kapalıçarşı / Harem canlı altın, döviz kurları, LME sanayi metalleri, petrol ve kripto verileri. X TL ile ne kadar altın, dolar veya hammadde alınır anında hesaplayın."
>
  <div class="bg-[#0c0e12] text-slate-100 min-h-screen py-6 lg:py-10 selection:bg-red-600 selection:text-white">
    <div class="container mx-auto px-4 lg:px-8 max-w-7xl">

      <!-- ========================================== -->
      <!-- KATMAN A: ÜST CANLI KAYAN BANT (TICKER)   -->
      <!-- ========================================== -->
      <div class="mb-8 bg-[#141820] border border-slate-800 rounded-2xl overflow-hidden shadow-2xl">
        <div class="flex items-center">
          <!-- Başlık Rozeti -->
          <div class="flex-shrink-0 bg-red-600 text-white px-4 py-3 flex items-center gap-2 font-black text-xs md:text-sm tracking-wider uppercase z-10 shadow-lg">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
            </span>
            <span>PİYASA RADARI</span>
          </div>

          <!-- Kayan Bant Alanı -->
          <div class="overflow-hidden whitespace-nowrap flex-1 py-3 relative font-mono text-xs md:text-sm">
            <div id="tickerTrack" class="inline-flex gap-8 animate-ticker">
              <span class="text-slate-400">Canlı kurlar yükleniyor...</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Sayfa Başlığı, Canlılık Durumu ve TV Modu Butonu -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Kapalıçarşı & Serbest Piyasa Anlık Verileri
          </div>
          <h1 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-white">
            Piyasa Radarı & Akıllı Hesaplayıcı
          </h1>
          <p class="text-slate-400 text-sm md:text-base mt-1">
            İşletmeniz ve yatırımlarınız için Kapalıçarşı altın, döviz, LME metalleri ve akaryakıt endeksi.
          </p>
        </div>

        <!-- Sağ Taraf: TV Tam Ekran, Yenile Butonu & Zaman Bilgisi -->
        <div class="flex items-center gap-3 flex-wrap">
          <div class="text-right">
            <div id="lastUpdateText" class="text-xs text-slate-400 font-mono">Son Güncelleme: --:--:--</div>
            <div class="text-[11px] text-emerald-400 font-medium flex items-center justify-end gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              30sn'de bir oto-yenilenir
            </div>
          </div>

          <!-- TV Tam Ekran Butonu -->
          <button 
            id="fullscreenBtn"
            class="flex items-center gap-2 px-3.5 py-2.5 bg-slate-800 hover:bg-slate-700 active:scale-95 border border-slate-700 rounded-xl text-xs md:text-sm font-bold text-amber-300 hover:text-white transition-all shadow-sm"
            title="TV / Monitör Tam Ekran Kiosk Modu"
          >
            <span>📺</span>
            <span class="hidden sm:inline">TV Tam Ekran</span>
          </button>

          <!-- Manuel Yenile Butonu -->
          <button 
            id="refreshBtn" 
            class="flex items-center gap-2 px-4 py-2.5 bg-red-600 hover:bg-red-700 active:scale-95 text-white rounded-xl text-xs md:text-sm font-bold transition-all shadow-md shadow-red-600/20"
            title="Kurları Şimdi Yenile"
          >
            <svg id="refreshIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span>Yenile</span>
          </button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- KATMAN B: YASAL UYARI VE VERİ KAYNAĞI BİLGİSİ -->
      <!-- ========================================== -->
      <div class="mb-8 p-4 rounded-2xl bg-amber-950/20 border border-amber-500/30 flex items-start gap-3 text-amber-200/90 text-xs md:text-sm">
        <span class="text-base flex-shrink-0">⚠️</span>
        <p class="leading-relaxed">
          <strong class="font-bold text-amber-300">Kapalıçarşı & Serbest Piyasa Bildirimi:</strong> 
          Piyasa Radarında yer alan altın ve döviz rakamları Serbest Piyasa (Kapalıçarşı / Harem Altın) anlık alış-satış verileridir. Banka ve kuyumcu makaslarına göre farklılık gösterebilir. Yatırım tavsiyesi niteliği taşımaz.
        </p>
      </div>

      <!-- ========================================== -->
      <!-- KATMAN C: AKILLI HESAPLAYICI (İLK SIRADA) -->
      <!-- ========================================== -->
      <section class="mb-12 bg-gradient-to-b from-[#161a22] to-[#101319] border border-slate-800 rounded-3xl p-6 lg:p-8 shadow-2xl relative overflow-hidden">
        <!-- Dekoratif Arka Plan Işıltısı -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 border-b border-slate-800/80 pb-5">
            <div>
              <span class="text-xs font-black tracking-widest text-red-500 uppercase">CANLI TİCARİ SİMÜLATÖR</span>
              <h2 class="text-2xl lg:text-3xl font-extrabold text-white mt-1">
                Akıllı Yatırımcı & Ticari Hesaplayıcı
              </h2>
            </div>

            <!-- Hesaplayıcı Mod Sekmeleri -->
            <div class="flex items-center gap-1.5 p-1 bg-[#0f1217] border border-slate-800 rounded-xl max-w-full overflow-x-auto">
              <button data-calc-tab="budget" class="calc-tab-btn active px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-bold transition-all text-white bg-red-600 shadow-sm whitespace-nowrap">
                X TL ile Ne Alınır?
              </button>
              <button data-calc-tab="target" class="calc-tab-btn px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all text-slate-400 hover:text-white whitespace-nowrap">
                Hedef Varlık Maliyeti
              </button>
              <button data-calc-tab="industry" class="calc-tab-btn px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all text-slate-400 hover:text-white whitespace-nowrap">
                Hammadde & Sanayi
              </button>
            </div>
          </div>

          <!-- MOD 1: Bütçe Dönüştürücü (X TL ile Ne Alınır?) -->
          <div id="calcModeBudget" class="calc-content-block">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              
              <!-- Sol: Tutar Girişi ve 2 Satırlı Hızlı Bütçe Butonları -->
              <div class="lg:col-span-4 bg-[#0f1217] border border-slate-800/80 p-5 rounded-2xl">
                <label for="budgetInput" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                  Hesaplanacak Bütçe (₺)
                </label>
                <div class="relative mb-4">
                  <input 
                    type="number" 
                    id="budgetInput" 
                    value="100000" 
                    min="1" 
                    step="1000"
                    class="w-full bg-[#181d26] border border-slate-700 focus:border-red-500 rounded-xl px-4 py-3 text-xl font-mono font-bold text-white outline-none transition-colors"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold">₺ TL</span>
                </div>

                <!-- 1. Satır Hızlı Seçenekler -->
                <span class="block text-[11px] font-semibold text-slate-500 mb-1.5 uppercase">Hızlı Bütçe Seçimi:</span>
                <div class="grid grid-cols-3 sm:grid-cols-5 gap-1.5 mb-2.5">
                  <button class="budget-chip px-2 py-1.5 bg-[#1b212b] hover:bg-slate-700 text-[11px] font-mono font-semibold rounded-lg text-slate-300 transition-colors" data-val="10000">10 Bin ₺</button>
                  <button class="budget-chip px-2 py-1.5 bg-[#1b212b] hover:bg-slate-700 text-[11px] font-mono font-semibold rounded-lg text-slate-300 transition-colors" data-val="50000">50 Bin ₺</button>
                  <button class="budget-chip px-2 py-1.5 bg-red-600/30 border border-red-500/50 text-[11px] font-mono font-bold rounded-lg text-white transition-colors" data-val="100000">100 Bin ₺</button>
                  <button class="budget-chip px-2 py-1.5 bg-[#1b212b] hover:bg-slate-700 text-[11px] font-mono font-semibold rounded-lg text-slate-300 transition-colors" data-val="250000">250 Bin ₺</button>
                  <button class="budget-chip px-2 py-1.5 bg-[#1b212b] hover:bg-slate-700 text-[11px] font-mono font-semibold rounded-lg text-slate-300 transition-colors" data-val="500000">500 Bin ₺</button>
                </div>

                <!-- 2. Satır: Prestijli Milyon Butonları (Renkli) -->
                <div class="grid grid-cols-3 gap-1.5 pt-2 border-t border-slate-800">
                  <button class="budget-chip px-2 py-2 bg-emerald-950/40 hover:bg-emerald-900/60 border border-emerald-500/40 text-emerald-300 text-xs font-bold rounded-lg transition-all text-center" data-val="1000000">
                    ✨ 1 Milyon ₺
                  </button>
                  <button class="budget-chip px-2 py-2 bg-amber-950/40 hover:bg-amber-900/60 border border-amber-500/40 text-amber-300 text-xs font-bold rounded-lg transition-all text-center" data-val="5000000">
                    ✨ 5 Milyon ₺
                  </button>
                  <button class="budget-chip px-2 py-2 bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/40 text-purple-300 text-xs font-bold rounded-lg transition-all text-center" data-val="10000000">
                    ✨ 10 Milyon ₺
                  </button>
                </div>
              </div>

              <!-- Sağ: Canlı Alım Gücü Sonuç Kartları (Altın Sarısı & Gümüş Gri Özel Renkli) -->
              <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                
                <!-- 1. Has Altın (24K) - GOLD TEMA -->
                <div class="bg-gradient-to-br from-amber-500/15 via-[#181d26] to-[#0f1217] border-2 border-amber-500/40 p-4 rounded-2xl relative overflow-hidden group hover:border-amber-400 transition-all shadow-lg shadow-amber-500/5">
                  <div class="flex items-center justify-between text-xs font-extrabold text-amber-300 mb-1">
                    <span class="tracking-wide">HAS ALTIN (24K)</span>
                    <span class="text-base">🪙</span>
                  </div>
                  <div id="resHasGold" class="text-2xl font-mono font-black text-amber-300 tracking-tight">-- gr</div>
                  <div class="text-[11px] text-amber-200/70 font-medium mt-0.5">Gram Külçe (.995) Alınabilir</div>
                  <div class="mt-2.5 pt-2 border-t border-amber-500/20 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-400 text-[11px]">Birim Fiyatı:</span>
                    <span id="rateHasGoldLabel" class="text-amber-300 font-bold">1 gr : -- ₺</span>
                  </div>
                </div>

                <!-- 2. Gram Altın (Kapalıçarşı) - GOLD TEMA -->
                <div class="bg-gradient-to-br from-amber-500/15 via-[#181d26] to-[#0f1217] border-2 border-amber-500/40 p-4 rounded-2xl relative overflow-hidden group hover:border-amber-400 transition-all shadow-lg shadow-amber-500/5">
                  <div class="flex items-center justify-between text-xs font-extrabold text-amber-300 mb-1">
                    <span class="tracking-wide">GRAM ALTIN (K.ÇARŞI)</span>
                    <span class="text-base">🪙</span>
                  </div>
                  <div id="resGoldGram" class="text-2xl font-mono font-black text-amber-300 tracking-tight">-- gr</div>
                  <div class="text-[11px] text-amber-200/70 font-medium mt-0.5">Harem / Kapalıçarşı Gram</div>
                  <div class="mt-2.5 pt-2 border-t border-amber-500/20 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-400 text-[11px]">Birim Fiyatı:</span>
                    <span id="rateGoldGramLabel" class="text-amber-300 font-bold">1 gr : -- ₺</span>
                  </div>
                </div>

                <!-- 3. Çeyrek Altın - GOLD TEMA -->
                <div class="bg-gradient-to-br from-amber-500/15 via-[#181d26] to-[#0f1217] border-2 border-amber-500/40 p-4 rounded-2xl relative overflow-hidden group hover:border-amber-400 transition-all shadow-lg shadow-amber-500/5">
                  <div class="flex items-center justify-between text-xs font-extrabold text-amber-300 mb-1">
                    <span class="tracking-wide">ÇEYREK ALTIN</span>
                    <span class="text-base">🏅</span>
                  </div>
                  <div id="resGoldCeyrek" class="text-2xl font-mono font-black text-amber-300 tracking-tight">-- adet</div>
                  <div class="text-[11px] text-amber-200/70 font-medium mt-0.5">Yeni Tarihli Çeyrek Alınabilir</div>
                  <div class="mt-2.5 pt-2 border-t border-amber-500/20 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-400 text-[11px]">Birim Fiyatı:</span>
                    <span id="rateCeyrekLabel" class="text-amber-300 font-bold">1 adet : -- ₺</span>
                  </div>
                </div>

                <!-- 4. Külçe Gümüş - GÜMÜŞ / SILVER TEMA -->
                <div class="bg-gradient-to-br from-slate-300/15 via-[#181d26] to-[#0f1217] border-2 border-slate-300/40 p-4 rounded-2xl relative overflow-hidden group hover:border-slate-200 transition-all shadow-lg shadow-slate-300/5">
                  <div class="flex items-center justify-between text-xs font-extrabold text-slate-200 mb-1">
                    <span class="tracking-wide">KÜLÇE GÜMÜŞ</span>
                    <span class="text-base">🥈</span>
                  </div>
                  <div id="resSilver" class="text-2xl font-mono font-black text-slate-100 tracking-tight">-- gr</div>
                  <div class="text-[11px] text-slate-300/70 font-medium mt-0.5">Gram Külçe Gümüş Alınabilir</div>
                  <div class="mt-2.5 pt-2 border-t border-slate-300/20 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-400 text-[11px]">Birim Fiyatı:</span>
                    <span id="rateSilverLabel" class="text-slate-100 font-bold">1 gr : -- ₺</span>
                  </div>
                </div>

                <!-- 5. Dolar ($) -->
                <div class="bg-gradient-to-br from-emerald-500/10 via-[#181d26] to-[#0f1217] border border-emerald-500/30 p-4 rounded-2xl relative overflow-hidden group hover:border-emerald-400 transition-all">
                  <div class="flex items-center justify-between text-xs font-extrabold text-emerald-400 mb-1">
                    <span class="tracking-wide">DOLAR (USD)</span>
                    <span class="text-base">💵</span>
                  </div>
                  <div id="resUsd" class="text-2xl font-mono font-black text-emerald-300 tracking-tight">--</div>
                  <div class="text-[11px] text-slate-400 font-medium mt-0.5">Amerikan Doları Alınabilir</div>
                  <div class="mt-2.5 pt-2 border-t border-slate-800 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-500 text-[11px]">Birim Fiyatı:</span>
                    <span id="rateUsdLabel" class="text-emerald-400 font-bold">1 $ : -- ₺</span>
                  </div>
                </div>

                <!-- 6. Euro (€) -->
                <div class="bg-gradient-to-br from-blue-500/10 via-[#181d26] to-[#0f1217] border border-blue-500/30 p-4 rounded-2xl relative overflow-hidden group hover:border-blue-400 transition-all">
                  <div class="flex items-center justify-between text-xs font-extrabold text-blue-400 mb-1">
                    <span class="tracking-wide">EURO (EUR)</span>
                    <span class="text-base">💶</span>
                  </div>
                  <div id="resEur" class="text-2xl font-mono font-black text-blue-300 tracking-tight">--</div>
                  <div class="text-[11px] text-slate-400 font-medium mt-0.5">Euro Alınabilir</div>
                  <div class="mt-2.5 pt-2 border-t border-slate-800 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-500 text-[11px]">Birim Fiyatı:</span>
                    <span id="rateEurLabel" class="text-blue-400 font-bold">1 € : -- ₺</span>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <!-- MOD 2: Hedef Varlık Maliyeti -->
          <div id="calcModeTarget" class="calc-content-block hidden">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end bg-[#0f1217] border border-slate-800/80 p-6 rounded-2xl">
              <div>
                <label for="targetAssetSelect" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                  Alınacak Varlık
                </label>
                <select id="targetAssetSelect" class="w-full bg-[#181d26] border border-slate-700 rounded-xl px-4 py-3 text-white font-semibold outline-none focus:border-red-500">
                  <option value="hasAltin">Has Altın (24K Külçe .995)</option>
                  <option value="gramAltin">Gram Altın (Kapalıçarşı / Harem)</option>
                  <option value="ceyrekAltin">Çeyrek Altın (Yeni)</option>
                  <option value="yarimAltin">Yarım Altın</option>
                  <option value="tamAltin">Tam Ziynet Altın</option>
                  <option value="ataAltin">Ata / Cumhuriyet Altını</option>
                  <option value="bilezik22">22 Ayar Bilezik (Gram)</option>
                  <option value="gumusGram">Külçe Gümüş (Gram)</option>
                  <option value="usd">Amerikan Doları ($)</option>
                  <option value="eur">Euro (€)</option>
                  <option value="gbp">İngiliz Sterlini (£)</option>
                  <option value="btcTry">Bitcoin (BTC)</option>
                </select>
              </div>

              <div>
                <label for="targetAmountInput" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                  Hedef Miktar / Adet
                </label>
                <input 
                  type="number" 
                  id="targetAmountInput" 
                  value="10" 
                  min="0.0001" 
                  step="1"
                  class="w-full bg-[#181d26] border border-slate-700 rounded-xl px-4 py-3 text-xl font-mono font-bold text-white outline-none focus:border-red-500"
                />
              </div>

              <div class="bg-[#181d26] border border-slate-700/80 p-4 rounded-xl flex items-center justify-between">
                <div>
                  <span class="text-xs text-slate-400 block font-semibold">GEREKEN TOPLAM TL:</span>
                  <div id="targetTotalCost" class="text-2xl font-mono font-black text-emerald-400">-- ₺</div>
                </div>
                <span class="text-2xl">💰</span>
              </div>
            </div>
          </div>

          <!-- MOD 3: Sanayi Hammadde & İmalat Maliyeti -->
          <div id="calcModeIndustry" class="calc-content-block hidden">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end bg-[#0f1217] border border-slate-800/80 p-6 rounded-2xl">
              <div>
                <label for="industryAssetSelect" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                  Hammadde / Enerji Kalemi
                </label>
                <select id="industryAssetSelect" class="w-full bg-[#181d26] border border-slate-700 rounded-xl px-4 py-3 text-white font-semibold outline-none focus:border-red-500">
                  <option value="bakir">LME Bakır (Katot) - Kg</option>
                  <option value="aluminyum">LME Alüminyum - Kg</option>
                  <option value="motorin">Motorin (Dizel) - Litre</option>
                  <option value="benzin">Kurşunsuz Benzin 95 - Litre</option>
                  <option value="brent">Brent Petrol - Varil</option>
                </select>
              </div>

              <div>
                <label for="industryAmountInput" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                  Kullanılacak Miktar (Kg / Litre / Varil)
                </label>
                <input 
                  type="number" 
                  id="industryAmountInput" 
                  value="500" 
                  min="1" 
                  step="50"
                  class="w-full bg-[#181d26] border border-slate-700 rounded-xl px-4 py-3 text-xl font-mono font-bold text-white outline-none focus:border-red-500"
                />
              </div>

              <div class="bg-[#181d26] border border-slate-700/80 p-4 rounded-xl flex items-center justify-between">
                <div>
                  <span class="text-xs text-slate-400 block font-semibold">İMALAT MALİYETİ:</span>
                  <div id="industryTotalCost" class="text-2xl font-mono font-black text-amber-400">-- ₺</div>
                </div>
                <span class="text-2xl">🏭</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ========================================== -->
      <!-- KATMAN D: PİYASA KARTLARI & KATEGORİLER    -->
      <!-- ========================================== -->
      <section>
        <!-- Kategori Filtre Butonları -->
        <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 scrollbar-none">
          <button data-filter="all" class="filter-btn active px-4 py-2 rounded-xl text-xs md:text-sm font-bold bg-white text-slate-900 shadow-md transition-all whitespace-nowrap">
            Tüm Piyasalar
          </button>
          <button data-filter="altin" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold bg-amber-500/10 text-amber-300 hover:text-white border border-amber-500/30 transition-all whitespace-nowrap">
            🪙 Altın & Gümüş
          </button>
          <button data-filter="doviz" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold bg-[#171c24] text-slate-300 hover:text-white border border-slate-800 transition-all whitespace-nowrap">
            💵 Döviz & Parite
          </button>
          <button data-filter="emtia" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold bg-[#171c24] text-slate-300 hover:text-white border border-slate-800 transition-all whitespace-nowrap">
            ⚙️ Sanayi Emtia & Petrol
          </button>
          <button data-filter="borsaFaiz" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold bg-[#171c24] text-slate-300 hover:text-white border border-slate-800 transition-all whitespace-nowrap">
            📈 Borsa & Faiz
          </button>
          <button data-filter="kripto" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold bg-[#171c24] text-slate-300 hover:text-white border border-slate-800 transition-all whitespace-nowrap">
            ₿ Kripto & USDT
          </button>
        </div>

        <!-- Kart Grid Alanı -->
        <div id="cardsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <div class="col-span-full py-16 text-center text-slate-500 font-mono">
            Piyasa verileri anlık olarak çekiliyor...
          </div>
        </div>
      </section>

      <!-- Alt Bilgi Notu & CTA -->
      <div class="mt-16 p-8 rounded-3xl bg-gradient-to-r from-red-950/30 via-slate-900 to-slate-900 border border-red-900/30 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-white mb-2">Finansınızı & Stoklarınızı Tek Panelden Yönetin</h3>
          <p class="text-slate-400 text-sm max-w-xl">
            Stok Pratik ile dövizli faturalar kesin, canlı Kapalıçarşı kurlarıyla anlık maliyet çıkarın ve kârınızı koruyun.
          </p>
        </div>
        <a href="https://stokpratik.com.tr/firma-kaydi" class="px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-red-600/30 whitespace-nowrap">
          1 Ay Ücretsiz Deneyin &rarr;
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-ticker {
    display: inline-flex;
    white-space: nowrap;
    animation: ticker 35s linear infinite;
  }
  .animate-ticker:hover {
    animation-play-state: paused;
  }
</style>

<script is:inline>
  let currentMarketData = null;

  async function fetchMarketData() {
    const refreshIcon = document.getElementById('refreshIcon');
    if (refreshIcon) refreshIcon.classList.add('animate-spin');

    try {
      const res = await fetch('/api/piyasa', { cache: 'no-cache' });
      if (!res.ok) throw new Error('API Hatası');
      const data = await res.json();
      currentMarketData = data;
      renderAll(data);
    } catch (err) {
      console.error('Piyasa verisi çekilemedi:', err);
    } finally {
      if (refreshIcon) {
        setTimeout(() => refreshIcon.classList.remove('animate-spin'), 600);
      }
    }
  }

  function renderAll(data) {
    updateTimestamp(data.updated_at || data.timestamp);
    renderTicker(data);
    updateCalculators(data.rates);
    renderCards(data, activeFilter);
  }

  function updateTimestamp(isoStr) {
    const el = document.getElementById('lastUpdateText');
    if (!el) return;
    const d = isoStr ? new Date(isoStr) : new Date();
    const time = d.toLocaleTimeString('tr-TR');
    el.textContent = `Son Güncelleme: ${time}`;
  }

  // Üst Kayan Bant (Ticker) Render
  function renderTicker(data) {
    const track = document.getElementById('tickerTrack');
    if (!track || !data) return;

    const r = data.rates;
    const items = [
      { name: 'HAS ALTIN', val: (r.hasAltin || 0).toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ' ₺', up: true, gold: true },
      { name: 'GRAM ALTIN', val: (r.gramAltin || 0).toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ' ₺', up: true, gold: true },
      { name: 'ÇEYREK ALTIN', val: (r.ceyrekAltin || 0).toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + ' ₺', up: true, gold: true },
      { name: 'GÜMÜŞ', val: (r.gumusGram || 0).toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ' ₺', up: true, silver: true },
      { name: 'USD/TRY', val: (r.usd || 0).toFixed(2) + ' ₺', up: true },
      { name: 'EUR/TRY', val: (r.eur || 0).toFixed(2) + ' ₺', up: false },
      { name: 'EUR/USD', val: (r.eurUsd || 0).toFixed(4), up: false },
      { name: 'LME BAKIR', val: (r.bakirKgTL || 0).toFixed(2) + ' ₺/Kg', up: true },
      { name: 'BRENT', val: '$' + (r.brentPetrolUsd || 0).toFixed(2), up: true },
      { name: 'MOTORİN', val: (r.motorinTL || 0).toFixed(2) + ' ₺/Lt', up: true },
      { name: 'BTC/USDT', val: '$' + (r.btcUsd || 0).toLocaleString('en-US'), up: true },
      { name: 'USDT/TRY', val: (r.usdt || 0).toFixed(2) + ' ₺', up: true }
    ];

    const generateHTML = () => items.map(i => `
      <span class="inline-flex items-center gap-2 px-3 py-1 bg-slate-900/80 border ${i.gold ? 'border-amber-500/40' : (i.silver ? 'border-slate-400/40' : 'border-slate-800')} rounded-lg">
        <span class="${i.gold ? 'text-amber-300 font-bold' : (i.silver ? 'text-slate-200 font-bold' : 'text-slate-400 font-bold')}">${i.name}</span>
        <span class="${i.gold ? 'text-amber-300' : 'text-white'} font-mono font-bold">${i.val}</span>
        <span class="${i.up ? 'text-emerald-400' : 'text-rose-400'} text-[10px]">${i.up ? '▲' : '▼'}</span>
      </span>
    `).join('');

    track.innerHTML = generateHTML() + generateHTML();
  }

  // Hesaplayıcı Değerlerini Güncelle (Birimleri ve 1 Birim Fiyatı ile)
  function updateCalculators(rates) {
    if (!rates) return;

    // Mod 1: Bütçe Hesapla
    const budgetInput = document.getElementById('budgetInput');
    const budget = parseFloat(budgetInput?.value) || 0;

    // 1. Has Altın
    const resHasGold = document.getElementById('resHasGold');
    const rateHasGoldLabel = document.getElementById('rateHasGoldLabel');
    if (resHasGold && rates.hasAltin) {
      resHasGold.textContent = (budget / rates.hasAltin).toFixed(2) + ' gr';
    }
    if (rateHasGoldLabel && rates.hasAltin) {
      rateHasGoldLabel.textContent = `1 gr : ${rates.hasAltin.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
    }

    // 2. Gram Altın
    const resGoldGram = document.getElementById('resGoldGram');
    const rateGoldGramLabel = document.getElementById('rateGoldGramLabel');
    if (resGoldGram && rates.gramAltin) {
      resGoldGram.textContent = (budget / rates.gramAltin).toFixed(2) + ' gr';
    }
    if (rateGoldGramLabel && rates.gramAltin) {
      rateGoldGramLabel.textContent = `1 gr : ${rates.gramAltin.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
    }

    // 3. Çeyrek Altın
    const resGoldCeyrek = document.getElementById('resGoldCeyrek');
    const rateCeyrekLabel = document.getElementById('rateCeyrekLabel');
    if (resGoldCeyrek && rates.ceyrekAltin) {
      resGoldCeyrek.textContent = (budget / rates.ceyrekAltin).toFixed(1) + ' adet';
    }
    if (rateCeyrekLabel && rates.ceyrekAltin) {
      rateCeyrekLabel.textContent = `1 adet : ${rates.ceyrekAltin.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
    }

    // 4. Külçe Gümüş
    const resSilver = document.getElementById('resSilver');
    const rateSilverLabel = document.getElementById('rateSilverLabel');
    if (resSilver && rates.gumusGram) {
      resSilver.textContent = (budget / rates.gumusGram).toFixed(1) + ' gr';
    }
    if (rateSilverLabel && rates.gumusGram) {
      rateSilverLabel.textContent = `1 gr : ${rates.gumusGram.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
    }

    // 5. Dolar
    const resUsd = document.getElementById('resUsd');
    const rateUsdLabel = document.getElementById('rateUsdLabel');
    if (resUsd && rates.usd) {
      resUsd.textContent = '$' + (budget / rates.usd).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (rateUsdLabel && rates.usd) {
      rateUsdLabel.textContent = `1 $ : ${rates.usd.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
    }

    // 6. Euro
    const resEur = document.getElementById('resEur');
    const rateEurLabel = document.getElementById('rateEurLabel');
    if (resEur && rates.eur) {
      resEur.textContent = '€' + (budget / rates.eur).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (rateEurLabel && rates.eur) {
      rateEurLabel.textContent = `1 € : ${rates.eur.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
    }

    // Mod 2: Hedef Varlık
    const targetSelect = document.getElementById('targetAssetSelect');
    const targetAmountInput = document.getElementById('targetAmountInput');
    const targetTotalCost = document.getElementById('targetTotalCost');

    if (targetSelect && targetAmountInput && targetTotalCost) {
      const assetKey = targetSelect.value;
      const qty = parseFloat(targetAmountInput.value) || 0;
      const unitRate = rates[assetKey] || 0;
      const total = qty * unitRate;
      targetTotalCost.textContent = total.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
    }

    // Mod 3: Sanayi Hammadde
    const indSelect = document.getElementById('industryAssetSelect');
    const indAmountInput = document.getElementById('industryAmountInput');
    const indTotalCost = document.getElementById('industryTotalCost');

    if (indSelect && indAmountInput && indTotalCost) {
      const indKey = indSelect.value;
      const qty = parseFloat(indAmountInput.value) || 0;
      let unitTL = 0;
      if (indKey === 'bakir') unitTL = rates.bakirKgTL;
      else if (indKey === 'aluminyum') unitTL = rates.aluminyumKgTL;
      else if (indKey === 'motorin') unitTL = rates.motorinTL;
      else if (indKey === 'benzin') unitTL = rates.benzinTL;
      else if (indKey === 'brent') unitTL = rates.brentPetrolUsd * rates.usd;

      const total = qty * unitTL;
      indTotalCost.textContent = total.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
    }
  }

  // Kartları Render Et (Altın = Gold Sarısı, Gümüş = Silver Gri)
  let activeFilter = 'all';

  function renderCards(data, filter) {
    const grid = document.getElementById('cardsGrid');
    if (!grid || !data) return;

    let cardsHTML = '';

    const createCard = (title, code, buy, sell, change, trend, unit, subtitle = '', theme = 'default') => {
      const isUp = trend === 'up' || (typeof change === 'number' && change >= 0) || (typeof change === 'string' && !change.startsWith('-'));
      
      let borderStyle = 'border-slate-800 hover:border-slate-700 bg-[#161a22]';
      let titleStyle = 'text-white group-hover:text-red-400';
      let codeBadgeStyle = 'text-slate-400 bg-slate-800/80';
      let valueColor = 'text-white';

      if (theme === 'gold') {
        borderStyle = 'border-amber-500/40 hover:border-amber-400 bg-gradient-to-br from-amber-500/10 via-[#181d26] to-[#101319] shadow-lg shadow-amber-500/5';
        titleStyle = 'text-amber-300 group-hover:text-amber-200';
        codeBadgeStyle = 'text-amber-300 bg-amber-500/20 border border-amber-500/30';
        valueColor = 'text-amber-300';
      } else if (theme === 'silver') {
        borderStyle = 'border-slate-300/40 hover:border-slate-200 bg-gradient-to-br from-slate-300/10 via-[#181d26] to-[#101319] shadow-lg shadow-slate-300/5';
        titleStyle = 'text-slate-100 group-hover:text-white';
        codeBadgeStyle = 'text-slate-200 bg-slate-300/20 border border-slate-300/30';
        valueColor = 'text-slate-100';
      }

      const formattedBuy = typeof buy === 'number' ? buy.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : buy;
      const formattedSell = typeof sell === 'number' ? sell.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : sell;
      const formattedChange = typeof change === 'number' ? (change > 0 ? `+${change.toFixed(2)}%` : `${change.toFixed(2)}%`) : change;

      return `
        <div class="${borderStyle} p-5 rounded-2xl transition-all group hover:-translate-y-1">
          <div class="flex items-center justify-between mb-3">
            <div>
              <span class="text-xs font-mono font-bold px-2 py-0.5 rounded ${codeBadgeStyle} inline-block mb-1">${code}</span>
              <h4 class="text-sm font-bold ${titleStyle} transition-colors">${title}</h4>
            </div>
            <span class="px-2 py-1 rounded-lg text-xs font-mono font-bold ${isUp ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20'}">
              ${isUp ? '▲' : '▼'} ${formattedChange}
            </span>
          </div>

          <div class="space-y-1.5 pt-2 border-t border-slate-800/60 font-mono">
            ${buy !== null && buy !== undefined ? `
              <div class="flex items-center justify-between text-xs">
                <span class="text-slate-400">Alış:</span>
                <span class="text-slate-300 font-semibold">${formattedBuy} ${unit || ''}</span>
              </div>
            ` : ''}
            ${sell !== null && sell !== undefined ? `
              <div class="flex items-center justify-between text-sm">
                <span class="text-slate-400 font-bold">${buy !== null && buy !== undefined ? 'Satış:' : 'Fiyat:'}</span>
                <span class="${valueColor} font-extrabold text-base">${formattedSell} ${unit || ''}</span>
              </div>
            ` : ''}
            ${subtitle ? `
              <div class="text-[11px] text-slate-500 pt-1 text-right">${subtitle}</div>
            ` : ''}
          </div>
        </div>
      `;
    };

    // 1. Altın & Gümüş (Öncelikli)
    if ((filter === 'all' || filter === 'altin') && data.altinMaden) {
      data.altinMaden.forEach(a => {
        const isSilver = a.id === 'gumus_gram';
        const theme = isSilver ? 'silver' : 'gold';
        const subtitle = a.id === 'ons_altin' ? 'Uluslararası Referans ($)' : 'Kapalıçarşı / Harem';
        cardsHTML += createCard(a.name, a.unit === '$' ? 'ONS' : (isSilver ? 'GÜMÜŞ' : 'ALTIN'), a.buying, a.selling || a.price, a.change, a.trend, a.unit, subtitle, theme);
      });
    }

    // 2. Döviz & Parite
    if ((filter === 'all' || filter === 'doviz') && data.doviz) {
      data.doviz.forEach(d => {
        const subtitle = d.id === 'tcmb_usd' ? 'TCMB Resmi Gösterge' : 'Kapalıçarşı Serbest Piyasa';
        cardsHTML += createCard(d.name, d.code, d.buying, d.selling, d.change, d.trend, '₺', subtitle, 'default');
      });
    }

    // 3. Emtia & Petrol
    if ((filter === 'all' || filter === 'emtia') && data.emtia) {
      data.emtia.forEach(e => {
        cardsHTML += createCard(e.name, e.symbol, null, e.price, e.change, e.trend, e.unit, 'Piyasa Referansı', 'default');
      });
    }

    // 4. Borsa & Faiz
    if ((filter === 'all' || filter === 'borsaFaiz') && data.borsa) {
      data.borsa.forEach(b => {
        cardsHTML += createCard(b.name, b.code, null, b.price, b.change, b.trend, b.unit || 'Puan', 'Borsa İstanbul / TCMB', 'default');
      });
    }

    // 5. Kripto
    if ((filter === 'all' || filter === 'kripto') && data.kripto) {
      data.kripto.forEach(k => {
        const unit = k.code.includes('USDT') || k.code.includes('USD') ? '$' : '₺';
        cardsHTML += createCard(k.name, k.code, null, k.price, k.change, k.trend, unit, 'Binance Canlı Ticker', 'default');
      });
    }

    grid.innerHTML = cardsHTML;
  }

  // TV / Kiosk Tam Ekran Modu Fonksiyonu
  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => {
        console.warn('Tam ekran moduna geçilemedi:', err);
      });
    } else {
      if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    }
  }

  // Olay Dinleyicileri (Event Listeners)
  function setupEvents() {
    // Manuel Yenile Butonu
    const refreshBtn = document.getElementById('refreshBtn');
    if (refreshBtn) {
      refreshBtn.onclick = fetchMarketData;
    }

    // TV Tam Ekran Butonu
    const fsBtn = document.getElementById('fullscreenBtn');
    if (fsBtn) {
      fsBtn.onclick = toggleFullscreen;
    }

    // Hesaplayıcı Sekme Değişimi
    const tabButtons = document.querySelectorAll('[data-calc-tab]');
    tabButtons.forEach(btn => {
      btn.onclick = () => {
        const tabKey = btn.getAttribute('data-calc-tab');
        tabButtons.forEach(b => {
          b.classList.remove('active', 'bg-red-600', 'text-white');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('active', 'bg-red-600', 'text-white');
        btn.classList.remove('text-slate-400');

        document.querySelectorAll('.calc-content-block').forEach(b => b.classList.add('hidden'));
        if (tabKey === 'budget') document.getElementById('calcModeBudget')?.classList.remove('hidden');
        if (tabKey === 'target') document.getElementById('calcModeTarget')?.classList.remove('hidden');
        if (tabKey === 'industry') document.getElementById('calcModeIndustry')?.classList.remove('hidden');
      };
    });

    // Bütçe Hızlı Seçim Butonları (1. Satır ve 2. Satır Milyon Butonları)
    const chips = document.querySelectorAll('.budget-chip');
    const budgetInput = document.getElementById('budgetInput');
    chips.forEach(c => {
      c.onclick = () => {
        const val = c.getAttribute('data-val');
        if (budgetInput && val) {
          budgetInput.value = val;
          if (currentMarketData) updateCalculators(currentMarketData.rates);
        }
      };
    });

    // Hesaplayıcı Canlı Girdi Dinleyicileri
    if (budgetInput) {
      budgetInput.oninput = () => {
        if (currentMarketData) updateCalculators(currentMarketData.rates);
      };
    }

    const targetSelect = document.getElementById('targetAssetSelect');
    const targetAmountInput = document.getElementById('targetAmountInput');
    if (targetSelect) targetSelect.onchange = () => updateCalculators(currentMarketData?.rates);
    if (targetAmountInput) targetAmountInput.oninput = () => updateCalculators(currentMarketData?.rates);

    const indSelect = document.getElementById('industryAssetSelect');
    const indAmountInput = document.getElementById('industryAmountInput');
    if (indSelect) indSelect.onchange = () => updateCalculators(currentMarketData?.rates);
    if (indAmountInput) indAmountInput.oninput = () => updateCalculators(currentMarketData?.rates);

    // Kategori Filtre Butonları
    const filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach(fb => {
      fb.onclick = () => {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-md');
          b.classList.add('bg-[#171c24]', 'text-slate-300');
        });
        fb.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-md');
        fb.classList.remove('bg-[#171c24]', 'text-slate-300');

        activeFilter = fb.getAttribute('data-filter') || 'all';
        if (currentMarketData) renderCards(currentMarketData, activeFilter);
      };
    });
  }

  // Başlatma ve 30 saniyede bir otomatik yenileme döngüsü
  let timerInterval = null;

  function initPage() {
    setupEvents();
    fetchMarketData();

    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      fetchMarketData();
    }, 30000);
  }

  document.addEventListener('DOMContentLoaded', initPage);
  document.addEventListener('astro:page-load', initPage);
</script>
