          <a href="/teknik-servis-yonetimi-ve-online-cihaz-takip" class="sitemap-item"><span>📲</span> Cihaz & Servis Durum Takibi</a>
          <a href="/bakim-onarim-yonetimi" class="sitemap-item"><span>🧰</span> Bakım Onarım Yönetimi</a>
        </div>
      </section>

      <!-- 6. PAZARYERİ, E-TİCARET, B2B & DEPO WMS -->
      <section id="pazaryeri-b2b" class="sitemap-category-group bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-200">
