---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Gıda, Market ve Şarküteri Barkod Satış Programı | Stok Pratik";
const pageDescription = "Terazi ve kantar entegreli hızlı market ve şarküteri kasa yazılımı. Gramajlı ürün satışı, SKT takibi ve açık veresiye hesap yönetimi!";

const features = [
  { icon: "⚖️", title: "Terazi & Kantar Bağlantısı", desc: "Barkodlu veya PC bağlantılı terazilerden çıkan gramajlı etiketleri kasada otomatik okutun ve hesaplayın.", details: ["Barkodlu terazi", "PC bağlantılı kantar", "Otomatik gramaj hesaplama"] },
  { icon: "📋", title: "Dijital Veresiye Defteri", desc: "Mahalle esnafının vazgeçilmezi olan 'yaz deftere' kültürünü dijitalleştirin. Alacaklarınızı tek ekranda görün.", details: ["Açık hesap takibi", "Ödeme hatırlatma", "Bakiye görüntüleme"] },
  { icon: "📱", title: "Cep Telefonu İle Hızlı Sayım", desc: "Pahalı el terminallerine gerek kalmadan, çalışanlarınız kendi akıllı telefonlarıyla raftaki ürünleri sayabilir.", details: ["Mobil sayım", "Bulut senkron", "Raporlama"] },
  { icon: "📄", title: "Alış Faturası Maliyet Güncelleme", desc: "Toptancıdan gelen XML veya e-faturaları içeri aktararak değişen alış fiyatlarınızı otomatik güncelleyin.", details: ["XML/e-Fatura içe aktar", "Otomatik maliyet güncelleme", "Kar marjı hesaplama"] },
  { icon: "⚠️", title: "SKT Uyarı Sistemi", desc: "Tarihi yaklaşan süt ürünleri ve şarküteri ürünleri için alarm alın, çöpe gitmeden indirime sokun.", details: ["SKT takibi", "Otomatik uyarı", "İndirim kampanyası"] },
  { icon: "📊", title: "Kasa Gün Sonu Z Raporu", desc: "Günün sonunda kasadaki nakit, pos ve veresiye toplamlarını kuruşu kuruşuna hatasız alın.", details: ["Nakit/Kart/Veresiye ayrımı", "Toplam ciro", "Excel çıktısı"] }
];

const faqs = [
  { q: "Barkodu olmayan sebze/meyveleri nasıl satacağım?", a: "Hızlı satış (POS) ekranımızda ürünlerin resimlerini ekleyebileceğiniz dokunmatik 'Hızlı Tuşlar' bulunur. Üstüne tıklayıp kilosuyla çarparak saniyeler içinde satabilirsiniz." },
  { q: "Sistemde kaç tane terazi tanımlayabiliriz?", a: "Sınır yok! Manav, kasap ve şarküteri reyonlarınızdaki tüm terazilerden çıkan 27'li veya 29'lu barkodları sistemimiz otomatik tanır ve hesaplar." },
  { q: "Müşterime fiş vermem gerekiyor mu?", a: "Mevcut termal fiş yazıcınızdan bilgi fişi yazdırabilir veya dilerseniz e-Arşiv faturası keserek müşterinize SMS/Email ile gönderebilirsiniz." }
];

const stats = [
  { number: "%50", label: "Kasa Süresi Azalması", icon: "⏱️" },
  { number: "%40", label: "Veresiye Hatası Azalması", icon: "✅" },
  { number: "%30", label: "Ziyan Azalması", icon: "📈" },
  { number: "7/24", label: "Kesintisiz Çalışma", icon: "🛡️" }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <span class="badge">🛒 Market & Şarküteri</span>
          <h1>Market ve Şarküteriler İçin <span class="highlight">Terazi Entegreli Yıldırım Hızında Kasa Programı!</span></h1>
          <p class="subtitle">{pageDescription}</p>
          <div class="stats">
            {stats.map(s => (
              <div class="stat" key={s.label}>
                <div class="stat-icon">{s.icon}</div>
                <div class="stat-number">{s.number}</div>
                <div class="stat-label">{s.label}</div>
              </div>
            ))}
          </div>
          <div class="buttons">
            <a href="https://wa.me/+905325000999?text=Merhaba,%20Market%20programı%20demo%20istiyorum" target="_blank" rel="noopener" class="btn btn-primary">📅 Demo İste</a>
            <a href="tel:+905325000999" class="btn btn-secondary">📞 0532 500 09 99</a>
          </div>
          <div class="tags">
            <span>⚖️ Terazi</span>
            <span>📋 Veresiye</span>
            <span>⚠️ SKT Uyarı</span>
            <span>📱 Mobil Sayım</span>
          </div>
        </div>
        <div class="hero-image">
          <div class="dashboard">
            <div class="dash-header"><span>🏪 Market POS</span><span>Bugün</span></div>
            <div class="dash-cards">
              <div><div class="dash-label">Toplam Satış</div><div class="dash-value">₺8.450</div></div>
              <div><div class="dash-label">Fiş Sayısı</div><div class="dash-value">34</div></div>
              <div><div class="dash-label">Veresiye</div><div class="dash-value warning">₺1.200</div></div>
            </div>
            <div class="dash-list">
              <div><span>🥩 Dana Kıyma (0.75kg)</span><span class="badge-stock">₺225</span></div>
              <div><span>🧀 Kaşar Peynir (1.2kg)</span><span class="badge-stock">₺180</span></div>
              <div><span>🥛 Süt (3 adet)</span><span class="badge-stock danger">SKT: 2 gün</span></div>
            </div>
            <div class="dash-alert">⚠️ 3 üründe SKT yaklaşıyor!</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KARŞILAŞTIRMA -->
  <section class="compare">
    <div class="container">
      <h2>Eski Yazar Kasa mı, Stok Pratik mi?</h2>
      <p class="section-desc">Hangisi işletmenize daha çok kazandırır?</p>
      <div class="compare-grid">
        <div class="compare-old">
          <div class="compare-icon">📵</div>
          <h3>Eski Nesil Yazar Kasalar</h3>
          <ul>
            <li>Düğmeleri bozuk, yavaş ve hantal donanımlar</li>
            <li>Raftaki fiyatla kasadaki fiyatın uyuşmaması</li>
            <li>Veresiyelerin defterde silinip kaybolması</li>
            <li>Tarihi geçmiş ürünlerin fark edilmemesi</li>
          </ul>
        </div>
        <div class="compare-new">
          <div class="compare-icon">🚀</div>
          <h3>Stok Pratik Market Yazılımı</h3>
          <ul>
            <li>İstediğiniz bilgisayardan dokunmatik hızlı satış</li>
            <li>Fiyat değişikliklerinin anında kasaya yansıması</li>
            <li>Güvenli ve şeffaf dijital veresiye (açık hesap)</li>
            <li>SKT alarmları ile sıfır ziyan</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ÖZELLİKLER -->
  <section class="features">
    <div class="container">
      <h2>Bakkal, Market ve Şarküterileri Hızlandıran Araçlar</h2>
      <p class="section-desc">Tüm ihtiyaçlarınız için özel çözümler</p>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card" key={f.title}>
            <div class="feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
            <ul>
              {f.details.map(d => <li key={d}>✓ {d}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  
    <div class="container">
      <h2>Market Kasasında Hayat Kurtaran Süreç</h2>
      <p class="section-desc">3 adımda satışları hızlandırın</p>
      <div class="steps-grid">
        <div class="step"><span class="step-num">1</span><span class="step-icon">🏷️</span><h3>Barkodları Okutun</h3><p>Ürünlerin standart barkodlarını veya teraziden çıkan gramaj barkodlarını okuyucuyla taratın.</p></div>
        <div class="step"><span class="step-num">2</span><span class="step-icon">💰</span><h3>Ödemeyi Seçin</h3><p>Müşterinin ödeme tipini (Nakit, Kredi Kartı, Veresiye, Parçalı) saniyeler içinde belirleyin.</p></div>
        <div class="step"><span class="step-num">3</span><span class="step-icon">🧾</span><h3>Fişi Kesip Yollayın</h3><p>Fiş yazıcısından çıktıyı alın, stok anında düşsün ve sıradaki müşteriye hemen geçin.</p></div>
      </div>
      <div class="steps-result">
        <span class="result-icon">🎉</span>
        <div><h3>Kuyruklar Tarih Olsun, Satışlar Uçuşa Geçsin!</h3><p>Stok Pratik Market ile işletmenizde düzen ve hız kazanın.</p></div>
      </div>
    </div>
  </section>

  <!-- ENTEGRASYON -->
  <section class="integrations">
    <div class="container">
      <h2>Uyumlu Donanım ve Sistemler</h2>
      <p class="section-desc">Tüm cihazlarla tak-çalıştır uyumu</p>
      <div class="integ-grid">
        <div><span>⚖️</span><h3>Terazi & Kantar</h3><p>Tüm markalar</p></div>
        <div><span>🖨️</span><h3>Fiş Yazıcı</h3><p>Termal makbuz</p></div>
        <div><span>📱</span><h3>Mobil Cihaz</h3><p>Telefon/Tablet</p></div>
        <div><span>🔒</span><h3>Ödeme POS</h3><p>Bankalar ile entegre</p></div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="faq">
    <div class="container">
      <h2>Sıkça Sorulan Sorular</h2>
      <div class="faq-list">
        {faqs.map(f => (
          <details key={f.q}>
            <summary>{f.q} <span>▼</span></summary>
            <div class="faq-answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <div class="cta-box">
        <span class="cta-icon">🛒</span>
        <h2>Market ve Şarküterinizi Dijitalleştirmeye Hazır mısınız?</h2>
        <p>Hemen ücretsiz demo talep edin, terazi entegreli satışa başlayın.</p>
        <div class="cta-buttons">
          <a href="https://wa.me/+905325000999?text=Merhaba,%20Market%20programı%20demo%20istiyorum" target="_blank" rel="noopener" class="btn btn-primary">📅 Demo İste</a>
          <a href="tel:+905325000999" class="btn btn-secondary">📞 Canlı Destek</a>
        </div>
        <div class="cta-benefits">
          <span>🎯 Ücretsiz Kurulum</span>
          <span>👨‍🏫 Canlı Eğitim</span>
          <span>🔄 Veri Aktarımı</span>
          <span>💰 Özel Fiyat</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ===== TEMEL ===== */
    *{box-sizing:border-box;margin:0;padding:0}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}

    /* ===== HERO - TURUNCU / LACİVERT ===== */
    .hero{background:linear-gradient(135deg,#0D1B3E,#1A2A6C);color:#fff;padding:60px 0}
    .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
    .badge{display:inline-block;background:rgba(255,255,255,.15);padding:6px 18px;border-radius:20px;font-size:.9rem;margin-bottom:16px}
    .hero h1{font-size:2.8rem;line-height:1.2;margin-bottom:16px;color:#ffffff}
    .highlight{color:#FF7A00}
    .subtitle{font-size:1.1rem;opacity:.9;margin-bottom:30px}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:20px 0}
    .stat{background:rgba(255,255,255,.08);padding:12px;border-radius:10px;text-align:center}
    .stat-icon{font-size:1.5rem}
    .stat-number{font-size:1.4rem;font-weight:700;color:#FF7A00}
    .stat-label{font-size:.75rem;opacity:.8}
    .buttons{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}
    .btn{display:inline-block;padding:12px 28px;border-radius:8px;font-weight:700;text-decoration:none;transition:.3s}
    .btn-primary{background:#FF7A00;color:#0D1B3E}
    .btn-primary:hover{background:#E66A00;transform:translateY(-2px)}
    .btn-secondary{background:rgba(255,255,255,.15);color:#fff;border:2px solid rgba(255,255,255,.2)}
    .btn-secondary:hover{background:rgba(255,255,255,.25);transform:translateY(-2px)}
    .tags{display:flex;gap:10px;flex-wrap:wrap}
    .tags span{background:rgba(255,255,255,.08);padding:4px 14px;border-radius:16px;font-size:.85rem}

    /* ===== DASHBOARD ===== */
    .dashboard{background:#fff;color:#333;border-radius:16px;padding:20px;box-shadow:0 20px 40px rgba(0,0,0,.3)}
    .dash-header{display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem;padding-bottom:12px;border-bottom:2px solid #eee}
    .dash-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0}
    .dash-cards>div{background:#f5f5f5;padding:10px;border-radius:8px;text-align:center}
    .dash-label{font-size:.75rem;color:#777}
    .dash-value{font-size:1.4rem;font-weight:700;color:#0D1B3E}
    .dash-value.warning{color:#E65100}
    .dash-list>div{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;font-size:.9rem}
    .badge-stock{background:#e8f5e9;padding:2px 10px;border-radius:12px;font-size:.8rem;color:#2e7d32}
    .badge-stock.danger{background:#ffebee;color:#c62828}
    .dash-alert{background:#fff8e1;border:1px solid #ffecb3;padding:8px;border-radius:8px;margin-top:12px;font-size:.9rem;color:#E65100}

    /* ===== KARŞILAŞTIRMA ===== */
    .compare{padding:60px 0;background:#f5f7ff}
    .compare h2{text-align:center;font-size:2.2rem;color:#0D1B3E}
    .section-desc{text-align:center;color:#777;margin-bottom:36px;font-size:1.05rem}
    .compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}
    .compare-old,.compare-new{padding:28px;border-radius:16px;box-shadow:0 4px 12px rgba(0,0,0,.06)}
    .compare-old{background:#fff;border-top:5px solid #E65100}
    .compare-new{background:linear-gradient(135deg,#0D1B3E,#1A2A6C);color:#fff;border-top:5px solid #FF7A00}
    .compare-icon{font-size:2.5rem;margin-bottom:10px}
    .compare-old h3{color:#0D1B3E}
    .compare-new h3{color:#fff}
    .compare-old ul,.compare-new ul{list-style:none;padding:0;margin-top:12px}
    .compare-old li,.compare-new li{padding:6px 0;padding-left:28px;position:relative}
    .compare-old li:before{content:"❌";position:absolute;left:0;color:#E65100}
    .compare-new li:before{content:"✅";position:absolute;left:0;color:#FF7A00}

    /* ===== ÖZELLİKLER ===== */
    .features{padding:60px 0;background:#fff}
    .features h2{text-align:center;font-size:2.2rem;color:#0D1B3E}
    .features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .feature-card{background:#fafaff;padding:24px;border-radius:14px;border:2px solid transparent;transition:.3s}
    .feature-card:hover{border-color:#FF7A00;transform:translateY(-4px);box-shadow:0 8px 24px rgba(255,122,0,.15)}
    .feature-icon{font-size:2.2rem;margin-bottom:10px}
    .feature-card h3{color:#0D1B3E;font-size:1.15rem;margin-bottom:6px}
    .feature-card p{color:#666;font-size:.92rem;line-height:1.5}
    .feature-card ul{list-style:none;padding:0;margin-top:10px}
    .feature-card li{color:#555;font-size:.88rem;padding:3px 0}

    /* ===== ADIMLAR - GENİŞ ===== */
    .steps{padding:60px 0;background:#f5f7ff}
    .steps h2{text-align:center;font-size:2.2rem;color:#0D1B3E}
    .steps-grid{display:grid;grid-template-columns: repeat(3, 1fr);gap:30px;margin-bottom:30px}
    .step{background:#fff;padding:28px 20px;border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,.06);position:relative;text-align:center}
    .step-num{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#FF7A00;color:#fff;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.9rem}
    .step-icon{font-size:2.5rem;display:block;margin:10px 0 12px}
    .step h3{color:#0D1B3E;font-size:1.2rem;margin-bottom:8px}
    .step p{color:#555;font-size:.95rem;line-height:1.5;max-width:90%;margin:0 auto}
    .steps-result{display:flex;align-items:center;gap:24px;background:linear-gradient(135deg,#FF7A00,#E66A00);padding:28px 36px;border-radius:14px;color:#fff}
    .result-icon{font-size:3.5rem}
    .steps-result h3{font-size:1.4rem;margin-bottom:4px}

    /* ===== ENTEGRASYON ===== */
    .integrations{padding:60px 0;background:#fff}
    .integrations h2{text-align:center;font-size:2.2rem;color:#0D1B3E}
    .integ-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
    .integ-grid>div{text-align:center;background:#fafaff;padding:24px;border-radius:14px;transition:.3s}
    .integ-grid>div:hover{transform:translateY(-4px);box-shadow:0 6px 16px rgba(0,0,0,.08)}
    .integ-grid span{font-size:2.5rem;display:block}
    .integ-grid h3{color:#0D1B3E;margin:8px 0 4px;font-size:1rem}
    .integ-grid p{color:#777;font-size:.85rem}

    /* ===== SSS ===== */
    .faq{padding:60px 0;background:#f5f7ff}
    .faq h2{text-align:center;font-size:2.2rem;color:#0D1B3E}
    .faq-list{max-width:760px;margin:0 auto}
    .faq-list details{background:#fff;border:1px solid #e0e5f0;border-radius:10px;padding:4px 20px;margin-bottom:12px}
    .faq-list summary{display:flex;justify-content:space-between;padding:14px 0;font-weight:600;color:#0D1B3E;cursor:pointer;list-style:none}
    .faq-list summary::-webkit-details-marker{display:none}
    .faq-list details[open] summary span{transform:rotate(180deg)}
    .faq-answer{padding:0 0 18px;color:#555;border-top:1px solid #eee;padding-top:14px;line-height:1.6}

    /* ===== CTA ===== */
    .cta{padding:60px 0;background:#0D1B3E}
    .cta-box{text-align:center;color:#fff}
    .cta-icon{font-size:3.5rem;display:block;margin-bottom:12px}
    .cta-box h2{font-size:2.2rem;margin-bottom:10px}
    .cta-box p{font-size:1.1rem;opacity:.9;margin-bottom:24px}
    .cta-buttons{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-bottom:24px}
    .cta-benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:700px;margin:0 auto}
    .cta-benefits span{background:rgba(255,255,255,.08);padding:8px 12px;border-radius:20px;font-size:.9rem}

    /* ===== RESPONSIVE ===== */
    @media(max-width:992px){
      .hero-grid{grid-template-columns:1fr}
      .hero h1{font-size:2.2rem}
      .stats{grid-template-columns:repeat(2,1fr)}
      .features-grid{grid-template-columns:repeat(2,1fr)}
      .integ-grid{grid-template-columns:repeat(2,1fr)}
      .compare-grid{grid-template-columns:1fr}
      .steps-grid{grid-template-columns:1fr}
      .step p{max-width:100%}
      .cta-benefits{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:600px){
      .hero h1{font-size:1.8rem}
      .features-grid{grid-template-columns:1fr}
      .integ-grid{grid-template-columns:1fr}
      .dashboard .dash-cards{grid-template-columns:1fr}
      .buttons{flex-direction:column}
      .btn{width:100%;text-align:center}
      .cta-buttons{flex-direction:column}
      .steps-result{flex-direction:column;text-align:center}
    }
  </style>
</BaseLayout>