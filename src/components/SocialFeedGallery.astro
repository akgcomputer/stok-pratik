        data-category={post.category}
        data-shortcode={post.shortcode}
        data-mediatype={post.mediaType}
        data-permalink={post.permalink}
        data-title={post.title}
        data-badge={post.badge}
        data-caption={encodeURIComponent(post.caption)}
        data-thumbnail={post.thumbnail}
        data-date={post.date}
        data-likes={post.likes}
