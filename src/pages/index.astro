---
// src/pages/index.astro - Stok Pratik Kurumsal Ana Sayfa (Logo Yazılım Tarzı Modern Tasarım)
import BaseLayout from '../layouts/BaseLayout.astro';

const slides = [
  {
    id: 1,
    badge: "💼 Bulut ERP & Ön Muhasebe",
    title: "Tüm operasyonlarınız tek platformda!",
    description: "Üretim, finans, satış ve tedarik zincirini uçtan uca yönetin. Stok Pratik ERP çözümleriyle verimliliği artırın, işletmenizi geleceğe güvenle ölçeklendirin.",
    buttonText: "ERP Çözümlerimizi İnceleyin",
    buttonUrl: "/online-muhasebe-programi",
    image: "/images/hero/slider-erp.jpg",
    alt: "Stok Pratik Bulut ERP ve Muhasebe Yönetimi"
  },
  {
    id: 2,
    badge: "🌐 37+ Pazaryeri & E-İhracat",
    title: "Pazaryerlerinde canlı stok ve sipariş senkronizasyonu!",
    description: "Trendyol, Hepsiburada, Amazon, N11, Çiçeksepeti ve Shopify siparişleriniz tek ekrana düşsün; faturalarınız saniyeler içinde otomatik kesilsin.",
    buttonText: "Pazaryeri Entegrasyonunu İnceleyin",
    buttonUrl: "/e-ticaret-pazaryeri-entegrasyonu",
    image: "/images/hero/slider-pazaryeri.jpg",
    alt: "37+ Pazaryeri ve E-Ticaret Entegrasyonu"
  },
  {
    id: 3,
    badge: "🛒 Hızlı Barkod POS & Mağaza",
    title: "Kasada müşteri kuyruklarını eriten ultra hızlı dokunmatik POS!",
    description: "Terazi, fiş yazıcı ve barkod okuyucuyla %100 entegre. İnternet kopsa dahi kesintisiz satış yapın, mağaza kasanızı ve vardiyaları güvenle yönetin.",
    buttonText: "Barkod POS Sistemini İnceleyin",
    buttonUrl: "/barkodlu-magaza-pos-programi",
    image: "/images/hero/slider-pos.jpg",
    alt: "Hızlı Satış Dokunmatik POS Programı"
  },
  {
    id: 4,
    badge: "🤝 B2B Bayi Portalı & CariNET",
    title: "Bayilerinize 7/24 özel fiyatlı B2B portalı açın, toptan satışınızı katlayın!",
    description: "Müşteri bazlı özel iskonto, vadeli bakiye limiti, online sipariş toplama ve DepodanDirekt toptan ağı ile anında yeni bayiler ve müşteriler edinin.",
    buttonText: "B2B Çözümünü Keşfedin",
    buttonUrl: "/b2b-toptan-satis-sistemi",
    image: "/images/hero/slider-b2b.jpg",
    alt: "B2B Toptan Sipariş ve Bayi Ağı"
  },
  {
    id: 5,
    badge: "🏭 Üretim ERP & Reçete Takibi",
    title: "Ürün reçetesi, istasyon takibi ve anlık gerçek üretim maliyeti!",
    description: "Hammadde sarfiyatı, işçilik, genel giderler ve fire oranlarını otomatik hesaplayın. Üretim emrinden mamul depoya kadar her istasyonu canlı izleyin.",
    buttonText: "Üretim ERP Modülünü İnceleyin",
    buttonUrl: "/uretim-erp-urun-agaci-bom-ve-gercek-maliyet-motoru",
    image: "/images/hero/slider-uretim.jpg",
    alt: "Üretim ERP ve Reçete Maliyet Motoru"
  },
  {
    id: 6,
    badge: "🤖 AI Masraf OCR & 15 Sn QR-PDKS",
    title: "Masraf fişlerini fotoğraflayın AI okusun, personeli dinamik QR ile takip edin!",
    description: "Gemini AI OCR ile fiş ve faturaları 2 saniyede cariye işleyin. 15 saniyede yenilenen kriptografik QR kod ile cihazsız, hilesiz mobil PDKS konforu.",
    buttonText: "AI & PDKS Yeteneklerini İnceleyin",
    buttonUrl: "/yapay-zeka-fis-okuma-masraf-yonetimi",
    image: "/images/hero/slider-ai-pdks.jpg",
    alt: "Yapay Zeka Fiş Okuma ve Dinamik QR-PDKS"
  }
];

const customerSegments = [
  {
    id: "mikro",
    title: "Mikro İşletmeler & Esnaflar",
    tagline: "Hızlı, Pratik ve Masrafsız Başlangıç",
    desc: "Karmaşık yazılımlarla vakit kaybetmeyin. E-Faturanızı saniyeler içinde kesin, kasanızı ve stoğunuzu cep telefonunuzdan dahi kontrol edin.",
    features: [
      "Hızlı Satış Dokunmatik POS Ekranı",
      "GİB Onaylı Kolay E-Fatura & E-Arşiv",
      "Yapay Zekalı AI Fiş/Masraf Okuma",
      "Müşteri Veresiye ve Cari Takibi",
      "Sıfır Sunucu & IT Masrafı"
    ],
    ctaText: "Mikro İşletme Paketini Seçin",
    ctaUrl: "/paketlerimiz"
  },
  {
    id: "kobi",
    title: "KOBİ'ler & E-Ticaret Satıcıları",
    tagline: "Satış Kanallarınızı ve Finansınızı Tek Merkezde Birleştirin",
    desc: "37+ Pazaryeri, e-ticaret siteniz, fiziki mağazanız ve banka hesaplarınız tek çatı altında. Fazla stok satma veya sipariş kaçırma derdine son.",
    features: [
      "Trendyol, Amazon, Hepsiburada Çift Yönlü Senkron",
      "Otomatik E-Fatura & Kargo Barkod Basımı",
      "Banka Entegrasyonu & Canlı Kasa/Banka",
      "Çoklu Depo ve Raf Adresleme Sistemi",
      "B2B Bayi Sipariş & CariNET Köprüsü"
    ],
    ctaText: "KOBİ Çözümlerini İnceleyin",
    ctaUrl: "/paketlerimiz"
  },
  {
    id: "uretim",
    title: "İmalatçılar & Fabrikalar",
    tagline: "Ürün Reçetesinden Gerçek Birim Maliyete Tam Hakimiyet",
    desc: "Hammadde girdiğinden mamul depoya çıkana kadar tüm istasyonları takip edin. İşçilik, elektrik ve genel giderleri birim maliyete otomatik yansıtın.",
    features: [
      "Çok Katmanlı Ürün Reçetesi (BOM Ağacı)",
      "4 Aşamalı İstasyon ve Hat Takibi",
      "Gerçek Maliyet Motoru & Fire Hesaplama",
      "Otomatik Hammadde Rezerve & Çıkış Fişi",
      "Fason Takibi ve Mamul Depo Girişi"
    ],
    ctaText: "Üretim ERP Detayları",
    ctaUrl: "/uretim-erp-urun-agaci-bom-ve-gercek-maliyet-motoru"
  },
  {
    id: "zincir",
    title: "Zincir Mağazalar & Çok Şubeli Ağlar",
    tagline: "Merkezi Yönetim, Kesintisiz Şube İletişimi",
    desc: "Tüm şubelerinizin anlık cirosunu, kâr marjını ve stok transferlerini tek ekrandan izleyin. Şubeler arası konsinye ve irsaliyeli transferi otomatikleştirin.",
    features: [
      "Merkezi Fiyat ve Kampanya Güncelleme",
      "Şubeler Arası İrsaliyeli Stok Transferi",
      "Personel Vardiya & 15 Sn Dinamik QR-PDKS",
      "Konsolidasyonlu Patron BI Kokpiti",
      "Yetkilendirme ve Kasiyer Limit Yönetimi"
    ],
    ctaText: "Kurumsal Çözümleri Keşfedin",
    ctaUrl: "/paketlerimiz"
  }
];

const stats = [
  { value: "Onlarca", label: "Aktif İşletme ve Kullanıcı" },
  { value: "37+", label: "Pazaryeri ve E-Ticaret Entegrasyonu" },
  { value: "%99.98", label: "Bulut Çalışma Süresi (Uptime)" },
  { value: "0 TL", label: "Sunucu ve Donanım Yatırım Masrafı" }
];

const reasons = [
  {
    icon: "⚡",
    title: "15 Dakikada Canlıya Geçiş",
    desc: "Haftalarca süren kurulum ve eğitim toplantılarını unutun. Stok Pratik bulut altyapısıyla aynı gün fatura kesmeye ve satışa başlayın."
  },
  {
    icon: "💰",
    title: "Şeffaf, Sürprizsiz Fiyat",
    desc: "Yıllık fahiş bakım bedeli, gizli modül lisansı veya kullanıcı başı ceza ücreti yok. Ne ödeyeceğinizi ilk günden net bilin."
  },
  {
    icon: "🏛️",
    title: "Mevzuat ve GİB Tam Uyumlu",
    desc: "E-Fatura, E-Arşiv, E-İrsaliye, SMMM E-Aktarım köprüsü ve tevkifat kuralları mevzuat değiştikçe otomatik ve ücretsiz güncellenir."
  },
  {
    icon: "📱",
    title: "Cebinizden Yönetin",
    desc: "Masaüstü, tablet, el terminali ve akıllı cep telefonunuzla tam uyumlu. İşletmeniz nerede olursanız olun parmaklarınızın ucunda."
  }
];
---

<BaseLayout 
  title="Stok Pratik — Tüm Operasyonlarınız Tek Platformda | Bulut ERP, E-Ticaret, POS & Üretim"
  description="Türkiye'nin en kapsamlı bulut ERP, e-ticaret pazaryeri entegrasyonu, hızlı barkod POS, üretim reçetesi ve B2B toptan satış yönetim sistemi. 1 ay ücretsiz deneyin."
>

  <!-- HERO SECTION: LOGO YAZILIM TARZI SLIDER & SAĞ KIRMIZI KUTU -->
  <section class="bg-white pt-6 pb-10 sm:pt-8 sm:pb-12">
    <div class="container mx-auto px-4 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
        
        <!-- SOL 8 KOLON: İNTERAKTİF HERO SLIDER -->
        <div class="lg:col-span-8 bg-slate-50/80 border border-slate-200/90 rounded-3xl p-6 sm:p-10 relative overflow-hidden flex flex-col justify-between shadow-sm">
          
          <!-- SLIDE ITEMS WRAPPER -->
          <div id="heroSliderTrack" class="relative min-h-[380px] sm:min-h-[400px]">
            {slides.map((slide, idx) => (
              <div 
                class={`hero-slide transition-all duration-700 absolute inset-0 flex flex-col md:flex-row items-center gap-6 sm:gap-8 ${idx === 0 ? 'opacity-100 z-10 translate-x-0' : 'opacity-0 z-0 translate-x-12 pointer-events-none'}`}
                data-slide-index={idx}
              >
                <!-- Metin Alanı (Sol) -->
                <div class="w-full md:w-7/12 flex flex-col items-start justify-center text-left">
                  <div class="inline-flex items-center gap-2 bg-red-100/80 text-red-700 text-xs sm:text-sm font-bold px-3.5 py-1.5 rounded-full mb-4">
                    <span>{slide.badge}</span>
                  </div>
                  
                  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
                    {slide.title}
                  </h1>
                  
                  <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
                    {slide.description}
                  </p>
                  
                  <a 
                    href={slide.buttonUrl}
                    class="inline-flex items-center gap-2 px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-full text-sm sm:text-base transition-all shadow-md shadow-red-600/20 group"
                  >
                    <span>{slide.buttonText}</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>

                <!-- Resim Alanı (Sağ) -->
                <div class="w-full md:w-5/12 h-64 md:h-80 relative rounded-2xl overflow-hidden shadow-lg border border-slate-200/60 bg-white">
                  <img 
                    src={slide.image} 
                    alt={slide.alt} 
                    class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700"
                    loading={idx === 0 ? "eager" : "lazy"}
                    fetchpriority={idx === 0 ? "high" : "auto"}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 via-transparent to-transparent"></div>
                </div>
              </div>
            ))}
          </div>

          <!-- SLIDER ALT KONTROLLER (Önceki / Sayfa Sayacı / Sonraki) -->
          <div class="flex items-center justify-between pt-6 mt-4 border-t border-slate-200/70">
            <!-- Sol: Dairesel Butonlar ve Sayaç -->
            <div class="flex items-center gap-4">
              <button 
                id="sliderPrevBtn" 
                class="w-10 h-10 rounded-full border border-slate-300 hover:border-red-600 hover:bg-red-50 text-slate-700 hover:text-red-600 flex items-center justify-center transition-all focus:outline-none"
                aria-label="Önceki Slayt"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              </button>
              
              <div class="font-extrabold text-sm sm:text-base text-slate-800 tracking-wider">
                <span id="sliderCurrentNum" class="text-red-600">01</span> / <span class="text-slate-400">06</span>
              </div>

              <button 
                id="sliderNextBtn" 
                class="w-10 h-10 rounded-full border border-slate-300 hover:border-red-600 hover:bg-red-50 text-slate-700 hover:text-red-600 flex items-center justify-center transition-all focus:outline-none relative group"
                aria-label="Sonraki Slayt"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <!-- Active circle indicator outline -->
                <span class="absolute inset-0 rounded-full border-2 border-red-500/30 scale-110 opacity-0 group-hover:opacity-100 transition-opacity"></span>
              </button>
            </div>

            <!-- Sağ: Doğrudan Atlama Çizgileri / Noktaları -->
            <div class="flex items-center gap-2">
              {slides.map((_, i) => (
                <button 
                  class={`slider-dot h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-8 bg-red-600' : 'w-2 bg-slate-300 hover:bg-slate-400'}`}
                  data-target-slide={i}
                  aria-label={`Slayt ${i + 1}`}
                ></button>
              ))}
            </div>
          </div>

        </div>

        <!-- SAĞ 4 KOLON: İKONİK KIRMIZI KUTU (LOGO YAZILIM FORMATI) -->
        <div class="lg:col-span-4 bg-gradient-to-br from-[#c5161d] via-[#dc2626] to-[#991b1b] rounded-3xl p-6 sm:p-8 flex flex-col justify-between text-white relative overflow-hidden shadow-xl shadow-red-950/20">
          
          <!-- Arka Plan Süsleme Halka Efektleri -->
          <div class="absolute -top-12 -right-12 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
          <div class="absolute -bottom-16 -left-16 w-56 h-56 bg-black/15 rounded-full blur-2xl pointer-events-none"></div>

          <!-- Üst Görsel / Danışman Rozeti -->
          <div class="relative z-10 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-16 h-16 rounded-full border-2 border-white/60 p-0.5 bg-white/20 shadow-md overflow-hidden shrink-0">
                <img 
                  src="/images/hero/advisor-avatar.jpg" 
                  alt="Stok Pratik Müşteri Temsilcisi" 
                  class="w-full h-full object-cover rounded-full"
                />
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-red-200 font-bold">Canlı Destek & Demo</div>
                <div class="text-sm font-extrabold text-white">Stok Pratik Danışmanı</div>
              </div>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-white/15 backdrop-blur-sm border border-white/20 flex items-center justify-center text-xl shadow-inner">
              📞
            </div>
          </div>

          <!-- Orta Metin Alanı -->
          <div class="relative z-10 my-6">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
              1 Ay Ücretsiz Deneyin — <br class="hidden sm:inline" />Kredi Kartsız Anında Kurulum!
            </h2>
            <p class="text-red-100 text-sm sm:text-base leading-relaxed mt-3">
              İşletmenizi Stok Pratik'in sınırsız bulut gücüyle hemen tanıştırın. Taahhüt yok, gizli ücret veya kurulum masrafı yok.
            </p>

            <div class="mt-4 space-y-1.5 text-xs text-red-100 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-white">✓</span> <span>Onlarca Aktif İşletme Güvencesi</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-white">✓</span> <span>GİB ve E-Dönüşüm Tam Uyumluluk</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-white">✓</span> <span>7/24 Kesintisiz Uzman Telefon & WhatsApp Desteği</span>
              </div>
            </div>
          </div>

          <!-- Alt Butonlar -->
          <div class="relative z-10 space-y-2.5">
            <a 
              href="/firma-kaydi"
              class="w-full py-4 px-6 bg-white hover:bg-slate-50 text-red-600 font-extrabold rounded-full text-center transition-all shadow-lg shadow-black/10 flex items-center justify-center gap-2 group text-base"
            >
              <span>Ücretsiz Başla</span>
              <span class="group-hover:translate-x-1 transition-transform font-bold">→</span>
            </a>

            <a 
              href="https://wa.me/+905325000999?text=Merhaba,%20Stok%20Pratik%201%20ay%20ücretsiz%20kullanım%20ve%20demo%20hakkında%20bilgi%20almak%20istiyorum."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 px-4 bg-red-700/60 hover:bg-red-700/90 text-white font-bold rounded-full text-center text-xs sm:text-sm border border-white/20 transition-all flex items-center justify-center gap-2"
            >
              <span>💬 Satış Uzmanımızla WhatsApp'ta Görüşün</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- 3'LÜ HIZLI AKSİYON BANDI (GÖRSELDEKİ FORMAT: DİJİTAL DANIŞMAN | ÇÖZÜM BUL | WHATSAPP) -->
  <section class="border-y border-slate-200 bg-white py-6">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-200">
        
        <!-- 1. Aksiyon: Dijital Asistan -->
        <a 
          href="/ozellikler" 
          class="flex items-center justify-center sm:justify-start gap-4 py-4 md:py-1 px-4 lg:px-8 group hover:bg-slate-50 rounded-xl transition-colors"
        >
          <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shrink-0">
            🤖
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-bold">Akıllı Rehber</div>
            <div class="text-base font-extrabold text-slate-800 group-hover:text-red-600 transition-colors">
              Dijital Danışman'a Sorun
            </div>
            <div class="text-xs text-slate-500">İşletmenize en uygun modülleri keşfedin</div>
          </div>
        </a>

        <!-- 2. Aksiyon: Fiyat & Çözüm Bulucu -->
        <a 
          href="/fiyatlar" 
          class="flex items-center justify-center sm:justify-start gap-4 py-4 md:py-1 px-4 lg:px-8 group hover:bg-slate-50 rounded-xl transition-colors"
        >
          <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-800 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shrink-0">
            🧮
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-bold">Maliyet Hesaplayıcı</div>
            <div class="text-base font-extrabold text-slate-800 group-hover:text-red-600 transition-colors">
              Size En Uygun Çözümü Bulun
            </div>
            <div class="text-xs text-slate-500">30 saniyede net fiyatınızı anında hesaplayın</div>
          </div>
        </a>

        <!-- 3. Aksiyon: Canlı WhatsApp -->
        <a 
          href="https://wa.me/+905325000999?text=Merhaba,%20Stok%20Pratik%20uzman%20desteği%20almak%20istiyorum." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center sm:justify-start gap-4 py-4 md:py-1 px-4 lg:px-8 group hover:bg-slate-50 rounded-xl transition-colors"
        >
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shrink-0">
            💬
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-bold">Hızlı İletişim Hattı</div>
            <div class="text-base font-extrabold text-slate-800 group-hover:text-emerald-600 transition-colors">
              WhatsApp Uzman Desteği
            </div>
            <div class="text-xs text-slate-500">Satış uzmanımızla anında canlı görüşün</div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- İŞLETMENİZİN BÜYÜKLÜĞÜNE GÖRE ÇÖZÜMLER (SEKMELİ MODÜLER MİMARİ) -->
  <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
    <div class="container mx-auto px-4 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 bg-red-100 text-red-600 font-bold text-xs uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-3">
          Ölçeklenebilir Çözümler
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          İşletmenizin İhtiyacına Tam Uyumlu Çözümler
        </h2>
        <p class="text-slate-600 text-base sm:text-lg mt-3">
          Tek bir dükkândan yüzlerce çalışanı olan fabrikaya kadar; işiniz büyüdükçe sizinle birlikte büyüyen modüler altyapı.
        </p>
      </div>

      <!-- Segment Kartları Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {customerSegments.map((seg) => (
          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-red-200 transition-all flex flex-col justify-between group">
            <div>
              <div class="h-1.5 w-12 bg-red-600 rounded-full mb-5 group-hover:w-20 transition-all"></div>
              
              <h3 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-red-600 transition-colors">
                {seg.title}
              </h3>
              
              <div class="text-xs font-semibold text-red-600 mb-3">
                {seg.tagline}
              </div>
              
              <p class="text-slate-600 text-sm leading-relaxed mb-5">
                {seg.desc}
