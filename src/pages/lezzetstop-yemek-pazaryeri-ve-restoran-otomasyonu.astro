---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "LezzetSTOP: Restoran POS, e-Adisyon ve Reçeteli Mutfak | Stok Pratik";
const pageDescription = "Yemek satarken cironuzun yarısını komisyona vermeyin! Esnaf dostu LezzetSTOP pazaryeri, dokunmatik masa/paket adisyonu, gramajlı mutfak reçetesi ve GİB e-Adisyon tek sistemde.";

const restaurantPowers = [
  {
    icon: "🛵",
    title: "Paket Servis, Gel-Al ve Masa Adisyonu Tek Ekranda",
    desc: "Telefonla, QR menüyle veya LezzetSTOP üzerinden gelen paket siparişleri ile salon ve bahçe masalarınızın adisyonlarını tek dokunmatik ekrandan yönetin; sipariş karışıklığına son verin."
  },
  {
    icon: "⚖️",
    title: "Gramajlı Yemek Reçetesi (BOM) & Otomatik Hammadde Düşümü",
    desc: "Her menü kalemine gramaj reçetesi tanımlayın (Örn: 120 gr Döner Eti + 1 Adet Pide + 40 gr Tereyağı). Kasa fişi kesildiği an mutfak deponuzdan gramı gramına stok düşsün, fire ve mutfak kaçakları anında yakalansın."
  },
  {
    icon: "🍽️",
    title: "GİB Resmi e-Adisyon & Çoklu Ödeme (Alman Usulü)",
    desc: "Masada açılan adisyonu GİB e-Adisyon standartlarında anında resmileştirin. Hesap ödenirken Nakit, Kredi Kartı, Yemek Kartları (Sodexo, Ticket, Multinet, Metropol) veya parçalı hesap bölme ile saniyeler içinde kapatın."
  },
  {
    icon: "📺",
    title: "Mağaza TV ile Canlı Dijital Menü Panosu (/magaza-tv)",
    desc: "Kasa arkasındaki veya vitrindeki televizyonları anlık fiyatların, günlük çorbaların ve fırsat menülerinin döndüğü dinamik bir dijital menü panosuna (Digital Signage) dönüştürün."
  },
  {
    icon: "🏍️",
    title: "Kurye Zimmet & Gün Sonu Paket Kasa Mutabakatı",
    desc: "Hangi kuryede kaç paket var, ne kadar nakit ve mobil POS tahsilatı topladı? Vardiya sonunda tek tıkla kurye kasa devir mutabakatı yapın, kaçakları sıfırlayın."
  }
];

const faqs = [
  {
    q: "LezzetSTOP geleneksel yemek platformlarından nasıl farklıdır?",
    a: "Geleneksel yemek platformları restoranlardan %35 ile %40'a varan devasa komisyonlar keser. LezzetSTOP ise restoranın kendi bağımsız dijital sipariş altyapısını kurmasını sağlar ve komisyonsuz doğrudan müşteriye ulaşma imkanı sunar."
  },
  {
    q: "Yemek tariflerindeki porsiyon gramajları stoktan nasıl düşer?",
    a: "Sistemde her ürün için Ürün Reçetesi (BOM) oluşturulur. Örneğin 1 porsiyon Köfte satıldığında depodan 150 gr kıyma, 1 adet lavaş ve 50 gr garnitür otomatik düşer; ay sonunda gerçek et sarfiyatınızla satış adediniz kuruşu kuruşuna örtüşür."
  },
  {
    q: "Adisyon fişi yazıcıları ve dokunmatik POS ekranlarıyla uyumlu mu?",
    a: "Evet. Tüm ESC/POS standart termal adisyon yazıcıları (Mutfak, Bar, Kasa), dokunmatik POS terminalleri ve garson el tabletleriyle tak-çalıştır şeklinde %100 uyumludur."
  },
  {
    q: "Aynı masanın hesabını misafirler ayrı ayrı (Alman usulü) ödeyebilir mi?",
    a: "Kesinlikle! Adisyon ekranında tek tıkla 'Parçalı Ödeme / Hesap Böl' seçilerek bir kişi nakit, diğeri kredi kartı, üçüncüsü ise Sodexo/Ticket ile kendi payını saniyeler içinde ödeyebilir."
  },
  {
    q: "GİB e-Adisyon zorunluluğuna tabi restoranlar için uygun mudur?",
    a: "Evet. Gelir İdaresi Başkanlığı'nın e-Adisyon teknik kılavuzuna tam uyumludur. Masada açılan siparişler anında GİB zaman damgasıyla imzalanır ve e-Fatura / e-Arşiv faturaya dönüştürülür."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-rose-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-rose-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-rose-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
              🍔 LezzetSTOP • Restoran ERP, e-Adisyon & Komisyonsuz Sipariş
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Kazancınızın Yarısını <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-emerald-300">
                Komisyona Vermeyin!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Restoranlar, kafeler, dönerciler ve bulut mutfaklar için tek çatı! Dokunmatik masa adisyonundan kurye paketine, satılan her porsiyonun içindeki gramajlı et ve peynir stok düşümünden resmi <strong>GİB e-Adisyonuna</strong> kadar tam entegre gastronomi ERP'si!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-rose-600 via-rose-500 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-base shadow-lg shadow-rose-600/30 hover:scale-[1.02] transition-all text-center"
              >
                🍔 Restoranınızı Ücretsiz Kaydedin
              </a>
              <a 
                href="#komisyon-kds" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>🧮 Canlı KDS & Tasarruf Hesabı</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> %0 Komisyon Seçeneği</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Gramajlı Reçete (BOM)</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> GİB e-Adisyon Hazır</span>
            </div>
          </div>

          <!-- Sağ: Canlı Sipariş & Mutfak Hazırlık (KDS) + Komisyon Tasarruf Mockup'ı -->
          <div class="lg:col-span-7" id="komisyon-kds">
            <div class="bg-slate-900/90 rounded-2xl border border-rose-500/30 p-5 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-rose-500 via-amber-500 to-emerald-500"></div>

              <!-- Üst Tasarruf Şeridi -->
              <div class="bg-slate-950 p-3 rounded-xl border border-rose-500/30 mb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div>
                  <div class="text-[10px] text-slate-400 uppercase font-mono">Aylık Paket Sipariş Cirosu: 300.000 ₺</div>
                  <div class="text-xs text-rose-400">Pazaryeri Komisyonu (%38 Kesinti): <strong class="font-mono text-sm">-114.000 ₺</strong></div>
                </div>
                <div class="px-3 py-1.5 bg-emerald-500/20 border border-emerald-500/40 rounded-lg text-emerald-400 text-xs font-bold font-mono">
                  LezzetSTOP Kazancı: +114.000 ₺ / Ay Cepte!
                </div>
              </div>

              <!-- İki Panel: Masa Adisyonu + Mutfak KDS Ekranı -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4 text-xs">
                
                <!-- 1. Panel: Masa 4 Dokunmatik Adisyon -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800 mb-2">
                      <span class="font-bold text-white flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        Masa #4 • Salon (4 Kişi)
                      </span>
                      <span class="text-[10px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-300">Garson: Can</span>
                    </div>

                    <div class="space-y-1.5 text-[11px]">
                      <div class="flex justify-between items-center text-slate-200">
                        <span>2x Tereyağlı İskender</span>
                        <span class="font-mono">540 ₺</span>
                      </div>
                      <div class="flex justify-between items-center text-slate-200">
                        <span>1x Kaşarlı Pide</span>
                        <span class="font-mono">190 ₺</span>
                      </div>
                      <div class="flex justify-between items-center text-slate-200">
                        <span>3x Yayık Ayran</span>
                        <span class="font-mono">105 ₺</span>
                      </div>
                    </div>
                  </div>

                  <div class="pt-2 border-t border-slate-800 mt-2">
                    <div class="flex justify-between items-center text-xs font-black text-amber-400">
                      <span>Toplam Tutar:</span>
                      <span class="font-mono text-sm">835 ₺</span>
                    </div>
                    <div class="grid grid-cols-2 gap-1 mt-2 text-[10px]">
                      <span class="py-1 bg-slate-800 text-center rounded text-slate-300">Nakit / Kart</span>
                      <span class="py-1 bg-rose-600 text-center rounded text-white font-bold">e-Adisyon Kapat</span>
                    </div>
                  </div>
                </div>

                <!-- 2. Panel: Mutfak KDS & Gramajlı Stok Düşümü -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800 mb-2">
                      <span class="font-bold text-amber-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                        Mutfak KDS (Hazırlanıyor)
                      </span>
                      <span class="text-[10px] font-mono text-slate-400">03:42 dk</span>
                    </div>

                    <!-- Otomatik Gramaj Düşümü -->
                    <div class="space-y-1 text-[10px] text-slate-300 bg-slate-900/80 p-2 rounded border border-slate-800 mb-2">
                      <div class="font-bold text-emerald-400 text-[11px] mb-1">⚡ Otomatik Gramaj Düşümü:</div>
                      <div>• 240 gr Döner Eti (Depodan -240g)</div>
                      <div>• 2 Adet Pide Ekmek (Depodan -2 Ad)</div>
                      <div>• 80 gr Tereyağı (Depodan -80g)</div>
                    </div>
                  </div>

                  <div class="pt-2 border-t border-slate-800">
                    <div class="w-full py-1.5 bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 text-center rounded font-semibold text-[11px]">
                      ✓ Mutfak Kaçağı Sıfırlandı (Reçete BOM)
                    </div>
                  </div>
                </div>

              </div>

              <!-- Alt Canlı TV ve Kurye Durumu -->
              <div class="p-2.5 bg-rose-950/20 rounded-lg border border-rose-500/20 text-xs text-rose-200/90 flex items-center justify-between">
                <span class="flex items-center gap-2">
                  <span>🏍️</span>
                  <strong>Kurye Takibi:</strong> Kurye Ahmet şu an 3 teslimatta (1.840 ₺ tahsilat zimmetinde).
                </span>
                <span class="text-[10px] bg-rose-500/20 text-rose-300 px-2 py-0.5 rounded font-mono shrink-0">Canlı Yayında</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. LEZZETSTOP 5 EŞSİZ GÜÇ -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-rose-400 font-bold mb-3">Gastronomi ERP Çözümü</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">LezzetSTOP ile Restoranınızın Bereketini ve Kârını Koruyun</h3>
          <p class="text-slate-400 mt-4 text-base">
            Masa yönetiminden mutfak gramajına, paket servis kuryesinden e-Adisyona kadar tüm operasyon tek platformda.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {restaurantPowers.map((power, index) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-rose-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center text-2xl mb-4">
                  {power.icon}
                </div>
                <div class="text-xs font-mono text-rose-400 font-bold mb-1">ÖZELLİK 0{index + 1}</div>
                <h4 class="text-lg font-bold text-white mb-2">{power.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{power.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-rose-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">LezzetSTOP & Restoran ERP Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-rose-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-rose-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-rose-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-rose-500/20 border border-rose-500/40 text-rose-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🍔
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Mutfağınızın Bereketini ve Kârını Korumaya Bugün Başlayın! <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-emerald-300">
              LezzetSTOP ile Restoranınızı Dijitalleştirin.
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Hemen ücretsiz hesabınızı açın; dokunmatik adisyonlarınızı, gramajlı menülerinizi ve kuryelerinizi dakikalar içinde yönetmeye başlayın.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-rose-600 via-rose-500 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-lg shadow-xl shadow-rose-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 Ücretsiz Hesabımı Aç ve LezzetSTOP'a Katıl
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • Termal mutfak adisyon yazıcılarıyla %100 uyumlu</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik LezzetSTOP Restoran ve Mutfak ERP",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
