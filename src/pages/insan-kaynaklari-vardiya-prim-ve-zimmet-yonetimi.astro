---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "360° İnsan Kaynakları, Vardiya, Prim ve Zimmet Yönetimi | Stok Pratik";
const pageDescription = "Personel yönetimini sadece giriş-çıkış sanmayın! Vardiya planlamasından zimmet tutanağına, satış prim motorundan granüler yetkilendirmeye kadar 360° entegre İK sistemi.";

const lifecycleSteps = [
  {
    step: "01",
    title: "İşe Giriş & Granüler Yetki",
    desc: "Özlük dosyası oluşturulur. Hangi personelin hangi şubeyi, hangi ekranları ve hangi fiyatları görebileceği yetki şablonuyla saniyeler içinde kilitlenir.",
    icon: "🔐",
    badge: "bg-blue-500/20 text-blue-400 border-blue-500/30"
  },
  {
    step: "02",
    title: "Demirbaş & Zimmet Takibi",
    desc: "Personele teslim edilen bilgisayar, telefon, şirket aracı veya anahtarlar tek tıkla zimmetlenir; yasal A4 Zimmet Teslim Tutanağı otomatik üretilir.",
    icon: "💻",
    badge: "bg-indigo-500/20 text-indigo-400 border-indigo-500/30"
  },
  {
    step: "03",
    title: "Şube & Vardiya Planlaması",
    desc: "Haftalık ve aylık vardiya saatleri belirlenir. Şubeler arası geçici veya kalıcı personel transferleri tek ekrandan sürükle-bırak kolaylığıyla yapılır.",
    icon: "🗓️",
    badge: "bg-purple-500/20 text-purple-400 border-purple-500/30"
  },
  {
    step: "04",
    title: "Kripto QR-PDKS & Mesai Radarı",
    desc: "15 saniyede bir değişen dinamik QR ile personelin işe başlama ve çıkış saatleri milimetrik GPS ve cihaz parmak iziyle hatasız kaydedilir.",
    icon: "⏱️",
    badge: "bg-cyan-500/20 text-cyan-400 border-cyan-500/30"
  },
  {
    step: "05",
    title: "Mobil İzin & Maaş Avansı",
    desc: "Personel koridorda yönetici aramaz; telefonundan izin veya avans talebi gönderir. Tek tıkla onaylanan izinler SGK puantajına, avanslar kasaya işlenir.",
    icon: "🏖️",
    badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30"
  },
  {
    step: "06",
    title: "Satış Primi & Net Maaş Bordrosu",
    desc: "Kasiyer veya saha plasiyerinin yaptığı net satış cirosu veya kâr marjı üzerinden hakediş primi hesaplanır; ay sonu net maaşa otomatik eklenir.",
    icon: "🎯",
    badge: "bg-amber-500/20 text-amber-400 border-amber-500/30"
  }
];

const hrStrengths = [
  {
    icon: "🏢",
    title: "Çok Şubeli & Esnek Vardiya Dağıtımı",
    desc: "50 farklı şubeniz olsa bile her mağazanın açılış-kapanış saatlerine göre sabahçı, öğlenci ve gece vardiyalarını dakikalar içinde çakışmasız planlayın."
  },
  {
    icon: "📋",
    title: "Demirbaş & Zimmet Protokolü",
    desc: "Hangi araba hangi personelde, muayene tarihi ne zaman, teslim edilen telefon veya laptop nerede? İşten ayrılışta teslim alınmamış hiçbir zimmet kalmaz."
  },
  {
    icon: "💰",
    title: "Otomatik Ciro & Kâr Prim Motoru",
    desc: "Kasiyerlerinize veya satış ekibinize mağaza cirosu, ürün kategorisi veya kâr marjı bazlı yüzdesel primler tanımlayın; sistem hak edişi kuruşu kuruşuna toplasın."
  },
  {
    icon: "🛡️",
    title: "Granüler Ekran & Fiyat Görme Kilidi",
    desc: "Satış elemanınız satış yapsın ama alış maliyetini ve şirket kârını görmesin. Mağaza müdürü şube stoklarını görsün ama şirket banka hesaplarını görmesin."
  },
  {
    icon: "📱",
    title: "Sıfır Kurulum Mobil Personel Portalı",
    desc: "Personelin cep telefonuna App Store veya Play Store'dan hantal uygulamalar indirtmeyin. Mobil web arayüzüyle tüm talepler ve bordro görüntüleme tek tıkla."
  },
  {
    icon: "⚖️",
    title: "%100 KVKK & İş Kanunu Uyumluluğu",
    desc: "Personel özlük verileri, sağlık raporları, sözleşmeler ve imza sirküleri en üst düzey şifreli bulut altyapısında güvenle arşivlenir."
  }
];

const faqs = [
  {
    q: "Bir personel işten ayrılırken üzerindeki zimmetli eşyaları sistem nasıl denetler?",
    a: "Personelin işten çıkış kaydı açıldığında sistem, zimmetinde kayıtlı bulunan şirket aracı, bilgisayar, telefon veya anahtarları otomatik listeler. 'Tüm zimmetler eksiksiz teslim alınmadan' çıkış süreci tamamlanamaz ve zimmet iade tutanağı tek tıkla A4 olarak yazdırılır."
  },
  {
    q: "Satış personelinin primini ciro yerine brüt kârlılık üzerinden hesaplayabilir miyiz?",
    a: "Evet! Stok Pratik Satış Primi motorunda dilediğiniz formülü kurgulayabilirsiniz: 'KDV hariç net ciro üzerinden %2' veya 'Gerçekleşen brüt kâr tutarı üzerinden %5'. İadeler ve iptaller prim hakedişinden otomatik olarak düşülür."
  },
  {
    q: "Farklı şehirlerdeki şubelerin vardiyalarını tek bir merkezden yönetebilir miyiz?",
    a: "Kesinlikle. Stok Pratik'in çok şubeli mimarisi sayesinde tüm mağazalarınızın haftalık vardiya çizelgelerini tek ekrandan oluşturabilir, acil durumlarda şubeler arası personel görevlendirmelerini tek tıkla yapabilirsiniz."
  },
  {
    q: "Kasiyerlerin ürün alış fiyatlarını veya şirket kâr marjını görmesini engelleyebilir miyiz?",
    a: "Evet. Stok Pratik'te rol bazlı yetkilendirme son derece hassastır. Kasiyer rolündeki kullanıcılar yalnızca perakende satış fiyatını ve barkodunu görebilir; ürün alış maliyeti, kâr oranı veya tedarikçi bilgisi bu kullanıcılara tamamen gizlenir."
  },
  {
    q: "KVKK kapsamında personelin özlük ve sağlık belgeleri nasıl korunur?",
    a: "Personel özlük dosyalarına yalnızca İK Yöneticisi ve Şirket Sahibi yetkisine sahip kullanıcılar erişebilir. Belgeler AES-256 şifrelemeyle bulutta saklanır ve yetkisiz çalışanların erişimine kesin olarak kapalıdır."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-purple-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-purple-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
              👥 360° İnsan Kaynakları • Mesai, Vardiya, Zimmet, Prim ve Yetki
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Personel Yönetimini Sadece "Giriş-Çıkış Saati" Sanmayın: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-300 to-indigo-200">
                Vardiyasından Zimmetine, Satış Priminden Ekran Yetkisine Tam Entegre İK!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Klasik PDKS sistemleri personeli yalnızca kapıdaki turnikeden ibaret görür. Stok Pratik Bulut ERP ise işe girişten çıkışa tüm döngüyü tek merkezden yönetir: Şube vardiyaları, zimmetli araçlar, satış primleri ve granüler ekran yetkileri tek çatıda!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-purple-600 via-purple-500 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-purple-600/30 hover:shadow-purple-600/50 hover:scale-[1.02] transition-all text-center"
              >
                🚀 360° İK'yı Ücretsiz Deneyin
              </a>
              <a 
                href="#lifecycle" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>🧩 6 Aşamalı Yaşam Döngüsü</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Çok Şubeli Vardiya</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Otomatik Satış Primi</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> %100 KVKK Uyumlu</span>
            </div>
          </div>

          <!-- Sağ: 360° Personel Profil & Entegre İK Mockup'ı -->
          <div class="lg:col-span-6">
            <div class="bg-slate-900/90 rounded-2xl border border-purple-500/30 p-6 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-purple-500 via-pink-500 to-indigo-500"></div>

              <!-- Profil Başlığı -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-800 mb-6">
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-500 text-white font-black text-xl flex items-center justify-center shadow-lg shadow-purple-500/20">
                    AE
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white flex items-center gap-2">
                      Ahmet Erdem
                      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" title="Şu an Mesai Başında"></span>
                    </h4>
                    <p class="text-xs text-slate-400">Kıdemli Mağaza Müdürü • Kadıköy Şube</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30">
                    🟢 Aktif Mesai
                  </span>
                  <span class="text-xs px-2.5 py-1 rounded-full bg-purple-500/20 text-purple-400 font-semibold border border-purple-500/30">
                    🛡️ Şube Müdürü
                  </span>
                </div>
              </div>

              <!-- 4 Entegre Metrik Kartı -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                
                <!-- 1. Zimmet Durumu -->
                <div class="bg-slate-950/80 rounded-xl p-3 border border-slate-800">
                  <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                    <span class="flex items-center gap-1.5 text-indigo-400 font-semibold">💻 Zimmetli Varlıklar</span>
                    <span class="font-mono text-white font-bold">3 Kalem</span>
                  </div>
                  <div class="text-xs text-slate-300 space-y-0.5">
                    <div class="truncate">• MacBook Pro M3 (SN-9821)</div>
                    <div class="truncate">• iPhone 14 Pro (Kurumsal Hat)</div>
                    <div class="truncate text-indigo-300">• Araç: 34 ABC 123 (Megane)</div>
                  </div>
                </div>

                <!-- 2. Vardiya & Mesai -->
                <div class="bg-slate-950/80 rounded-xl p-3 border border-slate-800">
                  <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                    <span class="flex items-center gap-1.5 text-purple-400 font-semibold">⏰ Haftalık Vardiya</span>
                    <span class="text-emerald-400 font-bold font-mono">08:48 Giriş</span>
                  </div>
                  <div class="text-xs text-slate-300 space-y-0.5">
                    <div>• Saat: 09:00 - 18:00 (Hafta İçi)</div>
                    <div>• Hafta Sonu: Pazar Dinlenme</div>
                    <div class="text-emerald-400">• Tolerans: 12 dk önce giriş</div>
                  </div>
                </div>

                <!-- 3. Satış Primi -->
                <div class="bg-slate-950/80 rounded-xl p-3 border border-slate-800">
                  <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                    <span class="flex items-center gap-1.5 text-amber-400 font-semibold">🎯 Satış Primi (Ekim)</span>
                    <span class="font-mono text-amber-400 font-bold">%2,5 Ciro</span>
                  </div>
                  <div class="text-xs text-slate-300 space-y-0.5">
                    <div>• Şube Satış Cirosu: 498.000 ₺</div>
                    <div class="text-amber-300 font-bold">• Hak Edilen Prim: 12.450 ₺</div>
                    <div class="text-[10px] text-slate-400">• Maaş bordrosuna eklendi</div>
                  </div>
                </div>

                <!-- 4. Granüler Yetki -->
                <div class="bg-slate-950/80 rounded-xl p-3 border border-slate-800">
                  <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                    <span class="flex items-center gap-1.5 text-blue-400 font-semibold">🔐 Ekran Yetkileri</span>
                    <span class="text-xs text-slate-400 font-mono">Özel Profil</span>
                  </div>
                  <div class="text-xs text-slate-300 space-y-0.5">
                    <div class="text-emerald-400">✓ Kasa & Hızlı Satış (Açık)</div>
                    <div class="text-emerald-400">✓ Kadıköy Şube Deposu (Açık)</div>
                    <div class="text-rose-400">✕ Alış Maliyeti & Bankalar (Kilitli)</div>
                  </div>
                </div>

              </div>

              <!-- Alt Canlı Bildirim Çubuğu -->
              <div class="p-3 bg-purple-950/30 rounded-xl border border-purple-500/20 text-xs flex items-center justify-between text-purple-200">
                <span class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
                  Son İşlem: Yıllık İzin Talebi (2 Gün) onaylandı, SGK puantajına işlendi.
                </span>
                <span class="text-slate-400 text-[10px]">10 dk önce</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. 6 AŞAMALI ENTEGRE PERSONEL YAŞAM DÖNGÜSÜ -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800" id="lifecycle">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-purple-400 font-bold mb-3">Tek Platform • Kesintisiz İK Operasyonu</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">İşe Alımdan Emekliliğe: 6 Aşamalı Entegre Yaşam Döngüsü</h3>
          <p class="text-slate-400 mt-4 text-base">
            Personelinizle ilgili hiçbir bilgi kaybolmasın. Ayrı ayrı Excel tabloları, WhatsApp grupları ve kağıt dosyalar yerine her aşaması birbirini tetikleyen birleşik İK mimarisi.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {lifecycleSteps.map((item) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 hover:border-purple-500/40 transition-all group">
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl group-hover:scale-110 transition-transform">{item.icon}</span>
                <span class={`px-2.5 py-1 rounded text-xs font-mono font-bold border ${item.badge}`}>
                  AŞAMA {item.step}
                </span>
              </div>
              <h4 class="text-lg font-bold text-white mb-2 group-hover:text-purple-300 transition-colors">
                {item.title}
              </h4>
              <p class="text-slate-400 text-sm leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. 6 ÇEKİRDEK GÜÇ BENTO GRID -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-purple-400 font-bold mb-3">Üstün Kurumsal Kabiliyetler</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">İşletmenizin İhtiyaç Duyduğu Tüm İK Gücü Elinizin Altında</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {hrStrengths.map((strength) => (
            <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 p-6 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center text-2xl mb-4">
                  {strength.icon}
                </div>
                <h4 class="text-lg font-bold text-white mb-2">{strength.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{strength.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-purple-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">360° İK Ekosistemi Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-purple-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-purple-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-purple-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-purple-500/20 border border-purple-500/40 text-purple-400 flex items-center justify-center text-3xl mx-auto mb-6">
            👥
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Şirketinizin En Değerli Sermayesini Kağıtlara Değil, <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-300 to-indigo-200">
              Stok Pratik 360° İK Ekosistemine Emanet Edin!
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Vardiyalardan zimmetlere, satış primlerinden yetkilendirmeye kadar tüm personel süreçlerinizi dakikalar içinde modernleştirin.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-purple-600 via-purple-500 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-lg shadow-xl shadow-purple-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
