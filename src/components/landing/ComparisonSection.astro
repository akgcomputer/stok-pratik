---
interface Props {
  title?: string;
  oldMethodTitle?: string;
  oldMethodItems?: string[];
  newMethodTitle?: string;
  newMethodItems?: string[];
}

const { 
  title = "Neden Stok Pratik'i Seçmelisiniz?",
  oldMethodTitle = "Eski Karmaşık Yöntemler",
  oldMethodItems = [
    "Farklı ekranlar arasında geçiş yapmak",
    "Excel tablolarıyla boğuşmak",
    "Manuel ve hatalara açık stok sayımı",
    "Karmaşık ve anlaşılmaz raporlar",
    "Kurulum ve eğitim için yüksek maliyet"
  ],
  newMethodTitle = "Stok Pratik Yöntemi",
  newMethodItems = [
    "Tek ekrandan tüm süreci yönetmek",
    "Bulut tabanlı, her yerden erişilebilir",
    "Barkod ve mobil kamera ile hatasız sayım",
    "Anlaşılır, anlık kâr-zarar raporları",
    "Ücretsiz kurulum ve 7/24 destek"
  ]
} = Astro.props;
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">{title}</h2>
      <div class="mt-4 w-24 h-1 bg-blue-600 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {/* Old Method */}
      <div class="bg-red-50 rounded-2xl p-8 border border-red-100 shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-red-200 rounded-full blur-3xl opacity-50 -mr-16 -mt-16 transition-transform group-hover:scale-110 duration-500"></div>
        <h3 class="text-xl font-bold text-red-800 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {oldMethodTitle}
        </h3>
        <ul class="space-y-4">
          {oldMethodItems.map(item => (
            <li class="flex items-start">
              <svg class="w-5 h-5 mr-3 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              <span class="text-red-900">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* New Method */}
      <div class="bg-emerald-50 rounded-2xl p-8 border border-emerald-100 shadow-md relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-200 rounded-full blur-3xl opacity-50 -mr-16 -mt-16 transition-transform group-hover:scale-110 duration-500"></div>
        <div class="absolute -top-3 -right-3 text-emerald-200 opacity-20">
            <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-emerald-800 mb-6 flex items-center relative z-10">
          <svg class="w-6 h-6 mr-2 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {newMethodTitle}
        </h3>
        <ul class="space-y-4 relative z-10">
          {newMethodItems.map(item => (
            <li class="flex items-start">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center mr-3 mt-0.5">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-emerald-950 font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
