---
import BaseLayout from '../layouts/BaseLayout.astro';
import pricingData from '../data/pricing.json';

const pageTitle = "Paketlerimiz & Modül Özellikleri | Stok Pratik Modüler ERP";
const pageDescription = "Stok Pratik'in tek çekirdek paket ve seçmeli modüllerden oluşan esnek yapısını keşfedin. İhtiyacınız olan modülleri seçin, işletmenizi gereksiz yazılım maliyetlerinden kurtarın.";

const { core_package, categories, modules, currency_symbol, vat_text } = pricingData;

// Extended detailed feature checklists for each module in /paketlerimiz
const detailedModuleSpecs: Record<string, string[]> = {
  cek_senet: [
    "Müşteri ve tedarikçi çek/senet bordroları",
    "Tahsilata veya teminata bankaya verme işlemleri",
    "Çek ciro etme ve parçalı takip mekanizması",
    "Otomatik vade ve risk kontrolü",
    "Vadesi yaklaşan kıymetli evraklar için bildirim sistemi"
  ],
  masraf_ocr: [
    "Cep telefonu kamerasıyla fiş ve fatura tarama",
    "Yapay Zekâ ile KDV, matrah, tarih ve firma unvanı okuma",
    "Personel masraf harcama bildirimleri ve onay süreci",
    "Kategori bazlı masraf ve şirket gider raporlaması",
    "Tek tıkla gider kaydını muhasebeye ve kasaya işleme"
  ],
  gib_edonusum: [
    "GİB onaylı resmi e-Fatura ve e-Arşiv faturası düzenleme",
    "Gelen ticari ve temel e-faturaları sisteme otomatik çekme",
    "Resmi e-İrsaliye ve sevk süreçleri yönetimi",
    "Serbest Meslek Makbuzu (e-SMM) ve e-Müstahsil makbuzu",
    "Müşterilere e-posta veya SMS ile otomatik fatura linki iletimi"
  ],
  demirbas: [
    "Şirket demirbaş ve sabit kıymet kartları oluşturma",
    "Personel veya şubeye zimmet ataması ve takip tutanağı",
    "VUK mevzuatına uygun doğrusal ve azalan amortisman hesabı",
    "Bakım, onarım ve garanti süreleri takibi",
    "Demirbaş elden çıkarma veya hurdaya ayırma muhasebe kaydı"
  ],
  pazaryeri: [
    "Trendyol, Hepsiburada, N11 ve Çiçeksepeti çift yönlü canlı senkronizasyon",
    "Ortak stok havuzu ve pazaryerlerine özel kritik emniyet stoğu",
    "Tek tıkla 100x150 mm termal kargo barkodu ve sevk etiketi basımı",
    "Sipariş anında otomatik e-fatura kesilip pazaryeri sistemine iletilmesi",
    "İade masası ile eksik/kusurlu gelen siparişlerin kontrolü",
    "Pazaryeri komisyon ve kargo kesintileri sonrası net hakediş (kâr) analizi",
    "Müşteri soru-cevaplarını ERP panelinden anlık yanıtlama"
  ],
  depodandirekt: [
    "Binlerce hazır toptan ürüne sıfır sermaye ile erişim (Global Toptan E-Ticaret)",
    "Tek tıkla ürünleri kendi ERP stoğunuza ve pazaryeri mağazalarınıza yükleme",
    "Toptancı depolarındaki anlık stok ve fiyat değişimlerinin otomatik güncellenmesi",
    "Satış gerçekleştikçe siparişin toptancıya otomatik iletilmesi",
    "Kendi logonuz ve faturanız ile müşteriye doğrudan depodan kargolama"
  ],
  hizli_pos: [
    "Dokunmatik ekran ve barkod okuyucu destekli saniyeler içinde satış",
    "Barkodsuz popüler ürünler için hızlı dokunmatik butonlar",
    "Parçalı tahsilat (Nakit + Kredi Kartı + Açık Hesap bölebilme)",
    "Elektronik terazi ve barkodlu terazi etiketleri entegrasyonu",
    "Müşteri ekranı (fiyat gör) desteği ve gün sonu Z raporu / kasa mutabakatı"
  ],
  uretim_mrp: [
    "Çok seviyeli ürün reçeteleri (BOM) ve yarı mamul tanımlama",
    "Üretim iş emirleri oluşturma ve istasyon bazlı operasyon takibi",
    "Otomatik hammadde sarfiyatı ve mamul stok girişi",
    "İşçilik, genel giderler ve fire oranları ile net birim maliyet hesabı",
    "Gelecek siparişlere göre hammadde ihtiyaç (MRP) planlaması"
  ],
  pdks: [
    "Karekod (QR Kod) veya GPS lokasyon doğrulaması ile mobil giriş-çıkış",
    "Vardiya planlama, esnek çalışma saatleri ve mola kontrolleri",
    "Haftalık ve aylık fazla mesai, eksik gün ve gecikme puantajı",
    "Personel yıllık izin, rapor ve mazeret izin onay mekanizması",
    "Ay sonunda muhasebeye hazır bordro puantaj dökümü aktarımı"
  ],
  plasiyer: [
    "Her ticari aracın sisteme bağımsız mobil şube/depo olarak tanımlanması",
    "Plaka bazlı araç içi anlık stok takibi ve kaçakların önlenmesi",
    "Saha personeline özel fatura/irsaliye/tahsilat yetki kısıtlamaları",
    "Bluetooth mobil termal yazıcı ile araç başında fiş ve irsaliye basımı",
    "Müşteri ziyaret rotaları ve anlık saha tahsilat makbuzu düzenleme"
  ],
  ek_kullanici: [
    "Ana paketteki 1 kullanıcıya ilave sınırsız yeni personel yetkilendirmesi",
    "Modül, işlem ve buton bazlı detaylı rol yetki yönetimi",
    "Kullanıcı bazlı log ve yapılan işlem geçmişi kayıtları"
  ],
  ek_depo: [
    "Ana depoya ilave yeni fiziksel mağaza, AVM şubesi veya bölgesel depo tanımı",
    "Şubeler/depolar arası sevk irsaliyesi ve stok transfer onayları",
    "Şube bazında bağımsız kâr/zarar ve ciro performansı raporlaması"
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    
    <!-- HERO -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 py-20 text-white border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-blue-300 bg-blue-950/80 border border-blue-500/30 rounded-full">
          📦 Stok Pratik Modüler Ekosistem Rehberi
        </span>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-6 leading-tight">
          <span class="text-red-500">Paketlerimiz ve</span> <span class="bg-gradient-to-r from-blue-400 to-indigo-300 bg-clip-text text-transparent">Modül Yetenekleri</span>
        </h1>
        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto mb-8 leading-relaxed">
          Stok Pratik'te karmaşık ve pahalı paket dayatmaları yok! İşletmenizin çekirdek ERP omurgasını kurun, büyüdükçe ihtiyacınız olan eklentileri tek tıkla sisteminize dahil edin.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="/fiyatlar"
            class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-extrabold text-base rounded-2xl shadow-lg shadow-blue-500/25 transition duration-200 text-center"
          >
            Fiyat Hesaplayıcıya Git (Kendi Paketini Kur) →
          </a>
          <a
            href="/firma-kaydi"
            class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold text-base rounded-2xl border border-white/20 transition duration-200 text-center"
          >
            14 Gün Ücretsiz Başla
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 1: CORE PACKAGE (ZORUNLU ÇEKİRDEK) -->
    <section class="py-16 sm:py-20">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 text-white rounded-3xl p-8 sm:p-12 shadow-2xl border border-indigo-500/30 relative overflow-hidden">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 pb-8 border-b border-slate-700/80">
            <div>
              <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 text-xs font-bold uppercase tracking-wider mb-3">
                🔒 İşletmenizin Temel Omurgası
              </div>
              <h2 class="text-3xl sm:text-4xl font-black text-white">
                {core_package.name}
              </h2>
              <p class="text-slate-300 text-base mt-2 max-w-2xl">
                {core_package.subtitle}. Her işletmenin stok, cari, finans ve satış yönetimini eksiksiz yürütebilmesi için özel olarak tasarlandı.
              </p>
            </div>

            <div class="lg:text-right bg-slate-800/90 lg:bg-transparent p-6 lg:p-0 rounded-2xl border border-slate-700 lg:border-0 shrink-0">
              <div class="flex items-baseline lg:justify-end gap-2">
                <span class="text-4xl sm:text-5xl font-black text-white">
                  {core_package.yearly_monthly_price} {currency_symbol}
                </span>
                <span class="text-slate-300 font-medium text-base">/ ay</span>
              </div>
              <p class="text-xs text-blue-300 mt-1 font-semibold">
                Yıllık ödemede aylık (Aylık ödemede {core_package.monthly_price} ₺/ay)
              </p>
              <p class="text-[11px] text-slate-400 mt-0.5">
                {vat_text}
              </p>
            </div>
          </div>

          <div class="pt-8">
            <h3 class="text-sm font-bold uppercase tracking-wider text-blue-400 mb-6">
              Çekirdek Pakette Standart Olarak Sunulan Özellikler:
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {core_package.features.map((feature, idx) => (
                <div key={idx} class="p-4 rounded-2xl bg-white/5 border border-white/10 flex items-start gap-3">
                  <div class="p-1 rounded-full bg-emerald-500/20 text-emerald-400 mt-0.5 shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-sm text-slate-200 font-medium">{feature}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: OPTIONAL MODULAR ADD-ONS -->
    <section class="py-10 pb-24">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-black uppercase tracking-wider text-blue-600 block mb-2">Genişletilebilir Modüller</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
            İhtiyacınıza Göre Ekleyebileceğiniz Modüller
          </h2>
          <p class="text-slate-600 text-base mt-3">
            Aşağıdaki tüm modüller çekirdek pakete tam entegre çalışır. Yalnızca operasyonunuzun ihtiyaç duyduğu modülleri aktif edebilirsiniz.
          </p>
        </div>

        <div class="space-y-16">
          {categories.map(category => {
            const catModules = modules.filter(m => m.category === category.id);
            if (catModules.length === 0) return null;

            return (
              <div key={category.id} class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
                <div class="flex items-center gap-3.5 mb-8 pb-5 border-b border-slate-100">
                  <span class="text-3xl p-3 bg-blue-50 rounded-2xl">{category.icon}</span>
                  <div>
                    <h3 class="text-2xl font-black text-slate-900 tracking-tight">
                      {category.title}
                    </h3>
                    <p class="text-sm text-slate-500 mt-0.5">
                      {category.description}
                    </p>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  {catModules.map(mod => {
                    const specs = detailedModuleSpecs[mod.id] || [];
                    const displayPrice = mod.yearly_monthly_price || mod.base_yearly_monthly_price;
                    const monthlyStandard = mod.monthly_price || mod.base_monthly_price;

                    return (
                      <div key={mod.id} class="flex flex-col justify-between p-6 sm:p-7 rounded-2xl border border-slate-200/90 bg-slate-50/50 hover:bg-white hover:border-blue-400 hover:shadow-md transition-all duration-200">
                        <div>
                          <div class="flex items-start justify-between gap-3 mb-3">
                            <div class="flex items-center gap-3">
                              <span class="text-3xl p-2 bg-white rounded-xl border border-slate-200/70 shadow-sm">{mod.icon}</span>
                              <div>
                                <h4 class="text-lg font-bold text-slate-900 leading-snug">
                                  {mod.name}
                                </h4>
                                {mod.badge && (
                                  <span class="inline-block px-2 py-0.5 text-[11px] font-bold rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100 mt-1">
                                    {mod.badge}
                                  </span>
                                )}
                              </div>
                            </div>

                            <div class="text-right shrink-0">
                              <span class="text-xl font-black text-slate-950">
                                +{displayPrice} {currency_symbol}
                              </span>
                              <span class="text-xs text-slate-500 font-medium block">/ ay</span>
                            </div>
                          </div>

                          <p class="text-sm text-slate-600 mb-5 leading-relaxed">
                            {mod.description}
                          </p>

                          {specs.length > 0 && (
                            <div class="space-y-2 mb-6 pt-4 border-t border-slate-200/70">
                              <span class="text-xs font-bold text-slate-700 uppercase tracking-wide block mb-2">
                                Neler İçerir?
                              </span>
                              {specs.map((item, i) => (
                                <div key={i} class="flex items-start gap-2 text-xs sm:text-sm text-slate-600">
                                  <svg class="w-4 h-4 text-blue-600 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                  </svg>
                                  <span>{item}</span>
                                </div>
                              ))}
                            </div>
                          )}
                        </div>

                        <div class="pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs text-slate-500">
                          <span>
                            {mod.unit_label ? `${mod.unit_label} bazlı fiyatlandırma` : 'Sabit modül ücreti'}
                          </span>
                          <span class="font-semibold text-blue-700">
                            Aylık ödemede: +{monthlyStandard} {currency_symbol}/ay
                          </span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>

        {/* BOTTOM ACTION CARD */}
        <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-blue-900 to-indigo-950 text-white text-center shadow-xl">
          <h3 class="text-2xl sm:text-3xl font-black mb-3">
            Hangi Modüllere İhtiyacınız Olduğunu Hemen Seçin
          </h3>
          <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto mb-8">
            İnteraktif hesaplayıcımız ile işletmenizin bütçesine en uygun paketi saniyeler içinde oluşturabilir, anında 14 gün ücretsiz denemeye başlayabilirsiniz.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/fiyatlar"
              class="px-8 py-4 bg-white text-slate-950 hover:bg-slate-100 font-extrabold text-base rounded-2xl shadow-lg transition-all"
            >
              Fiyat Hesaplayıcıyı Aç →
            </a>
            <a
              href="/firma-kaydi"
              class="px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold text-base rounded-2xl transition-all"
            >
              14 Gün Ücretsiz Kaydol
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>