                    </p>
                  </div>
                </div>
              </div>

              {/* Zaman Tasarrufu & Hazır Kurulum Bilgi Çubukları */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 pb-6 border-b border-slate-800 text-xs sm:text-sm">
                <div class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-800/40 border border-slate-700/50">
                  <span class="text-amber-400 text-base shrink-0">⏳</span>
                  <div>
                    <strong class="text-amber-300 block font-bold">Zaman Tasarrufu Garantisi:</strong>
                    <span class="text-slate-300" id="revealTimeSaving">
