// Fetch live feed to merge any new items dynamically if possible
let posts = [...defaultPosts];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 2000);
  const res = await fetch("https://feeds.behold.so/aqk1LlwnSuTE6SDhTCCY", { signal: controller.signal });
  clearTimeout(timeoutId);
  if (res.ok) {
    const data = await res.json();
    if (data.posts && Array.isArray(data.posts) && data.posts.length > 0) {
      // Merge unique permalinks or update thumbnails
      const livePosts = data.posts.map((p: any) => {
        const shortcodeMatch = p.permalink?.match(/\/(reel|p)\/([^/]+)/);
        const shortcode = shortcodeMatch ? shortcodeMatch[2] : "";
        const isVideo = p.mediaType === "VIDEO" || p.permalink?.includes("/reel/");
        const titleFirstLine = p.caption ? p.caption.split("\n")[0].replace(/^🏷️\s*/, "") : "Stok Pratik Paylaşımı";
        
        return {
          id: p.id,
          shortcode,
          permalink: p.permalink,
          mediaType: isVideo ? "VIDEO" : "CAROUSEL_ALBUM",
          category: isVideo ? "video" : "post",
          title: titleFirstLine.slice(0, 70),
          badge: isVideo ? "🎬 Reels Video" : "📖 Bilgi Rehberi",
          thumbnail: p.sizes?.medium?.mediaUrl || p.mediaUrl || p.thumbnailUrl,
          caption: p.caption || "",
          date: p.timestamp ? new Date(p.timestamp).toLocaleDateString("tr-TR", { day: 'numeric', month: 'long', year: 'numeric' }) : "Güncel",
          likes: p.likeCount || 5
        };
      });

      // Combine: keep unique by shortcode, live items at front
      const seen = new Set();
      const combined = [];
      for (const item of [...livePosts, ...defaultPosts]) {
        if (!seen.has(item.shortcode) && item.shortcode) {
          seen.add(item.shortcode);
          combined.push(item);
        }
      }
      posts = combined;
    }
  }
} catch (e) {
  // Use defaultPosts on fetch error
}

