---
// src/components/Footer.astro
import SocialMedia from './SocialMedia.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const destekPosts = await getCollection('destek');

const allPosts = [
  ...blogPosts.map(p => ({ title: p.data.title, url: `/blog/${p.data.category || 'genel'}/${p.slug}` })),
  ...destekPosts.map(p => ({ title: p.data.title, url: `/destek/${p.slug}` }))
];

// Randomize and pick up to 21
const shuffledPosts = allPosts.sort(() => 0.5 - Math.random()).slice(0, 21);
