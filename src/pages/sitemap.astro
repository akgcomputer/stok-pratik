      <!-- 5. PLAKA SİCİL & OTO SERVİS -->
      <section id="oto-servis" class="sitemap-category-group bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-200">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
          <span class="text-2xl p-2 rounded-xl bg-amber-50 text-amber-600">🚗</span>
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900">Plaka Sicil Oto Servis, Ekspertiz ve Bakım Ekosistemi</h2>
            <p class="text-xs md:text-sm text-slate-500">TR plaka sorgulama, şasi/motor no, iş emri ve yedek parça yönetimi</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href="/plaka-sicil-oto-servis-ve-arac-gecmisi" class="sitemap-item"><span>🔎</span> Ulusal Araç Bakım Sicili & Geçmişi</a>
