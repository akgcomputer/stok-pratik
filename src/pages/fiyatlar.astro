---
// src/pages/fiyatlar.astro - Stok Pratik Şeffaf Fiyatlandırma & Modüler Paket Yapılandırma
import BaseLayout from '../layouts/BaseLayout.astro';
import ModernPricingCalculator from '../components/ModernPricingCalculator.jsx';
import pricingData from '../data/pricing.json';

const pageTitle = "Fiyatlar & Paketler | Stok Pratik Bulut ERP";
const pageDescription = "1 Ay ücretsiz tam sürüm deneyin! Kredi kartı gerekmez. Başlangıç, KOBİ Pro ve Kurumsal ERP hazır paketleri veya ihtiyacınıza özel modül seçimiyle net fiyatınızı anında hesaplayın.";

// Structured Data (JSON-LD) for SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Stok Pratik Bulut ERP Fiyatlandırma",
  "description": pageDescription,
  "brand": {
    "@type": "Brand",
    "name": "Stok Pratik"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "TL",
    "lowPrice": 490,
    "highPrice": 1990,
    "offerCount": "3",
    "priceValidUntil": "2027-12-31"
  }
};

const sectoralShortcuts = [
  { title: "🚗 Oto Servis & Ekspertiz", desc: "Plaka sicil, iş emri, şasi no ve periyodik bakım takibi.", url: "https://stokpratik.com.tr/oto-tamir-yazilimi" },
  { title: "💎 Kuyumcu & Sarraf", desc: "Gram, milyem, has altın kuru ve anlık canlı fiyat senkronizasyonu.", url: "https://stokpratik.com.tr/kuyumculuk-yazilimi" },
  { title: "👗 Butik & Tekstil", desc: "Renk-beden-kavela varyant matrisi ve asortili mağaza POS kasası.", url: "https://stokpratik.com.tr/tekstil-ve-magazacilik-yazilimi" },
  { title: "🍽️ Kafe & Restoran", desc: "Adisyon, masa planı, mutfak ekranı ve reçeteli porsiyon maliyeti.", url: "https://stokpratik.com.tr/kafe-ve-restoran-adisyon-sistemi" },
  { title: "📦 Toptan & Dağıtım B2B", desc: "Bayi sipariş portalı, vadeli bakiye limiti ve plasiyer araç satışı.", url: "https://stokpratik.com.tr/b2b-toptan-satis-sistemi" },
  { title: "⚙️ Üretim & İmalat", desc: "Hammadde reçetesi, istasyon takibi ve anlık birim maliyet motoru.", url: "https://stokpratik.com.tr/uretim-erp-urun-agaci-bom-ve-gercek-maliyet-motoru" }
];

const faqs = [
  {
    q: "StokPratik'te ek kurulum, sunucu veya gizli bakım ücreti var mı?",
    a: "Kesinlikle hayır. Stok Pratik %100 bulut tabanlı bir sistemdir. Sunucu yatırımı, donanım masrafı, sürüm güncelleme veya kurulum bedeli ödemezsiniz. Seçtiğiniz paket tutarı dışında sürpriz bir maliyet çıkmaz."
  },
  {
    q: "1 Ay ücretsiz kullanım sürecinde kredi kartı gerekiyor mu?",
    a: "Hayır. 1 aylık tam sürüm deneme için kesinlikle kredi kartı bilgisi istemiyoruz. Sisteme 1 dakikada kaydolup firmanızın gerçek verileriyle çalışmaya hemen başlayabilirsiniz."
  },
  {
    q: "Ödemeler nasıl yapılıyor?",
    a: "Tüm paketlerimizde ve ek modüllerde fiyatlar aylık karşılığı olarak belirtilmiş olup, yıllık peşin olarak faturalandırılır. Böylece yıl boyunca fiyat artışından etkilenmezsiniz."
  },
  {
    q: "İhtiyacım olduğunda yeni bir modülü sonradan ekleyebilir miyim?",
    a: "Evet! İşletmeniz büyüdükçe veya yeni bir satış kanalına başladığınızda (örneğin Trendyol pazaryeri, e-irsaliye veya üretim modülü) dilediğiniz modülü tek tıkla aktif edebilirsiniz. Kullanmadığınız modülleri dilediğiniz zaman devre dışı bırakabilirsiniz."
  },
  {
    q: "E-Fatura kontör maliyetleri nedir?",
    a: "Stok Pratik çift entegratör güvencesiyle çalışır. E-Fatura kontör maliyeti fatura başına piyasanın en ekonomik oranı olan yaklaşık 0.70₺ - 0.90₺ civarındadır. Arşivleme tamamen ücretsizdir."
  },
  {
    q: "Mevcut Excel veya eski program verilerimizi aktarabilir miyiz?",
    a: "Evet. Ürünleriniz, stok kartlarınız, müşteri ve tedarikçi carileriniz Excel/CSV formatında tek tıkla Stok Pratik'e aktarılabilir. Dilerseniz uzman destek ekibimiz bu süreci sizin adınıza ücretsiz tamamlar."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main class="bg-slate-50/60 text-slate-800 antialiased min-h-screen">
    
    <!-- EN ÜST ÇARPICI 1 AY ÜCRETSİZ BANNERI -->
    <div class="w-full bg-gradient-to-r from-red-600 via-rose-600 to-red-600 text-white py-3.5 px-4 text-center shadow-md">
      <div class="container mx-auto flex items-center justify-center gap-2 flex-wrap">
        <span class="text-base sm:text-xl font-black tracking-wide">
          🎁 1 Ay Tam Sürüm Ücretsiz Kullanım — Kredi Kartı Gerekmez!
        </span>
        <a 
          href="https://stokpratik.com.tr/firma-kaydi" 
          class="inline-flex items-center gap-1 bg-white text-red-600 hover:bg-red-50 font-black px-4 py-1 rounded-full text-xs sm:text-sm shadow-sm transition-transform hover:scale-105"
        >
          <span>Hemen Başlayın</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- BAŞLIK & AÇIKLAMA (SADE, FİYAT ODAKLI) -->
    <section class="pt-10 pb-6 text-center">
      <div class="container mx-auto px-4 max-w-4xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight mb-3">
          Şeffaf ve Esnek ERP Fiyatlandırması
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Tüm paketlerimizde yıllık peşin ödeme esastır. İhtiyacınıza uygun hazır paketi seçin veya dilediğiniz ek modülleri işaretleyerek net toplamınızı anında belirleyin.
        </p>
      </div>
    </section>

    <!-- ENTEGRE PAKET & MODÜL HESAPLAYICI -->
    <section class="pb-16 sm:pb-24">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <ModernPricingCalculator client:load />
      </div>
    </section>

    <!-- SEKTÖREL ÇÖZÜM PAKETLERİ HIZLI GEÇİŞ KARTLARI -->
    <section class="py-14 sm:py-20 bg-white border-y border-slate-200">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        
        <div class="text-center max-w-3xl mx-auto mb-10">
          <div class="inline-flex items-center gap-2 bg-slate-100 text-slate-700 font-bold text-xs uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-3">
            🏢 Sektörel Dikey Çözümler
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Sektörünüze Özel Hazır Çözümler
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2">
            İşletmenizin faaliyet alanına özel olarak optimize edilmiş dikey yazılım sayfalarımızı inceleyin.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {sectoralShortcuts.map((sec) => (
            <a 
              href={sec.url}
              class="p-5 rounded-2xl border border-slate-200 hover:border-red-400 hover:shadow-md transition-all group bg-slate-50/50 hover:bg-white flex flex-col justify-between"
            >
              <div>
                <h3 class="text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors mb-1.5">
                  {sec.title}
                </h3>
                <p class="text-slate-600 text-xs leading-relaxed mb-3">
                  {sec.desc}
                </p>
              </div>
              <div class="text-xs font-bold text-red-600 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Detaylı İncele →
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- SIKÇA SORULAN SORULAR (SSS) -->
    <section class="py-14 sm:py-20 bg-slate-50">
      <div class="container mx-auto px-4 max-w-4xl">
        
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 bg-red-100 text-red-600 font-bold text-xs uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-3">
            ❓ Şeffaf Yanıtlar
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Fiyatlandırma Hakkında Merak Edilenler
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-xs">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">
                {faq.q}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>
</BaseLayout>
