---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Stok Pratik Çözüm Ortağı & Bayimiz Olun | %30 Yüksek Kâr ve Ömür Boyu Pasif Gelir";
const pageDescription = "Stok Pratik iş ortağı olun! Hem tek seferlik satışlarda %30 net kâr kazanın hem de kiralama yapan müşterileriniz ödeme yaptığı sürece yıllarca süren düzenli pasif gelir elde edin.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased">
    
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-900 to-slate-900 py-20 text-white">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-emerald-300 bg-emerald-950/60 border border-emerald-500/30 rounded-full">
          🚀 Stok Pratik Çözüm Ortaklığı Programı
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
          İşletmelerin Dijital Dönüşümüne Öncülük Edin,<br class="hidden sm:inline" />
          <span class="text-emerald-400">%30 Net Kazanç & Ömür Boyu Pasif Gelir</span> Elde Edin!
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed">
          Sıfır altyapı maliyeti ve kota baskısı olmadan; ön muhasebe, e-ticaret ve sektörel yazılım çözümlerimizi portföyünüze sunarak kazancınızı katlayın.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="#basvuru" class="w-full sm:w-auto px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold text-lg rounded-xl shadow-lg hover:shadow-emerald-500/25 transition duration-200 text-center">
            Hemen Bayilik Başvurusu Yap
          </a>
          <a href="/paketlerimiz" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold text-lg rounded-xl border border-white/20 transition duration-200 text-center">
            Paketleri İncele
          </a>
        </div>
      </div>
    </section>

    <!-- KAZANÇ VE İŞ MODELİ SECTION -->
    <section class="py-16 bg-white border-b border-slate-200">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">Çift Yönlü Kazanç Modeli</h2>
          <p class="text-slate-600 max-w-2xl mx-auto">
            Müşterinizin tercihine göre ister tek seferlik yüksek kazanç elde edin, ister yıllarca sürecek düzenli nakit akışı oluşturun.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Model 1: Satış -->
          <div class="p-8 rounded-2xl border border-slate-200 bg-slate-50 hover:shadow-md transition">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center text-2xl font-bold mb-5">
              💎
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Ömür Boyu Lisans Satışı</h3>
            <p class="text-slate-600 leading-relaxed mb-4">
              İşletmelere tek seferlik ömür boyu lisans paketlerimizin satışını yapın, gerçekleştirilen her satıştan anında <strong class="text-slate-900 font-semibold">%30 net kâr payı</strong> kazanın.
            </p>
            <span class="text-sm font-medium text-blue-600">Yüksek nakit dönüşümü & anında hakediş.</span>
          </div>

          <!-- Model 2: Kiralama (Pasif Gelir) -->
          <div class="p-8 rounded-2xl border border-emerald-200 bg-emerald-50/50 hover:shadow-md transition relative">
            <span class="absolute top-4 right-4 text-xs font-bold bg-emerald-200 text-emerald-800 px-3 py-1 rounded-full">
              Sürekli Kazanç
            </span>
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-2xl font-bold mb-5">
              🔄
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Kiralama & Ömür Boyu Pasif Gelir</h3>
            <p class="text-slate-600 leading-relaxed mb-4">
              Kiralama modeliyle sisteme dahil ettiğiniz işletmeler hizmeti kullandığı ve ödeme yaptığı sürece (10 yıl, 20 yıl fark etmeksizin) <strong class="text-slate-900 font-semibold">her dönem düzenli hakedişinizi almaya devam edersiniz.</strong>
            </p>
            <span class="text-sm font-medium text-emerald-700 font-semibold">Bayilik statünüz korunduğu sürece garantili gelir.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SEKTÖREL ÇÖZÜMLER & İÇ LİNKLER -->
    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">Hangi Çözümleri Sunacaksınız?</h2>
          <p class="text-slate-600 max-w-2xl mx-auto">
            Geniş ürün yelpazemiz sayesinde her sektörden işletmeye tam ihtiyacı olan çözümü rahatlıkla sunabilirsiniz.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-6 bg-white rounded-xl border border-slate-200 flex flex-col justify-between">
            <div>
              <h4 class="font-bold text-lg text-slate-900 mb-2">Ön Muhasebe & POS</h4>
              <p class="text-sm text-slate-600 mb-4">Hızlı satış, barkod entegrasyonu, stok, cari ve e-fatura takibi.</p>
            </div>
            <a href="/ozelliklerimiz" class="text-blue-600 font-medium text-sm hover:underline inline-flex items-center">
              Özellikleri İncele &rarr;
            </a>
          </div>

          <div class="p-6 bg-white rounded-xl border border-slate-200 flex flex-col justify-between">
            <div>
              <h4 class="font-bold text-lg text-slate-900 mb-2">Oto Servis Yazılımı</h4>
              <p class="text-sm text-slate-600 mb-4">Araç kabul, iş emri, yedek parça ve servis bakım süreç yönetimi.</p>
            </div>
            <a href="/oto-tamir-yazilimi" class="text-blue-600 font-medium text-sm hover:underline inline-flex items-center">
              Oto Servis Çözümünü Gör &rarr;
            </a>
          </div>

          <div class="p-6 bg-white rounded-xl border border-slate-200 flex flex-col justify-between">
            <div>
              <h4 class="font-bold text-lg text-slate-900 mb-2">GOLD Kuyumculuk</h4>
              <p class="text-sm text-slate-600 mb-4">Özel matrah, MASAK uyumu ve kuyumculara özel maden takip altyapısı.</p>
            </div>
            <a href="/kuyumculuk-yazilimi" class="text-blue-600 font-medium text-sm hover:underline inline-flex items-center">
              Kuyumcu Paketini İncele &rarr;
            </a>
          </div>
        </div>

        <div class="mt-8 text-center">
          <p class="text-slate-600 text-sm">
            Farklı bütçeler ve yapılandırmalar için 
            <a href="/fiyatlar" class="text-blue-600 font-semibold underline">Fiyat Yapılandırma</a> ve 
            <a href="/paketlerimiz" class="text-blue-600 font-semibold underline">Tüm Paketler</a> sayfalarımızı ziyaret edebilirsiniz.
          </p>
        </div>
      </div>
    </section>

    <!-- NEDEN STOK PRATİK BAYİLİĞİ? -->
    <section class="py-16 bg-white border-t border-slate-200">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-12">İş Ortaklarımıza Sağladığımız Ayrıcalıklar</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-14 h-14 mx-auto bg-slate-100 rounded-2xl flex items-center justify-center text-2xl mb-4">
              🛡️
            </div>
            <h3 class="font-bold text-lg text-slate-900 mb-2">Sıfır Sunucu & Bakım Yükü</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Tüm sunucu, yedekleme ve mevzuat güncellemeleri bizim tarafımızdan yönetilir. Siz sadece satışa ve müşteri ilişkilerine odaklanırsınız.
            </p>
          </div>

          <div class="text-center">
            <div class="w-14 h-14 mx-auto bg-slate-100 rounded-2xl flex items-center justify-center text-2xl mb-4">
              🎯
            </div>
            <h3 class="font-bold text-lg text-slate-900 mb-2">Kota veya Teminat Yok</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Sözleşme bağlayıcılığı, aylık satış kotaları veya yüksek bayilik giriş ücretleri olmadan doğrudan ortaklığınızı başlatabilirsiniz.
            </p>
          </div>

          <div class="text-center">
            <div class="w-14 h-14 mx-auto bg-slate-100 rounded-2xl flex items-center justify-center text-2xl mb-4">
              🤝
            </div>
            <h3 class="font-bold text-lg text-slate-900 mb-2">Birebir Eğitim ve Destek</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Satış öncesi ve sonrası süreçlerde teknik ekibimiz her zaman yanınızda. Demo sunumlarında ve kurulumlarda tam destek sağlıyoruz.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- BAŞVURU FORMU / CTA SECTION -->
    <section id="basvuru" class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4 max-w-3xl text-center">
        <h2 class="text-3xl font-extrabold mb-4">Bayimiz Olmak İçin İlk Adımı Atın</h2>
        <p class="text-slate-400 mb-10">
          Aşağıdaki butona tıklayarak WhatsApp üzerinden doğrudan yetkili ekibimizle görüşebilir veya bilgilerinizi ileterek aynı gün içinde iş ortaklığınızı başlatabilirsiniz.
        </p>

        <div class="bg-slate-800/80 p-8 rounded-3xl border border-slate-700 backdrop-blur-sm max-w-xl mx-auto shadow-2xl">
          <div class="flex flex-col gap-4">
            <a 
              href="https://wa.me/+905325000999?text=Merhaba,%20Stok%20Pratik%20bayilik%20ve%20%C3%A7%C3%B6z%C3%BCm%20ortakl%C4%B1%C4%9F%C4%B1%20hakk%C4%B1nda%20g%C3%B6r%C3%BC%C5%9Fmek%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-4 px-6 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold text-lg rounded-xl shadow-lg transition duration-200 flex items-center justify-center gap-3"
            >
              <span>💬</span> WhatsApp ile Hızlı Başvuru Yap
            </a>
            
            <a 
              href="tel:+905325000999" 
              class="w-full py-3 px-6 bg-slate-700 hover:bg-slate-600 text-white font-medium text-sm rounded-xl transition duration-200"
            >
              📞 Doğrudan Telefon ile İletişime Geç
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">
            Mali Müşavirler, Donanım & POS Satıcıları, Bilişim Teknik Servisleri ve E-Ticaret Danışmanları için başvurular öncelikli olarak değerlendirilir.
          </p>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
