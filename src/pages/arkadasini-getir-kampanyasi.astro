---
// src/pages/arkadasini-getir-kampanyasi.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Arkadaşını Getir, Ücretsiz Kullan! - Stok Pratik">

  <style>
    /* Pulse glow animation for the special CTA */
    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.4);
      }
      50% {
        box-shadow: 0 0 0 20px rgba(220, 38, 38, 0);
      }
    }
    .btn-glow {
      animation: pulse-glow 2s infinite;
    }
  </style>

  {/* Removed floating CTAs per user request to avoid duplication with Header CTA */}

  
  {/* FLOATING STICKY CTA (Top Right) */}
  <div class="fixed top-28 right-6 z-50 animate-in fade-in duration-700 delay-500 hidden lg:block">
    <a href="/arkadasini-getir-formu" class="btn-glow flex flex-col items-center justify-center rounded-full bg-yellow-500 hover:bg-yellow-600 text-black shadow-2xl shadow-yellow-600/50 px-6 py-4 transition-transform hover:scale-105 active:scale-95 text-center group border border-yellow-600">
      <span class="text-[10px] uppercase tracking-widest font-bold opacity-90 group-hover:opacity-100 mb-0.5">arkadaşını getir</span>
      <span class="text-xl font-extrabold tracking-tight leading-none">ÜCRETSİZ KULLAN</span>
    </a>
  </div>

  <main>
    
    {/* HERO / BANNER CTA - AT THE TOP */}
    <section class="bg-red-600 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>
      
      <div class="container mx-auto px-4 max-w-4xl relative z-10 text-center">
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 leading-tight">
          Yazılım masrafınızı sıfırlamaya hazır mısınız?
        </h2>
        <p class="text-red-100 text-lg md:text-xl mb-12 max-w-2xl mx-auto font-medium">
          İşletmeci çevrenizi Stok Pratik kolaylığıyla tanıştırın, hemen kazanmaya başlayın.
        </p>
        
        <a href="/arkadasini-getir-formu" class="btn-glow inline-flex flex-col items-center justify-center rounded-full bg-yellow-500 hover:bg-yellow-600 text-black shadow-2xl shadow-yellow-600/50 px-10 py-5 transition-transform hover:scale-105 active:scale-95 group border border-yellow-400">
          <span class="text-xs uppercase tracking-widest font-bold opacity-80 group-hover:opacity-100 mb-1">arkadaşını getir</span>
          <span class="text-2xl sm:text-3xl font-black tracking-tight">ÜCRETSİZ KULLAN</span>
        </a>
      </div>
    </section>

    {/* COMPARE BENEFITS & GRAPHIC */}
    <section class="pt-16 pb-12 lg:pt-24 lg:pb-16 bg-slate-50 border-b border-slate-200">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          
          {/* Left: Text Content */}
          <div class="order-2 lg:order-1">
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-10 text-center lg:text-left">Birlikte Güçlüyüz, Birlikte Karlıyız</h2>
            
            <div class="space-y-8">
              <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-slate-300"></div>
                <h4 class="text-lg font-bold text-slate-800 mb-3 uppercase tracking-wide flex items-center gap-2">
                  <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                  Arkadaşın Ne Kazanıyor?
                </h4>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2 text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Yeni gelen işletme için ilk yılda <strong>+1 Ay Ücretsiz</strong> kullanım</span>
                  </li>
                  <li class="flex items-start gap-2 text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Sıfır entegrasyonlu ekosistem konforu</span>
                  </li>
                  <li class="flex items-start gap-2 text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Ücretsiz veri aktarım ve on-boarding desteği</span>
                  </li>
                </ul>
              </div>

              <div class="bg-white p-6 rounded-2xl border border-red-200 shadow-lg shadow-red-100 relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-red-600"></div>
                <h4 class="text-lg font-bold text-red-700 mb-3 uppercase tracking-wide flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  Sen Ne Kazanıyorsun?
                </h4>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2 text-slate-700 font-medium">
                    <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Her arkadaşın için bitiş tarihine <strong>+30 gün eklensin</strong></span>
                  </li>
                  <li class="flex items-start gap-2 text-slate-700 font-medium">
                    <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>12 davette <strong>tam <span class="text-red-600">1 yıl bedava</span></strong> lisans kazanın</span>
                  </li>
                  <li class="flex items-start gap-2 text-slate-700 font-medium">
                    <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Üst limit yok: Sınırsız birikim imkanı</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          {/* Right: Graphic 2 */}
          <div class="order-1 lg:order-2">
            <div class="w-full relative rounded-3xl overflow-hidden shadow-xl shadow-slate-200/50">
              <img src="/images/site-foto/arkadasini-getir-2.webp" alt="Avantajlar" class="w-full h-auto object-cover aspect-[4/3]" />
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* GRAPHIC 1 SECTION (Reduced padding to close gap) */}
    <section class="relative pt-12 pb-16 lg:pt-16 lg:pb-20 overflow-hidden bg-white">
      {/* Background decoration */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-red-50 rounded-full blur-3xl opacity-30 -z-10 -translate-y-1/2 pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="text-center max-w-4xl mx-auto flex flex-col items-center">
          
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-100 text-red-700 text-sm font-bold tracking-wide mb-8 border border-red-200 shadow-sm">
            <span>🎁</span> Stok Pratik Dayanışma Programı: Üst Limit Yok!
          </div>
          
          <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
            İşletmenizi Büyütürken Birlikte Kazanın: <br class="hidden md:block"/>
            <span class="text-red-600">Arkadaşını Getir, Ücretsiz Kullan!</span>
          </h1>
          
          <p class="text-lg md:text-xl text-slate-600 mb-12 leading-relaxed max-w-3xl">
            Çevrenizdeki işletmeleri entegrasyon karmaşasından kurtarın; hem davet ettiğiniz işletme kazansın hem siz kazanın. Her başarılı davet için <strong class="text-slate-800 font-bold">+1 ay ücretsiz lisans!</strong> Üstelik davet sınırı yok: 12 arkadaşını getiren işletme tam 1 yıl boyunca tek kuruş ödemez.
          </p>

          {/* HERO GRAPHIC WITH CAMPAIGN SLOGAN */}
          <div class="w-full relative rounded-3xl overflow-hidden shadow-2xl shadow-slate-200/50 max-w-6xl mx-auto">
            <img src="/images/site-foto/arkadasini-getir.webp" alt="Arkadaşını Getir" class="w-full h-auto object-cover" />
            <div class="absolute inset-0 flex items-center justify-start p-6 sm:p-12 md:p-16 lg:p-24 w-full md:w-2/3 lg:w-1/2">
              <div>
                <h2 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight drop-shadow-sm">
                  İşletmeni Büyüt,<br />
                  <span class="text-red-600">Masrafsız Yönet!</span>
                </h2>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    {/* HOW IT WORKS (3 STEPS) */}
    <section class="py-16 lg:py-24 bg-slate-50 border-t border-slate-200">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Nasıl Çalışır?</h2>
          <p class="text-lg text-slate-500 max-w-2xl mx-auto">3 basit adımda çevrenizdeki işletmeleri dijitalleştirin ve çift taraflı kazancın keyfini çıkarın.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
          {/* Step 1 */}
          <div class="bg-white rounded-2xl p-8 border border-slate-100 hover:border-slate-300 hover:shadow-lg transition-all duration-300 relative group shadow-sm">
            <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center text-2xl font-black mb-6 group-hover:bg-red-600 group-hover:text-white transition-colors shadow-sm">1</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Kodunu Al & Paylaş</h3>
            <p class="text-slate-600 leading-relaxed">
              Panelindeki "Arkadaşını Getir" alanından sana özel davet kodunu veya bağlantını tek tıkla kopyala, işletmeci dostlarınla WhatsApp'tan paylaş.
            </p>
          </div>
          
          {/* Step 2 */}
          <div class="bg-white rounded-2xl p-8 border border-slate-100 hover:border-slate-300 hover:shadow-lg transition-all duration-300 relative group shadow-sm">
            <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center text-2xl font-black mb-6 group-hover:bg-red-600 group-hover:text-white transition-colors shadow-sm">2</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Arkadaşın Abone Olsun</h3>
            <p class="text-slate-600 leading-relaxed">
              Arkadaşın ilk aboneliğini başlatırken senin kodunu girsin veya müşteri temsilcimize belirtsin. İlk faturası kesilsin.
            </p>
          </div>
          
          {/* Step 3 */}
          <div class="bg-red-50 rounded-2xl p-8 border border-red-100 hover:border-red-300 hover:shadow-xl transition-all duration-300 relative group shadow-sm">
            <div class="w-14 h-14 bg-red-600 text-white rounded-2xl flex items-center justify-center text-2xl font-black mb-6 shadow-md">3</div>
            <h3 class="text-xl font-bold text-red-900 mb-3">İkiniz de 1 Ay Kazanın!</h3>
            <p class="text-red-800/80 leading-relaxed font-medium">
              Arkadaşının paketine anında <strong>+1 Ay Hediye</strong> eklensin, senin mevcut aboneliğin de <strong>1 Ay Ücretsiz</strong> uzatılsın. Sıfır karmaşa!
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SAVINGS TABLE */}
    <section class="py-16 lg:py-24 bg-white border-t border-slate-100">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">"Üst Limit Yok!" Tasarruf Tablosu</h2>
          <p class="text-lg text-slate-500">Ne kadar çok davet ederseniz, yazılım masrafınız o kadar hızlı sıfırlanır.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-lg shadow-slate-100">
          <div class="flex flex-col">
            
            {/* Table Row 1 */}
            <div class="flex flex-col sm:flex-row items-center p-6 border-b border-slate-100 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-4 w-full sm:w-1/3 mb-4 sm:mb-0">
                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-700">1</div>
                <span class="font-bold text-slate-800 text-lg">1 Arkadaş</span>
              </div>
              <div class="w-full sm:w-1/3 text-center mb-4 sm:mb-0">
                <span class="inline-block px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-bold">&rarr; +1 Ay Ücretsiz</span>
              </div>
              <div class="w-full sm:w-1/3 sm:text-right text-slate-600 font-medium">
                1 Aylık Yazılım Maliyeti Sıfırlandı
              </div>
            </div>

            {/* Table Row 2 */}
            <div class="flex flex-col sm:flex-row items-center p-6 border-b border-slate-100 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-4 w-full sm:w-1/3 mb-4 sm:mb-0">
                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-700">3</div>
                <span class="font-bold text-slate-800 text-lg">3 Arkadaş</span>
              </div>
              <div class="w-full sm:w-1/3 text-center mb-4 sm:mb-0">
                <span class="inline-block px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-bold">&rarr; +3 Ay Ücretsiz</span>
              </div>
              <div class="w-full sm:w-1/3 sm:text-right text-slate-600 font-medium">
                Çeyrek Yıl Bedava Yönetim
              </div>
            </div>

            {/* Table Row 3 */}
            <div class="flex flex-col sm:flex-row items-center p-6 border-b border-slate-100 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-4 w-full sm:w-1/3 mb-4 sm:mb-0">
                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-700">6</div>
                <span class="font-bold text-slate-800 text-lg">6 Arkadaş</span>
              </div>
              <div class="w-full sm:w-1/3 text-center mb-4 sm:mb-0">
                <span class="inline-block px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-bold">&rarr; +6 Ay Ücretsiz</span>
              </div>
              <div class="w-full sm:w-1/3 sm:text-right text-slate-600 font-medium">
                Yarım Yıl Sıfır Masraf
              </div>
            </div>

            {/* Table Row 4 (Highlight) */}
            <div class="flex flex-col sm:flex-row items-center p-6 sm:p-8 bg-red-600 text-white relative overflow-hidden group">
              <div class="absolute right-0 top-0 bottom-0 opacity-10 group-hover:scale-110 transition-transform duration-700">
                <svg class="h-full w-auto" viewBox="0 0 200 200" fill="currentColor"><path d="M45.7,-76.3C58.9,-69.3,69.1,-55.3,77.5,-40.8C85.8,-26.3,92.3,-11.3,91.3,3.3C90.3,17.9,81.7,32,71.2,43.3C60.7,54.6,48.2,63,34.7,69.5C21.2,76,6.6,80.5,-7.6,79.9C-21.8,79.3,-35.6,73.5,-47.9,64.9C-60.2,56.3,-71.1,44.9,-78.9,31.4C-86.7,17.9,-91.5,2.4,-88.7,-11.9C-85.9,-26.2,-75.6,-39.3,-63.3,-48.9C-51,-58.5,-36.8,-64.5,-23.1,-70.5C-9.4,-76.5,3.7,-82.5,17.6,-81.1C31.5,-79.6,45.3,-70.7,45.7,-76.3Z" transform="translate(100 100)" /></svg>
              </div>
              
              <div class="flex items-center gap-4 w-full sm:w-1/3 mb-4 sm:mb-0 relative z-10">
                <div class="w-12 h-12 rounded-full bg-white text-red-600 flex items-center justify-center font-black text-xl shadow-lg">12</div>
                <span class="font-extrabold text-xl sm:text-2xl">12 Arkadaş</span>
              </div>
              <div class="w-full sm:w-1/3 text-center mb-4 sm:mb-0 relative z-10">
                <span class="inline-block px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-bold border border-white/30 text-white">&rarr; Tam 1 Yıl Ücretsiz!</span>
              </div>
              <div class="w-full sm:w-1/3 sm:text-right font-bold text-lg relative z-10">
                Stok Pratik 365 Gün Boyunca Tamamen Bedava!
              </div>
            </div>

          </div>
          
          <div class="p-4 bg-slate-50 text-center border-t border-slate-200">
            <p class="text-sm text-slate-500 font-medium"><em>12'den Fazla mı?</em> Kazanmaya devam edin; her yeni işletme abonelik sürenizi ileriye taşır.</p>
          </div>
        </div>
      </div>
    </section>

    {/* FAQ SECTION */}
    <section class="py-16 lg:py-24 bg-slate-50 border-y border-slate-200">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Sıkça Sorulan Sorular</h2>
          <p class="text-lg text-slate-500">Kampanya hakkında merak ettiğiniz tüm detaylar.</p>
        </div>

        <div class="mb-12 rounded-3xl overflow-hidden shadow-xl shadow-slate-200/50 max-w-4xl mx-auto">
          <img src="/images/site-foto/arkadasini-getir-3.webp" alt="Sıkça Sorulan Sorular" class="w-full h-auto object-cover" />
        </div>

        <div class="space-y-4" id="faq-container">
          
          {/* FAQ Item 1 */}
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200">
            <button class="w-full px-6 py-5 text-left font-bold text-slate-800 flex justify-between items-center focus:outline-none faq-btn">
              <span>Davet edebileceğim işletme sayısında bir üst sınır var mı?</span>
              <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="px-6 pb-5 text-slate-600 hidden faq-content">
              Hayır, limit yok. 12 işletmede 1 tam yıl, 24 işletmede 2 yıl ücretsiz kullanım hakkı kazanırsınız. Sınır tamamen sizin çevrenize bağlıdır.
            </div>
          </div>

          {/* FAQ Item 2 */}
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200">
            <button class="w-full px-6 py-5 text-left font-bold text-slate-800 flex justify-between items-center focus:outline-none faq-btn">
              <span>Arkadaşım kampanyadan nasıl faydalanacak?</span>
              <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="px-6 pb-5 text-slate-600 hidden faq-content">
              Sizin kodunuzla geldiğinde satın aldığı pakete ek olarak anında +1 ay kullanım süresi hesabına tanımlanır. Örneğin yıllık alım yaparsa 13 ay kullanır.
            </div>
          </div>

          {/* FAQ Item 3 */}
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200">
            <button class="w-full px-6 py-5 text-left font-bold text-slate-800 flex justify-between items-center focus:outline-none faq-btn">
              <span>Ücretsiz ayım ne zaman hesabıma yansır?</span>
              <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="px-6 pb-5 text-slate-600 hidden faq-content">
              Davet ettiğiniz işletmenin abonelik aktivasyonu tamamlandıktan ve ilk faturası oluştuktan hemen sonra otomatik olarak hesabınıza eklenir ve size bildirim gelir.
            </div>
          </div>

          {/* FAQ Item 4 */}
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200">
            <button class="w-full px-6 py-5 text-left font-bold text-slate-800 flex justify-between items-center focus:outline-none faq-btn">
              <span>Davet kodumu nereden bulabilirim?</span>
              <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="px-6 pb-5 text-slate-600 hidden faq-content">
              Stok Pratik yönetim panelinize giriş yaptıktan sonra profil veya sol menüdeki "Arkadaşını Getir" sekmesinden kodunuzu görebilirsiniz.
            </div>
          </div>
          
          {/* FAQ Item 5 */}
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200">
            <button class="w-full px-6 py-5 text-left font-bold text-slate-800 flex justify-between items-center focus:outline-none faq-btn">
              <span>Farklı sektördeki işletmeleri davet edebilir miyim?</span>
              <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="px-6 pb-5 text-slate-600 hidden faq-content">
              Evet! Butik, oto servis, hırdavat, market, toptancı veya e-ticaret fark etmeksizin tüm işletmeler davet kodunuzla katılabilir ve kampanyadan faydalanabilir.
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>

  <script>
    // FAQ Accordion Logic
    document.addEventListener('DOMContentLoaded', () => {
      const faqButtons = document.querySelectorAll('.faq-btn');
      
      faqButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const content = btn.nextElementSibling;
          const icon = btn.querySelector('.faq-icon');
          
          // Toggle current
          if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
          } else {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
          }
        });
      });
    });
  </script>

</BaseLayout>
