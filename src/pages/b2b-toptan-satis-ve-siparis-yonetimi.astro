---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "B2B Toptan Satış, Sevk İrsaliyesi, Cari Risk ve Tahsilat | Stok Pratik";
const pageDescription = "Toptan satış operasyonlarınızı tekliften tahsilata tek ekrandan yönetin. Cari risk kontrolü, kamyon/tır plakalı resmi sevk irsaliyesi, irsaliye birleştirme ve vadeli çek-senet entegrasyonu.";

const workflowSteps = [
  {
    step: "01",
    title: "Hızlı Toptan Teklif ve Sipariş Oluşturma",
    desc: "Müşterinizi seçin; daha önce hangi ürünü hangi fiyattan aldığını görün. Koli veya palet adedini girdiğiniz anda müşteriye özel kademeli toptan fiyat otomatik gelsin."
  },
  {
    step: "02",
    title: "Otomatik Cari Risk ve Kredi Limiti Denetimi",
    desc: "Siparişi onaylamadan önce müşterinin mevcut açık hesap borcunu, portföydeki vadesi gelmemiş çek/senet riskini ve kalan kredi limitini anında görün; batık alacak riskini sıfırlayın!"
  },
  {
    step: "03",
    title: "Barkodlu Depo Toplama ve Resmi Sevk İrsaliyesi",
    desc: "Siparişi depoya iletin; koridor ve raf adreslerinden ürünler barkodla toplansın. Taşıyıcı lojistik firması, kamyon/tır plakası, dorse plakası ve şoför TCKN bilgileriyle resmi e-İrsaliye saniyeler içinde basılsın."
  },
  {
    step: "04",
    title: "İrsaliyeleri Birleştirip Tek Tıkla Satış Faturasına Dönüştürme",
    desc: "Aynı bayiye hafta boyunca 5 ayrı kamyonla sevk irsaliyesi mi kestiniz? Hafta sonunda irsaliyeleri tek tıkla e-Faturaya dönüştürün; mükerrer stok düşümü olmadan faturanız resmileşsin."
  },
  {
    step: "05",
    title: "Çek, Senet, Havale veya Sanal POS ile Esnek Tahsilat",
    desc: "Toptan faturanın karşılığında müşteriden aldığınız vadeli çeki/senedi portföye işleyin, banka havalesini kaydedin veya CariNET / Linkle Sat üzerinden kredi kartına 12 taksitle anında tahsil edin."
  }
];

const b2bFeatures = [
  {
    icon: "👔",
    title: "Asorti ve Varyantlı Toptan Satış",
    desc: "Tekstil, ayakkabı ve moda toptancıları için renk, beden, numara ve kalıp serili (asorti koli) tek ekrandan yıldırım hızında toptan sipariş girişi.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "📈",
    title: "Satış Temsilcisi (Plasiyer) Prim Takibi",
    desc: "Hangi satış temsilcisinin hangi bayilere ne kadarlık toptan ciro yaptığını, tahsilat başarısını ve hak ettiği plasiyer primini otomatik hesaplayın.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "🏭",
    title: "Çoklu Depo ve Bölge Sevkiyatı",
    desc: "Toptan siparişi merkez ofiste onaylayın; sevkiyat iş emrini fabrika ambarınıza veya bölge lojistik deponuza anlık yönlendirin.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "💱",
    title: "Dövizli Fatura ve Kur Sabitleme",
    desc: "USD veya EUR bazında toptan teklif ve fatura düzenleyin; TCMB canlı döviz kuru veya müşteriyle önceden anlaşılmış sabit kur ile cari bakiyeyi yönetin.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "💬",
    title: "WhatsApp'tan Anında Proforma & Ekstre",
    desc: "Müşterinize tek tıkla WhatsApp üzerinden PDF Proforma Fatura, A4 Resmi Fatura ve ayrıntılı Cari Hesap Ekstresi ileterek süreci hızlandırın.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "🌐",
    title: "DepodanDirekt & CariNET Hazır",
    desc: "Ürünlerinizi tek tıkla kendi bayilerinizin girebildiği CariNET B2B portalına ve DepodanDirekt.com üzerinden tüm Türkiye'deki toptan alıcılara açın.",
    colSpan: "lg:col-span-1"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-blue-600 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-blue-950/30 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-blue-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
              📦 B2B Toptan Ticaret • Siparişten Sevkiyata Tam Entegre Toptan Satış
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Toptan Satışta Hız, Güven ve Disiplin: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-200">
                Siparişi Alın, Cari Riskini Denetleyin, İrsaliyesini Kesin!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Toptan ticaret perakendeye benzemez; vadeli açık hesaplar, müşteri çekleri, birleştirilen sevk irsaliyeleri ve paletli sevkiyatlar kusursuz bir düzen ister. Stok Pratik ile toptan satışlarınızı tekliften tahsilata kadar tek ekrandan yönetin.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-blue-600/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🚀 Toptan Satış Sistemini Ücretsiz Kullanın</span>
              </a>
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/giris" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🔐 Giriş Yap</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-blue-400 font-bold">✓</span> Otomatik Cari Risk & Çek Limiti
              </div>
              <div class="flex items-center gap-2">
                <span class="text-blue-400 font-bold">✓</span> Plakalı Resmi Sevk İrsaliyesi
              </div>
              <div class="flex items-center gap-2">
                <span class="text-blue-400 font-bold">✓</span> İrsaliye Birleştirme & e-Fatura
              </div>
            </div>
          </div>

          <!-- Sağ: B2B Toptan Akış Simülasyon Kartı -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-blue-500/30 rounded-3xl p-6 sm:p-7 shadow-2xl backdrop-blur-xl">
              
              <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-blue-400"></span>
                  <span class="text-xs font-mono font-bold text-slate-300">Toptan Sipariş & Sevk İş Emri</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold">
                  Risk Onaylı ✓
                </span>
              </div>

              <!-- Bayi ve Risk Özeti -->
              <div class="bg-slate-950/80 rounded-2xl p-4 border border-slate-800 mb-4 space-y-2">
                <div class="flex justify-between items-center text-xs">
                  <span class="text-slate-400 font-medium">Cari / Bayi:</span>
                  <span class="font-bold text-white">Marmara Yapı Market Ltd. Şti.</span>
                </div>
                <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-800/80 text-[11px]">
                  <div>
                    <div class="text-slate-400 text-[10px]">Açık Hesap</div>
                    <div class="font-mono font-bold text-amber-300">42.500 ₺</div>
                  </div>
                  <div>
                    <div class="text-slate-400 text-[10px]">Portföy Çek</div>
                    <div class="font-mono font-bold text-blue-300">80.000 ₺</div>
                  </div>
                  <div>
                    <div class="text-slate-400 text-[10px]">Kalan Limit</div>
                    <div class="font-mono font-bold text-emerald-400">127.500 ₺</div>
                  </div>
                </div>
              </div>

              <!-- Sevkiyat ve İrsaliye Kartı -->
              <div class="bg-blue-950/30 rounded-2xl p-4 border border-blue-500/20 space-y-3 mb-4">
                <div class="flex justify-between items-center text-xs">
                  <span class="text-blue-300 font-semibold">🚚 Resmi Sevk İrsaliyesi (#IRS-2026-084)</span>
                  <span class="text-slate-400 text-[10px]">10 Palet (240 Koli)</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-[10px] font-mono bg-slate-950/70 p-2.5 rounded-xl border border-slate-800">
                  <div><span class="text-slate-400">Lojistik:</span> Borusan Lojistik</div>
                  <div><span class="text-slate-400">Kamyon:</span> 34 SP 884</div>
                  <div><span class="text-slate-400">Dorse:</span> 34 TK 1902</div>
                  <div><span class="text-slate-400">Şoför TCKN:</span> 284••••••14</div>
                </div>
              </div>

              <!-- Eylem Butonları -->
              <div class="grid grid-cols-2 gap-2 text-[11px] font-semibold">
                <div class="p-2.5 rounded-xl bg-slate-800 text-center text-slate-300 border border-slate-700 flex items-center justify-center gap-1.5">
                  <span>📄 Sevk e-İrsaliyesi Bas</span>
                </div>
                <div class="p-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-center text-white flex items-center justify-center gap-1.5 shadow-md shadow-blue-600/30">
                  <span>⚡ Tek Tıkla e-Faturaya Çevir</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. TOPTAN SATIŞIN 5 ADIMLI KUSURSUZ İŞ AKIŞI -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative bg-slate-900/40">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-blue-400 text-sm font-semibold tracking-wider uppercase mb-3">Uçtan Uca Operasyon</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Toptan Satışın 5 Adımlı Kusursuz İş Akışı
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            Sipariş fişinden kamyon yüklemesine, irsaliye birleştirmeden çek tahsilatına sıfır hata ile çalışan B2B omurga.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
          {workflowSteps.map((step) => (
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 font-mono font-black text-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  {step.step}
                </div>
                <h3 class="text-base font-bold text-white mb-2 leading-snug">{step.title}</h3>
                <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. TOPTANCILAR İÇİN 6 KRİTİK ÖZELLİK (BENTO GRID) -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-blue-400 text-sm font-semibold tracking-wider uppercase mb-3">Gelişmiş B2B Yetenekleri</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Toptancılara Özel Geliştirilen Kritik Kabiliyetler
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            Klasik ön muhasebelerin yetersiz kaldığı asortili satış, plasiyer primleri ve dövizli kur sabitleme Stok Pratik'te standart!
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {b2bFeatures.map((feat) => (
            <div class={`${feat.colSpan} bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-7 hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group`}>
              <div>
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 text-2xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                  {feat.icon}
                </div>
                <h3 class="text-lg font-bold text-white mb-2.5">{feat.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{feat.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-blue-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs sm:text-sm font-semibold mb-6">
          ✨ 14 Gün Ücretsiz Deneme • Kurulum Gerektirmez
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          Toptan Ticaretinizi Büyütmenin En Pratik Yolu!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Kurulumsuz ve taahhütsüz hemen ücretsiz hesabınızı açın; toptan tekliften sevk irsaliyesine, vadeli çek yönetiminden tahsilata tüm operasyonunuzu bugün dijitalleştirin.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-base shadow-lg shadow-blue-600/30 transition-all duration-200"
          >
            🎁 Ücretsiz Hesabımı Oluştur
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
