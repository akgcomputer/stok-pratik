---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Dijital Fiyat Gör ve Ürün Bilgi Kiosku | Stok Pratik";
const pageDescription = "Herhangi bir tableti veya ekranı saniyeler içinde akıllı Fiyat Gör kioskuna dönüştürün. Müşteri barkodu okutsun, indirimli fiyatı ve ürün detayını dev ekranda görsün.";

const benefits = [
  {
    icon: "💸",
    title: "Binlerce Liralık Cihaz Maliyetini Sıfırlar",
    desc: "Özel endüstriyel kiosk cihazları almak yerine, elinizdeki herhangi bir Android/iPad tableti veya USB barkod okuyuculu eski bir monitörü anında Fiyat Gör istasyonuna çevirir."
  },
  {
    icon: "🏷️",
    title: "Raf Etiketi ile Kasa Fiyatı Uyuşmazlığına Son",
    desc: "Fiyat değişikliklerinde personeliniz rafları güncelleyene kadar müşteriniz en güncel kasa fiyatını kiosk ekranından teyit eder; kasada tartışma ve itiraz yaşanmaz."
  },
  {
    icon: "📸",
    title: "Kamera veya Lazer Barkod Okuyucu Desteği",
    desc: "İster USB veya Bluetooth lazer barkod okuyucu bağlayın, ister tabletin kendi ön/arka kamerasını kullanarak anında barkod taratın."
  },
  {
    icon: "🔒",
    title: "Tam Ekran Kilitli (Kiosk) Güvenlik Modu",
    desc: "Müşteri bu ekranda sadece barkod okutup fiyat ve ürün bilgisi görebilir; şirketinizin alış maliyetlerine veya diğer menülerine kesinlikle erişemez."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-cyan-600 selection:text-white">
    
    <!-- 1. HERO SECTION (Cyan & Neon Glassmorphic Theme) -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-cyan-950/30 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/3 w-[500px] h-[300px] bg-cyan-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-7 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
              🔍 Temel Ticaret • Mağaza İçi Dijital Fiyat Gör & Bilgi Kiosku
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              "Bu Ürünün Fiyatı Ne Kadar?" Sorusuna Son: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-white">
                Herhangi Bir Tableti Akıllı Fiyat Gör Kioskuna Dönüştürün!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-400 max-w-2xl mb-8 leading-relaxed">
              Binlerce dolarlık özel fiyat gör cihazlarına ihtiyacınız yok! Stok Pratik'in yerleşik ekranını mağazanızdaki bir tablete veya barkod okuyuculu ekrana açın; müşteriniz ürünü okutsun, anlık satış fiyatını, indirimini ve fotoğrafını dev ekranda görsün.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black rounded-xl shadow-lg shadow-cyan-500/30 transition-all transform hover:-translate-y-0.5 text-center text-base">
                🔍 Fiyat Gör Kioskunu Ücretsiz Aç
              </a>
              <a href="#avantajlar" class="w-full sm:w-auto px-7 py-4 bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-bold rounded-xl transition-all text-center text-base">
                💡 Donanım Avantajlarını İncele
              </a>
            </div>

            <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <span class="flex items-center gap-1.5"><span class="text-cyan-400">✓</span> Sıfır Donanım Maliyeti</span>
              <span class="flex items-center gap-1.5"><span class="text-cyan-400">✓</span> Tablet & Kamera Desteği</span>
              <span class="flex items-center gap-1.5"><span class="text-cyan-400">✓</span> Kilitli Kiosk Güvenliği</span>
            </div>
          </div>

          <!-- Sağ: Canlı İnteraktif Kiosk Ekranı Mockup Simülasyonu -->
          <div class="lg:col-span-5">
            <div class="rounded-3xl bg-slate-900 p-6 sm:p-8 border-2 border-cyan-500/40 shadow-2xl shadow-cyan-950/50 backdrop-blur-xl relative">
              <div class="text-center pb-4 border-b border-slate-800 mb-6">
                <span class="text-xs uppercase tracking-widest text-cyan-400 font-extrabold block">STOK PRATİK FİYAT GÖR</span>
                <span class="text-xs text-slate-400">Barkodu cihazın kamerasına veya lazer okuyucuya tutunuz</span>
              </div>

              <!-- Simülasyon Ürün Kartı -->
              <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 text-center mb-6">
                <div class="w-24 h-24 mx-auto mb-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-4xl shadow-inner">
                  👟
                </div>
                
                <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold mb-2">
                  🔥 %24 İNDİRİM FIRSATI
                </span>
                <h3 class="text-lg font-bold text-white mb-1">Air Comfort Koşu & Yürüyüş Ayakkabısı</h3>
                <p class="text-xs text-slate-500 font-mono mb-4">Barkod: 8690123987654</p>

                <div class="flex items-baseline justify-center gap-3">
                  <span class="text-sm text-slate-500 line-through">590,00 ₺</span>
                  <span class="text-4xl font-black text-cyan-400">449,90 ₺</span>
                </div>
                <span class="text-[11px] text-slate-400 block mt-1">KDV Dahil Satış Fiyatı</span>
              </div>

              <div class="text-center">
                <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="inline-block w-full py-3.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black rounded-xl text-sm transition">
                  Kiosk Ekranını Başlatın ➔
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. AVANTAJLAR (4 BÜYÜK KART) -->
    <section id="avantajlar" class="py-24 bg-slate-900/50 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-cyan-400 font-bold uppercase tracking-wider text-xs">Maliyet ve Müşteri Memnuniyeti</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
            Neden Mağazanızda Fiyat Gör Kullanmalısınız?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {benefits.map((b) => (
            <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-cyan-500/40 transition-all flex items-start gap-5">
              <span class="text-4xl flex-shrink-0">{b.icon}</span>
              <div>
                <h3 class="text-lg font-bold text-white mb-2">{b.title}</h3>
                <p class="text-sm text-slate-400 leading-relaxed">{b.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ALT KAPANIŞ ÇAĞRISI (BOTTOM CTA) -->
    <section class="py-24 bg-gradient-to-b from-slate-900 via-cyan-950 to-slate-950 text-white text-center relative overflow-hidden border-t border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(#06b6d4_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
        <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-500/20 border border-cyan-400/30 text-cyan-300 text-xs font-bold uppercase tracking-wider mb-4">
          Kurumsal Dokunuş • Sıfır Maliyet
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 text-white">
          Mağazanıza Kurumsal Bir Dokunuş Katın — Tamamen Ücretsiz!
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Stok Pratik hesabınızı açtığınız anda Fiyat Gör Kiosk ekranınız kullanıma hazırdır. Hemen ücretsiz başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black rounded-xl shadow-xl shadow-cyan-500/30 transition-all text-center">
            🚀 Hemen Giriş Yapın & Başlayın
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center">
            🎁 14 Gün Ücretsiz Deneyin
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
