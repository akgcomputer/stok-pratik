          <div class="mb-6 bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 flex items-center justify-center min-h-[200px]">
            <!-- Görseli buraya ekleyiniz. Örn: /images/destek/ornek-3.jpg -->
            <img src="/images/destek/transfer-10.jpg" alt="Adım 10 Görseli" class="w-full h-auto object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="text-slate-400 font-medium hidden">Görsel Yeri: /images/destek/transfer-10.jpg</span>
          </div>
          <!-- Açıklama Alanı -->
          <div class="text-slate-600 text-lg leading-relaxed">
            <p>
              Transferin Kabulü için listeden transferlere bakılır ve kontrol edilir.
              Artı (+) simgesine basarak gelen ürünler incelenir              
              </p>
          </div>
        </div>

        <!-- ADIM 10 -->
        <div class="step-block border-b border-slate-100 pb-12 last:border-0 last:pb-0">
