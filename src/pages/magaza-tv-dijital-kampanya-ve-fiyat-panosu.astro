---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Mağaza TV - Dijital Kampanya, Menü ve Fiyat Yayını | Stok Pratik";
const pageDescription = "Mağazanızdaki Smart TV'leri canlı kampanya ve fiyat panosuna dönüştürün. Fiyat değiştiğinde TV anında güncellensin. Sıfır cihaz ve lisans maliyetiyle hemen deneyin!";

const tvFeatures = [
  {
    icon: "⚡",
    title: "Fiyat Değiştiği Saniyede TV'de Güncellenir",
    desc: "USB bellekle televizyona görsel taşıma devri bitti! Stok Pratik'ten ürünün fiyatını değiştirdiğiniz veya stoğu bittiği anda TV ekranındaki yayın otomatik güncellenir.",
    colSpan: "lg:col-span-2"
  },
  {
    icon: "🛍️",
    title: "Kasa Arkası & Vitrin Ekranı",
    desc: "Kasa kuyruğunda bekleyen müşterilere kasa arkasındaki ekrandan 'Günün Fırsat Ürünlerini' göstererek sepet ortalamanızı %25'e kadar artırın.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "🍔",
    title: "Restoran, Kafe & Şarküteri Menü Panosu",
    desc: "Günlük değişen yemek menülerini, unlu mamulleri veya şarküteri reyonu fiyatlarını uzaktan okunabilir şık bir dijital menü panosu olarak yayınlayın.",
    colSpan: "lg:col-span-1"
  },
  {
    icon: "💎",
    title: "Kuyumcu, Döviz & Elektronik Mağazaları",
    desc: "Hem vitrindeki özel takı ve teknoloji ürünlerinizi sergileyin hem de alt bantta anlık canlı döviz ve altın kurlarını prestijle akıtın.",
    colSpan: "lg:col-span-2"
  },
  {
    icon: "🔌",
    title: "Sıfır Ek Cihaz ve Sıfır Lisans Ücreti",
    desc: "Özel digital signage kutuları veya pahalı yazılımlar yok! İnternet tarayıcısı olan herhangi bir Smart TV veya HDMI bağlı bilgisayardan anında çalışır.",
    colSpan: "lg:col-span-3"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-purple-600 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-950/30 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-purple-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
              📺 Temel Ticaret • Mağaza İçi Digital Signage & TV Modu
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Mağazanızdaki Televizyonlar Boş Durmasın: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-300 to-white">
                Fırsat Ürünlerinizi Dev Ekranda Canlı Yayınlayın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-400 max-w-xl mb-8 leading-relaxed">
              Marketinizde, restoranınızda, fırınınızda veya vitrininizde asılı duran Smart TV'yi 7/24 çalışan bir satış temsilcisine dönüştürün! Stok Pratik'te seçtiğiniz ürünler, güncel fiyatlarıyla otomatik dönsün.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-purple-600 hover:bg-purple-500 text-white font-black rounded-xl shadow-lg shadow-purple-600/30 transition-all transform hover:-translate-y-0.5 text-center text-base">
                📺 Mağaza TV'yi Ücretsiz Başlat
              </a>
              <a href="#ozellikler" class="w-full sm:w-auto px-7 py-4 bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-bold rounded-xl transition-all text-center text-base">
                ✨ TV Yayın Modlarını Gör
              </a>
            </div>

            <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <span class="flex items-center gap-1.5"><span class="text-purple-400">✓</span> Sıfır Ek Donanım / Lisans</span>
              <span class="flex items-center gap-1.5"><span class="text-purple-400">✓</span> Anlık Otomatik Fiyat Eşitleme</span>
              <span class="flex items-center gap-1.5"><span class="text-purple-400">✓</span> Kayan Canlı Döviz Bandı</span>
            </div>
          </div>

          <!-- Sağ: 16:9 Smart TV Mockup Simülasyonu -->
          <div class="lg:col-span-6">
            <!-- TV Dış Çerçevesi -->
            <div class="rounded-2xl bg-black p-3 border-4 border-slate-800 shadow-2xl shadow-purple-950/50">
              <div class="aspect-video bg-gradient-to-br from-slate-950 via-purple-950/40 to-slate-950 rounded-lg p-5 flex flex-col justify-between relative overflow-hidden border border-slate-800">
                
                <!-- TV Üst Başlık -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded bg-rose-600 text-white text-[11px] font-black uppercase tracking-wider animate-pulse">
                      🔥 GÜNÜN FIRSATI
                    </span>
                    <span class="text-xs font-bold text-slate-300">Stok Pratik Vitrin TV</span>
                  </div>
                  <span class="text-xs font-mono text-purple-300 font-bold">18:42</span>
                </div>

                <!-- TV İçerik Alanı -->
                <div class="grid grid-cols-2 gap-4 items-center my-auto">
                  <div class="flex items-center justify-center text-6xl">
                    ☕
                  </div>
                  <div>
                    <h3 class="text-lg font-black text-white leading-tight mb-1">Premium Filtre Kahve Çekirdeği 500g</h3>
                    <p class="text-xs text-slate-400 mb-2">%100 Arabica Orta Kavrum</p>
                    <div class="flex items-baseline gap-2">
                      <span class="text-xs text-slate-500 line-through">240,00 ₺</span>
                      <span class="text-2xl font-black text-purple-400">179,90 ₺</span>
                    </div>
                  </div>
                </div>

                <!-- TV Alt Kayan Bant -->
                <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                  <span class="text-purple-300 font-bold">📢 Kampanyamız Pazar Gününe Kadar Geçerlidir!</span>
                  <span class="font-mono text-emerald-400">USD: 34,20 ▲ • EUR: 37,10 ▲ • ALTIN: 3.050 ₺</span>
                </div>

              </div>
              <!-- TV Stand Ayağı -->
              <div class="w-20 h-2 bg-slate-700 mx-auto rounded-b"></div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. NELER YAPABİLİRSİNİZ? (BENTO GRID) -->
    <section id="ozellikler" class="py-24 bg-slate-900/50 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-purple-400 font-bold uppercase tracking-wider text-xs">Yüksek Görsel Etki</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
            Mağaza TV ile Satışlarınızı Otomatik Artırın
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {tvFeatures.map((f) => (
            <div class={`${f.colSpan} p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-purple-500/40 transition-all flex flex-col justify-between`}>
              <div>
                <span class="text-3xl mb-4 block">{f.icon}</span>
                <h3 class="text-xl font-bold text-white mb-2">{f.title}</h3>
                <p class="text-sm text-slate-400 leading-relaxed">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ALT KAPANIŞ ÇAĞRISI (BOTTOM CTA) -->
    <section class="py-24 bg-gradient-to-b from-slate-900 via-purple-950 to-slate-950 text-white text-center relative overflow-hidden border-t border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(#a855f7_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
        <span class="inline-block px-4 py-1.5 rounded-full bg-purple-500/20 border border-purple-400/30 text-purple-300 text-xs font-bold uppercase tracking-wider mb-4">
          Ek Masrafsız Canlı Yayın
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 text-white">
          Mağazanızın Ekranlarını Bugün Canlandırın!
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Kurulumsuz, cihaz maliyetsiz Mağaza TV özelliğini hemen ücretsiz hesabınızla kullanmaya başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-purple-600 hover:bg-purple-500 text-white font-black rounded-xl shadow-xl shadow-purple-600/30 transition-all text-center">
            🚀 Hemen Giriş Yapın & Başlayın
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center">
            🎁 14 Gün Ücretsiz Deneyin
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
