---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Gıda İşleme & B2B Tarım Ürünleri Yönetim Yazılımı | Stok Pratik";
const pageDescription = "Gıda üreticileri, bakliyat, kuruyemiş ve toptan tarım işletmeleri için parti-lot/SKT takibi, fire hesabı ve DepodanDirekt B2B toptan gıda vitrini.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
    <section class="hero py-16" style="background: linear-gradient(135deg, #1e3a8a, #0f172a, #0f172a); overflow: hidden;">
    <div class="container" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      
      <!-- Başlık (Üstte) -->
      <div style="width: 100%; max-width: 800px; margin: 0 auto;">
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 2rem; line-height: 1.3; color: white; font-weight: 800; text-align: center;">
          Depodandirekt Pazaryeri ile Gida Ve Tarim ürünlerinizi tüm Avrupa ve civar bölgelere satın
        </h1>
      </div>
      
      <!-- Resim (Ortada) -->
      <div style="width: 100%; max-width: 800px; margin-bottom: 2rem;">
        <img src="/images/sektorler/gida-ve-tarim.jpg" alt="Gida Ve Tarim" style="width: 100%; border-radius: 1.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.3); display: block;" />
      </div>
      
      <!-- Alt Metin ve Butonlar (Altta) -->
      <div class="hero-content" style="width: 100%; max-width: 800px;">
        <p class="hero-description" style="margin: 0 auto 2rem auto; font-size: 1.15rem; color: rgba(255,255,255,0.9);">
          Toptan bakliyat, unlu mamul, konserve ve kuruyemişte son kullanma tarihlerini izleyin; koli ve palet bazlı siparişleri DepodanDirekt ile toplayın.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://wa.me/+905325000999?text=Depodandirekt%20de%20Gida%20Ve%20Tarim%20Kategorisinde%20sat%C4%B1%C5%9F%20yapmak%20istiyorum" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #25D366, #128C7E); border: none; color: white; text-align: center; padding: 1rem 2rem; font-weight: 600; border-radius: 0.75rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pazaryerinde Satıcı Ol
          </a>
          <a href="/pazaryeri-ihracat" class="btn btn-secondary btn-lg" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; text-align: center; padding: 1rem 2rem; font-weight: 600; border-radius: 0.75rem;">
            Tüm Sektörleri Gör
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Avantajlar Grid -->
  <section class="advantages py-16">
    <div class="container">
      <div class="section-header text-center">
        <h2>Gıda Sektörü Fonksiyonları</h2>
      </div>

      <div class="advantages-grid">
        <div class="advantage-card">
          <div class="advantage-icon">📅</div>
          <h3>Lot & SKT Takibi</h3>
          <p>İlk giren ilk çıkar (FIFO) prensibiyle son kullanma tarihi yaklaşan partileri otomatik uyarma.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">⚖️</div>
          <h3>Fire & Kuruma Oranları</h3>
          <p>Tarımsal ürünlerde işleme, kuruma ve paketleme esnasındaki kilo firelerinin net muhasebesi.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🌍</div>
          <h3>DepodanDirekt B2B Gıda</h3>
          <p>Yurt dışındaki market zincirlerine ve toptancılara tonaj ve koli bazında doğrudan ihracat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Başvuru Formu -->
  <section class="application py-16">
    <div class="container">
      <div class="application-card">
        <div class="application-content">
          <h2>Sektörünüze Özel Çözümlerle Büyüyün</h2>
          <p>Stok Pratik ile operasyonlarınızı dijitalleştirin ve DepodanDirekt ile dünyaya açılın.</p>
          
          <div class="application-buttons">
            <a 
              href="https://wa.me/+905325000999?text=Depodandirekt%20de%20Gida%20Ve%20Tarim%20Kategorisinde%20sat%C4%B1%C5%9F%20yapmak%20istiyorum" 
              class="btn btn-primary btn-lg"
              style="background: linear-gradient(135deg, #25D366, #128C7E); border: none; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Pazaryerinde Satıcı Ol
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Hero Section */
    .hero {
      color: white;
    }

    .hero h1 {
      color: white;
      margin-bottom: var(--spacing-sm);
      font-size: 3rem;
      line-height: 1.2;
    }

    .hero-description {
      font-size: 1.25rem;
      color: rgba(255, 255, 255, 0.8);
      max-width: 800px;
      margin: 0 auto var(--spacing-lg);
      line-height: 1.6;
    }

    .btn-lg {
      padding: 1rem 2rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 0.75rem;
      text-decoration: none;
      display: inline-block;
      text-align: center;
      transition: all 0.2s;
    }

    .btn-lg:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    /* Advantages Section */
    .advantages {
      background-color: var(--bg-white);
    }

    .section-header h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-sm);
    }

    .advantages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-lg);
    }

    .advantage-card {
      background: var(--bg-white);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      text-align: center;
      border: 1px solid var(--border-color);
      transition: transform var(--transition-normal);
    }

    .advantage-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-lg);
      border-color: #bef264;
    }

    .advantage-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
      background: var(--bg-light);
      width: 80px;
      height: 80px;
      line-height: 80px;
      border-radius: 20px;
      margin: 0 auto 1.5rem;
    }

    .advantage-card h3 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
    }

    .advantage-card p {
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* Application Section */
    .application {
      background: linear-gradient(135deg, var(--primary-red-light), var(--bg-light));
    }

    .application-card {
      background: var(--bg-white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: var(--spacing-xl);
      max-width: 800px;
      margin: 0 auto;
    }

    .application-content h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
      text-align: center;
    }

    .application-content p {
      color: var(--text-dark);
      text-align: center;
      margin-bottom: var(--spacing-xl);
      line-height: 1.6;
    }

    .application-buttons {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      margin-bottom: 1rem;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2.5rem;
      }
      
      .hero-description {
        font-size: 1.1rem;
      }
      
      .advantages-grid {
        grid-template-columns: 1fr;
      }
      
      .advantage-card, .application-card {
        padding: var(--spacing-lg);
      }
    }

    @media (max-width: 480px) {
      .hero h1 {
        font-size: 2rem;
      }
      
      .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
      }
    }
  </style>
</BaseLayout>
