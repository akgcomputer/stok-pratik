---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Alış-Satış Faturası ve Sevk İrsaliyesi Yönetimi | Stok Pratik";
const pageDescription = "Saniyeler içinde satış ve alış faturası kesin. Şoför ve araç plakalı sevk irsaliyesi düzenleyin, tek tıkla faturaya dönüştürün. e-Fatura/e-Arşiv hazır. Hemen ücretsiz deneyin!";

const features = [
  {
    icon: "⚡",
    title: "Hızlı Satış Faturası & Maliyet Koruma Kilidi",
    desc: "Barkod okutarak veya ürün adı yazarak saniyeler içinde fatura kesin; zararına satışı engelleyin.",
    items: [
      "Satış fiyatı alış maliyetinin altına girdiğinde anında uyaran Sıfır Zarar Kalkanı",
      "Müşteriye özel iskonto, tevkifat ve KDV muafiyet kodları seçimi",
      "Fatura kaydedildiği anda stoktan otomatik düşüm ve cari hesaba borç işleme"
    ]
  },
  {
    icon: "📥",
    title: "Alış Faturaları & Otomatik Maliyet Güncelleme",
    desc: "Tedarikçiden gelen faturaları sisteme işleyin; depo stoklarınız ve birim maliyetiniz anında güncellensin.",
    items: [
      "Yeni alış fiyatını son alış maliyeti olarak sisteme otomatik kaydetme",
      "Kargo ve nakliye giderlerini ürün birim maliyetine paylaştırma",
      "Tedarikçi borç bakiyesini ve ödeme vadesini tek tıkla oluşturma"
    ]
  },
  {
    icon: "🚚",
    title: "Gelen ve Giden Sevk İrsaliyeleri",
    desc: "Yol denetimlerine ve mevzuata tam uyumlu; araç plakası ve şoför bilgilerini içeren sevk irsaliyesi.",
    items: [
      "Taşıyıcı firma, Çekici Plakası, Dorse Plakası ve Şoför (Ad/Soyad/TCKN) alanları",
      "Sevk tarihi ve fiili sevk saati hassas zaman damgası takibi",
      "Depolar arası transferler ve şubeler arası mal sevkiyatları için tam uyum"
    ]
  },
  {
    icon: "🔄",
    title: "İrsaliyeden Tek Tıkla Faturaya Dönüştürme",
    desc: "Ay içinde düzenlenen irsaliyeleri tek tek veya topluca birleştirip satış faturasına dönüştürün.",
    items: [
      "Mükerrer stok düşüşünü kesin olarak engelleyen akıllı irsaliye kilidi",
      "Aynı müşteriye ait birden fazla sevk irsaliyesini tek faturada toplama",
      "Hangi irsaliyenin faturalandığını, hangisinin açıkta kaldığını anlık izleme"
    ]
  },
  {
    icon: "🖨️",
    title: "Profesyonel A4 Fatura & İrsaliye Tasarımı (PDF)",
    desc: "Şirket logonuz, banka IBAN hesaplarınız ve kaşe/imza alanınızla baskıya hazır A4 şablonu.",
    items: [
      "'Yalnız ... Türk Lirasıdır' yazı ile tutar çevirici alanı",
      "Müşterinin e-postasına veya WhatsApp hattına doğrudan PDF iletimi",
      "Nokta vuruşlu (sürekli form) veya lazer yazıcılarla tam uyumlu baskı formatı"
    ]
  },
  {
    icon: "🏛️",
    title: "e-Fatura, e-Arşiv ve e-İrsaliye Hazır Altyapı",
    desc: "Taslak fatura ve irsaliyelerinizi tek tıkla resmi GİB onaylı e-Belge formatına dönüştürün.",
    items: [
      "Ek veri girmeden doğrudan resmi e-Fatura / e-Arşiv XML ve PDF üretimi",
      "GİB posta kutusu üzerinden gelen e-Faturaları tek tıkla alış faturasına aktarma",
      "10 yıl yasal süre boyunca güvenli bulut e-Belge arşivi"
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    
    <!-- 1. HERO SECTION (Teal & Sky Blue Theme) -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-teal-950/40 to-slate-900 py-20 sm:py-24 text-white border-b border-teal-900/40">
      <div class="absolute inset-0 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-5xl text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 border border-teal-400/30 text-teal-300 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          Temel Ticaret • Fatura & Sevk İrsaliyesi Yönetimi
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          Saniyeler İçinde Fatura ve İrsaliye Kesin: <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-white">
            Stok, Cari ve Kasanız Aynı Anda Güncellensin!
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
          Tek bir ekrandan alış/satış faturanızı veya sevk irsaliyenizi oluşturun; Stok Pratik arka planda ürün stoğunuzu düşsün, müşteri bakiyesini güncellesin ve dilerseniz tek tıkla resmi e-Fatura / e-Arşiv veya A4 PDF çıktı üretsin.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 font-extrabold rounded-xl shadow-lg shadow-teal-500/30 transition-all transform hover:-translate-y-0.5 text-center text-base">
            🚀 Hemen Giriş Yap & Ücretsiz Başla
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center text-base backdrop-blur-sm">
            🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
          </a>
        </div>

        <div class="mt-8 flex items-center justify-center gap-6 text-xs text-slate-400">
          <span class="flex items-center gap-1.5">✓ Şoför & Plakalı Sevk İrsaliyesi</span>
          <span class="flex items-center gap-1.5">✓ İrsaliyeden Tek Tıkla Fatura</span>
          <span class="flex items-center gap-1.5">✓ GİB e-Fatura / e-Arşiv Uyumlu</span>
        </div>
      </div>
    </section>

    <!-- 2. ÖNE ÇIKAN KABİLİYETLER (6 KART) -->
    <section class="py-20 bg-slate-50">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-teal-600 font-bold uppercase tracking-wider text-xs">Hızlı ve Hatasız Evrak</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2">
            Fatura ve Sevk İrsaliyesinde Uçtan Uca Kolaylık
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg">
            Hızlı barkodlu satıştan şoför ve araç plakalı irsaliye yönetimine kadar ticari süreçleriniz tam entegre.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((item) => (
            <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-teal-300 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-2xl mb-5">
                  {item.icon}
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">{item.title}</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">{item.desc}</p>
              </div>
              <ul class="space-y-2.5 pt-4 border-t border-slate-100 text-xs text-slate-700 font-medium">
                {item.items.map((sub) => (
                  <li class="flex items-start gap-2">
                    <span class="text-teal-600 font-bold">✓</span>
                    <span>{sub}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ALT KAPANIŞ ÇAĞRISI (BOTTOM CTA) -->
    <section class="py-20 bg-gradient-to-br from-slate-950 via-teal-950/60 to-slate-900 text-white text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:20px_20px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
        <span class="inline-block px-4 py-1.5 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-xs font-bold uppercase tracking-wider mb-4">
          Bulut Hızı • Sıfır Bürokrasi
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">
          İlk Faturanızı 30 Saniye İçinde Ücretsiz Kesin!
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Kurulum gerektirmeyen bulut altyapısıyla hemen ücretsiz kaydolun veya giriş yapın, fatura ve irsaliye süreçlerinizi hızlandırın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 font-extrabold rounded-xl shadow-xl shadow-teal-500/30 transition-all text-center">
            🚀 Hemen Giriş Yapın & Başlayın
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center">
            🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
