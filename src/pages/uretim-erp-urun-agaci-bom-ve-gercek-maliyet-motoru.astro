---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Üretim ERP, Ürün Ağacı (BOM) ve Gerçek Maliyet Motoru | Stok Pratik";
const pageDescription = "Tahminle değil, gerçek maliyetle üretin! Stok Pratik Üretim ERP ile ürün reçeteleri (BOM), hammadde sarfiyatı, % fire, istasyon işçilik ve makine amortismanı tek ekranda.";

const productionModes = [
  {
    badge: "Mod 1 • Tek Tıkla Pratik Üretim",
    icon: "⚡",
    title: "Hızlı (Tek Adımda) Üretim Modu",
    target: "Gıda paketleme, karışım/dolum, hızlı montaj, set/takım birleştirme ve ara istasyon gerektirmeyen atölyeler.",
    desc: "Üretilecek mamulü ve adedi seçip 'Üretimi Tamamla' butonuna bastığınız anda; reçetedeki tüm hammaddeler (fire oranlarıyla birlikte) depodan otomatik düşer, bitmiş mamul stoğunuz artar ve birim üretim maliyeti mamul kartına anında yazılır.",
    bullets: [
      "Sıfır ara istasyon karmaşası; tek tıkla hammadde sarfiyatı",
      "Koli, paket veya set bazlı hızlı üretim emri",
      "Otomatik fire oranı düşümü ve anlık mamul stok girişi"
    ]
  },
  {
    badge: "Mod 2 • Fabrika İstasyon Rotası",
    icon: "🏗️",
    title: "Aşamalı (İstasyon & Operasyon Rotalı) Üretim Modu",
    target: "Tekstil konfeksiyon, metal/sac işleme, makine imalatı, mobilya üretimi ve çok aşamalı fabrikalar.",
    desc: "Üretim emri açıldığında iş adım adım istasyonlardan geçer: 1. Kesim ➔ 2. İşleme/Büküm ➔ 3. Kaynak/Montaj ➔ 4. Boya/Cila ➔ 5. Kalite & Paketleme. Her istasyonun operasyon süresi, işçilik maliyeti ve makine enerji payı ayrı ayrı hesaplanır.",
    bullets: [
      "İstasyon bazlı süre (dakika) ve personel işçilik takibi",
      "Tezgah ve makine elektrik/amortisman payı maliyete dahil",
      "Darboğazları ve geciken iş emirlerini canlı panodan izleme"
    ]
  }
];

const erpFeatures = [
  {
    icon: "📋",
    title: "Malzeme İhtiyaç Planlama (MRP)",
    desc: "'500 adet sipariş geldi, depodaki hammadde yeter mi?' Üretim emrini açarken eksik hammaddeleri saniyeler içinde listeler ve doğrudan satın alma/tedarik talebine dönüştürür."
  },
  {
    icon: "♻️",
    title: "Gerçekçi Fire Oranı (% Wastage) Hesabı",
    desc: "Kumaş pastal firesi, sac hurda kaybı veya kimyasal dolum firesini reçeteye yüzde olarak tanımlayın; stok sarfiyatı ve maliyet hesabı fire dahil kuruşu kuruşuna yapılsın."
  },
  {
    icon: "🧩",
    title: "Çok Seviyeli Ürün Ağacı (Yarı Mamul ➔ Mamul)",
    desc: "Önce talaşlı imalatla gövde yarı mamulünü üretip depoya alın; ardından ana montaj reçetesinde bu yarı mamulü ve motor aksamını kullanarak çok kademeli BOM kurgulayın."
  },
  {
    icon: "🔒",
    title: "Otomatik Maliyet Koruma Kilidi Bağlantısı",
    desc: "Üretim maliyeti 450 ₺ olarak hesaplanan bir mamulü, satış ekibiniz veya e-ticaret kanalınız yanlışlıkla 440 ₺'ye satamaz; sistem zararına satışı matematiksel olarak kilitler."
  },
  {
    icon: "🏷️",
    title: "Parti (Batch) ve Lot Numarası Takibi",
    desc: "Tek seferde 1.000 litrelik kimyasal kazan partisi veya 500 adetlik konfeksiyon kesim partisi üzerinden parti/lot bazlı geriye dönük izlenebilirlik sağlayın."
  },
  {
    icon: "📚",
    title: "Sektörel Hazır Fabrika Şablonları",
    desc: "Sıfırdan reçete tasarlamakla haftalar harcamayın. Tekstil, Metal, Kimya/Kozmetik ve Mobilya hazır fabrika şablonlarını tek tıkla işletmenize kopyalayın."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-orange-500 selection:text-slate-950">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-orange-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-orange-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-orange-400 animate-ping"></span>
              ⚙️ Stok Pratik Üretim ERP • BOM Ağacı & Gerçek Maliyet Motoru
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              "Bu Ürünü Kaça Mal Ediyoruz?" <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-200">
                Tahminle Değil, Kuruşu Kuruşuna Hesaplayın!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Milyonluk hantal ERP yazılımlarına ve aylarca süren danışmanlık projelerine ihtiyacınız yok! Stok Pratik Üretim ERP ile ürün reçetelerinizi (BOM) dakikalar içinde kurun; hammadde, fire, işçilik ve amortismanı tek ekranda toplayarak gerçek maliyetle üretin.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-slate-950 font-bold text-base shadow-lg shadow-orange-500/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🏭 Üretim ERP'yi Ücretsiz Başlatın</span>
              </a>
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/giris" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🔐 Giriş Yap</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-orange-400 font-bold">✓</span> İstasyon & Operasyon Rotası
              </div>
              <div class="flex items-center gap-2">
                <span class="text-orange-400 font-bold">✓</span> Otomatik Fire ve Sarfiyat
              </div>
              <div class="flex items-center gap-2">
                <span class="text-orange-400 font-bold">✓</span> Maliyet Koruma Kilidi Entegre
              </div>
            </div>
          </div>

          <!-- Sağ: Canlı BOM Gerçek Maliyet Denklemi Mockup'ı -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-orange-500/30 rounded-3xl p-6 sm:p-7 shadow-2xl backdrop-blur-xl">
              
              <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <div>
                  <div class="text-[10px] text-orange-400 font-mono uppercase tracking-wider font-semibold">Canlı BOM Maliyet Motoru</div>
                  <div class="text-sm font-bold text-white">Endüstriyel Elektrik Panosu (60x80x25)</div>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-orange-500/20 text-orange-300 text-[10px] font-bold border border-orange-500/30">
                  Gerçek Zamanlı
                </span>
              </div>

              <!-- Maliyet Kalemleri Listesi -->
              <div class="space-y-2 text-xs font-mono bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
                
                <div class="flex justify-between items-center text-slate-300">
                  <span class="flex items-center gap-1.5 font-sans">
                    <span>🧱</span> Hammadde & Yarı Mamul:
                  </span>
                  <span class="font-bold text-white">310,00 ₺</span>
                </div>

                <div class="flex justify-between items-center text-amber-300">
                  <span class="flex items-center gap-1.5 font-sans">
                    <span>♻️</span> Üretim Fire Payı (+%6 Hurda):
                  </span>
                  <span class="font-bold">+ 18,60 ₺</span>
                </div>

                <div class="flex justify-between items-center text-blue-300">
                  <span class="flex items-center gap-1.5 font-sans">
                    <span>👷</span> İstasyon İşçilik Maliyeti (45 Dk):
                  </span>
                  <span class="font-bold">+ 85,00 ₺</span>
                </div>

                <div class="flex justify-between items-center text-cyan-300">
                  <span class="flex items-center gap-1.5 font-sans">
                    <span>⚡</span> Makine / Enerji / Amortisman:
                  </span>
                  <span class="font-bold">+ 36,40 ₺</span>
                </div>

                <!-- Çizgi ve Toplam -->
                <div class="pt-3 border-t border-slate-700 flex justify-between items-center text-emerald-400 text-sm">
                  <span class="font-sans font-bold">✅ GERÇEK BİRİM MALİYET:</span>
                  <span class="font-black text-base">450,00 ₺</span>
                </div>
                <div class="text-[9px] text-slate-400 font-sans text-right">
                  Mamul stok kartına otomatik alış maliyeti olarak yazıldı.
                </div>
              </div>

              <!-- Canlı Maliyet Koruma Kalkanı Uyarısı -->
              <div class="mt-4 p-3 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center gap-2.5">
                <span class="text-lg">🛡️</span>
                <div class="text-xs text-orange-200 leading-snug">
                  <strong>Maliyet Koruma Kilidi Devrede:</strong> Ürün maliyeti 450,00 ₺ olduğu için satış ekibiniz veya pazaryeri botları bu ürünü 450,00 ₺ altına satamaz.
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. İKİ FARKLI ÜRETİM MODU (HIZLI & AŞAMALI) -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative bg-slate-900/30">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-orange-400 text-sm font-semibold tracking-wider uppercase mb-3">Esnek Üretim Mimarisi</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            İşletmenizin İhtiyacına Uygun İki Farklı Üretim Modu
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            İster tek adımda set birleştirin, ister 5 istasyonlu montaj hattı ve personel sürelerini takip edin.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {productionModes.map((mode) => (
            <div class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-8 hover:border-orange-500/40 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-300 text-xs font-bold mb-4">
                  {mode.badge}
                </div>
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 text-2xl flex items-center justify-center">
                    {mode.icon}
                  </div>
                  <h3 class="text-xl font-bold text-white">{mode.title}</h3>
                </div>
                <div class="text-xs text-amber-300/90 mb-4">{mode.target}</div>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">{mode.desc}</p>
                
                <div class="space-y-2.5 pt-4 border-t border-slate-800">
                  {mode.bullets.map((b) => (
                    <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                      <span class="text-orange-400 font-bold shrink-0 mt-0.5">✓</span>
                      <span>{b}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ÜRETİCİLERİN HAYATINI KURTARAN 6 ERP KABİLİYETİ -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-orange-400 text-sm font-semibold tracking-wider uppercase mb-3">Endüstriyel Güç</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Üreticilerin Hayatını Kurtaran 6 ERP Kabiliyeti
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            Hammadde tedariğinden fire yönetimine, parti izlenebilirliğinden maliyet kalkanına eksiksiz kontrol.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {erpFeatures.map((feat) => (
            <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-7 hover:border-orange-500/40 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 text-2xl flex items-center justify-center mb-5">
                  {feat.icon}
                </div>
                <h3 class="text-lg font-bold text-white mb-2.5">{feat.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{feat.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-orange-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs sm:text-sm font-semibold mb-6">
          ⚙🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          Atölyenizi ve Fabrikanızı Bugün Dijital Üretime Geçirin!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Kurulum ücreti yok, aylarca danışmanlık beklemek yok. Hemen ücretsiz hesabınızı açın ve ilk üretim emrinizi 3 dakikada başlatın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-slate-950 font-bold text-base shadow-lg shadow-orange-500/30 transition-all duration-200"
          >
            🚀 Ücretsiz Kullanmaya Başla
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
