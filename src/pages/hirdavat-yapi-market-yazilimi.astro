---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import ComparisonSection from '../components/landing/ComparisonSection.astro';
import FeaturesGrid from '../components/landing/FeaturesGrid.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import FaqAccordion from '../components/landing/FaqAccordion.astro';
import CtaBanner from '../components/landing/CtaBanner.astro';

const pageTitle = "Hırdavat, Yapı Market ve Nalburiye Stok Takip Programı | Stok Pratik";
const pageDescription = "Binlerce çeşit hırdavat, civata ve yapı malzemesini barkodla kolayca yönetin. Depolar arası transfer, metre/kilo bazlı satış ve veresiye takibi!";

const features = [
  {
    title: "10.000+ Ürün Hızlı Arama",
    description: "Binlerce cıvata, vida, boya ve el aleti arasında saniyeler içinde arama yapın, kasada bekletmeyin.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>`
  },
  {
    title: "Çoklu Birim Yönetimi",
    description: "Aynı ürünü; Adet, Metre, Kilo, Kutu veya Koli cinsinden satabilir, stokları ana birime göre dönüştürebilirsiniz.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>`
  },
  {
    title: "Çoklu Depo & Raf Lokasyonu",
    description: "Hırdavat deponuzu reyon ve raf numarasına kadar haritalandırın, aradığınız malzemeyi anında bulun.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>`
  },
  {
    title: "Dijital Veresiye Defteri",
    description: "Ustalara ve taşeron firmalara yaptığınız vadeli satışları, ödemeleri ve tahsilatları açık hesap olarak tutun.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`
  },
  {
    title: "Kritik Stok İkaz Sistemi",
    description: "Sık satılan çivi, bant gibi ürünler belirlenen adedin altına düştüğünde sistem otomatik sipariş uyarısı versin.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`
  },
  {
    title: "Mobil Kameralı Sayım",
    description: "El terminaline para harcamadan, çalışanlarınız cep telefonu kamerasıyla mağaza sayımı yapabilsin.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`
  }
];

const faqs = [
  { question: "Mevcut ürün listemi nasıl aktarabilirim?", answer: "Toptancınızdan veya eski programınızdan aldığınız on binlerce satırlık Excel dosyasını tek tuşla Stok Pratik'e aktarabilirsiniz." },
  { question: "Hırdavat ürünlerinde birim dönüşümü yapabiliyor muyuz?", answer: "Evet, örneğin 1 Koli (100 Adet) olarak aldığınız silikonları, kasada Adet olarak satabilirsiniz. Stoktan 1 adet düşerken, koli bakiyesi otomatik güncellenir." },
  { question: "Barkodsuz dökme ürünleri nasıl satacağız?", answer: "Vidalar veya metreyle satılan kablolar gibi barkodsuz ürünler için, satış ekranında hızlı erişim tuşları (kısayol butonları) oluşturabilirsiniz." }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <HeroSection 
    h1="Binlerce Çeşit Hırdavat ve Yapı Malzemesinde Sayım Karmaşasına Son!"
    description={pageDescription}
    badges={["Hırdavat Takibi", "Çoklu Birim", "Kritik Stok Uyarıları", "Açık Hesap (Veresiye)"]}
    imageSrc="/images/site-foto/analiz.webp"
    imageAlt="Hırdavat Stok Takip Ekranı"
  />
  
  <ComparisonSection 
    oldMethodTitle="Klasik Nalburiye Yönetimi"
    oldMethodItems={["Sayım günlerinde dükkanı kapatmak", "Veresiye defterinde alacakların kaybolması", "Depoda var olan malın rafta bulunamaması", "Hangi vidanın azaldığını manuel kontrol etmek"]}
    newMethodTitle="Stok Pratik Yapı Market Çözümü"
    newMethodItems={["Mobil cihaz ile dükkan açıkken sayım", "Her müşterinin hesabını anlık görüntüleme", "Raf ve lokasyon numarasıyla kolay bulunabilirlik", "Akıllı kritik stok uyarılarıyla sıfır stoksuzluk"]}
  />
  
  <FeaturesGrid 
    title="Yapı Marketinizin İhtiyacı Olan Tüm Fonksiyonlar"
    features={features}
  />
  
  <HowItWorks 
    title="Nalbur ve Hırdavat Mağazanızı Dijitale Taşıyın"
    steps={[
      { title: "Toptancı Excel'ini Yükleyin", description: "Mal aldığınız toptancılardaki binlerce kalem ürünü fiyatlarıyla birlikte sisteme aktarın." },
      { title: "Raf Lokasyonlarını Belirleyin", description: "Ürünlerin mağaza içi reyon ve raf adreslerini belirterek kaybolmaları önleyin." },
      { title: "Barkodlu Satışa Geçin", description: "Hızlı satış ekranında barkod okutarak veya ismini yazarak saniyeler içinde fatura kesin." }
    ]}
  />
  
  <FaqAccordion faqs={faqs} />
  
  <CtaBanner />
</BaseLayout>
