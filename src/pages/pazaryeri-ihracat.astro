---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Pazaryeri & İhracat Platformu | Stok Pratik & DepodanDirekt";
const pageDescription = "Stok Pratik ile deponuzu ve ön muhasebenizi yönetin, ürünlerinizi DepodanDirekt ile Türkiye'ye ve dünyaya hem perakende hem toptan satın.";

const sectors = [
  { name: "Gelinlik & Abiye", slug: "gelinlik-ve-abiye", icon: "👰", desc: "Model, kumaş sarfiyatı, prova takibi ve küresel butik ihracatı." },
  { name: "Tekstil & Hazır Giyim", slug: "tekstil-ve-hazir-giyim", icon: "👗", desc: "Renk, beden, asorti varyant yönetimi ve seri bazlı toptan satış." },
  { name: "Otomotiv & Yedek Parça", slug: "otomotiv-ve-yedek-parca", icon: "🚗", desc: "OEM/OES kod eşleme, raf/kutu takibi ve toptan dağıtım ağı." },
  { name: "Mutfak & Züccaciye", slug: "zuccaciye-ve-mutfak", icon: "🍽️", desc: "Koli içi adet, hacim/desi hesabı ve çok kanallı ihracat." },
  { name: "Ayakkabı & Deri Mamulleri", slug: "ayakkabi-ve-deri", icon: "👞", desc: "Numara asortisi, seri üretimi ve toptan sipariş yönetimi." },
  { name: "Mobilya & İç Mekan", slug: "mobilya-ve-ic-mekan", icon: "🛋️", desc: "Modüler parça takibi, takım yönetimi ve hacimli B2B lojistik." },
  { name: "Kozmetik & Kişisel Bakım", slug: "kozmetik-ve-bakim", icon: "💄", desc: "Barkod, lot/SKT takibi ve sınır ötesi hızlı e-ihracat." },
  { name: "Ambalaj & Plastik", slug: "ambalaj-ve-plastik", icon: "📦", desc: "Hammadde reçeteleri, tonaj/adet hesabı ve toptan sevkiyat." },
  { name: "Gıda İşleme & B2B Tarım", slug: "gida-ve-tarim", icon: "🌾", desc: "Parti, parti no, menşei ve soğuk zincir toptan sipariş." },
  { name: "Metal İmalat & Hırdavat", slug: "metal-ve-hirdavat", icon: "🔩", desc: "Teknik ölçü, metraj, kg/adet dönüşümü ve sanayi tedariki." },
  { name: "Mermer & Doğal Taş", slug: "mermer-ve-dogal-tas", icon: "🪨", desc: "Plaka, kasa, m2/ton hesabı ve konteyner bazlı ihracat." },
  { name: "İş Elbiseleri & KKD", slug: "is-elbiseleri-ve-kkd", icon: "🦺", desc: "Kurumsal logo baskı takibi ve periyodik toplu siparişler." },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="hero py-16">
    <div class="container">
      <div class="hero-content text-center">
        <div style="display: inline-block; padding: 0.5rem 1rem; margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; color: #a5b4fc; background-color: rgba(30, 27, 75, 0.7); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 9999px;">
          🌐 Yazılım + B2B/B2C Pazaryeri & İhracat Ekosistemi
        </div>
        <h1>
          İster Tek Tek Perakende, İster Koli Koli Toptan:<br/>
          DepodanDirekt ile Dünyaya Satın
        </h1>
        <p class="hero-description">
          Stok Pratik ile deponuzu ve ön muhasebenizi yönetirken; tek tıkla ürünlerinizi çok dilli ve çok para birimli DepodanDirekt platformunda satışa açın.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="#sektorler" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #10b981, #059669); border: none; color: white;">
            Sektörünüzü Seçin
          </a>
          <a href="https://depodandirekt.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white;">
            DepodanDirekt.com'u Gör ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Avantajlar Grid -->
  <section class="advantages py-16">
    <div class="container">
      <div class="advantages-grid">
        <div class="advantage-card">
          <div class="advantage-icon">🔄</div>
          <h3>Otomatik Canlı Stok</h3>
          <p>Stok Pratik'e girdiğiniz her ürün ve miktar anında vitrinde güncellenir. Çift veri girişi gerekmez.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🌍</div>
          <h3>Çoklu Dil & Para Birimi</h3>
          <p>Ürünleriniz Türkçe, İngilizce, Arapça ve Rusça sergilenir; USD ve EUR cinsinden ödeme ve sipariş alabilirsiniz.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🎛️</div>
          <h3>Esnek Fiyatlandırma</h3>
          <p>İster adetli perakende fiyat belirleyin, ister minimum koli/seri adedi koyarak toptan esnaf fiyatı uygulayın.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sektörler Listesi -->
  <section id="sektorler" class="advantages py-16" style="background-color: var(--bg-light);">
    <div class="container">
      <div class="section-header text-center">
        <h2>Sektörünüze Özel Çözümü İnceleyin</h2>
        <p>Hangi sektörde faaliyet gösteriyorsanız gösterin, atölyenizden veya deponuzdan doğrudan satış yapmanızı sağlayan altyapı hazır.</p>
      </div>

      <div class="advantages-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
        {sectors.map((s) => (
          <a href={`/sektor/${s.slug}`} class="advantage-card" style="text-decoration: none; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="advantage-icon">{s.icon}</div>
              <h3 style="margin-bottom: 0.5rem; font-size: 1.1rem; color: #1e293b;">{s.name}</h3>
              <p style="font-size: 0.85rem; color: #64748b; line-height: 1.5; margin-bottom: 1rem;">{s.desc}</p>
            </div>
            <span style="color: #4f46e5; font-size: 0.85rem; font-weight: 600; text-decoration: none;">Detayları Gör &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Başvuru Formu -->
  <section class="application py-16">
    <div class="container">
      <div class="application-card">
        <div class="application-content">
          <h2>Ürünlerinizi DepodanDirekt Vitrinine Taşıyın</h2>
          <p>
            Stok Pratik paketlerimizle entegre çalışan B2B/B2C ekosistemimiz hakkında doğrudan bilgi alın.
          </p>
          
          <div class="application-buttons">
            <a 
              href="https://wa.me/+905325000999?text=Pazaryeri%20ve%20ihracat%20çözümleri%20hakkında%20bilgi%20almak%20istiyorum." 
              class="btn btn-primary btn-lg"
              style="background: linear-gradient(135deg, #10b981, #059669); border: none;"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp ile Hemen Görüşün
            </a>
            
            <a 
              href="/fiyatlar" 
              class="btn btn-secondary btn-lg"
            >
              Fiyat & Yapılandırma
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Hero Section */
    .hero {
      background: linear-gradient(135deg, #0f172a, #312e81, #0f172a);
      color: white;
    }

    .hero h1 {
      color: white;
      margin-bottom: var(--spacing-sm);
      font-size: 3rem;
      line-height: 1.2;
    }

    .hero-description {
      font-size: 1.25rem;
      color: rgba(255, 255, 255, 0.8);
      max-width: 800px;
      margin: 0 auto var(--spacing-lg);
      line-height: 1.6;
    }

    .btn-lg {
      padding: 1rem 2rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 0.75rem;
      text-decoration: none;
      display: inline-block;
      text-align: center;
      transition: all 0.2s;
    }

    .btn-lg:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    /* Advantages Section */
    .advantages {
      background-color: var(--bg-white);
    }

    .section-header h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-sm);
    }

    .section-header p {
      color: var(--text-gray);
      font-size: 1.125rem;
      margin-bottom: var(--spacing-xl);
    }

    .advantages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-lg);
    }

    .advantage-card {
      background: var(--bg-white);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      text-align: center;
      border: 1px solid var(--border-color);
      transition: transform var(--transition-normal);
      cursor: pointer;
    }

    .advantage-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-lg);
      border-color: #a5b4fc;
    }

    .advantage-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
      background: var(--bg-light);
      width: 80px;
      height: 80px;
      line-height: 80px;
      border-radius: 20px;
      margin: 0 auto 1.5rem;
    }

    .advantage-card h3 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
    }

    .advantage-card p {
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* Application Section */
    .application {
      background: linear-gradient(135deg, var(--primary-red-light), var(--bg-light));
    }

    .application-card {
      background: var(--bg-white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: var(--spacing-xl);
      max-width: 800px;
      margin: 0 auto;
    }

    .application-content h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
      text-align: center;
    }

    .application-content p {
      color: var(--text-dark);
      text-align: center;
      margin-bottom: var(--spacing-xl);
      line-height: 1.6;
    }

    .application-buttons {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      margin-bottom: 1rem;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2.5rem;
      }
      
      .hero-description {
        font-size: 1.1rem;
      }
      
      .advantages-grid {
        grid-template-columns: 1fr;
      }
      
      .advantage-card, .application-card {
        padding: var(--spacing-lg);
      }
      
      .application-buttons {
        flex-direction: column;
      }
    }

    @media (max-width: 480px) {
      .hero h1 {
        font-size: 2rem;
      }
      
      .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
      }
    }
  </style>
</BaseLayout>
