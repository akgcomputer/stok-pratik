      {/* Left Media Area: Reels Player or Image */}
      <div class="w-full md:w-[420px] bg-slate-950 flex items-center justify-center relative shrink-0 p-3 sm:p-4 min-h-[350px] md:min-h-[580px] overflow-hidden">
        
        {/* Loading Spinner */}
        <div id="modalLoading" class="absolute inset-0 flex items-center justify-center bg-slate-950 z-10 text-amber-400">
          <div class="flex flex-col items-center gap-3">
            <svg class="animate-spin h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span class="text-xs text-slate-400 font-mono">İçerik yükleniyor...</span>
          </div>
        </div>

        {/* Dynamic Iframe for Instagram Reel */}
        <iframe 
          id="modalIframe"
          src=""
          class="w-full h-[380px] sm:h-[460px] md:h-[540px] rounded-2xl border-0 shadow-lg relative z-20"
          frameborder="0" 
          scrolling="no" 
          allowtransparency="true"
          allow="autoplay; encrypted-media"
        ></iframe>

        {/* Fallback Image Box for standard posts */}
        <div id="modalImageBox" class="hidden relative z-20 w-full h-full flex items-center justify-center">
          <img id="modalImg" src="" alt="" class="max-w-full max-h-[520px] object-contain rounded-2xl shadow-xl" />
        </div>
      </div>

      {/* Right Content Area: Details & Conversion CTA */}
      <div class="w-full md:flex-1 p-6 sm:p-8 flex flex-col justify-between overflow-y-auto max-h-[50vh] md:max-h-[580px] bg-slate-900">
        
        <div>
          {/* Header Info */}
          <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-gradient-to-tr from-amber-400 to-rose-500 flex items-center justify-center text-sm font-bold text-slate-950 shadow-md">
                SP
              </span>
              <div>
                <p class="text-xs font-bold text-white flex items-center gap-1">
                  Stok Pratik <span class="text-sky-400 text-xs">☑</span>
                </p>
                <p class="text-[11px] text-pink-400 font-mono">@stokpratik</p>
              </div>
            </div>

            <span id="modalBadge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-300 border border-amber-400/40">
              Reels
            </span>
          </div>

          {/* Title */}
          <h2 id="modalTitle" class="text-lg sm:text-xl font-black text-white mb-3 leading-snug">
            Gönderi Başlığı
