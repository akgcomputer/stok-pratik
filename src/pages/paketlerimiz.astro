---
// src/pages/paketlerimiz.astro - Stok Pratik Paketler ve Modül Yetenekleri (Fiyatsız Özellik Vitrini)
import BaseLayout from '../layouts/BaseLayout.astro';
import pricingData from '../data/pricing.json';

const pageTitle = "Paketlerimiz & Modül Yetenekleri | Stok Pratik Bulut ERP";
const pageDescription = "Stok Pratik'in 3 ana paketi ve zengin modüler ekosistemini keşfedin. Başlangıç, KOBİ Pro ve Kurumsal ERP çözümleriyle işletmenize en uygun mimariyi inceleyin.";

const { packages, modules } = pricingData;

// Her modül için detaylı yetenek ve özellik kontrol listesi (Fiyatsız vitrin için)
const detailedModuleSpecs: Record<string, string[]> = {
  masraf_ocr: [
    "Akıllı telefon kamerasıyla anında fiş ve fatura tarama",
    "Yapay Zekâ (Gemini AI) ile KDV, matrah, tarih ve firma unvanını hatasız okuma",
    "Personel masraf harcama bildirimleri ve departman onay mekanizması",
    "Kategori bazlı gider analizi ve bütçe aşım alarmları",
    "Tek tıkla gider kaydını muhasebeye, kasaya ve cariye işleme"
  ],
  cek_senet: [
    "Müşteri ve tedarikçi çek/senet bordroları yönetimi",
    "Bankaya tahsilata veya teminata verme işlemleri",
    "Çek ciro etme ve parçalı takip mekanizması",
    "Otomatik vade ve risk kontrol takvimi",
    "Vadesi yaklaşan kıymetli evraklar için anlık bildirim sistemi"
  ],
  gib_edonusum: [
    "GİB onaylı resmi e-Fatura ve e-Arşiv faturası düzenleme",
    "Gelen ticari ve temel e-faturaları sisteme otomatik çekme ve onaylama",
    "Resmi e-İrsaliye ve araç/sevk süreçleri yönetimi",
    "Serbest Meslek Makbuzu (e-SMM) ve e-Müstahsil makbuzu",
    "Müşterilere e-posta veya SMS ile otomatik fatura linki iletimi"
  ],
  pazaryeri: [
    "Trendyol, Hepsiburada, Amazon, N11 ve Çiçeksepeti çift yönlü canlı senkronizasyon",
    "Ortak stok havuzu ve pazaryerlerine özel kritik emniyet stoğu",
    "Tek tıkla 100x150 mm termal kargo barkodu ve sevk etiketi basımı",
    "Sipariş anında otomatik e-fatura kesilip pazaryeri sistemine iletilmesi",
    "İade masası ile eksik/kusurlu gelen siparişlerin barkodlu kontrolü",
    "Pazaryeri komisyon ve kargo kesintileri sonrası net hakediş (kâr) analizi",
    "Müşteri soru-cevaplarını ERP panelinden anlık yanıtlama"
  ],
  hizli_pos: [
    "Dokunmatik ekran ve barkod okuyucu destekli saniyeler içinde perakende satış",
    "Barkodsuz popüler ürünler için hızlı dokunmatik resimli butonlar",
    "Parçalı tahsilat (Nakit + Kredi Kartı + Açık Hesap bölebilme)",
    "Elektronik terazi ve barkodlu terazi etiketleri entegrasyonu",
    "Müşteri ekranı (fiyat gör) desteği ve gün sonu Z raporu / kasa mutabakatı"
  ],
  uretim_mrp: [
    "Çok seviyeli ürün reçeteleri (BOM) ve yarı mamul tanımlama",
    "Üretim iş emirleri oluşturma ve istasyon bazlı operasyon takibi",
    "Otomatik hammadde sarfiyatı ve mamul stok girişi",
    "İşçilik, genel giderler ve fire oranları ile net birim maliyet hesabı",
    "Gelecek siparişlere göre hammadde ihtiyaç (MRP) planlaması"
  ],
  pdks: [
    "15 Saniyede dinamik değişen Karekod (QR Kod) veya GPS ile mobil giriş-çıkış",
    "Vardiya planlama, esnek çalışma saatleri ve mola kontrolleri",
    "Haftalık ve aylık fazla mesai, eksik gün ve gecikme puantajı",
    "Personel yıllık izin, rapor ve mazeret izin onay mekanizması",
    "Ay sonunda muhasebeye hazır bordro puantaj dökümü aktarımı"
  ],
  depodandirekt: [
    "Binlerce hazır toptan ürüne sıfır sermaye ile erişim (Global B2B Toptan Ağı)",
    "Tek tıkla ürünleri kendi ERP stoğunuza ve pazaryeri mağazalarınıza yükleme",
    "Toptancı depolarındaki anlık stok ve fiyat değişimlerinin otomatik güncellenmesi",
    "Satış gerçekleştikçe siparişin toptancıya otomatik iletilmesi",
    "Kendi logonuz ve faturanız ile müşteriye doğrudan depodan kargolama"
  ],
  demirbas: [
    "Şirket demirbaş ve sabit kıymet kartları oluşturma",
    "Personel veya şubeye zimmet ataması ve takip tutanağı",
    "VUK mevzuatına uygun doğrusal ve azalan amortisman hesabı",
    "Bakım, onarım ve garanti süreleri takibi",
    "Demirbaş elden çıkarma veya hurdaya ayırma muhasebe kaydı"
  ],
  ek_kullanici: [
    "Ana paketteki kullanıcılara ilave sınırsız yeni personel yetkilendirmesi",
    "Modül, menü, işlem ve buton bazlı detaylı rol yetki matrisi",
    "Kullanıcı bazlı log ve yapılan işlem geçmişi kayıtları"
  ],
  ek_depo: [
    "Ana depoya ilave yeni bölgesel depo, lojistik merkezi veya antrepo tanımı",
    "Depolar arası sevk irsaliyesi ve transfer onay mekanizması",
    "Depo bazında anlık stok miktarları ve kritik seviye kontrolleri"
  ],
  ek_magaza: [
    "Fiziksel perakende mağazaları ve AVM şubeleri için bağımsız kasa/stok yönetimi",
    "Mağazalar arası ürün transferi ve konsolide ciro karşılaştırması",
    "Mağaza personeli yetkilendirmesi ve gün sonu kasa kapama takibi"
  ],
  plasiyer: [
    "Her ticari aracın sisteme bağımsız mobil şube/depo olarak tanımlanması",
    "Plaka bazlı araç içi anlık stok takibi ve kaçakların önlenmesi",
    "Saha personeline özel fatura/irsaliye/tahsilat yetki kısıtlamaları",
    "Bluetooth mobil termal yazıcı ile araç başında fiş ve irsaliye basımı",
    "Müşteri ziyaret rotaları ve anlık saha tahsilat makbuzu düzenleme"
  ],
  sayim_modulu: [
    "Kamera veya el terminali ile hızlı ve hatasız barkodlu depo sayımı",
    "Sistem stoğu ile fiziksel sayım arasındaki farkların anında raporlanması",
    "Sayım fazlası ve sayım eksiği fişlerinin tek tıkla otomatik oluşturulması",
    "Kör sayım (personelin mevcut miktarı görmeden sayması) desteği"
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    
    <!-- HERO HEADER -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 py-20 text-white border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-blue-300 bg-blue-950/80 border border-blue-500/30 rounded-full">
          📦 Stok Pratik Modüler Ekosistem Rehberi
        </span>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-6 leading-tight">
          <span class="text-red-500">Paketlerimiz ve</span> <span class="bg-gradient-to-r from-blue-400 to-indigo-300 bg-clip-text text-transparent">Modül Yetenekleri</span>
        </h1>
        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto mb-8 leading-relaxed">
          Stok Pratik'te karmaşık ve gereksiz maliyet dayatmaları yok! İşletmenizin ölçeğine uygun ana paketi seçin, büyüdükçe ihtiyacınız olan yetenek modüllerini tek tıkla sisteminize dahil edin.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="/fiyatlar"
            class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-extrabold text-base rounded-2xl shadow-lg shadow-blue-500/25 transition duration-200 text-center"
          >
            Fiyat Hesaplayıcıya Git (Kendi Paketini Kur) →
          </a>
          <a
            href="https://stokpratik.com.tr/firma-kaydi"
            class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold text-base rounded-2xl border border-white/20 transition duration-200 text-center"
          >
            🎁 1 Ay Ücretsiz Kullan
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 1: 3 ANA PAKET VİTRİNİ (FİYATSIZ - ÖZELLİK VE KAPASİTE ODAKLI) -->
    <section class="py-16 sm:py-20">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs font-black uppercase tracking-wider text-blue-600 block mb-2">Çözüm Yelpazemiz</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
            İşletmenizin Ölçeğine Uygun 3 Ana Çözüm
          </h2>
          <p class="text-slate-600 text-base mt-3">
            Esnaf ve mikro işletmelerden, çok şubeli fabrikalara kadar her seviyeye özel tasarlanmış optimize altyapı.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          {packages && packages.map((pkg) => {
            const isPopular = pkg.is_popular;

            return (
              <div
                key={pkg.id}
                class={`flex flex-col justify-between rounded-3xl p-8 transition-all duration-300 relative ${
                  isPopular
                    ? 'bg-gradient-to-b from-blue-900 to-slate-900 text-white shadow-2xl border-2 border-blue-400 ring-4 ring-blue-500/20 lg:-translate-y-2'
                    : 'bg-white text-slate-900 shadow-lg border border-slate-200 hover:shadow-xl'
                }`}
              >
                {/* Popülerlik Rozeti */}
                {pkg.badge && (
                  <div class="mb-4">
                    <span
                      class={`inline-block px-3 py-1 text-xs font-black rounded-full uppercase tracking-wider ${
                        isPopular
                          ? 'bg-amber-400 text-slate-950 shadow-md'
                          : 'bg-blue-50 text-blue-700 border border-blue-200'
                      }`}
                    >
                      {pkg.badge}
                    </span>
                  </div>
                )}

                <div>
                  <h3 class={`text-2xl font-black tracking-tight mb-2 ${isPopular ? 'text-white' : 'text-slate-900'}`}>
                    {pkg.name}
                  </h3>
                  
                  {/* Kapasite Rozeti */}
                  <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold mb-6 ${
                    isPopular ? 'bg-white/10 text-blue-200 border border-white/10' : 'bg-slate-100 text-slate-700'
                  }`}>
                    <span>⚡ {pkg.capacity}</span>
                  </div>

                  <div class={`h-px w-full mb-6 ${isPopular ? 'bg-white/10' : 'bg-slate-100'}`} />

                  {/* Özellik Listesi */}
                  <div class="space-y-3.5 mb-8">
                    <span class={`text-xs font-black uppercase tracking-wider block mb-3 ${
                      isPopular ? 'text-blue-300' : 'text-slate-500'
                    }`}>
                      Paket Yetenekleri:
                    </span>
                    {pkg.features.map((feat, idx) => (
                      <div key={idx} class="flex items-start gap-2.5 text-sm leading-snug">
                        <div class={`p-1 rounded-full shrink-0 mt-0.5 ${
                          isPopular ? 'bg-blue-400/20 text-blue-300' : 'bg-emerald-100 text-emerald-600'
                        }`}>
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                          </svg>
                        </div>
                        <span class={isPopular ? 'text-slate-200 font-medium' : 'text-slate-700 font-medium'}>
                          {feat}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Aksiyon Butonları */}
                <div class="pt-6 border-t border-slate-200/20 space-y-3">
                  <a
                    href="/fiyatlar"
                    class={`block w-full py-3.5 px-4 rounded-xl text-center text-sm font-bold transition-all shadow-md ${
                      isPopular
                        ? 'bg-blue-500 hover:bg-blue-400 text-white'
                        : 'bg-slate-900 hover:bg-slate-800 text-white'
                    }`}
                  >
                    Fiyatları Gör & Yapılandır →
                  </a>
                  <a
                    href="https://stokpratik.com.tr/firma-kaydi"
                    class={`block w-full py-2.5 px-4 rounded-xl text-center text-xs font-semibold transition-all ${
                      isPopular
                        ? 'text-blue-200 hover:text-white bg-white/5 hover:bg-white/10'
                        : 'text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200'
                    }`}
                  >
                    1 Ay Ücretsiz Başla
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SECTION 2: GENİŞLETİLEBİLİR MODÜL YETENEKLERİ (FİYATSIZ VİTRİN) -->
    <section class="py-12 pb-24 bg-white border-t border-slate-200">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-black uppercase tracking-wider text-blue-600 block mb-2">Modüler Yetenekler</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
            İhtiyacınıza Göre Ekleyebileceğiniz Güçlü Modüller
          </h2>
          <p class="text-slate-600 text-base mt-3">
            Tüm modüller Stok Pratik omurgasına %100 entegre çalışır. İşletmeniz büyüdükçe yalnızca operasyonunuzun ihtiyaç duyduğu modülleri aktif edebilirsiniz.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {modules && modules.map((mod) => {
            const specs = detailedModuleSpecs[mod.id] || [];

            return (
              <div
                key={mod.id}
                class="flex flex-col justify-between p-6 sm:p-8 rounded-3xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-blue-400 hover:shadow-lg transition-all duration-200"
              >
                <div>
                  <div class="flex items-start gap-4 mb-4">
                    <span class="text-3xl p-3 bg-white rounded-2xl border border-slate-200 shadow-sm shrink-0">
                      {mod.icon}
                    </span>
                    <div>
                      <h3 class="text-xl font-black text-slate-900 leading-snug">
                        {mod.name}
                      </h3>
                      <div class="flex items-center gap-2 mt-1">
                        <span class="inline-block px-2.5 py-0.5 text-[11px] font-bold rounded-md bg-blue-50 text-blue-700 border border-blue-100">
                          {mod.type === 'quantity' ? `${mod.unit_label || 'Adet'} Bazlı Esnek Ölçek` : 'Aç/Kapa Bağımsız Modül'}
                        </span>
                      </div>
                    </div>
                  </div>

                  {specs.length > 0 && (
                    <div class="space-y-2.5 my-5 pt-4 border-t border-slate-200">
                      <span class="text-xs font-bold text-slate-800 uppercase tracking-wide block mb-3">
                        Neler İçerir ve Yetenekleri:
                      </span>
                      {specs.map((item, i) => (
                        <div key={i} class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
                          <svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          <span>{item}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div class="pt-5 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
                  <span class="text-xs text-slate-500 font-medium">
                    Tam Entegre & Bulut Uyumlu
                  </span>
                  <a
                    href="/fiyatlar"
                    class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 group"
                  >
                    <span>Fiyat & Hesaplayıcıda Yapılandır</span>
                    <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        {/* BOTTOM ACTION CARD */}
        <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-blue-900 via-indigo-950 to-slate-950 text-white text-center shadow-2xl relative overflow-hidden">
          <div class="relative z-10">
            <h3 class="text-2xl sm:text-4xl font-black mb-4 tracking-tight">
              İşletmenizin İhtiyaçlarına Göre Paketinizi Belirleyin
            </h3>
            <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto mb-8 leading-relaxed">
              İnteraktif fiyat hesaplayıcımız ile işletmenizin ölçeğine ve bütçesine en uygun paketi saniyeler içinde oluşturabilir, anında 1 ay ücretsiz denemeye başlayabilirsiniz.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
              <a
                href="/fiyatlar"
                class="w-full sm:w-auto px-8 py-4 bg-white text-slate-950 hover:bg-slate-100 font-extrabold text-base rounded-2xl shadow-xl transition-all text-center"
              >
                Fiyat Hesaplayıcıyı Aç →
              </a>
              <a
                href="https://stokpratik.com.tr/firma-kaydi"
                class="w-full sm:w-auto px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold text-base rounded-2xl shadow-lg transition-all text-center"
              >
                1 Ay Ücretsiz Kaydol
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>