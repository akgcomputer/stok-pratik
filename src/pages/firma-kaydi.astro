---
// src/pages/firma-kaydi.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Ücretsiz Firma Kaydı - Stok Pratik Bulut ERP"
  description="Stok Pratik Bulut ERP'yi 1 ay boyunca kredi kartsız, tam sürüm olarak ücretsiz deneyin. 15 saniyede firmanızı kaydedip anında kullanmaya başlayın."
>
  <main class="min-h-screen bg-gradient-to-b from-slate-50 via-white to-slate-50 py-12 md:py-20 px-4 flex flex-col items-center justify-center relative overflow-hidden">
    
    {/* Background Decorative Blur */}
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-red-100 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-blue-100 rounded-full blur-3xl opacity-50 pointer-events-none"></div>

    <div class="max-w-3xl w-full relative z-10">
      
      {/* Top Free Badge */}
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-bold shadow-sm animate-pulse">
          <span class="text-base">🎁</span>
          <span>1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez</span>
        </div>
      </div>

      {/* Header / Title */}
      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 mb-4 tracking-tight leading-tight">
          Stok Pratik Dünyasına <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-red-600 to-rose-600 bg-clip-text text-transparent">15 Saniyede</span> Adım Atın
        </h1>
        <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          Ön muhasebe, e-ticaret pazaryerleri, hızlı barkod POS, B2B toptan ağı ve üretim modüllerini 
          <strong>hiçbir taahhüt olmadan 1 ay boyunca ücretsiz</strong> test edin.
        </p>
      </div>

      {/* Package Notification from Pricing Calculator */}
      <div id="selectedPackageBanner" class="hidden mb-8 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 text-blue-950 text-sm flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📦</span>
          <div>
            <span class="font-bold block" id="selectedPackageTitle">Seçtiğiniz Modüler Paket</span>
            <span class="text-xs text-blue-700" id="selectedPackageText">1 ay boyunca tüm seçili özellikleriyle ücretsiz kullanımınıza açılacaktır.</span>
          </div>
        </div>
        <a href="/fiyatlar" class="text-xs font-bold text-blue-600 hover:text-blue-800 underline shrink-0 ml-2">Değiştir</a>
      </div>

      {/* Main Action Card */}
      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/70 border border-slate-200 p-6 sm:p-10 mb-8 relative overflow-hidden">
        
        {/* Step Guide */}
        <div class="mb-8">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 text-center">3 Kolay Adımda Başlayın</h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center">
              <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 font-black text-base flex items-center justify-center mb-3">1</div>
              <h3 class="font-bold text-slate-800 text-sm mb-1">Giriş Ekranına Geçin</h3>
              <p class="text-xs text-slate-500">Aşağıdaki butona tıklayarak canlı ERP giriş portalına ulaşın.</p>
            </div>
            
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center">
              <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 font-black text-base flex items-center justify-center mb-3">2</div>
              <h3 class="font-bold text-slate-800 text-sm mb-1">"Firma Kaydı"na Tıklayın</h3>
              <p class="text-xs text-slate-500">Giriş ekranında yer alan <strong>Firma Kaydı</strong> butonunu seçin.</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center">
              <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 font-black text-base flex items-center justify-center mb-3">3</div>
              <h3 class="font-bold text-slate-800 text-sm mb-1">Anında Başlayın</h3>
              <p class="text-xs text-slate-500">Firmanızı tanımlayın, 1 ay ücretsiz kullanımınız hemen başlasın.</p>
            </div>
          </div>
        </div>

        {/* Primary Direct CTA */}
        <div class="text-center space-y-4">
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-5 rounded-2xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white font-extrabold text-lg sm:text-xl shadow-xl shadow-red-600/30 hover:shadow-red-600/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            <span>Canlı ERP Portalında Ücretsiz Kayıt Ol</span>
            <svg class="w-6 h-6 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <p class="text-xs sm:text-sm text-slate-500 flex items-center justify-center gap-1.5 pt-1">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Kredi kartı bilgisi istenmez • Sözleşme veya taahhüt yok • Anında aktivasyon</span>
          </p>
        </div>

        {/* Value Badges */}
        <div class="mt-8 pt-8 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div class="p-3">
            <span class="text-2xl mb-1 block">💳</span>
            <span class="text-xs font-bold text-slate-700 block">Kredi Kartı Yok</span>
            <span class="text-[11px] text-slate-500">1 Ay bedava test</span>
          </div>
          <div class="p-3">
            <span class="text-2xl mb-1 block">⚡</span>
            <span class="text-xs font-bold text-slate-700 block">15 Saniyede Canlı</span>
            <span class="text-[11px] text-slate-500">Bekleme süresi sıfır</span>
          </div>
          <div class="p-3">
            <span class="text-2xl mb-1 block">🔓</span>
            <span class="text-xs font-bold text-slate-700 block">Tüm Modüller Açık</span>
            <span class="text-[11px] text-slate-500">Kısıtlamasız deneyim</span>
          </div>
          <div class="p-3">
            <span class="text-2xl mb-1 block">🎧</span>
            <span class="text-xs font-bold text-slate-700 block">Birebir Destek</span>
            <span class="text-[11px] text-slate-500">WhatsApp & Canlı Destek</span>
          </div>
        </div>

      </div>

      {/* Existing Account & WhatsApp Assistance */}
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-5 rounded-2xl bg-white border border-slate-200 text-sm text-slate-600 shadow-sm">
        <div>
          <span class="font-bold text-slate-800">Zaten bir hesabınız var mı?</span>
          <p class="text-xs text-slate-500">Mevcut şifrenizle ERP sistemine doğrudan giriş yapın.</p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-colors"
          >
            Giriş Yap →
          </a>
          <a 
            href="https://api.whatsapp.com/send?phone=905325000999&text=Merhaba%2C%20Stok%20Pratik%20%C3%BCcretsiz%20firma%20kayd%C4%B1%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs transition-colors shadow-sm"
          >
            <span>WhatsApp Destek</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Package configuration handler from Pricing Calculator if redirected with params
      const urlParams = new URLSearchParams(window.location.search);
      const modulesParam = urlParams.get('modules');
      const cycleParam = urlParams.get('cycle');
      
      if (modulesParam || cycleParam) {
        const packageBanner = document.getElementById('selectedPackageBanner');
        const packageText = document.getElementById('selectedPackageText');
        if (packageBanner && packageText) {
          packageBanner.classList.remove('hidden');
          const modText = modulesParam ? `+ ${modulesParam.split(',').join(', ')}` : 'Çekirdek Ön Muhasebe';
          const cycleText = cycleParam === 'yearly' ? 'Yıllık Avantajlı' : 'Aylık';
          packageText.textContent = `Seçiminiz: StokPratik ${modText} (${cycleText}) - 1 Ay Ücretsiz Tam Sürüm Olarak Açılacaktır.`;
        }
      }
    });
  </script>
</BaseLayout>
