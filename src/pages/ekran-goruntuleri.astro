    title: "Raporlama & İleri Düzey Yönetim Analitiği",
    description: "Kâr-zarar tabloları, ürün kârlılık matrisi, mağaza ciro karşılaştırmaları ve Excel formatında anlık rapor indirme.",
    features: [
      "En çok satanlar, ölü stoklar ve kâr marjı en yüksek ürünler",
      "Şube ve personel satış performans karşılaştırmaları",
      "Tek tıkla Excel, PDF ve grafiksel görsel rapor dışa aktarımı"
    ]
  },
  {
    id: 16,
    category: "analiz-yonetim",
    categoryLabel: "Destek & Yardım",
    badgeColor: "bg-blue-50 text-blue-700 border-blue-200",
    src: "/images/screenshots/StokPratik_destek.png",
    alt: "Stok Pratik Destek ve Canlı Yardım Merkezi",
    title: "Destek, Yardım & Entegrasyon Merkezi",
    description: "Adım adım video rehberler, kullanım dokümanları, uzaktan destek ve 7/24 WhatsApp teknik destek hattı.",
    features: [
      "Her modüle özel hazır rehber ve kullanım ipuçları",
      "Tek tıkla canlı destek ekibine bağlanma",
      "Sistem güncellemeleri ve yeni özellik duyuruları"
    ]
  },
  {
    id: 17,
    category: "eticaret",
    categoryLabel: "B2B & Saha",
    badgeColor: "bg-cyan-50 text-cyan-700 border-cyan-200",
    src: "/images/screenshots/depodandirekt.png",
    alt: "Stok Pratik Depodan Direkt B2B ve Saha Satış Portalı",
    title: "Depodan Direkt B2B & Saha Satış Portalı",
    description: "Bayileriniz ve toptan alıcılarınız için 7/24 kapalı devre sipariş verme, cari ekstre görüntüleme ve kredi kartıyla ödeme portalı.",
    features: [
      "Bayiye özel kademeli iskonto ve vadeli fiyat listeleri",
      "Saha satış personelinin plaka bazlı araç deposu üzerinden satış yapması",
      "Kendi siparişini giren müşterilerle sıfır veri giriş yükü"
    ]
  }
];

// Filtreleme Kategorileri
const categories = [
  { id: 'all', name: 'Tümü', count: screenshots.length },
  { id: 'ticaret', name: 'Ticaret & Satış', count: screenshots.filter(s => s.category === 'ticaret').length },
  { id: 'finans', name: 'Finans & e-Dönüşüm', count: screenshots.filter(s => s.category === 'finans').length },
  { id: 'uretim-depo', name: 'ERP & Depo', count: screenshots.filter(s => s.category === 'uretim-depo').length },
  { id: 'eticaret', name: 'E-Ticaret & B2B', count: screenshots.filter(s => s.category === 'eticaret').length },
  { id: 'ik-servis', name: 'İK & Teknik Servis', count: screenshots.filter(s => s.category === 'ik-servis').length },
  { id: 'analiz-yonetim', name: 'CRM & Analiz', count: screenshots.filter(s => s.category === 'analiz-yonetim').length },
];
---

<BaseLayout 
  title="Stok Pratik Ekran Görüntüleri | Modern ERP & E-Ticaret Platformu"
  description="Stok Pratik ERP, ön muhasebe, barkodlu satış, üretim, e-ticaret ve PDKS modüllerinin tüm gerçek ekran görüntülerini inceleyin. 14 gün ücretsiz deneyin."
>
  {/* Hero Section */}
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white pt-16 pb-20 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-red-600/20 text-red-400 border border-red-500/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          Güncel Sürüm Arayüzleri
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-6">
          Stok Pratik <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-400">Ekran Görüntüleri</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          KOBİ'lerin tüm operasyonlarını tek merkezden yöneten bulut tabanlı mimari. Satıştan üretime, e-dönüşümden QR-PDKS'ye kadar tüm ekranları canlı arayüz görüntüleriyle keşfedin.
        </p>
        
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-red-600/30 hover:scale-105 text-sm"
          >
            14 Gün Ücretsiz Deneyin
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a 
            href="#galeri" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl transition-all border border-white/10 text-sm"
          >
            Ekranları İncele
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Kategori Filtreleme Barı */}
  <section id="galeri" class="sticky top-16 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 py-4 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 sm:pb-0 sm:justify-center">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all cursor-pointer ${
              idx === 0 
                ? 'active bg-slate-900 text-white shadow-sm' 
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900'
            }`}
            data-category={cat.id}
          >
            {cat.name}
            <span class="ml-1.5 opacity-75 text-[11px] font-normal">({cat.count})</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* Ekran Görüntüleri Grid */}
  <section class="py-12 sm:py-16 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div id="screenshotsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {screenshots.map((item, index) => (
          <div 
            class="screenshot-card group bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1"
            data-category={item.category}
            data-index={index}
          >
            {/* Görsel Alanı */}
            <div class="relative aspect-16/10 bg-slate-100 overflow-hidden cursor-pointer img-trigger">
              <img 
                src={item.src} 
                alt={item.alt}
                loading="lazy"
                width="800"
                height="500"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              />
              
              {/* Karartma ve Büyüt Butonu */}
              <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center p-4">
                <span class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-xs text-slate-900 font-bold px-4 py-2 rounded-xl text-xs shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform">
                  <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                  Tam Ekran İncele
                </span>
              </div>

              {/* Kategori Rozeti */}
              <div class="absolute top-3 left-3 z-10">
                <span class={`inline-block px-2.5 py-1 text-[11px] font-bold rounded-lg border shadow-xs ${item.badgeColor}`}>
                  {item.categoryLabel}
                </span>
              </div>
            </div>

            {/* İçerik Alanı */}
            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold text-slate-400">Modül #{String(item.id).padStart(2, '0')}</span>
              </div>

              <h2 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors mb-2 line-clamp-1">
                {item.title}
              </h2>
              
              <p class="text-sm text-slate-600 leading-relaxed mb-4 line-clamp-2">
                {item.description}
              </p>

              {/* Öne Çıkan Yetenekler (Maddeler) */}
              <div class="mt-auto pt-4 border-t border-slate-100 space-y-2 mb-5">
                {item.features.map(f => (
                  <div class="flex items-start gap-2 text-xs text-slate-600">
                    <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    <span class="line-clamp-1">{f}</span>
                  </div>
                ))}
              </div>

              {/* Alt Butonlar */}
              <div class="flex items-center gap-2 pt-2">
                <button
                  type="button"
                  class="btn-open-lightbox flex-1 inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-bold transition-colors cursor-pointer"
                  data-index={index}
                >
                  <svg class="w-3.5 h-3.5 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  Görüntüle
                </button>
                <a
                  href="/firma-kaydi"
