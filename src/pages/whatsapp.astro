---
export const prerender = false;

const konu = Astro.url.searchParams.get('konu');
const isBayilik = konu === 'bayilik';
const isUts = konu === 'uts';
const phone = '905412465429';
const pixelId = '2019909158684223';
const googleTagId = 'AW-746045909';
const conversionSendTo = 'AW-746045909/5tHJCLWU8rkdENWD3-MC';

const pageTitle = isBayilik
  ? 'Stok Pratik Çözüm Ortaklığı & Yazılım Bayiliği | WhatsApp Bilgi Hattı'
  : isUts
  ? 'Sağlık Bakanlığı ÜTS Entegrasyonu | WhatsApp Canlı Demo Hattı'
  : 'Stok Pratik 45 Gün Ücretsiz Deneme | WhatsApp Hızlı Destek';

const pageDescription = isBayilik
  ? 'Stok Pratik Çözüm Ortaklığı ve Yazılım Bayiliği gelir modeli ve şartları hakkında WhatsApp üzerinden hemen bilgi alın.'
  : isUts
  ? 'Sağlık Bakanlığı ÜTS doğrudan REST API entegrasyonu, token kurulumu ve canlı demo için WhatsApp uzmanımıza anında bağlanın.'
  : 'Stok Pratik bulut ERP, e-ticaret ve ön muhasebe için 45 gün deneme şifrenizi ve canlı kurulum desteğini WhatsApp üzerinden hemen alın.';

const badgeText = isBayilik
  ? 'ÇÖZÜM ORTAKLIĞI & YAZILIM BAYİLİĞİ'
  : isUts
  ? 'T.C. SAĞLIK BAKANLIĞI TİTCK ÜTS'
  : 'BULUT ERP, ÖN MUHASEBE & E-TİCARET';

const headingText = isBayilik
  ? 'Hangi Bayilik Konusunda Bilgi Almak İstersiniz?'
  : isUts
  ? 'Sağlık Bakanlığı ÜTS İçin Nasıl Yardımcı Olalım?'
  : 'Size Nasıl Yardımcı Olalım? Konuyu Seçip Tek Tıkla Başlayın';

const subText = isBayilik
  ? 'Aşağıdan ilgilendiğiniz iş ortaklığı başlığını seçtiğinizde hazır mesajınız doğrudan resmi WhatsApp hattımızda açılır.'
  : isUts
  ? 'Aşağıdan ÜTS bildirim veya kurulum ihtiyacınızı seçtiğinizde hazır mesajınız doğrudan medikal entegrasyon uzmanımızın WhatsApp ekranında açılır.'
  : 'İhtiyacınıza uygun seçeneğe dokunduğunuzda hazır mesajınız doğrudan WhatsApp destek ve kurulum ekibimize açılır.';

const ogImage = 'https://stokpratik.com.tr/images/site-foto/fav-stok-pratik-2.png';

const options = isBayilik
  ? [
      {
        key: 'bayilik_komisyon',
        icon: '🤝',
        title: '1. Yazılım Bayiliği & Komisyon Oranları',
        desc: 'Tekrarlayan gelir modeli, karlılık ve bayilik başvuru şartları',
        msg: 'Merhaba, Stok Pratik Yazılım Bayiliği ve yüksek komisyon oranları hakkında detaylı bilgi almak istiyorum.'
      },
      {
        key: 'cozum_ortakligi',
        icon: '🏢',
        title: '2. Kurumsal Çözüm Ortaklığı & Portföy İş Birliği',
        desc: 'Muhasebe, danışmanlık ve teknoloji firmalarına özel ortaklık',
        msg: 'Merhaba, Kurumsal Çözüm Ortaklığı ve portföy iş birliği şartlarınızı görüşmek istiyorum.'
      },
      {
        key: 'bayilik_demo',
        icon: '💼',
        title: '3. Bayi Paneli & Canlı Sunum Talebi',
        desc: 'Müşteri yönetimi, lisanslama ve demo toplantı planlaması',
        msg: 'Merhaba, Stok Pratik bayi yönetim paneli ve canlı tanıtım toplantısı için bilgi almak istiyorum.'
      }
    ]
  : isUts
  ? [
      {
        key: 'uts_canli_demo',
        icon: '🩺',
        title: '1. Canlı ÜTS Entegrasyon Demosu İncelemek İstiyorum',
        desc: 'Fatura keserken tek tıkla verme-alma bildirimi ve BİD günlüğü canlı sunumu',
        msg: 'Merhaba, T.C. Sağlık Bakanlığı ÜTS entegrasyonu hakkında canlı demo ve tanıtım rica ediyorum.'
      },
      {
        key: 'uts_token_destek',
        icon: '🔑',
        title: '2. Sistem Tokenı & KNO Kurulum Desteği Almak İstiyorum',
        desc: 'ÜTS portalından Sistem Tokenı üretimi ve 5 dakikada bağlantı yardımı',
        msg: 'Merhaba, Sağlık Bakanlığı ÜTS Sistem Tokenı ve Kurum Numarası (KNO) ile StokPratik bağlantısı için destek rica ediyorum.'
      },
      {
        key: 'uts_fiyat_gecis',
        icon: '⚡',
        title: '3. Kontörsüz Doğrudan API Geçişi & Paket Bilgisi',
        desc: 'Aracı entegratör masrafı olmadan doğrudan TİTCK bağlantısına geçiş şartları',
        msg: 'Merhaba, aracı entegratör ve kontör masrafı olmadan doğrudan Sağlık Bakanlığı ÜTS entegrasyonuna geçiş şartlarını ve fiyatları öğrenmek istiyorum.'
      }
    ]
  : [
      {
        key: '45gun_sifre',
        icon: '🚀',
        title: '1. 45 Gün Ücretsiz Şifremi Hemen Al (StokPratik45Gun)',
        desc: 'Kredi kartı olmadan 45 gün sınırsız tam sürüm aktivasyonu',
        msg: 'Merhaba, Stok Pratik 45 Gün Ücretsiz Deneme (StokPratik45Gun) şifremi ve kurulum linkini almak istiyorum.'
      },
      {
        key: 'pazaryeri_eticaret',
        icon: '🛒',
        title: '2. E-Ticaret & 50+ Pazaryeri Entegrasyonu Bilgisi',
        desc: 'Trendyol, Hepsiburada, Amazon stok ve otomatik e-fatura akışı',
        msg: 'Merhaba, E-Ticaret ve 50+ Pazaryeri Entegrasyonu hakkında bilgi ve demo talep ediyorum.'
      },
      {
        key: 'erp_onmuhasebe_kurulum',
        icon: '📊',
        title: '3. Ön Muhasebe, Depo & ERP Canlı Kurulum Talebi',
        desc: '5 dakikada telefon veya uzaktan bağlantıyla anahtar teslim kurulum',
        msg: 'Merhaba, Ön Muhasebe, Depo ve ERP canlı kurulumu için bilgi ve destek almak istiyorum.'
      }
    ];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://stokpratik.com.tr/whatsapp" />
    <link rel="icon" type="image/png" href="/images/site-foto/fav-stok-pratik-2.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stokpratik.com.tr/whatsapp" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Stok Pratik" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Tag (AW-746045909) & Meta Pixel (2019909158684223) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleTagId}`}></script>
    <script is:inline define:vars={{ pixelId, googleTagId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', googleTagId);

      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixelId);
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at top, #0f172a 0%, #020617 70%);
        color: #f8fafc;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        padding: 16px;
      }
      .card {
        width: 100%;
        max-width: 520px;
        background: rgba(15, 23, 42, 0.96);
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 24px;
        padding: 28px 22px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
      }
      .top {
        text-align: center;
        margin-bottom: 18px;
      }
      .badge {
        display: inline-block;
        background: rgba(245, 158, 11, 0.14);
        border: 1px solid rgba(245, 158, 11, 0.42);
        color: #fcd34d;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.04em;
        padding: 6px 14px;
        border-radius: 999px;
        margin-bottom: 14px;
      }
      h1 {
        font-size: 21px;
        line-height: 1.3;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 8px;
      }
      p.desc {
        font-size: 13.5px;
        line-height: 1.5;
        color: #cbd5e1;
      }
      .options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 14px;
      }
      .opt-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 14px 16px;
        border-radius: 16px;
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: #ffffff;
        text-decoration: none;
        transition: all 0.18s ease;
      }
      .opt-btn.primary {
        background: linear-gradient(135deg, #059669, #10b981);
        border-color: #34d399;
        box-shadow: 0 10px 24px rgba(16, 185, 129, 0.3);
      }
      .opt-btn:hover {
        transform: translateY(-1px);
        border-color: #34d399;
      }
      .opt-icon {
        font-size: 24px;
        line-height: 1;
        flex-shrink: 0;
      }
      .opt-body {
        flex: 1;
        text-align: left;
      }
      .opt-title {
        display: block;
        font-size: 14.5px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2px;
      }
      .opt-sub {
        display: block;
        font-size: 12px;
        color: rgba(241, 245, 249, 0.86);
        line-height: 1.35;
      }
      .opt-arrow {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        flex-shrink: 0;
      }
      .actions-row {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .btn-tel {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px 18px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #f8fafc;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }
      .btn-tel:hover {
        background: rgba(255, 255, 255, 0.14);
      }
      .btn-register {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px 18px;
        border-radius: 14px;
        background: rgba(245, 158, 11, 0.16);
        border: 1px solid rgba(245, 158, 11, 0.45);
        color: #fde68a;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
      }
      .btn-register:hover {
        background: rgba(245, 158, 11, 0.24);
      }
      .foot-note {
        margin-top: 12px;
        text-align: center;
        font-size: 11.5px;
        color: #94a3b8;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <div class="top">
        <div class="badge">{badgeText}</div>
        <h1>{headingText}</h1>
        <p class="desc">{subText}</p>
      </div>

      <div class="options">
        {options.map((opt, idx) => (
          <a
            href={`https://wa.me/${phone}?text=${encodeURIComponent(opt.msg)}`}
            data-wa-key={opt.key}
            target="_blank"
            rel="noopener noreferrer"
            class={`opt-btn ${idx === 0 ? 'primary' : ''}`}
          >
            <span class="opt-icon" aria-hidden="true">{opt.icon}</span>
            <span class="opt-body">
              <span class="opt-title">{opt.title}</span>
              <span class="opt-sub">{opt.desc}</span>
            </span>
            <span class="opt-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="actions-row">
        <a id="tel-btn" href="tel:+905412465429" class="btn-tel">
          <span>📞 Hemen Telefonla Görüş: 0541 246 54 29</span>
        </a>

        {!isBayilik && (
          <a
            id="register-btn"
            href="https://erp-eticaret.stokpratik.com.tr/giris?promo=StokPratik45Gun"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-register"
          >
            <span>⚡ Beklemeden Online Kayıt Ol (StokPratik45Gun)</span>
          </a>
        )}
      </div>

      <p class="foot-note">
        Resmi WhatsApp &amp; Destek Hattı: 0541 246 54 29
      </p>
    </main>

    <script is:inline define:vars={{ conversionSendTo, konu: konu || (isBayilik ? 'bayilik' : '45gun') }}>
      (function () {
        function trackAction(key, kind) {
          try {
            if (typeof window.fbq === 'function') {
              if (kind === 'trial') {
                window.fbq('track', 'StartTrial', { content_name: key, currency: 'TRY', value: 0 });
                window.fbq('track', 'Lead', { content_name: key });
              } else {
                window.fbq('track', 'Contact', { content_name: key, content_category: kind });
                window.fbq('track', 'Lead', { content_name: key });
              }
            }
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'conversion', { send_to: conversionSendTo });
            }
          } catch (err) {}
        }

        document.querySelectorAll('[data-wa-key]').forEach(function (el) {
          el.addEventListener('click', function () {
            trackAction(el.getAttribute('data-wa-key') || konu, 'WhatsApp');
          });
        });

        var telBtn = document.getElementById('tel-btn');
        if (telBtn) {
          telBtn.addEventListener('click', function () {
            trackAction(konu + '_tel', 'Phone');
          });
        }

        var regBtn = document.getElementById('register-btn');
        if (regBtn) {
          regBtn.addEventListener('click', function () {
            trackAction('whatsapp_sayfasi_online_kayit', 'trial');
          });
        }
      })();
    </script>
  </body>
</html>
