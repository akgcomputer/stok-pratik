---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "SGK Personel Puantaj Cetveli ve Fazla Mesai Hesaplama | Stok Pratik";
const pageDescription = "Ay sonunda saatlerce mesai hesaplamaya son! QR-PDKS girişlerinden otomatik üretilen 30 günlük renk kodlu SGK puantaj cetveli, fazla mesai çarpanları ve tek tıkla SMMM aktarımı.";

const matrixLegend = [
  { code: "X", label: "Normal Çalışma", color: "bg-emerald-500/20 text-emerald-400 border-emerald-500/40" },
  { code: "FM", label: "Fazla Mesai (%50)", color: "bg-blue-500/20 text-blue-400 border-blue-500/40" },
  { code: "HT", label: "Hafta Tatili", color: "bg-slate-800 text-slate-400 border-slate-700" },
  { code: "GK", label: "Geç Kalma (Tolerans Dışı)", color: "bg-amber-500/20 text-amber-400 border-amber-500/40" },
  { code: "Üİ", label: "Ücretli Yıllık İzin", color: "bg-purple-500/20 text-purple-400 border-purple-500/40" },
  { code: "R", label: "İstirahat Raporlu", color: "bg-cyan-500/20 text-cyan-400 border-cyan-500/40" }
];

const puantajFeatures = [
  {
    icon: "🗓️",
    title: "30 Günlük Renk Kodlu Resmi SGK Puantaj Tablosu",
    desc: "Her personelin ayın hangi günü tam çalıştığını (Yeşil), ne zaman fazla mesai yaptığını (Mavi), hangi gün izinli olduğunu (Mor) ve ne zaman geç kaldığını (Sarı) tek bakışta gösteren görsel matris."
  },
  {
    icon: "⏰",
    title: "Fazla Mesai ve Eksik Süre Otomatik Matematiği",
    desc: "Şube çalışma saatlerine göre personelin toplam çalışma dakikalarını toplar; %50 normal fazla mesai veya %100 resmi bayram/hafta tatili çarpanlarını kuruşu kuruşuna ayırır."
  },
  {
    icon: "📝",
    title: "İzin ve Raporlarla Tam Entegre",
    desc: "Yöneticinin onayladığı yıllık izin, mazeret izni veya doktor raporu günleri puantaj cetveline anında işlenir; 'izinli olduğu gün devamsız yazıldı' hatası tamamen engellenir."
  },
  {
    icon: "💸",
    title: "Maaş, Avans ve Kesinti Mutabakatı",
    desc: "Personelin ay içinde aldığı onaylı nakit maaş avansları puantaj özetinde otomatik görünür; ay sonunda bankaya yatırılacak net maaş tutarı şeffafça ortaya çıkar."
  },
  {
    icon: "✍️",
    title: "İmza Sirkülü Resmi A4 Puantaj Çıktısı",
    desc: "İş Kanunu ve SGK denetimlerinde ibraz edilmek üzere altında 'Personel Onay İmzası' ve 'İşveren Onayı' sütunları bulunan A4 aylık puantaj cetvelini tek tıkla yazdırın."
  },
  {
    icon: "🔄",
    title: "Mali Müşavir (SMMM) Bordro Aktarımı",
    desc: "Normal gün, hafta tatili, genel tatil, eksik gün nedeni ve toplam fazla mesai saatlerini mali müşavirinizin bordro programına hazır standart Excel formatında indirin."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-emerald-500 selection:text-slate-950">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-emerald-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-emerald-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              📋 QR-PDKS ve İK • Otomatik SGK Puantaj & Mesai Motoru
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Ay Sonunda Saatlerce Mesai Hesaplamaya Son: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-200">
                SGK Puantaj Cetveliniz Tek Tıkla Hazır!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Personellerinizin ay boyunca QR-PDKS ile yaptığı girişler, çıkışlar, molalar, onaylanan izinler ve fazla mesailer otomatik olarak <strong>30 Günlük Resmi SGK Puantaj Cetveline</strong> dönüşsün. Eksik süreleri, fazla mesai çarpanlarını ve net hakedişleri tek tıkla görün; mali müşavirinize anında gönderin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-base shadow-lg shadow-emerald-500/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>📋 Otomatik Puantajı Ücretsiz Deneyin</span>
              </a>
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/giris" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🔐 Giriş Yap</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> %50 & %100 Mesai Ayrımı
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Resmi İmzalı A4 Çıktı
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Mali Müşavir Bordro Uyumlu
              </div>
            </div>
          </div>

          <!-- Sağ: Canlı SGK Puantaj Matrisi Mockup'ı -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-emerald-500/30 rounded-3xl p-5 sm:p-6 shadow-2xl backdrop-blur-xl">
              
              <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <div>
                  <div class="text-[10px] text-emerald-400 font-mono uppercase tracking-wider font-semibold">Resmi SGK Puantajı</div>
                  <div class="text-sm font-bold text-white">Ahmet Yılmaz (Satış Temsilcisi)</div>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">
                  2026 / Ağustos
                </span>
              </div>

              <!-- 30 Günlük Mini Matris Görünümü -->
              <div class="bg-slate-950 p-3 rounded-2xl border border-slate-800 mb-4">
                <div class="text-[10px] text-slate-400 uppercase font-mono mb-2 flex justify-between">
                  <span>30 Günlük Takvim Matrisi:</span>
                  <span class="text-emerald-400">22 Gün Normal • 2 FM • 1 İzin</span>
                </div>

                <!-- Gün Kutucukları (1'den 15'e örnek sergileme) -->
                <div class="grid grid-cols-5 gap-1.5 text-center font-mono text-[11px] font-bold">
                  <div class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">1: X</div>
                  <div class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">2: X</div>
                  <div class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">3: X</div>
                  <div class="p-1.5 rounded-lg bg-blue-500/20 text-blue-300 border border-blue-500/30">4: FM</div>
                  <div class="p-1.5 rounded-lg bg-slate-800 text-slate-400 border border-slate-700">5: HT</div>
                  
                  <div class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">6: X</div>
                  <div class="p-1.5 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30">7: GK</div>
                  <div class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">8: X</div>
                  <div class="p-1.5 rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/30">9: Üİ</div>
                  <div class="p-1.5 rounded-lg bg-slate-800 text-slate-400 border border-slate-700">10: HT</div>
                </div>
              </div>

              <!-- Puantaj Hesap Özeti -->
              <div class="space-y-1.5 text-xs font-mono bg-slate-950/70 p-3 rounded-2xl border border-slate-800 mb-4">
                <div class="flex justify-between text-slate-300">
                  <span>Toplam Çalışma Süresi:</span>
                  <span class="font-bold text-white">186 Saat 40 Dk</span>
                </div>
                <div class="flex justify-between text-blue-300">
                  <span>Hesaplanan Fazla Mesai:</span>
                  <span class="font-bold">+12 Saat (%50 Çarpanlı)</span>
                </div>
                <div class="flex justify-between text-purple-300">
                  <span>Kullanılan Yıllık İzin:</span>
                  <span class="font-bold">1 Gün (Bakiye: 13 Gün Kaldı)</span>
                </div>
                <div class="flex justify-between text-amber-300">
                  <span>Geç Kalma Kesintisi:</span>
                  <span class="font-bold">-45 Dakika</span>
                </div>
              </div>

              <!-- Tek Tıkla Yazdır ve Aktar -->
              <div class="grid grid-cols-2 gap-2 text-[11px] font-semibold">
                <div class="p-2.5 rounded-xl bg-slate-800 text-center text-slate-300 border border-slate-700">
                  🖨️ İmzalı A4 Çıktı
                </div>
                <div class="p-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 text-center text-white shadow-md">
                  📊 SMMM Excel İndir
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. PUANTAJ KODLARI VE DETAYLI YETENEKLER -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative bg-slate-900/30">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-emerald-400 text-sm font-semibold tracking-wider uppercase mb-3">SGK Uyumlu İş Akışı</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Canlı Puantaj Matrisinin 6 Otomatik Yeteneği
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            Giriş-çıkış saatlerini elle toplayıp Excel'e yazma devrini tamamen bitiren akıllı İK matematiği.
          </p>
        </div>

        <!-- Renk Kodları Açıklaması -->
        <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
          {matrixLegend.map((item) => (
            <div class={`px-3 py-1.5 rounded-xl border text-xs font-mono font-bold flex items-center gap-2 ${item.color}`}>
              <span>{item.code}:</span>
              <span class="font-sans font-medium">{item.label}</span>
            </div>
          ))}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {puantajFeatures.map((f) => (
            <div class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-7 hover:border-emerald-500/40 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-2xl flex items-center justify-center mb-5">
                  {f.icon}
                </div>
                <h3 class="text-lg font-bold text-white mb-2.5">{f.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-emerald-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs sm:text-sm font-semibold mb-6">
          �🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          Ay Sonu Puantaj Stresini 5 Dakikaya İndirin!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Hemen ücretsiz Stok Pratik hesabınızı açın, personellerinizin mesai ve izin kayıtlarını otomatik resmi SGK puantajına dönüştürün.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-base shadow-lg shadow-emerald-500/30 transition-all duration-200"
          >
            🚀 Hemen Ücretsiz Kullanmaya Başla
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
