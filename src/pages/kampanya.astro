  {/* Client script for 1-click copy feedback */}
  <script is:inline define:vars={{ promoCode }}>
    document.addEventListener('DOMContentLoaded', () => {
      const copyBtn = document.getElementById('copyPromoBtn');
      const copyText = document.getElementById('copyText');
      const copyIcon = document.getElementById('copyIcon');

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(promoCode);
            if (copyText) copyText.textContent = "Kopyalandı! 🎉";
            copyBtn.classList.remove('bg-amber-400', 'hover:bg-amber-300');
            copyBtn.classList.add('bg-emerald-400', 'text-slate-950');
            
            setTimeout(() => {
              if (copyText) copyText.textContent = "Kodu Kopyala";
              copyBtn.classList.remove('bg-emerald-400');
              copyBtn.classList.add('bg-amber-400', 'hover:bg-amber-300');
            }, 3000);
          } catch (err) {
            console.error('Kopyalama hatası:', err);
          }
        });
      }
    });
  </script>
