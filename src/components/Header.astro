            </div>
          </div>
        </li>
        
        <li class="list-none">
          <a href="/blog" class="text-slate-700 font-semibold hover:text-red-600 transition-colors">Blog</a>
        </li>

        <li class="list-none">
          <a href="/piyasa-radari" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 text-white font-bold text-[13px] hover:bg-red-600 transition-colors group shadow-sm" title="Piyasa Radarı">
