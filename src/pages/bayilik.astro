---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bayilik ve Çözüm Ortaklığı - Stok Pratik ERP">
  <!-- Hero Section -->
  <section class="hero py-16">
    <div class="container">
      <div class="hero-content text-center">
        <h1>Stok Pratik Bayisi Olun</h1>
        <h2 class="hero-subtitle">İşletmelerin Dijital Dönüşümüne Öncülük Edin</h2>
        <p class="hero-description">
          Sıfır altyapı maliyeti ve kota baskısı olmadan; ön muhasebe, e-ticaret ve sektörel yazılım çözümlerimizi portföyünüze sunarak %30 net kazanç ve ömür boyu pasif gelir elde edin!
        </p>
        <a href="#basvur" class="btn btn-primary btn-lg">Hemen Bayilik Başvurusu Yap</a>
      </div>
    </div>
  </section>

  <!-- Avantajlar Grid -->
  <section class="advantages py-16">
    <div class="container">
      <div class="section-header text-center">
        <h2>Çift Yönlü Kazanç Modeli</h2>
        <p>Müşterinizin tercihine göre ister tek seferlik yüksek kazanç elde edin, ister yıllarca sürecek düzenli nakit akışı oluşturun.</p>
      </div>

      <div class="advantages-grid">
        <div class="advantage-card">
          <div class="advantage-icon">💎</div>
          <h3>Ömür Boyu Lisans Satışı</h3>
          <p>İşletmelere tek seferlik ömür boyu lisans satışını yapın, gerçekleştirilen her satıştan anında <strong>%30 net kâr payı</strong> kazanın.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🔄</div>
          <h3>Kiralama & Pasif Gelir</h3>
          <p>Kiralama modeliyle sisteme dahil ettiğiniz işletmeler hizmeti kullandığı ve ödeme yaptığı sürece her dönem düzenli hakediş alın.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🛡️</div>
          <h3>Sıfır Sunucu & Bakım Yükü</h3>
          <p>Tüm sunucu, yedekleme ve güncellemeler bizim tarafımızdan yönetilir. Siz sadece satışa odaklanırsınız.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🎯</div>
          <h3>Kota veya Teminat Yok</h3>
          <p>Aylık satış kotaları veya yüksek bayilik giriş ücretleri olmadan doğrudan ortaklığınızı başlatabilirsiniz.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">🤝</div>
          <h3>Birebir Eğitim ve Destek</h3>
          <p>Satış öncesi ve sonrası süreçlerde, demo sunumlarında ve kurulumlarda tam destek sağlıyoruz.</p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">💼</div>
          <h3>Geniş Ürün Yelpazesi</h3>
          <p>Ön muhasebeden oto servis yazılımına kadar her sektörden işletmeye tam ihtiyacı olan çözümü rahatlıkla sunabilirsiniz.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Motivasyon Sections -->
  <section class="motivation py-16">
    <div class="container">
      <div class="motivation-grid">
        <div class="motivation-card">
          <div class="motivation-content">
            <h2>Hangi Çözümleri Sunacaksınız?</h2>
            <p>
              Geniş ürün yelpazemiz sayesinde her bütçeye ve her sektöre uygun modüler çözümler sunun. Ön muhasebe, POS, E-Ticaret ve özel sektörel paketlerle müşterilerinizi dijitalleştirin.
            </p>
            <ul class="motivation-list">
              <li>✓ Ön Muhasebe & POS</li>
              <li>✓ E-Ticaret ve Pazaryeri</li>
              <li>✓ Oto Servis & Yedek Parça</li>
              <li>✓ Kuyumcu & Market Çözümleri</li>
            </ul>
          </div>
          <div class="motivation-image">
            <div class="image-placeholder">
              <span style="font-size: 4rem;">📦</span>
            </div>
          </div>
        </div>

        <div class="motivation-card reverse">
          <div class="motivation-content">
            <h2>Kazanmaya Bugün Başlayın</h2>
            <p>
              Özellikle Mali Müşavirler, Donanım & POS Satıcıları, Bilişim Teknik Servisleri ve E-Ticaret Danışmanları için benzersiz bir ek gelir ve iş büyütme fırsatı!
            </p>
            <ul class="motivation-list">
              <li>✓ Garantili ömür boyu pasif gelir</li>
              <li>✓ %30 net satış hakedişi</li>
              <li>✓ Güçlü altyapı ve marka bilinirliği</li>
              <li>✓ Sürekli teknik destek</li>
            </ul>
          </div>
          <div class="motivation-image">
            <div class="image-placeholder">
              <span style="font-size: 4rem;">🚀</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nasıl Çalışır -->
  <section class="how-it-works py-16">
    <div class="container">
      <div class="section-header text-center">
        <h2>Bayilik Süreci Nasıl İşliyor?</h2>
        <p>3 adımda Stok Pratik bayisi olun</p>
      </div>

      <div class="steps-grid">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Başvuru Yap</h3>
          <p>Aşağıdaki form veya WhatsApp üzerinden ön başvurunuzu tamamlayın.</p>
        </div>

        <div class="step">
          <div class="step-number">2</div>
          <h3>Sözleşme ve Eğitim</h3>
          <p>Karşılıklı anlaşmanın ardından ürün ve satış eğitimlerini alın.</p>
        </div>

        <div class="step">
          <div class="step-number">3</div>
          <h3>Satışa Başla ve Kazan</h3>
          <p>Hemen sahaya inerek işletmeleri dijitalleştirin ve komisyonlarınızı alın.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Başvuru Formu -->
  <section class="application py-16" id="basvur">
    <div class="container">
      <div class="application-card">
        <div class="application-content">
          <h2>Bayimiz Olmak İçin İlk Adımı Atın</h2>
          <p>
            Aşağıdaki butona tıklayarak WhatsApp üzerinden doğrudan yetkili ekibimizle görüşebilir veya bilgilerinizi ileterek aynı gün içinde bayiliğinizi başlatabilirsiniz.
          </p>
          
          <div class="application-buttons">
            <a 
              href="https://wa.me/+905325000999?text=Merhaba,%20Stok%20Pratik%20bayilik%20ve%20%C3%A7%C3%B6z%C3%BCm%20ortakl%C4%B1%C4%9F%C4%B1%20hakk%C4%B1nda%20g%C3%B6r%C3%BC%C5%9Fmek%20istiyorum." 
              class="btn btn-primary btn-lg btn-whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span style="margin-right: 6px;">💬 WhatsApp ile Hızlı Başvuru Yap</span> 
            </a>
            
            <a 
              href="tel:+905325000999" 
              class="btn btn-secondary btn-lg"
            >
              <span class="btn btn-primary btn-lg">📞 Doğrudan Telefon ile İletişime Geç</span > 
            </a>
          </div>
          
          <div class="application-info">
            <p><strong>Öncelikli Değerlendirilen Başvurular:</strong></p>
            <ul>
              <li>Mali Müşavirler</li>
              <li>Donanım & POS Satıcıları</li>
              <li>Bilişim Teknik Servisleri</li>
              <li>E-Ticaret ve Marka Danışmanları</li>
              <li>Franchise bedeli veya kota istenmemektedir.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Hero Section */
    .hero {
      background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
      color: white;
    }

    .hero h1 {
      color: white;
      margin-bottom: var(--spacing-sm);
      font-size: 3rem;
    }

    .hero-subtitle {
      font-size: 1.75rem;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: var(--spacing-md);
      font-weight: 600;
    }

    .hero-description {
      font-size: 1.25rem;
      color: rgba(255, 255, 255, 0.8);
      max-width: 800px;
      margin: 0 auto var(--spacing-lg);
      line-height: 1.6;
    }

    .btn-lg {
      padding: 1rem 2rem;
      font-size: 1.1rem;
      font-weight: 600;
    }

    /* Advantages Section */
    .advantages {
      background-color: var(--bg-white);
    }

    .section-header h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-sm);
    }

    .section-header p {
      color: var(--text-gray);
      font-size: 1.125rem;
      margin-bottom: var(--spacing-xl);
    }

    .advantages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-lg);
    }

    .advantage-card {
      background: var(--bg-white);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      text-align: center;
      border: 2px solid var(--primary-red-light);
      transition: transform var(--transition-normal);
    }

    .advantage-card:hover {
      transform: translateY(-10px);
      box-shadow: var(--shadow-lg);
    }

    .advantage-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
    }

    .advantage-card h3 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
    }

    .advantage-card p {
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* Motivation Sections */
    .motivation {
      background-color: var(--bg-light);
    }

    .motivation-grid {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xl);
    }

    .motivation-card {
      background: var(--bg-white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-md);
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .motivation-card.reverse {
      direction: rtl;
    }

    .motivation-card.reverse .motivation-content {
      direction: ltr;
      text-align: left;
    }

    .motivation-card.reverse .motivation-list {
      direction: ltr;
    }

    .motivation-content {
      padding: var(--spacing-xl);
    }

    .motivation-content h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
    }

    .motivation-content p {
      color: var(--text-dark);
      line-height: 1.6;
      margin-bottom: var(--spacing-lg);
    }

    .motivation-list {
      list-style: none;
    }

    .motivation-list li {
      padding: var(--spacing-xs) 0;
      color: var(--text-dark);
    }

    .motivation-list li::before {
      content: "✓";
      color: var(--primary-red);
      font-weight: bold;
      margin-right: 10px;
    }

    .motivation-image {
      padding: var(--spacing-xl);
      background: linear-gradient(135deg, var(--primary-red-light), var(--primary-red));
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
    }

    .image-placeholder {
      text-align: center;
      color: white;
    }

    /* How It Works */
    .how-it-works {
      background-color: var(--bg-white);
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--spacing-lg);
      max-width: 1000px;
      margin: 0 auto;
    }

    .step {
      text-align: center;
      padding: var(--spacing-lg);
      position: relative;
    }

    .step-number {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
      margin: 0 auto var(--spacing-md);
    }

    .step h3 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-sm);
    }

    .step p {
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* Application Section */
    .application {
      background: linear-gradient(135deg, var(--primary-red-light), var(--bg-light));
    }

    .application-card {
      background: var(--bg-white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: var(--spacing-xl);
      max-width: 800px;
      margin: 0 auto;
    }

    .application-content h2 {
      color: var(--primary-red);
      margin-bottom: var(--spacing-md);
      text-align: center;
    }

    .application-content p {
      color: var(--text-dark);
      text-align: center;
      margin-bottom: var(--spacing-xl);
      line-height: 1.6;
    }

    .application-buttons {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      margin-bottom: var(--spacing-xl);
    }

    .btn-whatsapp {
      background: linear-gradient(135deg, #25D366, #128C7E);
      border-color: #25D366;
      color: white;
    }

    .btn-whatsapp:hover {
      background: linear-gradient(135deg, #128C7E, #075E54);
      border-color: #128C7E;
    }

    .application-info {
      background: var(--primary-red-light);
      padding: var(--spacing-lg);
      border-radius: var(--radius-md);
    }

    .application-info p {
      text-align: left;
      margin-bottom: var(--spacing-sm);
    }

    .application-info ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .application-info li {
      padding: var(--spacing-xs) 0;
      padding-left: var(--spacing-lg);
      position: relative;
    }

    .application-info li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--primary-red);
      font-size: 1.2rem;
    }

    /* Responsive Design */
    @media (max-width: 992px) {
      .motivation-card {
        grid-template-columns: 1fr;
      }
      
      .motivation-card.reverse {
        direction: ltr;
      }
      
      .motivation-image {
        min-height: 200px;
      }
      
      .application-buttons {
        flex-direction: column;
      }
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2.5rem;
      }
      
      .hero-subtitle {
        font-size: 1.5rem;
      }
      
      .hero-description {
        font-size: 1.1rem;
      }
      
      .advantages-grid {
        grid-template-columns: 1fr;
      }
      
      .steps-grid {
        grid-template-columns: 1fr;
      }
      
      .advantage-card,
      .motivation-content,
      .application-card {
        padding: var(--spacing-lg);
      }
    }

    @media (max-width: 480px) {
      .hero h1 {
        font-size: 2rem;
      }
      
      .hero-subtitle {
        font-size: 1.25rem;
      }
      
      .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
      }
    }
  </style>
</BaseLayout>
