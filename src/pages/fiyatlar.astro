    name2: '5 Şubeli Mağaza Paketi',
    rentPrice: '4.999',
    lifetimePrice: '119.900 ₺ + KDV',
    popular: false,
    features: pPro5.features
  },
  {
    id: 'eticaret-entegre',
    name: 'E-Ticaret +',
    name2: 'Pazaryeri Entegrasyon Paketi',
    rentPrice: '1.999',
    lifetimePrice: '54.900 ₺ + KDV',
    popular: false,
    features: pEticaret.features
  },
  {
    id: 'otoservis',
    name: 'Oto Servis & Yazılım Paketi',
    rentPrice: '2.499',
    lifetimePrice: '69.900 ₺ + KDV',
    popular: false,
    features: pOtoServis.features
  },
  {
    id: 'crm-erp',
    name: 'CRM + ERP',
    name2: 'Süreç Yönetimi Paketi',
    rentPrice: '5.999',
    lifetimePrice: '179.900 ₺ + KDV',
    popular: false,
    features: pErp.features
  }
];
---
<BaseLayout title="Fiyatlar | Stok Pratik">
  <div class="pricing-page">
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-bg-glow"></div>
      <div class="container text-center relative z-10">
        <span class="badge">Şeffaf Fiyatlandırma</span>
        <h1 class="page-title">İşletmeniz İçin <br/><span class="gradient-text">Doğru Paketi Seçin</span></h1>
        <p class="page-subtitle">Aylık kiralama veya ömür boyu kullanım seçenekleriyle, bütçenize en uygun planı belirleyin.</p>
      </div>
    </section>

    <!-- Pricing Grid -->
    <section class="pricing-section">
      <div class="container">
        <div class="pricing-grid">
          {pricingPackages.map((pkg) => (
            <div class={`pricing-card ${pkg.popular ? "featured" : ""}`}>
              {pkg.popular && <div class="popular-badge">{pkg.badge}</div>}
              
              <div class="card-header">
                <h3>{pkg.name}</h3>
                {pkg.name2 && <h4>{pkg.name2}</h4>}
                
                <div class="price-container">
                  <div class="price-type">Aylık Kiralama</div>
                  <div class="price-box rent">
                    <span class="currency">₺</span>
                    <span class="amount">{pkg.rentPrice}</span>
                    <span class="period">/ aylık + KDV</span>
                  </div>
                  
                  <div class="price-type lifetime">* Ömür Boyu Satın Alma</div>
                  <div class="price-box lifetime-price">
                    <span class="amount lifetime-amt">{pkg.lifetimePrice}</span>
                  </div>
                </div>
              </div>
              
              <div class="features-list">
                {pkg.features.map((feature) => (
                  <div class={`feature-item ${feature.type} ${feature.highlight ? "highlight" : ""}`}>
                    <div class="feature-title">
                      <span class="feature-icon">{feature.icon}</span>
                      <span class="feature-text">{feature.text}</span>
                    </div>
                    {feature.subItems && feature.subItems.length > 0 && (
                      <details class="sub-features">
                        <summary>Detayları Gör</summary>
                        <div class="sub-items-content">
                          {feature.subItems.map(sub1 => (
                            <div class="sub1">
                              <strong>{sub1.text}</strong>
                              {sub1.subItems && (
                                <ul class="sub2-list">
                                  {sub1.subItems.map(sub2 => (
                                    <li>{sub2.text}</li>
                                  ))}
                                </ul>
                              )}
                            </div>
                          ))}
                        </div>
                      </details>
                    )}
                  </div>
                ))}
              </div>
              
              <div class="card-footer">
                <a href={`https://wa.me/+905325000999?text=${encodeURIComponent(`${pkg.name} paketini kullanmaya başlamak istiyorum`)}`} class="btn-action">
                  Hemen Başla
                </a>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Info Box for Lifetime -->
        <div class="info-box-container">
          <div class="info-icon">💡</div>
          <div class="info-content">
            <strong>* Önemli not:</strong> Ömür Boyu Satın Alma yapınca yıllık 200$ ödeme yapmanız gerekmektedir. Yıl boyunca özel bir talebiniz ve bant genişliği sınırlarını aşmadığınız sürece farklı bir ödeme yapmazsınız.
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .pricing-page {
    background: #f8fafc;
    min-height: 100vh;
    padding-bottom: 80px;
    font-family: "Inter", sans-serif;
  }
  
  /* Hero */
  .hero-section {
    position: relative;
    padding: 100px 20px 40px;
    overflow: hidden;
    background: #ffffff;
    margin-bottom: 40px;
  }
  .hero-bg-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, rgba(255,255,255,0) 70%);
    z-index: 0;
  }
  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 20px;
    box-shadow: 0 2px 10px rgba(79, 70, 229, 0.1);
  }
  .page-title {
    font-size: 3rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 20px;
    letter-spacing: -1px;
  }
  .gradient-text {
    background: linear-gradient(135deg, #4f46e5, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-subtitle {
    font-size: 1.2rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Grid & Cards */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 30px;
    align-items: stretch;
  }
  
  .pricing-card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 24px;
    padding: 40px 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden;
  }
  .pricing-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; width: 100%; height: 6px;
    background: #e2e8f0;
    transition: background 0.3s ease;
  }
  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px rgba(0,0,0,0.06);
  }
  .pricing-card:hover::before {
    background: linear-gradient(90deg, #4f46e5, #ec4899);
  }
  .pricing-card.featured {
    border: 2px solid #4f46e5;
    background: #ffffff;
    box-shadow: 0 20px 40px rgba(79, 70, 229, 0.12);
    transform: scale(1.02);
    z-index: 2;
  }
  .pricing-card.featured::before {
    background: linear-gradient(90deg, #4f46e5, #ec4899);
  }
  .pricing-card.featured:hover {
    transform: scale(1.02) translateY(-8px);
  }
  
  .popular-badge {
    position: absolute;
    top: 18px;
    right: -40px;
    background: linear-gradient(90deg, #4f46e5, #ec4899);
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 6px 45px;
    transform: rotate(45deg);
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    z-index: 10;
  }

  /* Headers and Prices */
  .card-header {
    text-align: center;
    margin-bottom: 25px;
    padding-bottom: 25px;
    border-bottom: 1px solid #f1f5f9;
  }
  .card-header h3 {
    font-size: 1.5rem;
    color: #0f172a;
    font-weight: 700;
    margin-bottom: 5px;
  }
  .card-header h4 {
    font-size: 1.05rem;
    color: #64748b;
    margin-bottom: 20px;
    font-weight: 500;
  }
  
  .price-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #f8fafc;
    border-radius: 16px;
    padding: 15px;
  }
  
  .price-type {
    font-size: 0.85rem;
    text-transform: uppercase;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.5px;
  }
  .price-type.lifetime {
    color: #ec4899;
    margin-top: 10px;
  }
  
  .price-box {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    color: #0f172a;
  }
  .currency {
    font-size: 1.2rem;
    font-weight: 600;
  }
  .amount {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -1px;
  }
  .period {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 500;
  }
  .lifetime-amt {
    font-size: 1.8rem;
    color: #0f172a;
    background: linear-gradient(135deg, #0f172a, #334155);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Features List */
  .features-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 30px;
  }
  .feature-item {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    color: #334155;
    padding-bottom: 12px;
    border-bottom: 1px dashed #e2e8f0;
  }
  .feature-item:last-child {
    border-bottom: none;
  }
  .feature-item.disabled {
    opacity: 0.4;
    text-decoration: line-through;
  }
  .feature-item.highlight {
    font-weight: 600;
    color: #0f172a;
  }
  .feature-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .feature-icon {
    font-size: 1.1rem;
    width: 24px;
    text-align: center;
  }

  /* Accordion Sub Features */
  .sub-features {
    margin-top: 8px;
    padding-left: 34px;
  }
  .sub-features summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: #4f46e5;
    font-weight: 600;
    list-style: none;
    transition: color 0.2s;
  }
  .sub-features summary:hover {
    color: #3730a3;
  }
  .sub-features summary::-webkit-details-marker {
    display: none;
  }
  .sub-items-content {
    margin-top: 10px;
    font-size: 0.85rem;
    color: #475569;
    padding: 12px;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }
  .sub1 {
    margin-bottom: 8px;
  }
  .sub1 strong {
    color: #334155;
    display: block;
    margin-bottom: 4px;
  }
  .sub2-list {
    padding-left: 15px;
    margin: 0;
    list-style-type: disc;
    color: #64748b;
  }

  /* Footer & Button */
  .card-footer {
    margin-top: auto;
  }
  .btn-action {
    display: block;
    width: 100%;
    text-align: center;
    padding: 16px 20px;
    background: #0f172a;
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
  }
  .pricing-card.featured .btn-action {
    background: linear-gradient(135deg, #4f46e5, #ec4899);
    box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4);
  }
  .btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }
  .pricing-card.featured .btn-action:hover {
    box-shadow: 0 8px 25px rgba(79, 70, 229, 0.6);
  }
  
  /* Info Box */
  .info-box-container {
    margin-top: 50px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.02);
  }
  .info-icon {
    font-size: 2rem;
    line-height: 1;
  }
  .info-content {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
  }
  .info-content strong {
    color: #ec4899;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pricing-card.featured {
      transform: scale(1);
    }
    .pricing-card.featured:hover {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    .pricing-card {
      padding: 30px 20px;
    }
    .info-box-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
