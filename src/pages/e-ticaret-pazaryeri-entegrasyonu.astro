---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Hero Section - Turuncu/Koyu Mavi -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <span class="hero-badge">🚀 E-Ticaret Dönüşümü</span>
          <h1>Pazaryeri Entegrasyonu İçin Aracı Firmalara Ek Ücret Ödemeye <span class="highlight">SON!</span></h1>
          <p class="hero-subtitle">{pageDescription}</p>
          
          <div class="hero-stats">
            {statistics.map((stat, index) => (
              <div class="stat-item" key={index}>
                <div class="stat-icon">{stat.icon}</div>
                <div class="stat-number">{stat.number}</div>
                <div class="stat-label">{stat.label}</div>
              </div>
            ))}
          </div>
          
          <div class="hero-buttons">
            <a 
              href="https://wa.me/+905325000999?text=Merhaba,%20Pazaryeri%20Entegrasyon%20Sistemi%20demo%20talep%20ediyorum" 
              class="btn btn-primary btn-large"
              target="_blank"
              rel="noopener noreferrer"
            >
              🛒 Ücretsiz Demo İste
            </a>
            <a 
              href="tel:+905325000999" 
              class="btn btn-secondary btn-large"
            >
              📞 Hemen Ara: 0532 500 09 99
            </a>
          </div>
          
          <div class="hero-features">
            <div class="feature">
              <span class="feature-icon">🤖</span>
              <span>Otomatik Senkron</span>
            </div>
            <div class="feature">
              <span class="feature-icon">🔒</span>
              <span>Güvenli API</span>
            </div>
            <div class="feature">
              <span class="feature-icon">💳</span>
              <span>Komisyon Yok</span>
            </div>
            <div class="feature">
              <span class="feature-icon">⚡</span>
              <span>Anlık Güncelleme</span>
            </div>
          </div>
        </div>
        
        <div class="hero-image">
          <div class="marketplace-dashboard">
            <div class="dashboard-header">
              <div class="dashboard-title">
                <span class="title-icon">📊</span>
                <span>Pazaryeri Kontrol Paneli</span>
              </div>
              <div class="dashboard-period">Bugün: 12 Ağustos</div>
            </div>
            
            <div class="order-summary">
              <div class="summary-card">
                <div class="summary-label">Toplam Sipariş</div>
                <div class="summary-value">48</div>
                <div class="summary-trend success">↑ %15</div>
              </div>
              <div class="summary-card">
                <div class="summary-label">Bekleyen Sipariş</div>
                <div class="summary-value">12</div>
                <div class="summary-trend warning">⏳ İşlemde</div>
              </div>
              <div class="summary-card">
                <div class="summary-label">Hatalı Sipariş</div>
                <div class="summary-value">2</div>
                <div class="summary-trend danger">⚠️ Hata</div>
              </div>
            </div>
            
            <div class="platform-status">
               <div class="platform-item">
                <span class="platform-icon">🟢</span>
                <span class="platform-name">Trendyol</span>
                <span class="platform-orders">7 sipariş</span>
              </div>
              <div class="platform-item">
                <span class="platform-icon">🟢</span>
                <span class="platform-name">Amazon</span>
                <span class="platform-orders">12 sipariş</span>
              </div>
              <div class="platform-item">
                <span class="platform-icon">🟢</span>
                <span class="platform-name">Hepsiburada</span>
                <span class="platform-orders">8 sipariş</span>
              </div>
              <div class="platform-item">
                <span class="platform-icon">🟡</span>
                <span class="platform-name">N11</span>
                <span class="platform-orders">3 sipariş</span>
              </div>
             
            </div>
            
            <div class="urgent-alerts">
              <div class="alert-icon">⚡</div>
              <div class="alert-text">2 üründe stok kritik seviyede (≤5 adet)</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       DESTEKLENEN PAZARYERLERİ & ÇOK KANALLI E-TİCARET ALTYAPILARI
       ========================================== -->
  <section id="desteklenen-pazaryerleri" class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
    <div class="container mx-auto px-4 max-w-7xl">
      
      <!-- Section Header -->
      <div class="text-center max-w-4xl mx-auto mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-orange-100 text-orange-800 border border-orange-200 mb-4">
          🌐 Çok Kanallı Satış & Entegrasyon Ekosistemi
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          Desteklenen Pazaryerleri ve <span class="bg-gradient-to-r from-orange-600 via-amber-600 to-blue-600 bg-clip-text text-transparent">E-Ticaret Altyapıları</span>
        </h2>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed max-w-3xl mx-auto">
          Aracı entegratör komisyonlarına son! 10 büyük pazaryeri ve 6 popüler e-ticaret altyapısıyla doğrudan API bağlantısı; ortak stok havuzu, otomatik fatura ve tek tıkla kargo barkodu.
        </p>

        <!-- Bilgilendirme Notu: Ürünler ekranı "P" butonu -->
        <div class="mt-6 p-4 sm:p-5 rounded-2xl bg-blue-50/90 border border-blue-200/80 text-left flex items-start gap-3.5 shadow-sm max-w-3xl mx-auto">
          <span class="text-2xl shrink-0 p-2 bg-white rounded-xl shadow-xs border border-blue-100">💡</span>
          <div>
            <h4 class="text-sm font-bold text-blue-950 mb-1">
              Pazaryeri Eşleşme & Yönetim Paneli Kolaylığı
            </h4>
            <p class="text-xs sm:text-sm text-blue-900/90 leading-relaxed">
              Stok Pratik <strong>Ürünler (/urunler)</strong> ekranındaki <strong>"P" (Pazaryeri)</strong> butonuna ve <strong>E-Ticaret & Pazaryeri</strong> modülüne tıklayarak tüm bu kanallar arasında tek tıkla ürün yayını, fiyat eşitlemesi ve kritik emniyet stoğu korumasını anında aktif edebilirsiniz.
            </p>
          </div>
        </div>
      </div>

