    points: [
      "Pazaryeri Komisyon, Kargo & Net Cep Karı Simülatörü",
      "Tek Tıkla Toplu e-Fatura/e-Arşiv & Otomatik PDF İletimi",
      "Ortak Kargo Barkodu (ZPL / PDF Etiket Basımı)",
      "20 Dakikada Otomatik Çift Yönlü Stok & Fiyat Eşitleme"
    ],
    detailUrl: "/urunler/e-ticaretpratik",
    portalUrl: "https://erp-eticaret.stokpratik.com.tr/ticaretpratik",
    image: "/images/ekosistem/eticaret_lojistik_uretim_portallari_hero_1793942246499.jpg",
    theme: {
      gradient: "from-amber-600 to-yellow-600",
      border: "border-yellow-200",
      badge: "bg-amber-500/10 text-amber-400 border-amber-500/20"
