---
// src/pages/urunler/finanspratik.astro - FinansPratik Tanıtım Sayfası (5 Modül 1 Arada)
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = [
  {
    num: "1",
    name: "BankaPratik",
    badge: "AÇIK BANKACILIK (102)",
    icon: "🏦",
    title: "25 Banka Canlı Ekstre & Otomatik Cari Eşleştirme",
    desc: "Türkiye'deki 25 bankada bulunan TL, USD, EUR ve Altın hesaplarınızı tek ekranda konsolide eder. Gelen EFT/Havale/FAST hareketini gönderici IBAN veya VKN bilgisinden otomatik tanır, cari hesabına tahsilat olarak işler ve açık faturayı kapatır. Mali müşaviriniz için 102 Bankalar muhasebe fişini tek tıkla hazırlar."
  },
  {
    num: "2",
    name: "TahsilatRobotu",
    badge: "36 SANAL POS + OTONOM ROBOT",
    icon: "🔔",
    title: "Vade Hatırlatma & 3D Linkle Otonom Tahsilat",
    desc: "Vadesi yaklaşan veya geciken cari alacaklarınızı her sabah otomatik tarar. 3 farklı iletişim tonuyla (Kibar, Resmi, Acil) müşterinize WhatsApp, SMS veya E-Posta üzerinden güncel bakiye bilgisini ve içinde 3D Secure Kredi Kartıyla Ödeme Linki bulunan mesajı otomatik iletir."
  },
  {
    num: "3",
    name: "POSPratik",
    badge: "KOMİSYON & VALÖR RADARI",
    icon: "💳",
    title: "POS Valör Takvimi & Banka Komisyon Kesintisi Denetçisi",
    desc: "Fiziki yazarkasa POS ve Sanal POS çekimlerinizin kuruşu kuruşuna hangi gün hesaba geçeceğini (Valör/Bloke Takvimi) gösterir. Bankanın sizinle anlaştığı komisyon oranı (örn. %1.89) ile fiilen kestiği oranı (örn. %2.65) karşılaştırarak sözleşme dışı fazla kesilen komisyonları kırmızı alarmla raporlar."
  },
  {
    num: "4",
    name: "ÖdemePratik",
    badge: "TOPLU ÖDEME & MAAŞ",
    icon: "💸",
    title: "Toplu Tedarikçi EFT/FAST & Personel Maaş Ödeme Merkezi",
    desc: "Vadesi gelen onlarca tedarikçi faturasını ve ay sonu personel maaş listesini tek tek bankaya girmek yerine tek listede toplar. Seçtiğiniz ödemeleri banka toplu EFT/FAST ödeme dosyasına veya Açık Bankacılık Ödeme Başlatma (ÖBH) emrine dönüştürür; ödemeyi onayladığınız anda tedarikçi carilerinden otomatik düşer."
  },
  {
    num: "5",
    name: "NakitPratik & e-DBS",
    badge: "HAZİNE & LİKİDİTE SİMÜLATÖRÜ",
    icon: "📊",
    title: "Bayi Doğrudan Borçlandırma & 30/60/90 Günlük Likidite",
    desc: "Bayilerinizin bankalardaki e-DBS (Doğrudan Borçlandırma Sistemi) kredi limitlerini canlı sorgular; kestiğiniz faturayı vadesinde banka garantisiyle tahsil etmenizi sağlar. Mevcut nakit + beklenen valörler + müşteri çeklerini, tedarikçi borçları + çekler + maaş/SGK giderleriyle çarpıştırarak ay sonu net nakit açığını veya fazlasını önceden simüle eder."
  }
];

const faqs = [
  {
    q: "Banka hesap bilgilerim ve şifrelerim güvende mi?",
    a: "Evet, %100 güvendedir. FinansPratik, TCMB (Türkiye Cumhuriyet Merkez Bankası) Açık Bankacılık lisanslı altyapılar ve bankaların resmi BKM Açık Bankacılık protokolleri üzerinden çalışır. Hesap şifreniz hiçbir zaman kaydedilmez, sadece read-only (okuma) ve onaylı transfer yetkisiyle çalışır."
  },
  {
    q: "WhatsApp TahsilatRobotu mesajları benim adıma mı gönderir?",
    a: "Evet! Mesajlar şirketinizin kurumsal WhatsApp Business hattı üzerinden veya kurumsal SMS başlığınızla iletilir. İletişim tonunu (Kibar hatırlatma, Resmi bakiye bildirimi, İcra öncesi acil uyarı) cari bazında siz seçersiniz."
  },
  {
    q: "Tek bir modülü (örneğin sadece BankaPratik) kiralayabilir miyim?",
    a: "Evet, FinansPratik tamamen modülerdir. İhtiyacınıza göre sadece BankaPratik veya sadece TahsilatRobotu'nu seçebilirsiniz. Ancak FinansPratik FULL (5 Modül Birden) paketini seçtiğinizde 5 ürün tek fiyata %30 indirimli olarak tanımlanır."
  }
];
---

<BaseLayout
  title="FinansPratik | Açık Bankacılık, TahsilatRobotu, POS Komisyon Denetçisi & e-DBS — StokPratik"
  description="25 bankadaki hesaplarınızı tek ekranda birleştirin, gelen EFT/FAST ödemelerini cari hesaplara otomatik işleyin, WhatsApp TahsilatRobotu ile alacaklarınızı toplayın ve banka POS komisyon kesintilerini denetleyin."
>
  <main class="min-h-screen bg-slate-950 text-slate-100 selection:bg-emerald-500 selection:text-slate-950 pb-24">
    
    {/* HERO BÖLÜMÜ */}
    <section class="relative pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-slate-800 overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[850px] h-[380px] bg-gradient-to-b from-emerald-500/15 via-teal-600/10 to-transparent blur-3xl pointer-events-none"></div>

      <div class="container mx-auto px-4 max-w-6xl relative z-10">
        
        <div class="flex items-center gap-2 mb-6">
          <a href="/pratik-ekosistemi" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 transition-colors">
            ← Pratik Ekosistemi Ana Sayfası
          </a>
          <span class="text-slate-600">•</span>
          <span class="text-xs text-slate-400">Departman Çözümü 03 (Amiral Finans Üssü)</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-bold shadow-sm mb-5">
              <span>💎</span>
              <span>5 FİNANSAL MODÜL 1 ARADA • TCMB AÇIK BANKACILIK UYUMLU</span>
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
              FinansPratik: Şirketinizin Tüm Bankalarını, POS Valörlerini ve Alacak Tahsilatını Otomatiğe Bağlayan Hazine Üssü
            </h1>

            <p class="mt-5 text-slate-300 text-sm sm:text-base lg:text-lg leading-relaxed">
              Tek tek internet bankacılığına girip dekont aramaya, vadesi geçen alacaklar için telefon açmaya ve bankaların gizli POS komisyon kesintilerine son! İster tek modül seçin, ister <strong class="text-white">FinansPratik FULL (5 Modül Birden — 5 Ürün Tek Fiyat ile %30 İndirimli)</strong> Yıllık Ödeme avantajıyla kullanın.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/finanspratik"
                target="_blank"
                rel="noopener noreferrer"
                class="px-7 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-sm sm:text-base shadow-lg shadow-emerald-500/25 transition-all hover:scale-105 flex items-center gap-2"
              >
                <span>💎 FinansPratik Portala Gir</span>
                <span class="text-lg">↗</span>
              </a>

              <button 
                type="button"
                class="open-request-modal px-6 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm sm:text-base border border-slate-700 transition-all hover:border-emerald-500/50 cursor-pointer"
                data-package="FinansPratik FULL (5 Modül Birden) Yıllık Ödeme"
              >
                💎 Lisans & Paket Talebi Oluştur
              </button>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900">
              <img 
                src="/images/ekosistem/finanspratik_acik_bankacilik_hero_1793942210288.jpg" 
                alt="FinansPratik Açık Bankacılık Arayüz Görseli"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* 5 BAĞIMSIZ GÜÇ MODÜLÜ (CAROUSEL / GRID) */}
    <section class="py-16 sm:py-24 bg-slate-900/60 border-b border-slate-800">
      <div class="container mx-auto px-4 max-w-6xl">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Hazine & Likidite Üssü</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-1">
            FinansPratik İçindeki 5 Bağımsız Güç Modülü
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm mt-2">
            Her biri kendi alanında uzmanlaşmış, ister bağımsız ister tek çatı altında çalışan 5 kurumsal finansal araç.
          </p>
        </div>

        <div class="space-y-8">
          {modules.map((m) => (
            <div class="p-6 sm:p-8 rounded-3xl bg-slate-900 border border-slate-800 hover:border-emerald-500/40 transition-all relative overflow-hidden">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-2xl shrink-0">
                    {m.icon}
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono text-emerald-400 font-bold">{m.num}. Modül</span>
                      <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                        {m.badge}
                      </span>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-white mt-0.5">
                      {m.name} — {m.title}
                    </h3>
                  </div>
                </div>

                <button 
                  type="button"
                  class="open-request-modal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-400 font-bold text-xs border border-slate-700 transition-colors shrink-0 self-start md:self-auto cursor-pointer"
                  data-package={`${m.name} Tek Modül Lisansı`}
                >
                  Bu Modülü Seç →
                </button>
              </div>

              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed pl-0 md:pl-15">
                {m.desc}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* ÖZEL LİSANSLAMA KARTI: FinansPratik FULL */}
    <section class="py-16 sm:py-20 bg-slate-900">
      <div class="container mx-auto px-4 max-w-4xl">
        
        <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 border-2 border-emerald-500/50 shadow-2xl text-center relative overflow-hidden">
          
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 font-black text-xs uppercase tracking-wider mb-4 border border-emerald-500/30">
            💎 TAVSİYE EDİLEN AVANTAJLI PAKET
          </span>

          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            FinansPratik FULL (5 Modül Birden)
          </h2>
          <p class="text-base sm:text-xl font-bold text-emerald-400 mt-2">
            5 Ürün Tek Fiyat ile %30 İndirimli kullanın
          </p>

          <p class="text-slate-300 text-xs sm:text-sm mt-4 max-w-2xl mx-auto leading-relaxed">
            BankaPratik + TahsilatRobotu + POSPratik + ÖdemePratik + NakitPratik & e-DBS paketini tek lisansla ve Yıllık Ödeme avantajıyla hemen devreye alın.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
            <button 
              type="button"
              class="open-request-modal px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-sm sm:text-base shadow-xl shadow-emerald-500/30 transition-all hover:scale-105 cursor-pointer"
              data-package="FinansPratik FULL (5 Modül Birden) Yıllık Ödeme"
            >
              💎 Lisans & Paket Talebi Oluştur
            </button>

            <a 
              href="https://erp-eticaret.stokpratik.com.tr/finanspratik"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm border border-slate-700 transition-colors flex items-center justify-center gap-2"
            >
              <span>Portala Giriş Yap</span>
              <span>↗</span>
            </a>
          </div>

          <div class="mt-4 text-[11px] text-slate-400">
            Yıllık ödeme periyodu seçildiğinde tüm TCMB ve banka API entegrasyon kurulumları ücretsiz sağlanır.
          </div>
        </div>

      </div>
    </section>

    {/* SSS BÖLÜMÜ */}
    <section class="py-16 sm:py-20 border-t border-slate-800">
      <div class="container mx-auto px-4 max-w-4xl">
        
        <div class="text-center mb-12">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Sıkça Sorulan Sorular</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
            FinansPratik Hakkında Merak Edilenler
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
              <h3 class="text-base font-bold text-white mb-2">
                {faq.q}
              </h3>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* MODAL */}
    <div id="productModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative text-left">
        <button id="closeProdModalBtn" type="button" class="absolute top-5 right-5 text-slate-400 hover:text-white text-xl p-1">
          ✕
        </button>
        <h3 class="text-xl font-extrabold text-white mb-2">FinansPratik Lisans Talebi</h3>
        <p class="text-xs text-slate-400 mb-6">Yetkili satış temsilcimiz 15 dakika içinde sizinle iletişime geçecektir.</p>
        <form id="prodReqForm" class="space-y-4">
          <input type="text" required id="pName" placeholder="Adınız Soyadınız *" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-emerald-500" />
          <input type="tel" required id="pPhone" placeholder="Telefon Numaranız *" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-emerald-500" />
          <input type="email" required id="pEmail" placeholder="Firma E-Posta Adresiniz *" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-emerald-500" />
          <div id="pFeedback" class="hidden text-xs p-3 rounded-xl"></div>
          <button type="submit" id="pSubmitBtn" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-sm cursor-pointer">Talebi Gönder</button>
        </form>
      </div>
    </div>

  </main>
</BaseLayout>

<script>
  function setupProductModal() {
    const modal = document.getElementById('productModal');
    const openBtns = document.querySelectorAll('.open-request-modal');
    const closeBtn = document.getElementById('closeProdModalBtn');
    const form = document.getElementById('prodReqForm') as HTMLFormElement;
    const feedback = document.getElementById('pFeedback');
    const submitBtn = document.getElementById('pSubmitBtn') as HTMLButtonElement;

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.textContent = 'İletiliyor...';

      const name = (document.getElementById('pName') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('pPhone') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('pEmail') as HTMLInputElement)?.value || '';

      try {
        await fetch('/api/campaign/extend-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, package: 'FinansPratik FULL', timestamp: new Date().toISOString() })
        }).catch(() => null);
      } catch (err) {}

      if (feedback) {
        feedback.className = 'text-xs p-3 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 block';
        feedback.textContent = '✅ Talebiniz alınmıştır! Lisans ve paket talebiniz Süperadmin ekranına başarıyla iletildi.';
      }

      submitBtn.disabled = false;
      submitBtn.textContent = 'Talebiniz Alındı ✓';

      setTimeout(() => {
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
        form.reset();
        submitBtn.textContent = 'Talebi Gönder';
      }, 2500);
    });
  }

  document.addEventListener('DOMContentLoaded', setupProductModal);
  document.addEventListener('astro:page-load', setupProductModal);
</script>
