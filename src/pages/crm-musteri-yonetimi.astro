---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "CRM ve Müşteri İlişkileri Yönetimi | Stok Pratik";
const pageDescription = "Potansiyel müşteri takibi, satış fırsatları, teklif yönetimi ve otomatik hatırlatmalar. Satış ekibinizin verimliliğini artıran bulut CRM yazılımı.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 text-slate-800 antialiased">
    
    <!-- HERO -->
    <section class="relative overflow-hidden bg-gradient-to-b from-cyan-950 to-slate-900 py-20 text-white">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-cyan-300 bg-cyan-950/60 border border-cyan-500/30 rounded-full">
          👥 Satış Gücü & Müşteri İlişkileri
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
          Tekliften Tahsilata:<br class="hidden sm:inline" />
          <span class="text-cyan-400">Tüm Müşteri İletişiminiz Kayıt Altında</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed">
          Potansiyel müşterilerinizi kaçırmayın. Teklif hazırlama, görüşme geçmişi, randevu ve otomatik tahsilat hatırlatmalarını ön muhasebenizle entegre yönetin.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="https://wa.me/+905325000999?text=CRM%20modülü%20için%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold text-lg rounded-xl shadow-lg transition duration-200 text-center">
            CRM Demosu İsteyin
          </a>
          <a href="/fiyatlar" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold text-lg rounded-xl border border-white/20 transition duration-200 text-center">
            Özelleştir / Yapılandır
          </a>
        </div>
      </div>
    </section>

    <!-- CRM MODÜLLERİ -->
    <section class="py-16 bg-white border-b border-slate-200">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">Satış Ekibinizi Güçlendirin</h2>
          <p class="text-slate-600 max-w-2xl mx-auto">Tüm müşteri süreçlerini takip edin, teklifleri saniyeler içinde faturaya dönüştürün.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
            <div class="text-3xl mb-4">🎯</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Fırsat & Aday Takibi</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Gelen talepleri satış hunisinde (pipeline) aşama aşama takip edin, hangi temsilcinin ne aşamada olduğunu izleyin.</p>
          </div>

          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
            <div class="text-3xl mb-4">📄</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Proforma & Teklif Yönetimi</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Özel PDF teklifler hazırlayın. Onaylanan teklifi tek tıkla siparişe ve e-faturaya dönüştürün.</p>
          </div>

          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
            <div class="text-3xl mb-4">⏰</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Akıllı Hatırlatma & SMS</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Vadesi gelen ödemeleri, periyodik abonelik yenilemelerini ve müşteri randevularını otomatik hatırlatın.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-slate-900 text-white text-center">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold mb-4">Müşteri Memnuniyetini ve Satışları Artırın</h2>
        <p class="text-slate-400 mb-8">CRM modülümüzü mevcut ön muhasebenize dahil edin veya CRM+ERP paketimizi seçin.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/paketlerimiz" class="px-8 py-3.5 bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold rounded-xl transition">Paketleri Görüntüle</a>
          <a href="/ozelliklerimiz" class="px-8 py-3.5 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl border border-slate-700 transition">Tüm Özellikler</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
