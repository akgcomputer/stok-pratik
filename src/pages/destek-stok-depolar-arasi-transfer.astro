            <span class="text-slate-400 font-medium hidden">Görsel Yeri: /images/destek/transfer-2.jpg</span>
          </div>
          <!-- Açıklama Alanı -->
          <div class="text-slate-600 text-lg leading-relaxed">
            <p>
              3.Aşama Menüden Mağaza Giden bölümünü seçmek
E-posta gibi düşünebilirsiniz 
(Gelenler transfer edilmiş ürünler, Gidenler bizim Merkez yada mağazamızdan yollayacağımız ürünlerdir.)
            </p>
          </div>
        </div>

        <!-- ADIM 3 -->
        <div class="step-block border-b border-slate-100 pb-12 last:border-0 last:pb-0">
          <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-red-600 text-white text-xl shadow-md shadow-red-600/20">4</span>
            Transfer Listesi
          </h2>
          <!-- Görsel Alanı -->
          <div class="mb-6 bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 flex items-center justify-center min-h-[200px]">
            <!-- Görseli buraya ekleyiniz. Örn: /images/destek/ornek-3.jpg -->
            <img src="/images/destek/transfer-3.jpg" alt="Adım 3 Görseli" class="w-full h-auto object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="text-slate-400 font-medium hidden">Görsel Yeri: /images/destek/transfer-3.jpg</span>
          </div>
          <!-- Açıklama Alanı -->
          <div class="text-slate-600 text-lg leading-relaxed">
            <p>
              Transferlerin listelendiği alanı seçelim
            </p>
          </div>
        </div>

        <!-- ADIM 4 -->
