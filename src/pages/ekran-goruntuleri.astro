  },
  {
    id: 8,
    category: "uretim-depo",
    categoryLabel: "ERP & Üretim",
    badgeColor: "bg-orange-50 text-orange-700 border-orange-200",
    src: "/images/screenshots/StokPratik_erp.png",
    alt: "Stok Pratik ERP Üretim Yönetimi Reçete ve İş Emri Ekranı",
    title: "ERP & İleri Düzey Üretim Yönetimi",
    description: "Hammadde reçeteleri, fire oranları, operasyon adımları, iş emirleri ve fason üretim süreçlerini eksiksiz takip edin.",
    features: [
      "Çok seviyeli ürün ağacı (BOM) ve reçete maliyetlendirme",
