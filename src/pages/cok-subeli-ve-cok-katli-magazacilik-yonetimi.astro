---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Çok Şubeli ve Çok Katlı Mağazacılık Yönetimi | Stok Pratik";
const pageDescription = "Şubeleriniz, katlarınız ve depolarınız arasındaki sınırları kaldırın. Kat bazlı reyon takibi, şubeler arası canlı stok transferi, kasiyer prim ve vardiya sistemi.";

const bentoPowers = [
  {
    icon: "📈",
    title: "Şube Bazlı Net Kârlılık Kıyaslaması",
    desc: "Hangi şubenin kirası, personel gideri ve SMM maliyeti düşüldükten sonra ne kadar net kâr bıraktığını tek ekranda görün.",
    colSpan: "lg:col-span-2",
    accent: "from-blue-600 to-indigo-700"
  },
  {
    icon: "🏷️",
    title: "Merkezi Barkod & Raf Etiketi",
    desc: "Merkezden fiyatı değiştirdiğiniz anda tüm şubelerde yeni raf etiketleri ve Kiosk ekranları aynı saniyede eşitlenir.",
    colSpan: "lg:col-span-1",
    accent: "from-indigo-600 to-purple-600"
  },
  {
    icon: "🛒",
    title: "E-Ticaret ile Ortak veya Ayrık Stok",
    desc: "İster sadece Merkez Depo stoğunuzu Trendyol/Hepsiburada'ya açın, ister tüm şubelerin stoğunu konsolide edin.",
    colSpan: "lg:col-span-1",
    accent: "from-emerald-600 to-teal-700"
  },
  {
    icon: "💳",
    title: "Canlı Kasa & POS Mutabakatı",
    desc: "Gün sonunda her şubenin Nakit, Kredi Kartı, Yemek Kartı ve Açık Hesap tahsilatlarını tek ekranda denetleyin.",
    colSpan: "lg:col-span-2",
    accent: "from-sky-600 to-blue-700"
  },
  {
    icon: "📺",
    title: "Mağaza İçi Ekranlar (Kiosk & TV)",
    desc: "Mağazadaki televizyonları indirim panosuna (Mağaza TV), tabletleri ise fiyat sorgulama cihazına (Fiyat Gör) dönüştürün.",
    colSpan: "lg:col-span-2",
    accent: "from-amber-600 to-orange-700"
  },
  {
    icon: "☁️",
    title: "Sıfır Kurulum, Bulut Özgürlüğü",
    desc: "Pahalı sunucular ve IT masrafları yok; internet olan her bilgisayar, tablet veya dokunmatik POS'tan anında çalışın.",
    colSpan: "lg:col-span-1",
    accent: "from-rose-600 to-pink-700"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-blue-600 selection:text-white">
    
    <!-- 1. HERO SECTION (Dark Modern Glassmorphic / Apple-Shopify Style) -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-blue-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-7 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
              🏪 Temel Ticaret • Çok Şubeli & Çok Katlı Perakende Sistemi
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              İster Tek Mağaza, İster 50 Şube, İster 5 Katlı AVM: <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300">
                Tüm Kasalarınız ve Reyonlarınız Tek Merkezden Canlı Yayında!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-400 max-w-2xl mb-8 leading-relaxed">
              Kadıköy şubenizde hangi ürün satıldı, Merkez mağazanızın 3. katındaki tekstil reyonunda hangi beden bitti, hangi kasiyerin kasasında ne kadar nakit var? Stok Pratik ile şubeleriniz, katlarınız ve depolarınız arasındaki duvarları kaldırın; tüm perakende operasyonunuzu anlık yönetin.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-extrabold rounded-xl shadow-lg shadow-blue-600/30 transition-all transform hover:-translate-y-0.5 text-center text-base">
                🚀 Ücretsiz Mağazanızı Açın & Giriş Yapın
              </a>
              <a href="#senaryolar" class="w-full sm:w-auto px-7 py-4 bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-bold rounded-xl transition-all text-center text-base">
                🏢 Çok Katlı & Çok Şubeli Mimariyi Gör
              </a>
            </div>

            <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <span class="flex items-center gap-1.5"><span class="text-blue-400">✓</span> Sınırsız Kasa & Şube</span>
              <span class="flex items-center gap-1.5"><span class="text-blue-400">✓</span> Şubeler Arası Anlık Transfer</span>
              <span class="flex items-center gap-1.5"><span class="text-blue-400">✓</span> Kat ve Reyon Takibi</span>
            </div>
          </div>

          <!-- Sağ: Canlı Çok Şubeli & Çok Katlı Kontrol Kulesi Mockup'ı -->
          <div class="lg:col-span-5">
            <div class="relative rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 p-6 border border-slate-800 shadow-2xl shadow-blue-950/50 backdrop-blur-xl">
              <!-- Mockup Header -->
              <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-5">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                  <span class="ml-2 text-xs font-bold text-slate-400 tracking-wider uppercase">Merkez Kontrol Kulesi</span>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[11px] font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Canlı Senkron
                </span>
              </div>

              <!-- Şube / Kat Kartları -->
              <div class="space-y-3">
                <!-- Şube 1 -->
                <div class="p-4 rounded-xl bg-slate-900/90 border border-blue-500/30 hover:border-blue-500/60 transition-all">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm text-white flex items-center gap-2">
                      <span class="text-blue-400">📍</span> Merkez Mağaza (4 Katlı)
                    </span>
                    <span class="text-xs px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 font-bold">6 Kasa Aktif</span>
                  </div>
                  <div class="flex items-baseline justify-between text-xs text-slate-400 mt-2">
                    <span>Zemin + 3 Kat + Ana Depo</span>
                    <span class="text-sm font-black text-emerald-400">184.500 ₺</span>
                  </div>
                </div>

                <!-- Şube 2 -->
                <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition-all">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm text-white flex items-center gap-2">
                      <span class="text-indigo-400">📍</span> AVM Şubesi (2. Kat Reyonu)
                    </span>
                    <span class="text-xs px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-bold">3 Kasa Aktif</span>
                  </div>
                  <div class="flex items-baseline justify-between text-xs text-slate-400 mt-2">
                    <span>Kadın & Çocuk Reyonları</span>
                    <span class="text-sm font-black text-emerald-400">92.300 ₺</span>
                  </div>
                </div>

                <!-- Şube 3 -->
                <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition-all">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm text-white flex items-center gap-2">
                      <span class="text-sky-400">📍</span> Cadde Şubesi (Zemin + Alt Kat)
                    </span>
                    <span class="text-xs px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-bold">2 Kasa Aktif</span>
                  </div>
                  <div class="flex items-baseline justify-between text-xs text-slate-400 mt-2">
                    <span>Hızlı Satış + Depo Transfer</span>
                    <span class="text-sm font-black text-emerald-400">64.150 ₺</span>
                  </div>
                </div>
              </div>

              <!-- Canlı Akan Bildirim Bandı -->
              <div class="mt-4 pt-3 border-t border-slate-800/80">
                <div class="flex items-center gap-2 text-[11px] text-slate-400 bg-slate-950/70 p-2.5 rounded-lg border border-slate-800">
                  <span class="text-amber-400">⚡</span>
                  <span class="truncate">AVM Şubesi Kasa-2'den 1.450 ₺ satış yapıldı • 🔄 Merkezden Caddeye 50 adet transfer edildi</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. ETKİLEŞİMLİ 3 SEKME: ÇOK KATLI VE ÇOK ŞUBELİ SENARYOLAR -->
    <section id="senaryolar" class="py-24 bg-slate-900/50 border-b border-slate-800 relative">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-blue-400 font-bold uppercase tracking-wider text-xs">Gerçek Hayat Senaryoları</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
            Perakendenin Her Katında ve Her Şubesinde Kusursuz İşleyiş
          </h2>
          <p class="text-slate-400 mt-3 text-base">
            Büyük mağazaların ve zincir markaların günlük operasyonlarına özel olarak geliştirilmiş modüler mimari.
          </p>
        </div>

        <!-- 3 Kart / Sekmeli Vitrin -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Senaryo 1: Çok Katlı Mağazalar -->
          <div class="rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 p-8 border border-slate-800 hover:border-blue-500/50 transition-all flex flex-col justify-between shadow-xl group">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform">
                🏢
              </div>
              <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">Senaryo A</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-3">Çok Katlı Büyük Mağazalar</h3>
              <p class="text-sm font-semibold text-slate-300 mb-4">
                Katlar Arası Koşturmacaya Son: Her Kat Bağımsız, Merkezde Tek Bütün!
              </p>
              <ul class="space-y-3 text-xs text-slate-400">
                <li class="flex items-start gap-2">
                  <span class="text-blue-400 font-bold">✓</span>
                  <span><strong>Kat & Reyon Stoğu:</strong> Zemin kattaki personel, ürünün 2. katta mı yoksa bodrum ana depoda mı olduğunu ekrandan anında görür.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-400 font-bold">✓</span>
                  <span><strong>Kat Bazlı Kasa & Z Raporu:</strong> 1. kat çocuk reyonu ile 2. kat ev tekstili kasasını ayrı tanımlayın; reyon cirolarını kıyaslayın.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-400 font-bold">✓</span>
                  <span><strong>Katlar Arası Transfer:</strong> Üst katta tükenen ürün için alt depoya tek tıkla reyon besleme emri gönderin.</span>
                </li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80">
              <span class="text-xs text-blue-400 font-semibold">AVM ve Katlı Mağazalar İçin İdeal →</span>
            </div>
          </div>

          <!-- Senaryo 2: Çok Şubeli Zincir Mağazalar -->
          <div class="rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 p-8 border border-slate-800 hover:border-indigo-500/50 transition-all flex flex-col justify-between shadow-xl group">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform">
                🌐
              </div>
              <span class="text-xs font-bold text-indigo-400 uppercase tracking-wider">Senaryo B</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-3">Çok Şubeli Zincir Mağazalar</h3>
              <p class="text-sm font-semibold text-slate-300 mb-4">
                "Bizde Kalmadı Ama Yan Şubede 3 Adet Var!" Diyebilen Akıllı Sistem.
              </p>
              <ul class="space-y-3 text-xs text-slate-400">
                <li class="flex items-start gap-2">
                  <span class="text-indigo-400 font-bold">✓</span>
                  <span><strong>Canlı Şube Stoğu:</strong> Müşteriyi asla eli boş göndermeyin; diğer şubenin stoğunu görün ve transfer fişi kesin.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-indigo-400 font-bold">✓</span>
                  <span><strong>Şubeye Özel Fiyat:</strong> Cadde şubesi ile AVM şubesine dilerseniz ortak merkez fiyatı, dilerseniz özel kampanya tanımlayın.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-indigo-400 font-bold">✓</span>
                  <span><strong>Tek Tıkla Mal Dağıtımı:</strong> Merkeze gelen 1.000 adet ürünü satış hızlarına göre şube depolarına paylaştırın.</span>
                </li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80">
              <span class="text-xs text-indigo-400 font-semibold">Zincir Perakende İçin İdeal →</span>
            </div>
          </div>

          <!-- Senaryo 3: Personel Prim ve Vardiya -->
          <div class="rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 p-8 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between shadow-xl group">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform">
                👥
              </div>
              <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Senaryo C</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-3">Kasiyer, Prim & Vardiya</h3>
              <p class="text-sm font-semibold text-slate-300 mb-4">
                Hangi Danışman Ne Kadar Sattı? Otomatik Prim ve Kasa Devir Kalkanı!
              </p>
              <ul class="space-y-3 text-xs text-slate-400">
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Ürün Bazlı Satış Primi:</strong> Satışı yapan tezgahtarı seçin; sistem ürünün prim oranını (%) otomatik hak edişe eklesin.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Kasiyer Yetki Kalkanı:</strong> Kasiyer alış maliyetini göremez, yetkisi dışında iskonto yapamaz, fiş silemez.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Vardiya Kasa Devri:</strong> Vardiya değişiminde kasadaki nakit sayımı yapılır; kasa açığı veya fazlası anında raporlanır.</span>
                </li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80">
              <span class="text-xs text-emerald-400 font-semibold">Personel Yönetimi İçin İdeal →</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. ASİMETRİK BENTO GRID: 6 SÜPER GÜÇ -->
    <section class="py-24 bg-slate-950">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-blue-400 font-bold uppercase tracking-wider text-xs">Yüksek Performans</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
            Mağazacılık Ekosisteminin 6 Süper Gücü
          </h2>
          <p class="text-slate-400 mt-3 text-base">
            Geleneksel hantal masaüstü yazılımlarının aksine, modern bulut mimarisiyle sıfır donanım yatırımıyla büyüyün.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {bentoPowers.map((item) => (
            <div class={`${item.colSpan} p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between relative overflow-hidden group`}>
              <div class="relative z-10">
                <span class="text-3xl mb-4 block">{item.icon}</span>
                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
              </div>
              <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-gradient-to-br opacity-5 group-hover:opacity-10 transition-opacity rounded-full blur-2xl pointer-events-none"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. ALT KAPANIŞ ÇAĞRISI (BOTTOM CTA) -->
    <section class="py-24 bg-gradient-to-b from-slate-900 via-blue-950 to-slate-950 text-white text-center relative overflow-hidden border-t border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
      
      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-3xl">
        <span class="inline-block px-4 py-1.5 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-bold uppercase tracking-wider mb-4">
          Sıfır Kurulum Maliyeti
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 text-white">
          Tek Mağazadan Zincir Mağazaya Uzanan Yolculuğunuzda Stok Pratik Yanınızda!
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Hiçbir kurulum ücreti ödemeden hemen ücretsiz hesabınızı açın, şubelerinizi ve kasalarınızı bugün tanımlayarak yönetmeye başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="w-full sm:w-auto px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-extrabold rounded-xl shadow-xl shadow-blue-600/30 transition-all text-center">
            🚀 Hemen Giriş Yapın & Başlayın
          </a>
          <a href="/firma-kaydi" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold rounded-xl transition-all text-center">
            🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
