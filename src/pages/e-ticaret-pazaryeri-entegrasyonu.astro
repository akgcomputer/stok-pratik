---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/variables.css';
import '../styles/global.css';
import '../styles/components.css';

const pageTitle = "E-Ticaret Pazaryeri Entegrasyon Programı | Stok Pratik";
const pageDescription =
  "Trendyol, Hepsiburada, N11 ve Amazon siparişlerinizi tek panelden yönetin. Aracı entegrasyon firmasına gerek kalmadan e-fatura ve stok takibini otomatikleştirin.";

// Özellikler
const features = [
  {
    icon: "🔄",
    title: "Otomatik Stok Senkronizasyonu",
    description: "Tüm pazaryerlerindeki stoklarınız tek merkezden saniyeler içinde güncellenir.",
    details: [
      "Anlık stok güncelleme",
      "Çapraz platform senkronizasyonu",
      "Varyant bazlı güncelleme",
      "Stok uyarıları"
    ]
  },
  {
    icon: "🔗",
    title: "Doğrudan API Bağlantısı",
    description: "Aracı firmalara ek ücret ödemeden Trendyol, Hepsiburada gibi platformlara doğrudan bağlanın.",
    details: [
      "API anahtar yönetimi",
      "Otomatik token yenileme",
      "Hata logları",
      "Bağlantı test aracı"
    ]
  },
  {
    icon: "📄",
    title: "Tek Tıkla e-Fatura",
    description: "Gelen pazaryeri siparişlerinizi tek tıkla e-Faturaya dönüştürün ve müşteriye iletin.",
    details: [
      "Otomatik fatura oluşturma",
      "e-Arşiv/e-Fatura seçeneği",
      "Toplu fatura kesimi",
      "Müşteriye e-posta gönderimi"
    ]
  },
  {
    icon: "📦",
    title: "Toplu Kargo Barkodu",
    description: "Siparişlerinize ait kargo fişlerini ve faturaları tek seferde toplu olarak yazdırın.",
    details: [
      "Toplu barkod yazdırma",
      "Kargo firması entegrasyonu",
      "Otomatik kargo takip no",
      "Excel/PDF dökümü"
    ]
  },
  {
    icon: "🎨",
    title: "Varyantlı Ürün Yönetimi",
    description: "Renk, beden ve numara gibi farklı varyantları pazaryerlerinde hatasız eşleştirin.",
    details: [
      "Renk/beden eşleştirme",
      "Otomatik varyant oluşturma",
      "Stok sayımı",
      "Görsel yönetimi"
    ]
  },
  {
    icon: "🏪",
    title: "B2B Toptan Portal Entegresi",
    description: "Pazaryeri siparişlerinizi ve B2B toptan satışlarınızı tek bir havuzda birleştirin.",
    details: [
      "Kombine sipariş yönetimi",
      "Ortak stok havuzu",
      "Fatura birleştirme",
      "Raporlama"
    ]
  }
];

// Karşılaştırma
const comparison = {
  old: {
    title: "Geleneksel Entegrasyon Firmaları",
    icon: "💰",
    items: [
      "Aylık veya sipariş başı ek ücretler",
      "Destek almak için saatlerce beklemek",
      "Sadece entegrasyon (Muhasebesiz)",
      "Karmaşık eşleştirme süreçleri"
    ]
  },
  new: {
    title: "Stok Pratik Entegrasyonu",
    icon: "🚀",
    items: [
      "Ek kontör veya sipariş başı ücret YOK",
      "Ön muhasebe ve depo ile tam entegre",
      "Varyant (Renk/Beden) duyarlı stok",
      "Ücretsiz 7/24 kesintisiz destek"
    ]
  }
};

// Adımlar
const steps = [
  {
    step: 1,
    title: "API Bilgilerini Girin",
    description: "Pazaryeri panellerinizden aldığınız API anahtarlarını sisteme bir kez kaydedin.",
    icon: "🔑"
  },
  {
    step: 2,
    title: "Ürünleri Eşleştirin",
    description: "Sistem, pazaryerindeki ürünlerinizle Stok Pratik içindeki stokları otomatik eşleştirir.",
    icon: "🔗"
  },
  {
    step: 3,
    title: "Arkanıza Yaslanın",
    description: "Gelen siparişler onaylansın, stoklar düşsün ve e-faturalar otomatik kesilsin.",
    icon: "😎"
  }
];

// İstatistikler
const statistics = [
  { number: "%100", label: "Stok Tutarlılığı", icon: "📊" },
  { number: "%60", label: "Zaman Tasarrufu", icon: "⏱️" },
  { number: "%80", label: "Hata Azalması", icon: "✅" },
  { number: "7/24", label: "Otomatik Senkron", icon: "🌐" }
];

// SSS
const faqs = [
  {
    question: "Hangi pazaryerleri ile entegrasyonunuz var?",
    answer: "Şu anda Trendyol, Hepsiburada, N11, Çiçeksepeti, PttAVM ve Amazon ile tam entegre çalışıyoruz. Ayrıca kendi e-ticaret siteniz (WooCommerce, Shopify) ile de entegre olabilirsiniz."
  },
  {
    question: "Aracı firmalara ek komisyon veya kontör ücreti ödeyecek miyim?",
    answer: "Hayır! Stok Pratik doğrudan API üzerinden iletişim kurduğu için sipariş veya fatura başına ek bir entegratör ücreti ödemezsiniz."
  },
  {
    question: "Varyantlı ürünlerde stoklar nasıl güncelleniyor?",
    answer: "Renk ve beden gibi varyantlarınız için barkod eşleştirmesi yapılır. Herhangi bir pazaryerinde satış olduğunda diğer tüm platformlardaki varyant stokları anında düşülür."
  },
  {
    question: "Birden fazla pazaryerinde aynı ürünü satıyorum, sorun yaşar mıyım?",
    answer: "Hayır, sistem tüm pazaryerlerindeki stokları tek merkezden yönetir. Bir platformda satıldığında diğerlerinde otomatik düşer."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Hero Section - Turuncu/Koyu Mavi -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <span class="hero-badge">🚀 E-Ticaret Dönüşümü</span>
          <h1>Pazaryeri Entegrasyonu İçin Aracı Firmalara Ek Ücret Ödemeye <span class="highlight">SON!</span></h1>
          <p class="hero-subtitle">{pageDescription}</p>
          
          <div class="hero-stats">
            {statistics.map((stat, index) => (
              <div class="stat-item" key={index}>
                <div class="stat-icon">{stat.icon}</div>
                <div class="stat-number">{stat.number}</div>
                <div class="stat-label">{stat.label}</div>
              </div>
            ))}
          </div>
          
          <div class="hero-buttons">
            <a 
              href="https://wa.me/+905325000999?text=Merhaba,%20Pazaryeri%20Entegrasyon%20Sistemi%20demo%20talep%20ediyorum" 
              class="btn btn-primary btn-large"
              target="_blank"
              rel="noopener noreferrer"
            >
              🛒 Ücretsiz Demo İste
            </a>
            <a 
              href="tel:+905325000999" 
              class="btn btn-secondary btn-large"
            >
              📞 Hemen Ara: 0532 500 09 99
            </a>
          </div>
          
          <div class="hero-features">
            <div class="feature">
              <span class="feature-icon">🤖</span>
              <span>Otomatik Senkron</span>
            </div>
            <div class="feature">
              <span class="feature-icon">🔒</span>
              <span>Güvenli API</span>
            </div>
            <div class="feature">
              <span class="feature-icon">💳</span>
              <span>Komisyon Yok</span>
            </div>
            <div class="feature">
              <span class="feature-icon">⚡</span>
              <span>Anlık Güncelleme</span>
            </div>
          </div>
        </div>
        
        <div class="hero-image">
          <div class="marketplace-dashboard">
            <div class="dashboard-header">
              <div class="dashboard-title">
                <span class="title-icon">📊</span>
                <span>Pazaryeri Kontrol Paneli</span>
              </div>
              <div class="dashboard-period">Bugün: 12 Ağustos</div>
            </div>
            
            <div class="order-summary">
              <div class="summary-card">
                <div class="summary-label">Toplam Sipariş</div>
                <div class="summary-value">48</div>
                <div class="summary-trend success">↑ %15</div>
              </div>
              <div class="summary-card">
                <div class="summary-label">Bekleyen Sipariş</div>
                <div class="summary-value">12</div>
                <div class="summary-trend warning">⏳ İşlemde</div>
              </div>
              <div class="summary-card">
                <div class="summary-label">Hatalı Sipariş</div>
                <div class="summary-value">2</div>
                <div class="summary-trend danger">⚠️ Hata</div>
              </div>
            </div>
            
            <div class="platform-status">
               <div class="platform-item">
                <span class="platform-icon">🟢</span>
                <span class="platform-name">Trendyol</span>
                <span class="platform-orders">7 sipariş</span>
              </div>
              <div class="platform-item">
                <span class="platform-icon">🟢</span>
                <span class="platform-name">Amazon</span>
                <span class="platform-orders">12 sipariş</span>
              </div>
              <div class="platform-item">
                <span class="platform-icon">🟢</span>
                <span class="platform-name">Hepsiburada</span>
                <span class="platform-orders">8 sipariş</span>
              </div>
              <div class="platform-item">
                <span class="platform-icon">🟡</span>
                <span class="platform-name">N11</span>
                <span class="platform-orders">3 sipariş</span>
              </div>
             
            </div>
            
            <div class="urgent-alerts">
              <div class="alert-icon">⚡</div>
              <div class="alert-text">2 üründe stok kritik seviyede (≤5 adet)</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Karşılaştırma (Challenge/Solution) -->
  <section class="challenge-section">
    <div class="container">
      <div class="section-header">
        <h2>Aracı Firmalar mı, Stok Pratik mi?</h2>
        <p>Geleneksel entegratörler ile doğrudan API çözümümüzü karşılaştırın</p>
      </div>
      
      <div class="challenge-grid">
        <div class="challenge-card">
          <div class="challenge-icon">{comparison.old.icon}</div>
          <h3>{comparison.old.title}</h3>
          <ul>
            {comparison.old.items.map((item, i) => (
              <li key={i}>{item}</li>
            ))}
          </ul>
        </div>
        
        <div class="solution-card">
          <div class="solution-icon">{comparison.new.icon}</div>
          <h3>{comparison.new.title}</h3>
          <ul>
            {comparison.new.items.map((item, i) => (
              <li key={i}>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Özellikler Grid -->
  <section class="features-section">
    <div class="container">
      <div class="section-header">
        <h2>Pazaryeri Satışlarınızı Kolaylaştıran Özellikler</h2>
        <p>Tüm pazaryerlerini tek bir çatı altında yönetin</p>
      </div>
      
      <div class="features-grid">
        {features.map((feature, index) => (
          <div class="feature-card" key={index}>
            <div class="feature-header">
              <div class="feature-icon">{feature.icon}</div>
              <div>
                <h3>{feature.title}</h3>
                <p class="feature-desc">{feature.description}</p>
              </div>
            </div>
            
            <ul class="feature-details">
              {feature.details.map((detail, i) => (
                <li key={i}>
                  <span class="detail-check">✓</span>
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nasıl Çalışır (Adımlar) -->
  <section class="process-section">
    <div class="container">
      <div class="section-header">
        <h2>3 Adımda Satışlarınızı Otomatikleştirin</h2>
        <p>Stok Pratik ile entegrasyon süreci ne kadar kolay?</p>
      </div>
      
      <div class="process-timeline">
        {steps.map((step, index) => (
          <div class="process-step" key={index}>
            <div class="step-number">{step.step}</div>
            <div class="step-content">
              <div class="step-header">
                <div class="step-icon">{step.icon}</div>
                <h3>{step.title}</h3>
              </div>
              <p class="step-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="process-result">
        <div class="result-icon">🎉</div>
        <div class="result-content">
          <h3>Siparişler Otomatik, Stoklar Senkron, Siz Rahat!</h3>
          <p>Stok Pratik ile pazaryeri satışlarınızı otomatikleştirin, aracı firmaların ek maliyetlerinden kurtulun.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Entegrasyonlar -->
  <section class="integration-section">
    <div class="container">
      <div class="section-header">
        <h2>Desteklenen Pazaryerleri</h2>
        <p>Türkiye'nin önde gelen e-ticaret platformları ile entegre</p>
      </div>
      
      <div class="integrations-grid">
        <div class="integration-card">
          <div class="integration-icon">🟣</div>
          <h3>Trendyol</h3>
          <p>Trendyol API ile tam entegre, ürün ve sipariş yönetimi</p>
        </div>
        
        <div class="integration-card">
          <div class="integration-icon">🔵</div>
          <h3>Hepsiburada</h3>
          <p>Hepsiburada Entegrasyon API'si ile anlık veri akışı</p>
        </div>
        
        <div class="integration-card">
          <div class="integration-icon">🟢</div>
          <h3>N11</h3>
          <p>N11 API entegrasyonu ile stok ve sipariş senkronizasyonu</p>
        </div>
        
        <div class="integration-card">
          <div class="integration-icon">🟠</div>
          <h3>Amazon</h3>
          <p>Amazon Marketplac entegrasyonu ile uluslararası satış</p>
        </div>
      </div>
    </div>
  </section>

  <!-- İlgili Sayfalar -->
  <section class="related-pages">
    <div class="container">
      <div class="section-header">
        <h2>Entegre Çalışan Diğer Çözümlerimiz</h2>
        <p>Pazaryeri entegrasyonu ile birlikte kullanabileceğiniz modüller</p>
      </div>
      
      <div class="pages-grid">
        <a href="/stok-yonetimi" class="page-card">
          <h3>📦 Stok Yönetimi</h3>
          <p>Depo ve stok takibini pazaryerleriyle senkronize edin</p>
          <div class="page-link">
            <span>İncele</span>
            <span class="arrow">→</span>
          </div>
        </a>
        <a href="/fatura-yonetimi" class="page-card">
          <h3>🧾 Fatura Yönetimi</h3>
          <p>Otomatik e-fatura ve e-arşiv ile uyumlu</p>
          <div class="page-link">
            <span>İncele</span>
            <span class="arrow">→</span>
          </div>
        </a>
        <a href="/b2b-toptan-satis-sistemi" class="page-card">
          <h3>🏪 B2B Toptan Satış</h3>
          <p>Perakende ve toptan satışları tek panelde birleştirin</p>
          <div class="page-link">
            <span>İncele</span>
            <span class="arrow">→</span>
          </div>
        </a>
        <a href="/erp-sistemi" class="page-card">
          <h3>📊 ERP Sistemi</h3>
          <p>Tüm iş süreçlerinizi entegre yönetin</p>
          <div class="page-link">
            <span>İncele</span>
            <span class="arrow">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header">
        <h2>Sıkça Sorulan Sorular</h2>
        <p>Pazaryeri entegrasyonu hakkında merak edilenler</p>
      </div>
      
      <div class="faq-grid">
        {faqs.map((faq, index) => (
          <details class="faq-item" key={index}>
            <summary>
              {faq.question}
              <span class="faq-icon">▼</span>
            </summary>
            <div class="faq-answer">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="cta-content">
        <div class="cta-icon">🚀</div>
        <h2>Pazaryeri Satışlarınızı Otomatikleştirmeye Hazır mısınız?</h2>
        <p>Ücretsiz demo talep edin, aracı firmalara ödediğiniz ek ücretleri değerlendirelim.</p>
        
        <div class="cta-buttons">
          <a 
            href="https://wa.me/+905325000999?text=Merhaba,%20Pazaryeri%20Entegrasyon%20Sistemi%20demo%20talep%20ediyorum"
            class="btn btn-primary btn-large"
            target="_blank"
            rel="noopener noreferrer"
          >
            📅 Ücretsiz Demo İste
          </a>
          <a 
            href="tel:+905325000999"
            class="btn btn-secondary btn-large"
          >
            📞 Canlı Destek Al
          </a>
        </div>
        
        <div class="cta-benefits">
          <div class="benefit">
            <span class="benefit-icon">🎯</span>
            <span>Ücretsiz Entegrasyon Analizi</span>
          </div>
          <div class="benefit">
            <span class="benefit-icon">👨‍🏫</span>
            <span>Canlı Eğitim Desteği</span>
          </div>
          <div class="benefit">
            <span class="benefit-icon">🔄</span>
            <span>Veri Göçüm Desteği</span>
          </div>
          <div class="benefit">
            <span class="benefit-icon">💰</span>
            <span>Özel Fiyat Teklifi</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== TURUNCU + KOYU MAVİ TEMASI ===== */
  
  /* Hero Section */
  .hero-section {
    background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 100%);
    color: white;
    padding: 4rem 0;
  }
  
  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .hero-badge {
    display: inline-block;
    background: rgba(252, 252, 252, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  
  .hero-text h1 {
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: white;
  }
  
  .highlight {
    color: #f97316; /* Turuncu */
  }
  
  .hero-subtitle {
    font-size: 1.2rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }
  
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 2rem 0;
  }
  
  .stat-item {
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    padding: 1rem;
    border-radius: 10px;
    backdrop-filter: blur(10px);
  }
  
  .stat-icon {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  
  .stat-number {
    font-size: 1.5rem;
    font-weight: bold;
    color: #f97316;
    margin-bottom: 0.3rem;
  }
  
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  
  .hero-buttons {
    display: flex;
    gap: 1rem;
    margin: 2rem 0;
  }
  
  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.1rem;
  }
  
  .btn-primary {
    background: #f97316;
    color: #0d1b2a;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .btn-primary:hover {
    background: #ea580c;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(249, 115, 22, 0.3);
  }
  
  .btn-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }
  
  .hero-features {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  
  .feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.5rem 1rem;
    border-radius: 20px;
  }
  
  .feature-icon {
    font-size: 1rem;
  }
  
  /* Marketplace Dashboard */
  .marketplace-dashboard {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    color: #0d1b2a;
  }
  
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e2e8f0;
  }
  
  .dashboard-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: bold;
    font-size: 1.2rem;
  }
  
  .title-icon {
    font-size: 1.5rem;
  }
  
  .dashboard-period {
    font-size: 0.9rem;
    color: #64748b;
  }
  
  .order-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .summary-card {
    background: #f8fafc;
    padding: 1rem;
    border-radius: 10px;
