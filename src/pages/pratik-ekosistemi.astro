---
// src/pages/pratik-ekosistemi.astro - Pratik Ürün Ailesi & FinansPratik Ana Çatı Hub Sayfası
import BaseLayout from '../layouts/BaseLayout.astro';

const products = [
  {
    id: "musavirpratik",
    name: "MüşavirPratik",
    badge: "🏛️ SMMM ÖZEL ŞİFRE",
    title: "SMMM Mali Müşavir Portalı & Canlı KDV Pusulası",
    desc: "Müşavirinize kendi şirket yönetim şifrenizi vermeyin. CariNET modeliyle özel şifre üretin; resmi evraklarınızı, 102 banka ekstrelerinizi ve Luca/Zirve/Mikro fişlerini tek tıkla çeksin.",
    points: [
      "CariNET Modeliyle Müşavire Özel Kullanıcı & Şifre",
      "Canlı KDV & Vergi Pusulası (391 Hesaplanan vs 191 İndirilecek)",
      "Luca, Zirve, Mikro, Eta & Resmi XML/ZIP Tek Tıkla Aktarım",
      "Otomatik Masraf Fişi & İkincil Entegratör Tekilleştirme"
    ],
    detailUrl: "/urunler/musavirpratik",
    portalUrl: "https://erp-eticaret.stokpratik.com.tr/smmm/giris",
    image: "/images/ekosistem/departman_portallari_b2b_smmm_hero_1793942223136.jpg",
    theme: {
      gradient: "from-amber-500 to-red-600",
      border: "border-amber-200",
      badge: "bg-amber-500/10 text-amber-400 border-amber-500/20"
    }
  },
  {
    id: "carinet",
    name: "CariNET B2B",
    badge: "🌐 B2B CARİ & SİPARİŞ",
    title: "Müşteri & Bayi Self-Servis Sipariş ve 3D Tahsilat Portalı",
    desc: "Müşterileriniz ekstre istemek için sizi aramasın. 7/24 canlı bakiyelerini görsünler, 3D Secure kredi kartıyla borçlarını ödesinler ve özel iskontolarla sipariş versinler.",
    points: [
      "Canlı Cari Ekstre & Fatura PDF İndirme",
      "3D Secure Kredi Kartı ile Anında Bakiye Kapama",
      "Cariye Özel İskontolu B2B Katalog & Sipariş Sepeti",
