---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Stok Pratik — Türkiye'nin Ticaret İşletim Sistemi | Bulut ERP, E-Ticaret, POS & B2B";
const pageDescription = "Kasiyeriniz barkod okuturken Trendyol stoğunuz düşsün, plasiyeriniz sahada fatura kessin, yapay zeka fişleri okurken mali müşaviriniz tek tıkla e-Defter hazırlasın. Türkiye'nin en kapsamlı bulut ticaret işletim sistemi.";

const stats = [
  { value: "40+", label: "Entegre Kurumsal Modül", desc: "Ön muhasebeden üretime tek veritabanı" },
  { value: "37+", label: "Pazaryeri & E-İhracat", desc: "Trendyol, Amazon, Etsy, Ozon canlı senkron" },
  { value: "17", label: "GİB e-Dönüşüm Belgesi", desc: "e-Fatura, e-Arşiv, e-İrsaliye, e-Defter ve SMMM" },
  { value: "10 Sn", label: "Stok Senkronizasyonu", desc: "Mağazada satılan ürün saniyesinde internette biter" },
  { value: "%100", label: "Veri Özgürlüğü & KVKK", desc: "İstediğiniz an tüm verinizi Excel ile dışa aktarın" }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-indigo-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-12 pb-24 lg:pt-20 lg:pb-32 border-b border-slate-800">
      <!-- Arka Plan Gradyan ve Işık Efektleri -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-indigo-500/10 blur-[140px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="text-center max-w-4xl mx-auto mb-12">
          
          <!-- Üst Rozet -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            ⚡ 8 AYRI YAZILIM PARASI ÖDEMEYİN • TEK BULUT HESABIYLA TÜM ŞİRKETİNİZİ YÖNETİN
          </div>

          <!-- Ana Başlık (H1) -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
            Perakendeden Toptana, Pazaryerinden Üretime: <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-emerald-300">
              İşletmenizin Tüm Gücü Tek Ekranda.
            </span>
          </h1>

          <!-- Alt Başlık -->
          <p class="text-base sm:text-lg lg:text-xl text-slate-300 mb-10 leading-relaxed max-w-3xl mx-auto">
            Kasiyeriniz barkod okuturken Trendyol stoğunuz düşsün, plasiyeriniz sahada fatura keserken bayiniz CariNET'ten 12 taksitle ödeme yapsın, yapay zeka masraf fişlerinizi okurken mali müşaviriniz tek tıkla e-Defter hazırlasın. Kurulum yok, sunucu masrafı yok!
          </p>

          <!-- Hero CTA Butonları -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-emerald-600 hover:from-indigo-500 hover:to-emerald-500 text-white font-bold text-base shadow-xl shadow-indigo-600/30 hover:scale-[1.02] transition-all text-center"
            >
              🚀 30 Saniyede Ücretsiz Hesabınızı Açın
            </a>
            <a 
              href="#live-os" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
            >
              <span>🎯 7 Canlı Senaryoyu İnceleyin</span>
            </a>
          </div>
          <p class="text-xs text-slate-400">Kredi kartı gerekmez • 14 gün ücretsiz deneme • Tüm modüller anında aktif</p>

        </div>

        <!-- 🖥️ HERO MERKEZ GÖRSELİ: 7 SENARYOLU CANLI EKRAN DEĞİŞTİRİCİ (LIVE OS SWITCHER) -->
        <div class="mt-8 max-w-6xl mx-auto" id="live-os">
          <div class="bg-slate-900/90 rounded-2xl border border-indigo-500/30 shadow-2xl p-4 sm:p-6 backdrop-blur-xl relative overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-emerald-500"></div>

            <!-- Sekme Seçici Butonları -->
            <div class="flex items-center gap-2 pb-4 border-b border-slate-800 overflow-x-auto text-xs font-semibold mb-6">
              <button data-target="tab-pos" class="os-tab-btn active px-3.5 py-2 rounded-lg bg-indigo-600 text-white shadow whitespace-nowrap">
                🛒 Mağaza & Hızlı POS
              </button>
              <button data-target="tab-pazaryeri" class="os-tab-btn px-3.5 py-2 rounded-lg bg-slate-950 text-slate-400 hover:text-white whitespace-nowrap">
                🌐 37+ Pazaryeri & E-İhracat
              </button>
              <button data-target="tab-b2b" class="os-tab-btn px-3.5 py-2 rounded-lg bg-slate-950 text-slate-400 hover:text-white whitespace-nowrap">
                🤝 B2B Toptan, CariNET & DepodanDirekt
              </button>
              <button data-target="tab-muhasebe" class="os-tab-btn px-3.5 py-2 rounded-lg bg-slate-950 text-slate-400 hover:text-white whitespace-nowrap">
                🧾 Ön Muhasebe & AI OCR
              </button>
              <button data-target="tab-uretim" class="os-tab-btn px-3.5 py-2 rounded-lg bg-slate-950 text-slate-400 hover:text-white whitespace-nowrap">
                🏭 Üretim ERP & Depo WMS
              </button>
              <button data-target="tab-pdks" class="os-tab-btn px-3.5 py-2 rounded-lg bg-slate-950 text-slate-400 hover:text-white whitespace-nowrap">
                📲 QR-PDKS & Puantaj
              </button>
              <button data-target="tab-bi" class="os-tab-btn px-3.5 py-2 rounded-lg bg-slate-950 text-slate-400 hover:text-white whitespace-nowrap">
                🧠 Patron BI Kokpiti
              </button>
            </div>

            <!-- 1. Senaryo: Mağaza & Hızlı POS -->
            <div id="tab-pos" class="os-content-panel block">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 text-xs">
                <div class="lg:col-span-8 bg-slate-950 p-4 rounded-xl border border-slate-800">
                  <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
                    <span class="font-bold text-white flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                      Hızlı Satış Kasa #1 • Kadıköy Merkez Mağaza
                    </span>
                    <span class="text-slate-400 font-mono">Barkod: 8690123456789</span>
                  </div>
                  <div class="space-y-2 mb-3">
                    <div class="flex justify-between items-center p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">
                      <span>• Erkek Slim Fit Gömlek (Mavi / M Beden)</span>
                      <span class="font-mono font-bold text-white">450,00 ₺</span>
                    </div>
                    <div class="flex justify-between items-center p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">
                      <span>• Deri Kemer (Siyah / 110 cm)</span>
                      <span class="font-mono font-bold text-white">220,00 ₺</span>
                    </div>
                  </div>
                  <div class="pt-2 border-t border-slate-800 flex justify-between items-center">
                    <span class="text-slate-400">Genel Toplam (KDV Dahil):</span>
                    <span class="text-xl font-black text-emerald-400 font-mono">670,00 ₺</span>
                  </div>
                </div>
                <div class="lg:col-span-4 bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between">
                  <div>
                    <div class="font-bold text-indigo-400 mb-2">⚡ Anlık Ekosistem Etkisi:</div>
                    <p class="text-slate-300 text-[11px] leading-relaxed mb-3">
                      Kasada satılan gömlek Kadıköy deposundan düştü; <strong>Trendyol ve Hepsiburada stokları 10 saniye içinde otomatik güncellendi</strong>.
                    </p>
                  </div>
                  <div class="p-2.5 bg-indigo-950/40 rounded-lg border border-indigo-500/30 text-[11px] text-indigo-200">
                    ✓ Parçalı Ödeme: 200 ₺ Nakit + 470 ₺ Kredi Kartı ile fiş kesildi.
                  </div>
                </div>
              </div>
            </div>

            <!-- 2. Senaryo: 37+ Pazaryeri & E-İhracat -->
            <div id="tab-pazaryeri" class="os-content-panel hidden">
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 text-xs">
                <div class="bg-slate-950 p-3.5 rounded-xl border border-orange-500/30">
                  <div class="flex justify-between items-center font-bold text-orange-400 mb-2">
                    <span>🛍️ Trendyol Siparişi</span>
                    <span class="font-mono">#TY-98412</span>
                  </div>
                  <div class="text-slate-300 mb-1">Kablosuz Bluetooth Kulaklık (Siyah)</div>
                  <div class="text-[10px] text-slate-400 font-mono">Kargo Kodu: TY-KRG-8812 • e-Fatura Gönderildi</div>
                </div>
                <div class="bg-slate-950 p-3.5 rounded-xl border border-amber-500/30">
                  <div class="flex justify-between items-center font-bold text-amber-400 mb-2">
                    <span>📦 Amazon Global</span>
                    <span class="font-mono">#AMZ-DE-441</span>
                  </div>
                  <div class="text-slate-300 mb-1">El Yapımı Deri Cüzdan (Almanya)</div>
                  <div class="text-[10px] text-slate-400 font-mono">ETGB Mikro İhracat • EUR Fatura Hazır</div>
                </div>
                <div class="bg-slate-950 p-3.5 rounded-xl border border-emerald-500/30">
                  <div class="flex justify-between items-center font-bold text-emerald-400 mb-2">
                    <span>⚡ 10 Sn Otomatik Senkron</span>
                    <span class="text-emerald-400 font-bold">Aktif</span>
                  </div>
                  <p class="text-slate-300 text-[11px]">
                    37 pazaryeri tek stok havuzuna bağlı. Çifte satış (overbooking) riski sıfır!
                  </p>
                </div>
              </div>
            </div>

            <!-- 3. Senaryo: B2B Toptan, CariNET & DepodanDirekt -->
            <div id="tab-b2b" class="os-content-panel hidden">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                  <div class="font-bold text-white mb-2 flex items-center justify-between">
                    <span>🤝 CariNET Bayi Portalı: Ege Dağıtım Ltd.</span>
                    <span class="text-indigo-400 font-mono font-bold">A Grubu Bayi</span>
                  </div>
                  <div class="text-slate-300 text-[11px] space-y-1 mb-3">
                    <div>• 1 Koli (12 Adet) Alımda: 150,00 ₺ / Adet</div>
                    <div>• 1 Palet (120 Adet) Alımda: 132,00 ₺ / Adet</div>
                    <div class="text-emerald-400">✓ Kademeli Toptan Fiyat Motoru ve Maliyet Kilidi Devrede</div>
                  </div>
                </div>
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                  <div class="font-bold text-white mb-2">🌐 DepodanDirekt.com Toptan Ağı</div>
                  <p class="text-slate-300 text-[11px] mb-2 leading-relaxed">
                    Ürünlerinizi tek tıkla DepodanDirekt B2B toptan pazaryerinde yayınlayın, Türkiye genelindeki binlerce kurumsal alıcıya doğrudan toptan satış yapın.
                  </p>
                </div>
              </div>
            </div>

            <!-- 4. Senaryo: Ön Muhasebe & AI OCR -->
            <div id="tab-muhasebe" class="os-content-panel hidden">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-950 p-4 rounded-xl border border-purple-500/30">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-bold text-purple-400">🤖 Yapay Zeka (AI OCR) Fiş Okuma</span>
                    <span class="text-[10px] text-emerald-400 font-mono">3 Saniyede Okundu</span>
                  </div>
                  <div class="space-y-1 text-slate-300 text-[11px]">
                    <div>• Akaryakıt Fişi: 1.850,00 ₺</div>
                    <div>• Ayrıştırılan KDV (%20): 308,33 ₺</div>
                    <div>• Gider Hesabı: 770 Taşıt Masrafları (Otomatik Eklendi)</div>
                  </div>
                </div>
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                  <div class="font-bold text-white mb-2">🏛️ 17'li e-Dönüşüm & SMMM Köprüsü</div>
                  <p class="text-slate-300 text-[11px] leading-relaxed">
                    e-Fatura, e-Arşiv, e-İrsaliye, e-SMM ve e-Defter tek tıkla GİB'e iletilir; Luca, Zirve ve Logo programlarına hazır Excel mizanı üretilir.
                  </p>
                </div>
              </div>
            </div>

            <!-- 5. Senaryo: Üretim ERP & Depo WMS -->
            <div id="tab-uretim" class="os-content-panel hidden">
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs">
                <div class="flex justify-between items-center font-bold text-white mb-2">
                  <span>⚙️ Üretim Reçetesi (BOM) • Mamul: Deri Koltuk #DK-01</span>
                  <span class="text-emerald-400 font-mono">Gerçek Maliyet: 4.820 ₺</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-[11px] text-slate-300">
                  <div class="p-2 bg-slate-900 rounded border border-slate-800">• 6 m² Hakiki Deri (-6m² Depo)</div>
                  <div class="p-2 bg-slate-900 rounded border border-slate-800">• 1 Adet Ahşap İskelet (-1Ad)</div>
                  <div class="p-2 bg-slate-900 rounded border border-slate-800">• İşçilik & Makine Amortismanı</div>
                </div>
              </div>
            </div>

            <!-- 6. Senaryo: QR-PDKS & Puantaj -->
            <div id="tab-pdks" class="os-content-panel hidden">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-950 p-4 rounded-xl border border-cyan-500/30">
                  <div class="flex justify-between items-center font-bold text-cyan-400 mb-2">
                    <span>⏱️ 15 Sn Dinamik Kiosk QR</span>
                    <span class="text-emerald-400 font-mono font-bold animate-pulse">Yeni Kod: 08s</span>
                  </div>
                  <p class="text-slate-300 text-[11px]">
                    Fotoğrafı çekilemez, dışarıdan okutulamaz. GPS geofence ve cihaz kilidiyle sıfır donanım maliyetli personel takibi!
                  </p>
                </div>
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                  <div class="font-bold text-white mb-2">📋 SGK 30 Günlük Puantaj Matrisi</div>
                  <p class="text-slate-300 text-[11px]">
                    Normal çalışma, fazla mesai (%50 / %100), izin ve geç kalma süreleri otomatik hesaplanır, imzalı A4 çıktı ve SMMM Excel aktarımı hazır.
                  </p>
                </div>
              </div>
            </div>

            <!-- 7. Senaryo: Patron BI Kokpiti -->
            <div id="tab-bi" class="os-content-panel hidden">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="bg-slate-950 p-3.5 rounded-xl border border-emerald-500/30">
                  <div class="text-[10px] text-slate-400 font-mono">Net Dönem Kârı</div>
                  <div class="text-lg font-black text-emerald-400 font-mono mt-1">285.000 ₺</div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Komisyon ve masraflar düşüldü</div>
                </div>
                <div class="bg-slate-950 p-3.5 rounded-xl border border-amber-500/30">
                  <div class="text-[10px] text-slate-400 font-mono">ABC Pareto Analizi</div>
                  <div class="text-lg font-black text-amber-300 font-mono mt-1">%80 Ciro</div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Top 120 altın ürün getirdi</div>
                </div>
                <div class="bg-slate-950 p-3.5 rounded-xl border border-purple-500/30">
                  <div class="text-[10px] text-slate-400 font-mono">Maliyet Altı Kalkanı</div>
                  <div class="text-lg font-black text-purple-300 font-mono mt-1">0 Zarar</div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Zararına satış tamamen kilitli</div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- 2. RAKAMLARLA STOK PRATİK GÜCÜ (METRİK BANDI) -->
    <section class="py-12 bg-slate-900/60 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 text-center">
          {stats.map((s) => (
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
              <div class="text-3xl lg:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-emerald-400 font-mono">
                {s.value}
              </div>
              <div class="text-xs font-bold text-white mt-1">{s.label}</div>
              <div class="text-[11px] text-slate-400 mt-0.5">{s.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ESKİ PARÇALI DÜZEN VS STOK PRATİK (MALİYET & ZAMAN KALKANI) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-rose-400 font-bold mb-3">Maliyet ve Zaman Kalkanı</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Neden 7 Ayrı Yazılıma Servet Ödemeyi Bırakmalısınız?</h3>
          <p class="text-slate-400 mt-4 text-base">
            Farklı firmalardan alınan ve birbirini tutmayan kopuk yazılımlar işletmenizi hem yavaşlatır hem de sermayenizi tüketir.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
          
          <!-- Sol: Eski Parçalı Düzen -->
          <div class="bg-rose-950/20 border border-rose-500/30 rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/20 text-rose-400 text-xs font-bold mb-6 border border-rose-500/30">
                ❌ ESKİ PARÇALI VE KOPUK DÜZEN
              </div>
              <ul class="space-y-4 text-sm text-slate-300">
                <li class="flex items-start gap-3">
                  <span class="text-rose-400 text-lg">✕</span>
                  <span>Ön muhasebe için ayrı, pazaryeri entegratörü için ayrı aylık abonelik.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-rose-400 text-lg">✕</span>
                  <span>Mağaza POS kasası için terminal başı lisans ve kurulum ücretleri.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-rose-400 text-lg">✕</span>
                  <span>B2B bayi portalı için binlerce dolar yazılım masrafı.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-rose-400 text-lg">✕</span>
                  <span>PDKS parmak izi ve kart cihazları için pahalı donanım masrafı.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-rose-400 text-lg">✕</span>
                  <span>Mağazada satılan son ürünün internette 'stokta var' kalıp ceza yedirmesi.</span>
                </li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-rose-500/20 text-xs text-rose-300 font-mono">
              Tahmini Aylık Kayıp: 35.000 ₺+ ve Yüzlerce Saat Excel Angaryası
            </div>
          </div>

          <!-- Sağ: Stok Pratik Tek Ekosistem -->
          <div class="bg-emerald-950/20 border border-emerald-500/30 rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 blur-3xl pointer-events-none"></div>
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold mb-6 border border-emerald-500/30">
                ✅ STOK PRATİK: TEK MERKEZ, TEK VERİTABANI
              </div>
              <ul class="space-y-4 text-sm text-slate-200">
                <li class="flex items-start gap-3">
                  <span class="text-emerald-400 text-lg font-bold">✓</span>
                  <span><strong>11 Departman, 40+ Modül:</strong> Tek bir hesapla tüm şirketinizi yönetin.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-emerald-400 text-lg font-bold">✓</span>
                  <span><strong>10 Saniye Otomatik Stok Senkronu:</strong> Mağazada satılan ürün Trendyol'da biter.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-emerald-400 text-lg font-bold">✓</span>
                  <span><strong>Dahili B2B & CariNET:</strong> Bayileriniz 7/24 girip 12 taksitle ödeme yapsın.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-emerald-400 text-lg font-bold">✓</span>
                  <span><strong>Cihazsız Dinamik QR-PDKS:</strong> 15 saniyede değişen şifreli personel takibi.</span>
                </li>
                <li class="flex items-start gap-3">
