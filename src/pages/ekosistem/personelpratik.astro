<!-- Interactive JavaScript -->
<script>
    // Live Clock Simulation
    function updateClock() {
      const now = new Date();
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const seconds = String(now.getSeconds()).padStart(2, '0');
      const clockEl = document.getElementById('live-clock');
      if (clockEl) {
        clockEl.textContent = hours + ':' + minutes + ':' + seconds;
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 15-Second QR Dynamic Countdown Animation
    let countdownVal = 9;
    const totalDuration = 15;
    const ringPerimeter = 264;

    function runQRTimer() {
      const countdownEl = document.getElementById('qr-countdown');
      const ringEl = document.getElementById('qr-progress-ring');

      countdownVal--;
      if (countdownVal <= 0) {
        countdownVal = 15;
      }

      if (countdownEl) {
        countdownEl.textContent = String(countdownVal).padStart(2, '0') + 's';
      }

      if (ringEl) {
        const offset = ringPerimeter - (ringPerimeter * (countdownVal / totalDuration));
        ringEl.style.strokeDashoffset = offset;
      }
    }

    let qrInterval = setInterval(runQRTimer, 1000);

    function refreshSimulatedQR() {
      countdownVal = 15;
      const countdownEl = document.getElementById('qr-countdown');
      const ringEl = document.getElementById('qr-progress-ring');
      if (countdownEl) countdownEl.textContent = '15s';
      if (ringEl) ringEl.style.strokeDashoffset = 0;
    }
  </script>


