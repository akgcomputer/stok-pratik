        🎬 Reels & Videolar ({posts.filter(p => p.category === 'video').length})
      </button>
      <button 
        type="button"
        class="filter-tab px-5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700"
        data-filter="post"
      >
        📖 Rehber & Gönderiler ({posts.filter(p => p.category === 'post').length})
