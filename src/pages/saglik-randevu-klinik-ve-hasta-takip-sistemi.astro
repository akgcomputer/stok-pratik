---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Sağlık Randevu, Klinik ve Hasta Takip Sistemi | Stok Pratik";
const pageDescription = "Randevu defterlerine ve seans karışıklığına son! Hekim bazlı akıllı randevu takvimi, paket seans takibi, medikal lot/SKT stok yönetimi ve tek tıkla resmi e-SMM / e-Fatura kesimi.";

const doctorColumns = [
  {
    doc: "Dr. Selin Kaya",
    title: "Diş Hekimi / İmplantoloji",
    badge: "bg-teal-500/20 text-teal-400 border-teal-500/30",
    appointments: [
      { time: "10:00", patient: "Ali Vural (İmplant Kontrol)", status: "Tamamlandı", color: "text-emerald-400" },
      { time: "11:30", patient: "Zeynep Arslan (Zirkon Ölçü)", status: "Odada", color: "text-teal-300 font-bold animate-pulse" },
      { time: "14:00", patient: "Kemal Sunar (Gömülü 20'lik)", status: "Onaylandı", color: "text-slate-300" }
    ]
  },
  {
    doc: "Uzm. Dyt. Emre Yılmaz",
    title: "Beslenme & Diyet Danışmanı",
    badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30",
    appointments: [
      { time: "10:30", patient: "Merve Tekin (Haftalık Tartı)", status: "Tamamlandı", color: "text-emerald-400" },
      { time: "12:00", patient: "Hakan Yıldız (İlk Seans)", status: "Gecikti", color: "text-amber-400" },
      { time: "15:00", patient: "Ece Demir (Online Danışmanlık)", status: "Link Gönderildi", color: "text-sky-300" }
    ]
  },
  {
    doc: "Estetisyen Elif Demir",
    title: "Medikal Estetik & Lazer",
    badge: "bg-purple-500/20 text-purple-400 border-purple-500/30",
    appointments: [
      { time: "11:00", patient: "Ceren Aksoy (Lazer 4. Seans)", status: "Tamamlandı", color: "text-emerald-400" },
      { time: "13:30", patient: "Burcu Kara (Hydrafacial)", status: "Sıradaki", color: "text-purple-300" },
      { time: "16:00", patient: "Gamze Çelik (Botoks Kontrol)", status: "Onaylandı", color: "text-slate-300" }
    ]
  }
];

const clinicalPowers = [
  {
    icon: "📅",
    title: "Hekim, Uzman & Cihaz Bazlı Akıllı Randevu Takvimi",
    desc: "Aynı saate iki randevu çakışmasını sıfıra indirin. Hangi hekimin veya hangi lazer/tedavi odasının hangi saatte müsait olduğunu renkli takvimde görün, otomatik WhatsApp randevu hatırlatması gönderin."
  },
  {
    icon: "🎟️",
    title: "Paket Hizmet, Seans & Taksitli Hasta Tahsilat Takibi",
    desc: "6 seanslık estetik veya 10 seanslık fizik tedavi paketlerinde; hastanın kaçıncı seansta olduğunu, kalan seans haklarını ve kalan taksitli cari borcunu tek ekranda izleyin."
  },
  {
    icon: "💉",
    title: "Medikal Sarf Malzeme, Dolgu & Lot / SKT Stok Takibi",
    desc: "Kliniğinizde kullanılan yüksek maliyetli implant, botoks/dolgu flakonu, anestezi ve veteriner aşılarını parti/lot numarası ve son kullanma tarihiyle izleyin; işlem yapıldıkça stoktan otomatik düşsün."
  },
  {
    icon: "💼",
    title: "Hekimlere Özel Tek Tıkla e-SMM & e-Arşiv Makbuz",
    desc: "Muayene bittiği anda ayrı entegratör programlarına girmeden stopajı ve KDV'si hazır resmi e-Serbest Meslek Makbuzu (e-SMM) veya şirket kliniğiniz için e-Faturayı tek tıkla kesin."
  },
  {
    icon: "🔗",
    title: "Linkle Randevu Kaporası & Kredi Kartına Taksit",
    desc: "Randevusuna gelmeyip kliniğinizi meşgul eden hastaların önüne geçmek için WhatsApp'tan Kapora Ödeme Linki gönderin veya tedavi paketlerini peşin fiyatına taksitle tahsil edin."
  },
  {
    icon: "🪑",
    title: "Tıbbi Cihaz Demirbaş, Kalibrasyon & Garanti Takibi",
    desc: "Ultrason, röntgen, otoklav, lazer cihazı ve dental ünitelerin periyodik kalibrasyon, filtre değişim ve servis bakım tarihlerini düzenli takip ederek arıza riskini sıfırlayın."
  }
];

const faqs = [
  {
    q: "Hangi sağlık ve klinik branşları için uygundur?",
    a: "Diş klinikleri, medikal estetik ve güzellik merkezleri, diyetisyenler, psikolog/terapistler, fizyoterapi merkezleri, poliklinikler, göz/optik ve veteriner klinikleri için eksiksiz tasarlanmıştır."
  },
  {
    q: "Hastalara otomatik randevu hatırlatma SMS'i ve WhatsApp bildirimi gidebilir mi?",
    a: "Evet. Randevu oluşturulduğunda ve randevudan 24 saat / 2 saat önce hastaya doktor adı, saat ve klinik konumunu içeren otomatik hatırlatma mesajı iletilir; randevuya gelmeme oranları %80 azalır."
  },
  {
    q: "Doktorlar kendi şahıs şirketleri adına e-SMM (Serbest Meslek Makbuzu) kesebilir mi?",
    a: "Kesinlikle! Stok Pratik e-SMM modülü Gelir İdaresi Başkanlığı (GİB) ile tam entegredir. Muayene sonrası stopaj ve KDV otomatik hesaplanarak tek tıkla e-SMM üretilir ve hastaya e-posta/SMS ile gönderilir."
  },
  {
    q: "Kullanılan botoks veya aşıların son kullanma tarihi bittiğinde sistem uyarır mı?",
    a: "Evet. Lot ve SKT takip modülü sayesinde son kullanma tarihi yaklaşan (30 gün, 15 gün kala) veya dolan tıbbi ürünler kırmızı alarm ile işaretlenir ve hasta tedavisinde kullanılması engellenir."
  },
  {
    q: "Danışanların seans geçmişini ve klinik fotoğraflarını arşivleyebilir miyiz?",
    a: "Evet. Danışan kartı altında geçmiş seans notları, tedavi planları, röntgen/öncesi-sonrası fotoğrafları ve ıslak/dijital onam formları güvenli ve KVKK uyumlu bulut altyapısında arşivlenir."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-teal-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-teal-950/40 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[550px] h-[320px] bg-teal-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
              🏥 Sağlık & Klinik ERP • Randevu, Seans, Medikal Stok & e-SMM
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Randevu Defterlerine ve <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-emerald-200">
                Seans Karmaşasına Son!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Diş hekimleri, güzellik merkezleri, diyetisyenler ve veteriner klinikleri için uçtan uca çözüm! Hekim bazlı randevu takviminizi yönetin, paket seans bakiyelerini izleyin, medikal sarf malzemeleri SKT ile stoktan düşün ve tek tıkla <strong>resmi e-SMM veya e-Faturanızı</strong> kesin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-teal-600 via-teal-500 to-emerald-600 hover:from-teal-500 hover:to-emerald-500 text-white font-bold text-base shadow-lg shadow-teal-600/30 hover:scale-[1.02] transition-all text-center"
              >
                🏥 Kliniğinizi Ücretsiz Başlatın
              </a>
              <a 
                href="#hekim-ajanda" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all text-center flex items-center justify-center gap-2"
              >
                <span>🩺 Canlı Randevu & Seans Ekranı</span>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Çoklu Doktor Ajandası</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Seans & Paket Takibi</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Tek Tıkla e-SMM / e-Fatura</span>
            </div>
          </div>

          <!-- Sağ: Canlı Hekim Randevu Ajandası + Seans Paketi Mockup'ı -->
          <div class="lg:col-span-7" id="hekim-ajanda">
            <div class="bg-slate-900/90 rounded-2xl border border-teal-500/30 p-5 shadow-2xl relative overflow-hidden backdrop-blur-xl">
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-teal-500 via-cyan-500 to-emerald-500"></div>

              <!-- Üst Bar -->
              <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-teal-400 animate-pulse"></span>
                  <span class="text-xs font-mono font-bold text-white uppercase tracking-wider">KLİNİK HEKİM RANDEVU AJANDASI</span>
                </div>
                <span class="text-[10px] bg-teal-500/20 text-teal-300 px-2 py-0.5 rounded font-mono">24 Ekim • 14 Randevu</span>
              </div>

              <!-- 3 Sütunlu Doktor Randevu Akışı -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
                {doctorColumns.map((col) => (
                  <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs flex flex-col justify-between">
                    <div>
                      <div class="font-bold text-white text-xs truncate">{col.doc}</div>
                      <div class="text-[10px] text-slate-400 truncate mb-2">{col.title}</div>

                      <div class="space-y-1.5">
                        {col.appointments.map((apt) => (
                          <div class="p-1.5 rounded bg-slate-900 border border-slate-800/80">
                            <div class="flex justify-between items-center text-[10px]">
                              <span class="font-mono text-slate-400">{apt.time}</span>
                              <span class={apt.color}>{apt.status}</span>
                            </div>
                            <div class="font-semibold text-slate-200 text-[11px] truncate mt-0.5">{apt.patient}</div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Danışan Seans Paketi & e-SMM Çubuğu -->
              <div class="bg-slate-950/90 p-3.5 rounded-xl border border-teal-500/20 text-xs">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 pb-2 border-b border-slate-800/80 mb-2">
                  <div>
                    <span class="font-bold text-white">Danışan: Merve Tekin</span>
                    <span class="text-slate-400 ml-2 text-[11px]">8 Seanslık Zayıflama & Diyet Paketi</span>
                  </div>
                  <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono font-bold text-[11px]">
                    5. Seans Tamamlandı (Kalan: 3 Seans)
                  </span>
                </div>
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[11px]">
                  <span class="text-slate-400">Kullanılan Sarf: <strong class="text-slate-200">1 Adet Analiz Kiti (Lot: #AK-892)</strong></span>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 rounded bg-slate-800 text-slate-300 cursor-pointer">Seans Notu Ekle</span>
                    <span class="px-2.5 py-1 rounded bg-teal-600 text-white font-bold cursor-pointer">💼 Tek Tıkla e-SMM Kes</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. KLİNİK VE SAĞLIK 6 ENTEGRE KABİLİYET -->
    <section class="py-20 bg-slate-900/40 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs uppercase tracking-widest text-teal-400 font-bold mb-3">Steril ve Güvenli Yönetim</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Kliniğinizi Dijitalleştiren 6 Entegre Güç</h3>
          <p class="text-slate-400 mt-4 text-base">
            Randevu ajandalarından hekim e-SMM makbuzlarına, seans paketlerinden tıbbi demirbaşlara kadar her şey tek sistemde.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {clinicalPowers.map((power, index) => (
            <div class="bg-slate-950/80 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-teal-500/40 transition-all">
              <div>
                <div class="w-12 h-12 rounded-xl bg-teal-500/10 border border-teal-500/20 text-teal-400 flex items-center justify-center text-2xl mb-4">
                  {power.icon}
                </div>
                <div class="text-xs font-mono text-teal-400 font-bold mb-1">KABİLİYET 0{index + 1}</div>
                <h4 class="text-lg font-bold text-white mb-2">{power.title}</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{power.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="py-20 border-b border-slate-800">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-xs uppercase tracking-widest text-teal-400 font-bold mb-2">Merak Edilenler</h2>
          <h3 class="text-3xl font-extrabold text-white">Sağlık & Randevu Modülü Hakkında Sıkça Sorulan Sorular</h3>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div class="bg-slate-900/60 rounded-xl border border-slate-800 p-6">
              <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="text-teal-400 font-mono">Q{index + 1}.</span> {faq.q}
              </h4>
              <p class="text-slate-300 text-sm leading-relaxed pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-teal-950/30 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-slate-900/90 border border-teal-500/30 shadow-2xl relative backdrop-blur-xl">
          <div class="w-16 h-16 rounded-2xl bg-teal-500/20 border border-teal-500/40 text-teal-400 flex items-center justify-center text-3xl mx-auto mb-6">
            🏥
          </div>
          <h3 class="text-3xl sm:text-5xl font-black text-white mb-6 tracking-tight">
            Siz Hastalarınıza Odaklanın, <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-emerald-200">
              Kliniğinizi Stok Pratik Yönetsin!
            </span>
          </h3>
          <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Hemen ücretsiz klinik hesabınızı açın; hekim randevularınızı, danışan paketlerinizi ve resmi e-SMM makbuzlarınızı dakikalar içinde dijitalleştirin.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-teal-600 via-teal-500 to-emerald-600 hover:from-teal-500 hover:to-emerald-500 text-white font-bold text-lg shadow-xl shadow-teal-600/30 hover:scale-[1.02] transition-all"
            >
              🚀 Hemen Ücretsiz Kullanmaya Başla
            </a>
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg border border-slate-700 transition-all"
            >
              Giriş Yap
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-6">Kredi kartı gerekmez • 1 dakikada şirket hesabı açın • %100 KVKK & GİB e-SMM uyumlu</p>
        </div>
      </div>
    </section>

    <!-- SCHEMA JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Stok Pratik Klinik ve Sağlık Randevu Yönetim Sistemi",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "TRY"
      },
      "description": pageDescription
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

  </main>
</BaseLayout>
