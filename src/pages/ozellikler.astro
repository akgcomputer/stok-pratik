{/* Client script for interactive category filtering */}
<script>
  function setupFeatureFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.module-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button classes
        filterButtons.forEach(b => {
          b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-md', 'active');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        });

        btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-md', 'active');
        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');

        // Show/hide cards
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFeatureFilters);
  document.addEventListener('astro:page-load', setupFeatureFilters);
</script>
