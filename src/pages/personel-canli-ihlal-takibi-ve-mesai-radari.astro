---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Personel Canlı İhlal Takibi ve Mesai Radarı | Stok Pratik";
const pageDescription = "Sabah 09:05'te kim işbaşında, kim geç kaldı anlık görün! Esnek tolerans süreli geç giriş, erken çıkış, sahte GPS konumu ve yabancı cihaz ihlallerini canlı yakalayın.";

const violationTypes = [
  {
    icon: "⏳",
    title: "1. Geç Giriş İhlali (Esnek Tolerans Süreli)",
    desc: "Şube mesai başlangıcını 09:00, hoşgörü (tolerans) süresini 10 dakika belirleyin. 09:11'de giriş yapan personel 'Geç Giriş İhlali' olarak işaretlenir ve gecikme dakikası puantaja yazılır."
  },
  {
    icon: "🏃",
    title: "2. Erken Çıkış İhlali",
    desc: "Mesai bitiş saati 18:30 iken 18:05'te çıkış QR kodunu okutan personelin kaç dakika erken ayrıldığı anında tespit edilir ve yönetici onayına sunulur."
  },
  {
    icon: "📍",
    title: "3. Konum Dışı (Sahte GPS) Okutma Denemesi",
    desc: "İşyerine gelmeden evden veya yoldan QR okutmaya çalışan personelin tam GPS mesafesi (Örn: 1.450m uzaklıkta) kaydedilir, giriş reddedilir ve kırmızı alarm üretilir."
  },
  {
    icon: "📱",
    title: "4. Başkasının Telefonundan Giriş Denemesi",
    desc: "İşe gelmeyen arkadaşının yerine kendi telefonundan hesap açıp QR okutmaya çalışan personel, donanım parmak izi eşleşmediği için anında engellenir."
  },
  {
    icon: "🌙",
    title: "5. Çıkış Okutmayı Unutma / Açık Vardiya Tespiti",
    desc: "Akşam çıkarken QR okutmayı unutan personelleri sistem gece yarısı otomatik tespit eder; ertesi sabah yöneticinin tek tıkla vardiyayı normal saatinde kapatmasını sağlar."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-950 text-slate-100 antialiased min-h-screen selection:bg-rose-500 selection:text-white">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 border-b border-slate-800">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-rose-950/30 via-slate-950 to-slate-950"></div>
      <div class="absolute top-1/4 right-1/4 w-[500px] h-[300px] bg-rose-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Sol: Başlık ve CTA -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span>
              🚨 QR-PDKS ve İK • Canlı Mesai Takibi & İhlal Radarı
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
              Sabah 09:05'te Kim İşbaşında, Kim Geç Kaldı? <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-orange-200">
                Ay Sonunu Beklemeden Anında Görün!
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
              Klasik sistemlerde personelin geç kaldığını veya erken çıktığını ancak ay sonunda puantaj alırken fark edersiniz. Stok Pratik <strong>Canlı Takip & İhlal Radarı</strong> ile tüm şubelerinizdeki anlık mevcudu, mola sürelerini, geç girişleri ve sahte konum denemelerini canlı yayın gibi izleyin!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a 
                href="/firma-kaydi" 
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-rose-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-base shadow-lg shadow-rose-600/30 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🚨 Canlı Takip Radarını Ücretsiz Açın</span>
              </a>
              <a 
                href="https://erp-eticaret.stokpratik.com.tr/giris" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200 text-center flex items-center justify-center gap-2"
              >
                <span>🔐 Giriş Yap</span>
              </a>
            </div>

            <!-- Sosyal Güven Rozetleri -->
            <div class="mt-10 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-rose-400 font-bold">✓</span> Esnek Tolerans Süresi
              </div>
              <div class="flex items-center gap-2">
                <span class="text-rose-400 font-bold">✓</span> Konum Dışı Giriş Engeli
              </div>
              <div class="flex items-center gap-2">
                <span class="text-rose-400 font-bold">✓</span> Anlık Yönetici Bildirimi
              </div>
            </div>
          </div>

          <!-- Sağ: Canlı İhlal & Mevcut Durum Panosu -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-lg bg-slate-900/90 border border-rose-500/30 rounded-3xl p-5 sm:p-6 shadow-2xl backdrop-blur-xl">
              
              <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
                  <span class="text-xs font-mono font-bold text-slate-200">Canlı Mesai Kontrol Radarı</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 text-[10px] font-mono">
                  Canlı Yayın • 09:30
                </span>
              </div>

              <!-- 4 Canlı Sayaç -->
              <div class="grid grid-cols-4 gap-2 text-center mb-4 font-mono">
                <div class="p-2 rounded-xl bg-slate-950 border border-slate-800">
                  <div class="text-[9px] text-slate-400">İçeride</div>
                  <div class="text-emerald-400 font-black text-sm">38</div>
                </div>
                <div class="p-2 rounded-xl bg-slate-950 border border-slate-800">
                  <div class="text-[9px] text-slate-400">Molada</div>
                  <div class="text-cyan-400 font-black text-sm">4</div>
                </div>
                <div class="p-2 rounded-xl bg-slate-950 border border-slate-800">
                  <div class="text-[9px] text-slate-400">Geç Kalan</div>
                  <div class="text-amber-400 font-black text-sm">3</div>
                </div>
                <div class="p-2 rounded-xl bg-slate-950 border border-slate-800">
                  <div class="text-[9px] text-slate-400">İhlal</div>
                  <div class="text-rose-400 font-black text-sm">2</div>
                </div>
              </div>

              <!-- Canlı Akış Logları -->
              <div class="space-y-2 text-xs font-mono">
                <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800 flex items-start gap-2">
                  <span class="text-emerald-400 font-bold shrink-0">✓</span>
                  <div>
                    <span class="text-slate-400">08:31</span> • <span class="font-bold text-white">Ahmet Yılmaz (Merkez)</span>
                    <div class="text-[10px] text-emerald-400">Zamanında Giriş Yapıldı (Konum & Cihaz Doğrulandı)</div>
                  </div>
                </div>

                <div class="p-2.5 rounded-xl bg-amber-950/30 border border-amber-500/30 flex items-start gap-2">
                  <span class="text-amber-400 font-bold shrink-0">⚠️</span>
                  <div>
                    <span class="text-slate-400">09:24</span> • <span class="font-bold text-white">Mehmet Demir (Kadıköy)</span>
                    <div class="text-[10px] text-amber-300">Geç Giriş İhlali (+24 Dk Gecikme - Tolerans Aşıldı)</div>
                  </div>
                </div>

                <div class="p-2.5 rounded-xl bg-rose-950/40 border border-rose-500/40 flex items-start gap-2">
                  <span class="text-rose-400 font-bold shrink-0">🚨</span>
                  <div>
                    <span class="text-slate-400">09:28</span> • <span class="font-bold text-white">Ayşe Kaya (AVM Şube)</span>
                    <div class="text-[10px] text-rose-300 font-bold">KONUM DIŞI DENEME: 1.450 metre uzaktan okutma engellendi!</div>
                  </div>
                </div>
              </div>

              <!-- Bilgi Notu -->
              <div class="mt-4 p-2.5 rounded-xl bg-slate-950 text-[11px] text-slate-400 border border-slate-800 flex items-center justify-between">
                <span>⏱️ Esnek Tolerans: 10 Dk</span>
                <span class="text-emerald-400 font-bold">Otomatik Puantaja İşleniyor</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. SİSTEMİN OTOMATİK YAKALADIĞI 5 MESAI İHLALİ -->
    <section class="py-20 lg:py-24 border-b border-slate-800 relative bg-slate-900/30">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-rose-400 text-sm font-semibold tracking-wider uppercase mb-3">Otomatik Denetim</div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Sistemin Otomatik Yakaladığı 5 Mesai İhlali
          </h2>
          <p class="text-slate-400 text-base leading-relaxed">
            İşletmenizdeki disiplini dedikoduyla veya tartışmayla değil; şeffaf, tartışmasız dijital kayıtlarla sağlayın.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {violationTypes.map((v) => (
            <div class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-7 hover:border-rose-500/40 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-rose-500/10 border border-rose-500/20 text-2xl flex items-center justify-center mb-5">
                  {v.icon}
                </div>
                <h3 class="text-lg font-bold text-white mb-2.5">{v.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{v.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ALT DÖNÜŞÜM CTA BÖLÜMÜ -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-rose-950/20 to-slate-950"></div>
      <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs sm:text-sm font-semibold mb-6">
          �🎁 1 Ay Tam Sürüm Ücretsiz Kullanım • Kredi Kartı Gerekmez
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
          İş Disiplinini Tartışmayla Değil, Şeffaf Veriyle Sağlayın!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Hemen ücretsiz hesabınızı açın, şubelerinizin mesai saatlerini belirleyip personellerinizi anlık kontrol panosundan canlı izlemeye başlayın.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/firma-kaydi" 
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-gradient-to-r from-rose-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-base shadow-lg shadow-rose-600/30 transition-all duration-200"
          >
            🚀 Hemen Ücretsiz Kullanmaya Başla
          </a>
          <a 
            href="https://erp-eticaret.stokpratik.com.tr/giris" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-all duration-200"
          >
            🔐 Sisteme Giriş Yap
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
