    portalUrl: "https://erp-eticaret.stokpratik.com.tr/carinet",
    image: "/images/ekosistem/carinet_crm_servis_portallari_hero_1793942256908.jpg",
    theme: {
      gradient: "from-blue-600 to-cyan-600",
      border: "border-blue-200",
      badge: "bg-blue-500/10 text-blue-400 border-blue-500/20"
    }
  },
  {
    id: "finanspratik",
    name: "FinansPratik",
    badge: "💎 5 MODÜL 1 ARADA",
    title: "Açık Bankacılık, TahsilatRobotu & POS Hazine Üssü",
    desc: "Türkiye'nin 25 bankasındaki hesaplarınızı tek ekranda birleştirin, gelen EFT/FAST'leri cari hesaplara otomatik eşleyin, WhatsApp TahsilatRobotu ile alacakları toplayın.",
    points: [
      "BankaPratik: 25 Banka Canlı Ekstre & Akıllı IBAN Eşleştirme",
      "TahsilatRobotu: 3 Farklı Tonla WhatsApp Vade Hatırlatma & 3D Link",
      "POSPratik: Banka POS Komisyon Kesintisi Denetçisi & Valör Radarı",
      "ÖdemePratik & NakitPratik: Toplu EFT/FAST & 30 Günlük Likidite Simülatörü"
    ],
    detailUrl: "/urunler/finanspratik",
    portalUrl: "https://erp-eticaret.stokpratik.com.tr/finanspratik",
    image: "/images/ekosistem/finanspratik_acik_bankacilik_hero_1793942210288.jpg",
    theme: {
      gradient: "from-emerald-500 to-teal-700",
      border: "border-emerald-200",
      badge: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
    }
  },
  {
    id: "mutabakatpratik",
    name: "MutabakatPratik",
    badge: "🤝 ŞİFRESİZ ONAY",
    title: "Şifresiz Cari Bakiye & BA/BS Dijital Mutabakat Portalı",
    desc: "Müşteri ve tedarikçilerinize şifresiz WhatsApp ve e-posta onay linki gönderin. Karşı taraf üye olmadan tek tıkla onaylasın; fark varsa yapay zeka ekstredeki eksik faturayı bulsun.",
    points: [
      "Şifresiz Tek Tıkla WhatsApp & E-Posta Onay Linki",
      "Yapay Zeka Destekli Otomatik Ekstre Fark Bulucu",
      "5651 Sayılı Kanuna Uygun Zaman Damgalı Hukuki Delil",
      "Excel Mizan ile Başka Muhasebeden Toplu Gönderim"
    ],
    detailUrl: "/urunler/mutabakatpratik",
    portalUrl: "https://erp-eticaret.stokpratik.com.tr/mutabakat",
    image: "/images/ekosistem/departman_portallari_b2b_smmm_hero_1793942223136.jpg",
    theme: {
      gradient: "from-fuchsia-600 to-indigo-700",
      border: "border-fuchsia-200",
      badge: "bg-fuchsia-500/10 text-fuchsia-400 border-fuchsia-500/20"
    }
  },
  {
    id: "e-ticaretpratik",
