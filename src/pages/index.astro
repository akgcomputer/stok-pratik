---

<BaseLayout 
  title="Stok Pratik — Tüm Operasyonlarınız Tek Platformda | Bulut ERP, E-Ticaret, POS & Üretim"
  description="Türkiye'nin en kapsamlı bulut ERP, e-ticaret pazaryeri entegrasyonu, hızlı barkod POS, üretim reçetesi ve B2B toptan satış yönetim sistemi. 1 ay ücretsiz deneyin."
>

  <!-- HERO SECTION: LOGO YAZILIM TARZI SLIDER & SAĞ KIRMIZI KUTU -->
  <section class="bg-white pt-6 pb-10 sm:pt-8 sm:pb-12">
    <div class="container mx-auto px-4 lg:px-8">
      
      <!-- SOSYAL MEDYAYA ÖZEL 45 GÜN KAMPANYA HERO YÖNLENDİRMESİ -->
      <div class="mb-6 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-amber-500/15 via-yellow-500/10 to-red-500/15 border-2 border-amber-400/50 shadow-lg shadow-amber-500/5">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-4">
          
          <!-- Sol: İkon ve 2 Satır Kampanya Mesajı -->
          <div class="flex items-center gap-3.5 text-center sm:text-left w-full lg:w-auto">
            <span class="text-3xl sm:text-4xl shrink-0 p-2.5 bg-amber-400/20 border border-amber-400/30 rounded-2xl">🎁</span>
            <div class="flex-1">
              <span class="inline-block text-[11px] font-black uppercase tracking-wider text-amber-700 bg-amber-100 px-2.5 py-0.5 rounded-full mb-1">
                Sosyal Medyaya Özel Sınırlı Süre Fırsatı
              </span>
              <!-- Satır 1 -->
              <p class="text-slate-900 font-black text-sm sm:text-base lg:text-lg leading-snug">
                StokPratik ERP & E-Ticaret 30 Gün Değil, Tam <span class="text-red-600 underline">45 GÜN ÜCRETSİZ!</span>
              </p>
              <!-- Satır 2 -->
              <p class="text-xs sm:text-sm font-semibold text-slate-700 mt-1">
                Kampanya Kodu: <strong class="text-amber-700 font-mono font-black text-sm sm:text-base">StokPratik45Gun</strong> <span class="text-red-600 font-black ml-1">(Kredi Kartı Gerekmez)</span>
              </p>
            </div>
          </div>

          <!-- Sağ: Alt Alta Duran Eşit Boyutta 2 Buton -->
          <div class="flex flex-col gap-2 w-full sm:w-auto sm:min-w-[250px] shrink-0">
            <!-- Buton 1: Kırmızı - Kampanya Detayları -->
            <a 
              href="https://stokpratik.com.tr/kampanya"
              class="w-full py-2.5 px-5 bg-red-600 hover:bg-red-700 text-white font-black text-xs sm:text-sm rounded-xl text-center shadow-md shadow-red-600/20 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-1.5"
            >
              <span>Kampanya Detaylarını İncele</span>
              <span>→</span>
            </a>

            <!-- Buton 2: Altın/Sarı - Kodu Uygula ve Kaydol -->
            <a 
              href="https://erp-eticaret.stokpratik.com.tr/giris?promo=StokPratik45Gun"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-5 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-xs sm:text-sm rounded-xl text-center shadow-md shadow-amber-400/20 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-1.5"
            >
              <span>Kodu Uygula & 45 Gün Dene</span>
              <span>→</span>
            </a>
          </div>

        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
        
        <!-- SOL 8 KOLON: İNTERAKTİF HERO SLIDER -->
        <div class="lg:col-span-8 bg-slate-50/80 border border-slate-200/90 rounded-3xl p-6 sm:p-10 relative overflow-hidden flex flex-col justify-between shadow-sm">
          
          <!-- SLIDE ITEMS WRAPPER -->
          <div id="heroSliderTrack" class="relative min-h-[520px] xs:min-h-[490px] sm:min-h-[460px] md:min-h-[380px] lg:min-h-[400px]">
            {slides.map((slide, idx) => (
              <div 
                class={`hero-slide transition-all duration-700 absolute inset-0 flex flex-col md:flex-row items-center justify-between md:justify-center gap-4 sm:gap-6 md:gap-8 ${idx === 0 ? 'opacity-100 z-10 translate-x-0' : 'opacity-0 z-0 translate-x-12 pointer-events-none'}`}
                data-slide-index={idx}
              >
                <!-- Metin Alanı (Sol) -->
                <div class="w-full md:w-7/12 flex flex-col items-start justify-center text-left shrink-0 md:shrink">
                  <div class="inline-flex items-center gap-2 bg-red-100/80 text-red-700 text-xs sm:text-sm font-bold px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full mb-2 sm:mb-4">
                    <span>{slide.badge}</span>
                  </div>
                  
                  <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug sm:leading-tight mb-2 sm:mb-4">
                    {slide.title}
                  </h1>
                  
                  <p class="text-slate-600 text-xs sm:text-sm md:text-base leading-relaxed mb-4 sm:mb-6 line-clamp-3 sm:line-clamp-none">
                    {slide.description}
                  </p>
                  
                  <a 
                    href={slide.buttonUrl}
                    class="inline-flex items-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-full text-xs sm:text-sm md:text-base transition-all shadow-md shadow-red-600/20 group"
                  >
                    <span>{slide.buttonText}</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>

                <!-- Resim Alanı (Sağ) - Mobilde 4:3 oran ile tam görünüm, masaüstünde tam yükseklik -->
                <div class="w-full md:w-5/12 aspect-[4/3] md:aspect-auto md:h-80 relative rounded-2xl overflow-hidden shadow-md md:shadow-lg border border-slate-200/70 bg-slate-100/80 shrink-0 flex items-center justify-center">
                  <img 
                    src={slide.image} 
                    alt={slide.alt} 
                    class="w-full h-full object-contain md:object-cover object-center transform hover:scale-105 transition-transform duration-700"
                    loading={idx === 0 ? "eager" : "lazy"}
                    fetchpriority={idx === 0 ? "high" : "auto"}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 via-transparent to-transparent pointer-events-none"></div>
                </div>
              </div>
            ))}
          </div>

          <!-- SLIDER ALT KONTROLLER (Önceki / Sayfa Sayacı / Sonraki) -->
          <div class="flex items-center justify-between pt-6 mt-4 border-t border-slate-200/70">
            <!-- Sol: Dairesel Butonlar ve Sayaç -->
            <div class="flex items-center gap-4">
              <button 
                id="sliderPrevBtn" 
                class="w-10 h-10 rounded-full border border-slate-300 hover:border-red-600 hover:bg-red-50 text-slate-700 hover:text-red-600 flex items-center justify-center transition-all focus:outline-none"
                aria-label="Önceki Slayt"
