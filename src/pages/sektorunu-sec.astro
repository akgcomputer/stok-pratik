                    </span>
                  </div>
                </div>

                <div class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-800/40 border border-slate-700/50">
                  <span class="text-emerald-400 text-base shrink-0">🎁</span>
                  <div>
                    <strong class="text-emerald-300 block font-bold">Hazır Kurulum Müjdesi:</strong>
                    <span class="text-slate-300" id="revealReadySetup">
                      Hesabınız açıldığında pazaryeri kargo şablonları, e-ticaret KDV oranları ve desi hesaplama birimleri otomatik hazır gelir.
                    </span>
                  </div>
                </div>
              </div>

              {/* ========================================================================= */}
              {/* 4. ÇAĞRI BUTONU (CTA) */}
              {/* ========================================================================= */}
              <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                
                <div class="w-full sm:w-auto">
                  <a 
                    id="sectorCtaBtn"
                    href="https://erp-eticaret.stokpratik.com.tr/?sektor=e-ticaret"
                    class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-sm sm:text-base text-center shadow-lg shadow-emerald-500/25 transition-all hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-3"
                  >
                    <span>Seçtiğim Sektörle Ücretsiz Başla</span>
                    <span class="text-lg">→</span>
                  </a>
                  <p class="text-[11px] sm:text-xs text-slate-400 text-center sm:text-left mt-2">
                    Kurulum gerekmez, internet olan her yerden cep telefonu ve bilgisayarla anında kullanın.
                  </p>
                </div>

                {/* Alternatif WhatsApp Destek */}
                <div class="w-full sm:w-auto flex flex-col items-center sm:items-end">
                  <a 
                    id="sectorWhatsappBtn"
                    href="https://wa.me/+905325000999?text=Merhaba,%20E-ticaret%20sekt%C3%B6r%C3%BC%20i%C3%A7in%20Stok%20Pratik%20kurulumu%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-bold text-xs sm:text-sm border border-slate-700 transition-colors flex items-center gap-2"
                  >
                    <span>💬 Sektör Danışmanına Soru Sor</span>
                  </a>
                  <span class="text-[11px] text-slate-400 mt-1">Canlı destek ekibi 1 dakikada yanıtlar</span>
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* 5. SIKÇA SORULAN SORULAR (AKORDEON) */}
    {/* ========================================================================= */}
    <section class="py-12 sm:py-16 bg-white border-t border-slate-200">
      <div class="container mx-auto px-4 max-w-4xl">
        
        <div class="text-center mb-10">
          <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Aklınıza Takılanlar</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">
            Sıkça Sorulan Sorular
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm mt-1.5">
            Geçiş süreci ve kullanım hakkında en çok merak edilen konular.
          </p>
        </div>

        {/* Akordeon Listesi */}
        <div class="space-y-3" id="faqAccordion">
          {faqs.map((faq, idx) => (
            <div class="faq-item rounded-2xl border border-slate-200 bg-slate-50/50 overflow-hidden transition-all duration-200">
              <button 
                type="button"
                class="faq-trigger w-full px-5 py-4 text-left font-bold text-slate-800 hover:text-indigo-900 flex items-center justify-between gap-4 text-sm sm:text-base focus:outline-none cursor-pointer"
                aria-expanded={idx === 0 ? "true" : "false"}
              >
                <span>{faq.q}</span>
                <span class="faq-icon w-6 h-6 rounded-full bg-slate-200/80 text-slate-600 flex items-center justify-center text-xs font-bold shrink-0 transition-transform duration-200">
                  {idx === 0 ? "−" : "+"}
                </span>
              </button>
              
              <div class={`faq-content px-5 pb-4 text-xs sm:text-sm text-slate-600 leading-relaxed ${idx === 0 ? 'block' : 'hidden'}`}>
