    <!-- CLIENT SCRIPT: 7 SENARYOLU LIVE OS SWITCHER INTERACTION -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const tabBtns = document.querySelectorAll('.os-tab-btn');
        const panels = document.querySelectorAll('.os-content-panel');

        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-target');
            
            // Tab stillerini güncelle
            tabBtns.forEach(b => {
              b.classList.remove('active', 'bg-indigo-600', 'text-white', 'shadow');
              b.classList.add('bg-slate-950', 'text-slate-400');
            });
            btn.classList.add('active', 'bg-indigo-600', 'text-white', 'shadow');
            btn.classList.remove('bg-slate-950', 'text-slate-400');

            // Panelleri aç/kapa
            panels.forEach(p => {
              if (p.id === targetId) {
                p.classList.remove('hidden');
                p.classList.add('block');
              } else {
                p.classList.remove('block');
                p.classList.add('hidden');
              }
            });
          });
        });
      });
    </script>

