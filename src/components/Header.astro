          </a>
        </div>
        
        <a href="https://erp-eticaret.stokpratik.com.tr/giris" class="inline-flex items-center justify-center px-4 py-2 text-slate-700 hover:text-red-600 font-bold text-[13px] rounded-lg border border-slate-200 hover:border-red-200 hover:bg-red-50 transition-all">
