---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Stok Pratik — Türkiye'nin Ticaret İşletim Sistemi | Bulut ERP, E-Ticaret, POS & Sektörel Çözümler";
const pageDescription = "Mağaza POS kasasından 37+ pazaryerine, üretim reçetesinden B2B toptana, 17'li e-Dönüşümden QR-PDKS personel takibine ve 5 dikey sektörel yazılıma kadar tek ekranda ticaret işletim sistemi.";

// Rakamlarla Güç Bandı Verileri
const stats = [
  { value: "40+", label: "Kurumsal Rapor", desc: "Finans, stok, kâr analizi" },
  { value: "37+", label: "Pazaryeri & Global", desc: "Trendyol, Amazon, Hepsiburada" },
  { value: "17", label: "e-Dönüşüm & SMMM", desc: "GİB, Luca, Zirve entegre" },
  { value: "10 Sn", label: "Stok Senkronu", desc: "Çift yönlü anlık eşitleme" },
  { value: "%100", label: "Bulut & KVKK", desc: "Sıfır donanım ve kurulum" }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-[#060A17] text-slate-100 overflow-hidden font-sans selection:bg-indigo-500 selection:text-white">
    
    <!-- 1. HERO BÖLÜMÜ: TİCARET İŞLETİM SİSTEMİ VİTRİNİ -->
    <section class="relative pt-16 pb-16 lg:pt-24 lg:pb-20 bg-gradient-to-b from-[#060A17] via-[#0A1026] to-[#0F172A] border-b border-slate-800">
      
      <!-- Dekoratif Arka Plan Işıkları -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[450px] bg-gradient-to-b from-indigo-600/15 via-purple-600/10 to-transparent blur-[120px] pointer-events-none"></div>
      <div class="absolute -top-32 -left-32 w-80 h-80 bg-blue-500/10 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute top-1/2 -right-32 w-80 h-80 bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="container mx-auto px-4 lg:px-8 max-w-7xl relative z-10">
        
        <!-- Üst Rozet & Başlık -->
        <div class="text-center max-w-4xl mx-auto mb-10">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs sm:text-sm font-semibold uppercase tracking-wider mb-6 shadow-inner backdrop-blur-md">
            <span>⚡ Türkiye'nin İlk Bütünleşik Ticaret İşletim Sistemi</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15] mb-6">
            Sadece Ön Muhasebe Değil; <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-300 to-emerald-400">
              Şirketinizin Tüm Ticari Hayatı
            </span> <br class="hidden sm:inline" />
            Tek Bir Bulut Ekosistemde.
          </h1>

          <p class="text-base sm:text-xl lg:text-2xl text-slate-300 font-normal leading-relaxed max-w-3xl mx-auto mb-8">
            Fiziksel mağaza kasasından 37+ pazaryerine, imalat reçetesinden B2B bayi ağına, e-Faturadan 15 sn dinamik QR-PDKS personel takibine kadar tüm ticari operasyonunuz tek ekranda.
          </p>

          <!-- Hızlı Eylem Butonları -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
            <a 
              href="/firma-kaydi" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-emerald-600 hover:from-indigo-500 hover:to-emerald-500 text-white font-bold text-base sm:text-lg shadow-xl shadow-indigo-600/30 hover:scale-[1.02] transition-all text-center"
            >
              🚀 30 Saniyede Ücretsiz Hesabınızı Açın
            </a>
            <a 
              href="#live-os" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 font-bold text-base sm:text-lg border border-slate-700/80 hover:border-slate-500 transition-all text-center flex items-center justify-center gap-2 shadow-lg"
            >
              <span>🎯 7 Canlı Senaryoyu İnceleyin</span>
              <span>↓</span>
            </a>
          </div>
          <p class="text-sm text-slate-400">Kredi kartı gerekmez • 14 gün ücretsiz tam deneme • Tüm modüller anında aktif</p>
        </div>

      </div>
    </section>


    <!-- 2. 🖥️ CANLI İŞLETİM SİSTEMİ SİMÜLATÖRÜ (TAM GENİŞLİK BEYAZ ZEMİN) -->
    <section class="w-full bg-white py-16 border-y border-slate-200 text-slate-800 relative z-20 shadow-sm" id="live-os">
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
        
        <!-- Bölüm Başlığı -->
        <div class="text-center max-w-3xl mx-auto mb-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-3">
            <span>⚡ CANLI İŞLETİM SİSTEMİ DENEYİMİ</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
            Türkiye'nin Ticaret İşletim Sistemi — Canlı Sahne
          </h2>
          <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed">
            Bir işletmenin tüm gününü tek panelde yöneten 7 kritik operasyonel senaryoyu butonlara tıklayarak canlı test edin:
          </p>
        </div>

        <!-- Sekme Seçici Butonları (GERÇEK TACTILE BUTONLAR) -->
        <div class="flex items-center justify-start lg:justify-center gap-3 pb-4 overflow-x-auto mb-8 no-scrollbar">
          <button data-target="tab-pos" class="os-tab-btn active flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-indigo-600 bg-indigo-600 text-white shadow-lg shadow-indigo-600/25 transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">🛒</span> Mağaza & Hızlı POS
          </button>
          <button data-target="tab-pazaryeri" class="os-tab-btn flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:border-slate-300 shadow-sm transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">🌐</span> 37+ Pazaryeri & E-İhracat
          </button>
          <button data-target="tab-b2b" class="os-tab-btn flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:border-slate-300 shadow-sm transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">🤝</span> B2B Toptan, CariNET & DepodanDirekt
          </button>
          <button data-target="tab-muhasebe" class="os-tab-btn flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:border-slate-300 shadow-sm transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">🧾</span> Ön Muhasebe & AI OCR
          </button>
          <button data-target="tab-uretim" class="os-tab-btn flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:border-slate-300 shadow-sm transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">🏭</span> Üretim ERP & Depo WMS
          </button>
          <button data-target="tab-pdks" class="os-tab-btn flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:border-slate-300 shadow-sm transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">📲</span> QR-PDKS & Puantaj
          </button>
          <button data-target="tab-bi" class="os-tab-btn flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm sm:text-base border-2 border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:border-slate-300 shadow-sm transition-all whitespace-nowrap cursor-pointer">
            <span class="text-lg">🧠</span> Patron BI Kokpiti
          </button>
        </div>

        <!-- 7 İNTERAKTİF SENARYO PANELİ (Pencere Tasarımı) -->
        <div class="bg-slate-900 rounded-3xl border border-slate-800 shadow-2xl p-6 sm:p-8 text-white relative overflow-hidden">
          <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-emerald-500"></div>

          <!-- 1. Senaryo: Mağaza & Hızlı POS -->
          <div id="tab-pos" class="os-content-panel block">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              <div class="lg:col-span-7 bg-slate-950 p-6 rounded-2xl border border-slate-800">
                <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                  <span class="font-bold text-base text-white flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Hızlı Satış Kasa #1 • Kadıköy Merkez Mağaza
                  </span>
                  <span class="text-slate-400 font-mono text-sm">Barkod: 8690123456789</span>
                </div>
                <div class="space-y-3 mb-4">
                  <div class="flex justify-between items-center p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 text-sm sm:text-base">
                    <span>• Erkek Slim Fit Gömlek (Mavi / M Beden)</span>
                    <span class="font-mono font-bold text-white">450,00 ₺</span>
                  </div>
                  <div class="flex justify-between items-center p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 text-sm sm:text-base">
                    <span>• Deri Kemer (Siyah / 110 cm)</span>
                    <span class="font-mono font-bold text-white">220,00 ₺</span>
                  </div>
                </div>
                <div class="pt-3 border-t border-slate-800 flex justify-between items-center">
                  <span class="text-slate-300 font-medium text-sm sm:text-base">Genel Toplam (KDV Dahil):</span>
                  <span class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">670,00 ₺</span>
                </div>
              </div>

              <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
                <div class="bg-slate-950 p-6 rounded-2xl border border-indigo-500/30">
                  <div class="font-bold text-indigo-400 text-base mb-2">⚡ 10 Saniye Otomatik Ekosistem Etkisi:</div>
                  <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
                    Kasada satılan gömlek Kadıköy fiziki mağaza rafından düştü; <strong>Trendyol, Hepsiburada, Amazon ve B2B toptan stokları 10 saniye içinde otomatik senkronize oldu</strong>.
                  </p>
                  <div class="p-3 bg-indigo-950/60 rounded-xl border border-indigo-500/40 text-xs sm:text-sm text-indigo-200 font-medium">
                    ✓ Parçalı Ödeme: 200 ₺ Nakit + 470 ₺ Kredi Kartı ile anında resmi e-Arşiv Fatura kesildi.
                  </div>
                </div>
                <a href="/hizli-satis" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition">
                  Dokunmatik POS Modülünü Keşfet →
                </a>
              </div>
            </div>
          </div>

          <!-- 2. Senaryo: 37+ Pazaryeri & E-İhracat -->
          <div id="tab-pazaryeri" class="os-content-panel hidden">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
              <div class="bg-slate-950 p-5 rounded-2xl border border-orange-500/30">
                <div class="flex justify-between items-center font-bold text-orange-400 text-base mb-2">
                  <span>🛍️ Trendyol Siparişi</span>
                  <span class="font-mono text-sm">#TY-98412</span>
                </div>
                <div class="text-slate-200 text-sm sm:text-base font-semibold mb-2">Kablosuz Bluetooth Kulaklık (Siyah)</div>
                <div class="text-xs text-slate-400 font-mono">Kargo Kodu: TY-KRG-8812 • e-Fatura Gönderildi</div>
              </div>
              <div class="bg-slate-950 p-5 rounded-2xl border border-amber-500/30">
                <div class="flex justify-between items-center font-bold text-amber-400 text-base mb-2">
                  <span>📦 Amazon Global</span>
                  <span class="font-mono text-sm">#AMZ-DE-441</span>
                </div>
                <div class="text-slate-200 text-sm sm:text-base font-semibold mb-2">El Yapımı Deri Cüzdan (Almanya)</div>
                <div class="text-xs text-slate-400 font-mono">ETGB Mikro İhracat • EUR Fatura Hazır</div>
              </div>
              <div class="bg-slate-950 p-5 rounded-2xl border border-emerald-500/30 flex flex-col justify-between">
                <div>
                  <div class="flex justify-between items-center font-bold text-emerald-400 text-base mb-2">
                    <span>⚡ 10 Sn Otomatik Senkron</span>
                    <span class="text-emerald-400 text-xs px-2 py-0.5 rounded bg-emerald-950 border border-emerald-500/30 font-bold">Aktif</span>
                  </div>
                  <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                    Sipariş düştüğü anda kargo fişi yazıcıdan çıkar, fatura kesilir, stoklar tüm kanallarda kilitlenir.
                  </p>
                </div>
                <a href="/pazaryeri" class="text-emerald-400 font-bold text-xs sm:text-sm hover:underline mt-3 inline-block">
                  Pazaryeri Modülünü İncele →
                </a>
              </div>
            </div>
          </div>

          <!-- 3. Senaryo: B2B Toptan, CariNET & DepodanDirekt -->
          <div id="tab-b2b" class="os-content-panel hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              <div class="lg:col-span-7 bg-slate-950 p-6 rounded-2xl border border-slate-800">
                <div class="flex justify-between items-center pb-3 border-b border-slate-800 mb-3 font-mono text-sm">
                  <span class="text-indigo-400 font-bold">Bayi Kodu: BAYI-ANKARA-06</span>
                  <span class="text-emerald-400 font-bold">Platin Bayi İskontosu (%35)</span>
                </div>
                <div class="space-y-2 text-sm text-slate-300 mb-4">
                  <div class="flex justify-between p-2.5 rounded bg-slate-900">
                    <span>• 50 Koli Endüstriyel Streç Film (Palet Siparişi)</span>
                    <span class="font-mono text-white font-bold">12.500,00 ₺</span>
                  </div>
                  <div class="flex justify-between p-2.5 rounded bg-slate-900">
                    <span>• Açık Hesap Kalan Kredi Limiti:</span>
                    <span class="font-mono text-emerald-400 font-bold">85.000,00 ₺ (Onaylandı)</span>
                  </div>
                </div>
                <div class="text-xs text-slate-400">
                  Bayi kendi ekranından 12 taksit Sanal POS ile ödedi; sipariş doğrudan depoda sevkiyat emrine dönüştü.
                </div>
              </div>
              <div class="lg:col-span-5 bg-slate-950 p-6 rounded-2xl border border-blue-500/30">
                <div class="font-bold text-blue-400 text-base mb-2">🌐 DepodanDirekt.com B2B Ağı:</div>
                <p class="text-slate-300 text-sm leading-relaxed mb-4">
                  Ürünlerinizi Türkiye genelindeki binlerce toptancı ve bayiye kapalı devre B2B vitriniyle toptan satın; vadeli alacaklarınızı CariNET ile güvene alın.
                </p>
                <a href="/b2b" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 font-bold text-sm">
                  B2B Portali Detayları →
                </a>
              </div>
            </div>
          </div>

          <!-- 4. Senaryo: Ön Muhasebe & AI OCR (Görsel Önizlemeli) -->
          <div id="tab-muhasebe" class="os-content-panel hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              <div class="lg:col-span-7 bg-slate-950 p-6 rounded-2xl border border-slate-800">
                <div class="font-bold text-emerald-400 text-base mb-3 flex items-center gap-2">
                  <span>🤖 Yapay Zeka AI OCR Fiş Analizi (Tamamlandı)</span>
                </div>
                <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 font-mono text-sm text-slate-200 space-y-2 mb-4">
                  <div class="text-emerald-300 font-bold">✓ Satıcı: Opet Petrolcülük A.Ş. • Fiş No: 0042</div>
                  <div>• Akaryakıt Fişi: 1.850,00 ₺</div>
                  <div>• Ayrıştırılan KDV (%20): 308,33 ₺</div>
                  <div>• Gider Hesabı: 770 Taşıt Masrafları (Otomatik Eklendi)</div>
                </div>
                <div class="text-xs text-slate-400">
                  Cep telefonundan çekilen fotoğraf 3 saniyede taranıp resmi kayıtlara geçirildi; kayıp fiş ziyanı sıfırlandı.
                </div>
              </div>
              <div class="lg:col-span-5 bg-slate-950 p-4 rounded-2xl border border-purple-500/30 text-center">
                <img 
                  src="/images/site-foto/stok-pratik-efatura.jpg" 
                  alt="Stok Pratik e-Fatura ve Muhasebe Arayüzü" 
                  class="w-full h-44 object-cover rounded-xl border border-slate-800 mb-3 shadow" 
                  loading="lazy"
                />
                <div class="font-bold text-white text-sm mb-1">🏛️ 17'li e-Dönüşüm & SMMM Portalı</div>
                <p class="text-slate-400 text-xs mb-3">
                  e-Fatura, e-Arşiv, e-İrsaliye; Luca ve Zirve formatında tek tıkla mizan transferi.
                </p>
                <a href="/e-donusum" class="text-purple-400 hover:text-purple-300 font-bold text-xs sm:text-sm">
                  e-Dönüşüm Merkezini İncele →
                </a>
              </div>
            </div>
          </div>

          <!-- 5. Senaryo: Üretim ERP & Depo WMS -->
          <div id="tab-uretim" class="os-content-panel hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              <div class="lg:col-span-7 bg-slate-950 p-6 rounded-2xl border border-slate-800">
                <div class="flex justify-between items-center font-bold text-white text-base mb-3 pb-2 border-b border-slate-800">
                  <span>⚙️ Üretim Reçetesi (BOM) • Mamul: Deri Koltuk #DK-01</span>
                  <span class="text-emerald-400 font-mono">Birim Maliyet: 4.820 ₺</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm text-slate-300 mb-4">
                  <div class="p-3 bg-slate-900 rounded-xl border border-slate-800">• 6 m² Hakiki Deri (-6m² Depo)</div>
                  <div class="p-3 bg-slate-900 rounded-xl border border-slate-800">• 1 Adet İskelet (-1Ad Depo)</div>
                  <div class="p-3 bg-slate-900 rounded-xl border border-slate-800">• İşçilik & Makine Payı</div>
                </div>
                <p class="text-xs text-slate-400">
                  4 istasyonlu hat takibiyle fireler hesaplanır, mamul otomatik depoya girerken reçetedeki hammaddeler anında düşer.
                </p>
              </div>
              <div class="lg:col-span-5 bg-slate-950 p-4 rounded-2xl border border-orange-500/30 text-center">
                <img 
                  src="/images/site-foto/Stok-pratik-genel.png" 
                  alt="Stok Pratik Genel Yönetim ve Üretim Ekranı" 
                  class="w-full h-44 object-cover rounded-xl border border-slate-800 mb-3 shadow" 
                  loading="lazy"
                />
                <div class="font-bold text-orange-400 text-sm mb-1">Fabrika, İstasyon ve WMS Depo</div>
                <a href="/uretim" class="text-orange-400 hover:text-orange-300 font-bold text-xs sm:text-sm inline-block">
                  Üretim ERP Modülünü Aç →
                </a>
              </div>
            </div>
          </div>

          <!-- 6. Senaryo: QR-PDKS & Puantaj -->
          <div id="tab-pdks" class="os-content-panel hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div class="bg-slate-950 p-6 rounded-2xl border border-cyan-500/30">
                <div class="flex justify-between items-center font-bold text-cyan-400 text-base mb-3">
                  <span>⏱️ 15 Sn Dinamik Kiosk QR</span>
                  <span class="text-emerald-400 font-mono font-bold animate-pulse text-sm">Yeni Kod: 08s</span>
                </div>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
                  Fotoğrafı çekilemez, evden okutulamaz. GPS geofence mesafe kontrolü ve cihaz parmak izi kilidiyle sıfır donanım maliyetli personel takibi!
                </p>
                <div class="text-xs text-cyan-300 font-mono">HMAC-SHA256 Şifreleme • Tablet / Ekran Kiosk Uyumlu</div>
              </div>
              <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 flex flex-col justify-between">
                <div>
                  <div class="font-bold text-white text-base mb-2">📋 SGK 30 Günlük Puantaj Matrisi</div>
                  <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-3">
                    Normal çalışma, fazla mesai (%50 / %100), izin ve geç kalma süreleri otomatik hesaplanır, imzalı A4 çıktı ve SMMM Excel aktarımı anında hazır.
                  </p>
                </div>
                <a href="/pdks" class="text-cyan-400 font-bold text-sm hover:underline mt-2">
                  QR-PDKS Personel Takip Detayları →
                </a>
              </div>
            </div>
          </div>

          <!-- 7. Senaryo: Patron BI Kokpiti -->
          <div id="tab-bi" class="os-content-panel hidden">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="bg-slate-950 p-5 rounded-2xl border border-emerald-500/30">
                <div class="text-xs text-slate-400 font-mono uppercase tracking-wider">Net Dönem Kârı</div>
                <div class="text-2xl font-black text-emerald-400 font-mono mt-2">285.000 ₺</div>
                <div class="text-xs text-slate-400 mt-1">Pazaryeri komisyonları ve giderler düşüldü</div>
              </div>
